# Myntos environment configuration
#
# Copy this file to `.env` at the repo root:   cp .env.example .env
# The backend reads the repo-root .env in development; in production, inject
# real environment variables instead (never ship a .env file).
#
# NEVER commit .env or any key material. .gitignore excludes it and the
# gitleaks pre-commit hook scans for leaked secrets, but stay careful.

# --- General ------------------------------------------------------------------
# One of: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------
# Local PostgreSQL via: docker compose up -d db
DATABASE_URL=postgresql+asyncpg://myntos:myntos@localhost:5432/myntos

# --- CORS -----------------------------------------------------------------------
# JSON array of allowed browser origins for the API (Astro dev server is 4321).
# Also the trusted-origin allow-list for cookie-authenticated writes, so an
# origin missing here cannot POST with a session cookie.
CORS_ORIGINS=["http://localhost:4321"]

# --- Application accounts (Myntos' own login) --------------------------------------
# Absolute URL of the frontend. Post-login redirects and invitation links are
# built from it.
FRONTEND_BASE_URL=http://localhost:4321

# Session cookie. SESSION_COOKIE_DOMAIN is only needed when the API and the
# frontend live on different subdomains of one site (e.g. ".myntos.no"); leave
# it empty for a host-only cookie, which is the safer default.
SESSION_COOKIE_NAME=myntos_session
SESSION_COOKIE_DOMAIN=
# Absolute cap on a session's age, and how long an idle one stays usable.
SESSION_LIFETIME_DAYS=14
SESSION_IDLE_TIMEOUT_HOURS=24

# Password policy is length-based (NIST SP 800-63B advises against composition
# rules). Login throttling is per account; source-based rate limiting belongs at
# the edge (Cloudflare).
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
INVITATION_LIFETIME_DAYS=7

# --- Federated sign-in (Google, Microsoft, Vipps) ------------------------------------
# All optional; password login works without any of them. A provider appears on
# the login page only when its three values are set, so /api/v1/auth/providers
# lists nothing until then and no button can lead to a 503.
#
# Only identity scopes are requested from every provider — a name and an email,
# never access to mail, files or payments.

# Google. Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → "Web application". Register GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_WELL_KNOWN_URL=https://accounts.google.com/.well-known/openid-configuration

# Microsoft Entra ID. Azure portal → App registrations → New registration, with
# a "Web" redirect URI matching MICROSOFT_REDIRECT_URI, then Certificates &
# secrets → New client secret.
#
# IMPORTANT — add the optional claims before going live: Token configuration →
# Add optional claim → ID → "email", and enable "xms_edov". Microsoft does not
# send `email_verified` at all, and `xms_edov` is its documented replacement
# (the remediation for the nOAuth vulnerability). Without it Myntos treats every
# Microsoft address as unverified, which still lets people sign up, but refuses
# to attach a Microsoft login to a Myntos account that already exists on that
# address.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
# Who may sign in. This is an authorization boundary: with "common", any
# Microsoft tenant in the world can start a sign-in. Use your own tenant GUID to
# restrict it, or "organizations" for work and school accounts only.
MICROSOFT_TENANT=common
# Derived from MICROSOFT_TENANT unless set here.
MICROSOFT_WELL_KNOWN_URL=

# Vipps MobilePay Login. Needs a merchant agreement, not just an app
# registration — get the credentials from portal.vippsmobilepay.com.
# NOTE: the well-known URL below has not been verified against Vipps' current
# developer documentation. Check it before enabling this in production; it is a
# configuration value, so correcting it is an env change, not a code change.
# Test environment: https://apitest.vipps.no/access-management-1.0/access/.well-known/openid-configuration
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_REDIRECT_URI=http://localhost:8000/api/v1/auth/vipps/callback
VIPPS_WELL_KNOWN_URL=https://api.vipps.no/access-management-1.0/access/.well-known/openid-configuration

# --- Maskinporten ----------------------------------------------------------------
# Machine-to-machine auth required by all Skatteetaten APIs.
# Register a client in Digdir's Samarbeidsportalen, then fill these in.
# See docs/integrations/maskinporten.md.
#
# Test:  https://test.maskinporten.no/.well-known/oauth-authorization-server
# Prod:  https://maskinporten.no/.well-known/oauth-authorization-server
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_WELL_KNOWN_URL=https://test.maskinporten.no/.well-known/oauth-authorization-server
# Space-separated scopes. Request ONLY scopes your organization has actually
# been granted — Maskinporten rejects the entire token request if any
# requested scope is unauthorized. The Altinn ones below are available from
# the moment the client is created; add
# "skatteetaten:formueinntekt/skattemelding" once Skatteetaten grants access
# (see docs/integrations/maskinporten.md).
MASKINPORTEN_SCOPES=altinn:instances.read altinn:instances.write
# Absolute path to the private JWK used to sign the JWT grant.
# Keep it OUTSIDE the repo, or inside ./secrets/ (gitignored). Uncomment to use:
#MASKINPORTEN_JWK_PATH=./secrets/maskinporten.jwk.json

# --- ID-porten ---------------------------------------------------------------------
# Personal end-user login (OIDC authorization-code flow). REQUIRED for
# validating and submitting the MVA-melding and skattemelding — Maskinporten
# alone only covers retrieval APIs (Skatteetaten policy, as of 2026).
# Test:  https://test.idporten.no/.well-known/openid-configuration
# Prod:  https://idporten.no/.well-known/openid-configuration
IDPORTEN_CLIENT_ID=
IDPORTEN_WELL_KNOWN_URL=https://test.idporten.no/.well-known/openid-configuration
IDPORTEN_REDIRECT_URI=

# --- Altinn ------------------------------------------------------------------------
# ID-porten/Maskinporten tokens are exchanged for Altinn tokens here before
# calling instance APIs. Test: platform.tt02.altinn.no — Prod: platform.altinn.no
ALTINN_PLATFORM_BASE_URL=https://platform.tt02.altinn.no

# --- Skatteetaten ------------------------------------------------------------------
# Base URL for the Skatteetaten APIs (test environment first).
# Test: https://api-test.sits.no — Prod: https://api.skatteetaten.no
SKATTEETATEN_API_BASE_URL=

# --- Løynd (KI-forslag på bilag) -----------------------------------------------------
# Optional. Without a key, Myntos still reads uploaded PDFs — dato, beløp and mva
# come from the text itself — but nobody is asked which category the payment
# belongs to, and that field is left to the user.
#
# Løynd (loynd.no) runs its inference servers in Norway and retains nothing,
# which is why it is the one external service allowed to see a bilag. Keys are
# issued at loynd.no/developers. The API is OpenAI-shaped, so LOYND_BASE_URL can
# also point at a self-hosted model.
LOYND_KEY=
LOYND_BASE_URL=https://api.loynd.no
LOYND_MODEL=loynd-lite

# --- Enhetsregisteret (Brønnøysundregistrene) ----------------------------------------
# Open data — no credentials. Company and party names are looked up from the
# organisasjonsnummer here. Leave unset unless you are pointing it at a stub.
# BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# --- Document storage (bilag PDFs) ---------------------------------------------------
# One of: local | r2
#
# "local" writes to LOCAL_STORAGE_PATH and is for development only — a
# Cloudflare Container's disk is ephemeral, so anything stored there is gone
# when the instance sleeps. Production must use r2.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/bilag

# Cloudflare R2 (only used when STORAGE_BACKEND=r2). All four are required;
# a blank value counts as missing and the application refuses to start rather
# than discovering it at the first upload.
#
# Create the bucket with `wrangler r2 bucket create <name> --jurisdiction eu`,
# then an S3 API token under R2 → Manage API tokens. The token needs Object
# Read & Write on this bucket and nothing else — Myntos never lists, deletes or
# administers buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The jurisdiction is part of the endpoint hostname, is fixed when the bucket
# is created, and cannot be changed afterwards. "eu" keeps accounting records
# inside the EEA (see docs/ARCHITECTURE.md on bokføringsforskriften § 7-5);
# pointing at the wrong one does not fail over, it writes somewhere else.
# One of: eu | fedramp | default
R2_JURISDICTION=eu
# Optional: overrides the endpoint entirely, for a self-hosted S3-compatible
# store (MinIO) or a test double. Normally leave empty.
R2_ENDPOINT_URL=
