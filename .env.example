# Myntos environment configuration
#
# Copy this file to `.env` at the repo root:   cp .env.example .env
# The backend reads the repo-root .env in development; in production, inject
# real environment variables instead (never ship a .env file).
#
# NEVER commit .env or any key material. .gitignore excludes it and the
# gitleaks pre-commit hook scans for leaked secrets, but stay careful.

# --- General ------------------------------------------------------------------
# One of: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------
# Local PostgreSQL via: docker compose up -d db
DATABASE_URL=postgresql+asyncpg://myntos:myntos@localhost:5432/myntos

# --- CORS -----------------------------------------------------------------------
# JSON array of allowed browser origins for the API (Astro dev server is 4321).
# Also the trusted-origin allow-list for cookie-authenticated writes, so an
# origin missing here cannot POST with a session cookie.
CORS_ORIGINS=["http://localhost:4321"]

# --- Application accounts (Myntos' own login) --------------------------------------
# Absolute URL of the frontend. Post-login redirects and invitation links are
# built from it.
FRONTEND_BASE_URL=http://localhost:4321

# Session cookie. SESSION_COOKIE_DOMAIN is only needed when the API and the
# frontend live on different subdomains of one site (e.g. ".myntos.no"); leave
# it empty for a host-only cookie, which is the safer default.
SESSION_COOKIE_NAME=myntos_session
SESSION_COOKIE_DOMAIN=
# Absolute cap on a session's age, and how long an idle one stays usable.
SESSION_LIFETIME_DAYS=14
SESSION_IDLE_TIMEOUT_HOURS=24

# Password policy is length-based (NIST SP 800-63B advises against composition
# rules). Login throttling is per account; source-based rate limiting belongs at
# the edge (Cloudflare).
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
INVITATION_LIFETIME_DAYS=7
# Links mailed to a person's own address. A reset link is a password while it
# lives, so keep it short. The hourly cap is per account and per kind of link,
# and it is what stops the anonymous "forgot password" form being used to mail
# a stranger on repeat.
EMAIL_VERIFICATION_LIFETIME_HOURS=48
PASSWORD_RESET_LIFETIME_MINUTES=30
ACCOUNT_MAIL_MAX_PER_HOUR=3

# Keys a person makes for their own AI agent or program (docs/agents-and-api.md).
# The pasted connection key works once, within a day; the access token it is
# exchanged for lasts minutes; the refresh chain dies after a month unused and
# the key after a year regardless. The two limits are per key: requests a
# minute, and refusals in ten minutes before the key is stopped as a probe.
AGENT_CONNECTION_KEY_LIFETIME_HOURS=24
AGENT_ACCESS_TOKEN_LIFETIME_MINUTES=15
AGENT_REFRESH_IDLE_DAYS=30
AGENT_KEY_LIFETIME_DAYS=365
AGENT_KEY_REQUESTS_PER_MINUTE=120
AGENT_KEY_REFUSALS_BEFORE_SUSPENSION=20

# --- Outgoing email --------------------------------------------------------------
# Optional. Myntos sends three kinds of message: the invitation that lets a
# colleague into a company's books, the link that confirms a new account's
# address, and the password-reset link. Left unset, nothing is sent and the
# interface says so: the inviter gets a link to pass on themselves, and address
# confirmation and "forgot password" are simply not offered.
#
# SMTP_HOST and MAIL_FROM are both required before anything is sent; either one
# alone counts as unconfigured. MAIL_FROM has to be an address the host is
# allowed to send as, or the message is rejected or filed as spam however
# correct the rest of this is. Point SPF and DKIM at the same host while you are
# here: an invitation that lands in spam is an invitation nobody accepted.
#
# SMTP_TLS_MODE is "starttls" (submission, port 587), "ssl" (implicit TLS, port
# 465) or "none". Never "none" over a network.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM=
MAIL_FROM_NAME=Myntos
# Where replies go. Unset, an invitee's reply goes to MAIL_FROM; the invitation
# sets its own Reply-To to the colleague who sent it, which is the case that
# matters.
MAIL_REPLY_TO=

# --- Outgoing email via Cloudflare, instead of SMTP -------------------------------
# The other transport. Pick this one when the sending domain is already on
# Cloudflare DNS: `wrangler email sending enable <domain>` writes the SPF, DKIM
# and DMARC records itself, so there is no second set of records to keep in step
# with a relay's.
#
# MAIL_FROM above still decides the sender, and both transports send the same
# MIME message. SMTP_HOST wins if both are configured.
#
# CLOUDFLARE_ACCOUNT_ID is the same account R2_ACCOUNT_ID names; it is spelled
# out again so storage and mail can be moved independently.
# CLOUDFLARE_EMAIL_TOKEN is an API token with "Send email" and nothing else:
# Dashboard → My Profile → API Tokens → Create Token → Custom token →
# Permissions: Account · Email Sending · Send.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=

# --- Operator / developer error notifications (docs/operator.md) ------------------
# Plain-text ping when the server logs a new or reopened ERROR (code metadata
# only — route template, logger, log template, exception type — never accounting
# values). SERVER_ERROR_NOTIFY_TO takes precedence over DEVELOPER_MAIL if both
# are set; leave both empty to disable error emails.
DEVELOPER_MAIL=
SERVER_ERROR_NOTIFY_TO=

# --- Inbound email invoice intake (Mottatt, @myntos.no) --------------------------
# Optional. Every company gets a dedicated <slug>@<INBOUND_EMAIL_DOMAIN> address
# (e.g. test@myntos.no, falling back to testas@myntos.no) for emailing PDF/image
# invoices straight into Mottatt. Set INBOUND_EMAIL_WEBHOOK_SECRET to a random
# 32-byte hex string (openssl rand -hex 32) and store the exact same secret on
# the Cloudflare Email Worker in infra/cloudflare/email-worker/. Left unset, the
# webhook fails closed (503) while company addresses are still allocated.
INBOUND_EMAIL_DOMAIN=myntos.no
INBOUND_EMAIL_WEBHOOK_SECRET=
INBOUND_EMAIL_MAX_PER_HOUR=60

# --- Federated sign-in (Google, Microsoft, BankID) -----------------------------------
# All optional; password login works without any of them. A provider appears on
# the login page only when its values are all set, so /api/v1/auth/providers
# lists nothing until then and no button can lead to a 503.
#
# Only identity scopes are requested from every provider — a name and an email
# (BankID: a name only), never access to mail, files or payments.

# Google. Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → "Web application". Register GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_WELL_KNOWN_URL=https://accounts.google.com/.well-known/openid-configuration

# Microsoft Entra ID. Azure portal → App registrations → New registration, with
# a "Web" redirect URI matching MICROSOFT_REDIRECT_URI, then Certificates &
# secrets → New client secret.
#
# IMPORTANT — add the optional claims before going live: Token configuration →
# Add optional claim → ID → "email", and enable "xms_edov". Microsoft does not
# send `email_verified` at all, and `xms_edov` is its documented replacement
# (the remediation for the nOAuth vulnerability). Without it Myntos treats every
# Microsoft address as unverified, which still lets people sign up, but refuses
# to attach a Microsoft login to a Myntos account that already exists on that
# address.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
# Who may sign in. This is an authorization boundary: with "common", any
# Microsoft tenant in the world can start a sign-in. Use your own tenant GUID to
# restrict it, or "organizations" for work and school accounts only.
MICROSOFT_TENANT=common
# Derived from MICROSOFT_TENANT unless set here.
MICROSOFT_WELL_KNOWN_URL=

# BankID, through an OpenID Connect broker. Idura (formerly Criipto, part of
# Stø, which runs BankID; Denmark) is the documented one, with a free sandbox
# and test users; see docs/ARCHITECTURE.md § Federated providers for the
# dashboard steps. Never ID-porten: Digdir's terms do not allow it as a
# product login.
#
# The broker's domain or issuer. Sandbox: https://<name>.test.idura.broker.
BANKID_ISSUER=
# The application's "Client ID / Realm" in Idura's dashboard.
BANKID_CLIENT_ID=
# Register exactly this as a Redirect URL on the Idura application.
BANKID_REDIRECT_URI=http://localhost:8000/api/v1/auth/bankid/callback
# Client authentication: private_key_jwt (recommended by Idura) or a secret.
# For the key, a JWK or PEM file; the public JWKS to paste into the
# application's OpenID Connect -> Client JWKS comes from
#   cd backend && uv run python -m myntos.auth.digdir_key show bankid
# and a PEM needs BANKID_KID set to the kid in that JWKS. Uncomment to use:
#BANKID_JWK_PATH=./secrets/bankid.pem
BANKID_KID=
# Or, instead of a key, the application's client secret:
BANKID_CLIENT_SECRET=
# urn:grn:authn:no:bankid:substantial = BankID app with biometrics (default);
# urn:grn:authn:no:bankid = classic code device, assurance level high.
BANKID_ACR_VALUES=urn:grn:authn:no:bankid:substantial
# Never add "ssn": Myntos does not ask for the fødselsnummer (docs/gdpr.md).
BANKID_SCOPE=openid

# --- Maskinporten ----------------------------------------------------------------
# Machine-to-machine auth required by all Skatteetaten APIs.
# Register a client in Digdir's Samarbeidsportalen, then fill these in.
# See docs/integrations/maskinporten.md.
#
# Test:  https://test.maskinporten.no/.well-known/oauth-authorization-server
# Prod:  https://maskinporten.no/.well-known/oauth-authorization-server
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_WELL_KNOWN_URL=https://test.maskinporten.no/.well-known/oauth-authorization-server
# Space-separated scopes. Request ONLY scopes your organization has actually
# been granted — Maskinporten rejects the entire token request if any
# requested scope is unauthorized. The Altinn ones below are available from
# the moment the client is created; add
# "skatteetaten:formueinntekt/skattemelding" once Skatteetaten grants access
# (see docs/integrations/maskinporten.md).
# digdir:skattemelding carries the Altinn rights to represent a taxpayer -
# "lese og levere skattemelding for alle organisasjoner som jeg har rettigheter
# for i Altinn". Without it the API answers 400 SME-EKSTERN-005, and it belongs
# on BOTH the Maskinporten and the ID-porten client. Add it here once granted.
MASKINPORTEN_SCOPES=altinn:instances.read altinn:instances.write digdir:skattemelding
# Path to the private key that signs the JWT grant. A JWK document or a PEM
# private key — both are read; a relative path is resolved from the repo root.
# Keep it OUTSIDE the repo, or inside ./secrets/ (gitignored). Uncomment to use:
#MASKINPORTEN_JWK_PATH=./secrets/maskinporten.jwk.json
# The key id registered in Samarbeidsportalen. A JWK carries its own and this is
# ignored; a PEM does not, so it is REQUIRED for one. Get the value with:
#   cd backend && uv run python -m myntos.auth.digdir_key show maskinporten
# which prints the public JWK to paste into the portal and the kid to set here.
# A mismatch is answered with "invalid_client" and nothing more specific.
MASKINPORTEN_KID=
# Only for acting on a client's behalf (regnskapsfører) with one fixed client:
# the orgnr whose delegation is used, sent as consumer_org in the grant. Leave
# empty and pass it per request when you keep books for several companies.
MASKINPORTEN_CONSUMER_ORG=

# --- ID-porten ---------------------------------------------------------------------
# Personal end-user login (OIDC authorization-code flow). REQUIRED for
# validating and submitting the MVA-melding and skattemelding — Maskinporten
# alone only covers retrieval APIs (Skatteetaten policy, as of 2026).
# Test:  https://test.idporten.no/.well-known/openid-configuration
# Prod:  https://idporten.no/.well-known/openid-configuration
IDPORTEN_CLIENT_ID=
IDPORTEN_WELL_KNOWN_URL=https://test.idporten.no/.well-known/openid-configuration
# Must match the redirect URI registered in Samarbeidsportalen byte for byte.
# Note the loopback IP rather than the name "localhost": ID-porten follows
# RFC 8252, which prefers the literal 127.0.0.1 because a name can be resolved
# to somewhere else. Registering "localhost" is rejected.
IDPORTEN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/skatt/idporten/callback
# Scopes beyond openid, space separated. Ordered from Skatteetaten and inert
# until granted; requesting an ungranted one fails the whole authorization.
# The MVA-melding needs exactly one of them:
#   skatteetaten:mvameldingvalidering
# Do not add skatteetaten:mvameldinginnsending. Skatteetaten retired it in
# favour of altinn:instances.read/write (docs/integrations/mva.md, scope audit),
# and asking for it now fails the login with invalid_scope.
# digdir:skattemelding carries the Altinn rights to represent a taxpayer -
# "lese og levere skattemelding for alle organisasjoner som jeg har rettigheter
# for i Altinn". Without it the API answers 400 SME-EKSTERN-005, and it belongs
# on BOTH the Maskinporten and the ID-porten client. Add it here once granted.
# At least one altinn:* scope belongs on the ID-porten client, because a token
# carrying only openid has no audience Altinn recognises and the exchange to an
# Altinn token answers 403 naming nothing. One is enough, and this one earns its
# place twice over:
#   altinn:accessmanagement/authorizedparties   - the list of companies the
#     person may report for, shown as a picker on the dashboard's company form
#     and spent on confirming a company (myntos.integrations.altinn
#     .authorized_parties). Free to request once the client has it; without it
#     the list is a 403 and the form is typed by hand
# Not altinn:enduser. It was what test added first, and this file named it for a
# fortnight, but it is an Altinn-2-era umbrella: production has never held it
# and exchanges tokens fine, Altinn's own docs point at the specific scopes, and
# Samarbeidsportalen no longer offers it (the altinn:enduser/* scopes still in
# the picker are marked LEGACY, pointing at the name without the prefix).
# profile is Digdir's own and needs no grant from anybody - it is ticked onto
# the client in Samarbeidsportalen like the rest. It adds the "name" claim, from
# Folkeregisteret, which is what lets a person's ID-porten login be recognised
# in a company's styreliste in Enhetsregisteret: without it the organisasjon
# page can only say "trolig" where it could say "bekreftet". Nothing breaks
# without it - myntos.domain.identity.register_match falls back to the name on
# the account - so it buys a better answer rather than a working one.
IDPORTEN_SCOPES=
# How the client authenticates. private_key_jwt (Digdir's default) needs its own
# key — a separate one from Maskinporten's, since it is a separate client:
#   cd backend && uv run python -m myntos.auth.digdir_key generate --out ../secrets/idporten.pem
#IDPORTEN_JWK_PATH=./secrets/idporten.pem
IDPORTEN_KID=
# Alternative to the key, for a client registered with a secret instead.
IDPORTEN_CLIENT_SECRET=
# Level of assurance demanded of the login, and checked on the way back.
# idporten-loa-high means BankID/Buypass/Commfides rather than MinID, which is
# what Skatteetaten requires for submissions.
IDPORTEN_ACR_VALUES=idporten-loa-high

# Fernet key the stored government (ID-porten) access token is encrypted with.
# Unset, the ID-porten login is unavailable rather than stored in the clear -
# the token authorizes filing a tax return in a named person's name. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it invalidates in-flight logins only (rows live for minutes), so it
# is safe to change; those users log in again.
GOVERNMENT_TOKEN_KEY=

# --- Altinn ------------------------------------------------------------------------
# ID-porten/Maskinporten tokens are exchanged for Altinn tokens here before
# calling instance APIs. Test: platform.tt02.altinn.no — Prod: platform.altinn.no
ALTINN_PLATFORM_BASE_URL=https://platform.tt02.altinn.no
# The Altinn 3 apps a submission travels through, one absolute URL each. The
# host differs between environments, so these are never constants in code. The
# MVA app is "-v1" in both: "-etm2" was documented for test once and does not
# exist on tt02 (it answers 418).
ALTINN_SKATTEMELDING_APP_URL=https://skd.apps.tt02.altinn.no/skd/formueinntekt-skattemelding-v2
ALTINN_MVA_APP_URL=https://skd.apps.tt02.altinn.no/skd/mva-melding-innsending-v1
# Brønnøysundregistrene årsregnskap (RR-0002):
# Test: https://brg.apps.tt02.altinn.no/brg/aarsregnskap-vanlig-202406
# Prod: https://brg.apps.altinn.no/brg/aarsregnskap-vanlig-202406
ALTINN_AARSREGNSKAP_APP_URL=https://brg.apps.tt02.altinn.no/brg/aarsregnskap-vanlig-202406

# Systembruker: we are the *vendor* of this system. Forms the system id
# {orgnr}_{name}, which Altinn treats as permanent once a customer has
# approved a system user against it. The redirect URL must be https.
ALTINN_VENDOR_ORGNR=
ALTINN_SYSTEM_NAME=myntos
ALTINN_SYSTEM_REDIRECT_URL=https://myntos.no/skatt/systembruker/godkjent

# --- Skatteetaten ------------------------------------------------------------------
# Three hosts, because Skatteetaten splits them by auth plane — and the test
# names do not follow one pattern, so none of them can be derived from another.
#
# Maskinporten plane (fetch and validate the skattemelding).
# Test: https://api-test.sits.no — Prod: https://api.skatteetaten.no
SKATTEETATEN_API_BASE_URL=https://api-test.sits.no
# ID-porten plane for the skattemelding.
# Test: https://idporten-api-test.sits.no — Prod: https://idporten.api.skatteetaten.no
SKATTEETATEN_IDPORTEN_API_BASE_URL=https://idporten-api-test.sits.no
# MVA validation. Skatteetaten documents "sbstest" here, a different host from the
# line above, but idporten-api-sbstest.sits.no resets every connection after the
# TLS handshake (2026-10-06 onwards), and the "test" host answers the same path:
# it validated the 2026-10-10 run. See docs/integrations/mva.md, Endpoints.
# Test: https://idporten-api-test.sits.no — Prod: https://idporten.api.skatteetaten.no
SKATTEETATEN_MVA_API_BASE_URL=https://idporten-api-test.sits.no

# --- Løynd (KI-forslag på bilag og faktura) -----------------------------------------
# Optional. Without a key, Myntos still reads uploaded PDFs — dato, beløp and mva
# come from the text itself — but nobody is asked which category the payment
# belongs to, and that field is left to the user.
#
# Løynd (loynd.no) runs inside the EEA and retains nothing, which is why it is
# the one external service allowed to see a bilag. The free level (LOYND_MODEL)
# and every picture run on Løynd's own machines in Norway. Keys are issued at
# loynd.no/developers. The API is OpenAI-shaped, so LOYND_BASE_URL can also
# point at a self-hosted model.
LOYND_KEY=
LOYND_BASE_URL=https://api.loynd.no
LOYND_MODEL=loynd-lite
#
# The paid levels a KI plan buys, «Medium» and «Smart». Løynd runs them on
# its own machines when they are free and otherwise on extra inference capacity
# in the EU, so LOYND_KEY must not be a Norway-only key (Løynd answers 403 for
# these models then), and it needs prepaid credit at Løynd (402 without it).
# Either refusal falls back to the free level, says so, and charges no tokens.
# The defaults are Løynd's tier names, which follow its best model in each.
# LOYND_MODEL_MEDIUM=medium
# LOYND_MODEL_THINKING=high

# --- Mollie (payment for the KI plans) ----------------------------------------------
# Optional. Without a key for MOLLIE_MODE, or with MOLLIE_MODE=off, no plan can
# be bought and the buy buttons on /ki/ stay hidden; «Gratis» keeps working.
# Keys are at my.mollie.com under Developers -> API keys. Both may sit here:
# MOLLIE_MODE picks one, and the default, test, can never charge a card.
# Mollie B.V. is in the Netherlands, inside the EEA. Nothing about the card is
# stored in Myntos; the status is always fetched from Mollie with this key.
MOLLIE_TEST_KEY=
MOLLIE_LIVE_KEY=
# One of: test | live | off
MOLLIE_MODE=test
# Where Mollie reports a changed payment; production's by default. Only sent
# when it is public HTTPS. On a local or self-hosted copy, set it to your own
# API's address, or to nothing (MOLLIE_WEBHOOK_URL=) so Mollie is not told to
# report to myntos.no; a payment is then settled when the browser comes back
# from the checkout.
# MOLLIE_WEBHOOK_URL=https://api.myntos.no/api/v1/webhooks/mollie
# MOLLIE_TIMEOUT_SECONDS=15

# --- Monthly invoicing for KI subscriptions -------------------------------------------
# Optional. The Company.id in Myntos that issues monthly section 5-1 invoices
# for KI subscriptions (e.g. Lindeman Technologies AS). When set together with
# LOYND_KEY, company owners can start a monthly KI plan on /ki/about/#planer
# and receive a monthly invoice by EHF (over Peppol when the buyer can receive
# EHF) and PDF by email.
# KI_BILLING_COMPANY_ID=
# How often Myntos checks for renewals due for monthly invoicing (seconds). 0 turns it off.
# KI_BILLING_INTERVAL_SECONDS=3600

# --- Ademico (EHF over Peppol) ---------------------------------------------------------
# Optional. Without all three credentials, e-faktura is not offered: nothing is
# sent or received over Peppol. Ademico Software is in Belgium, inside the EEA.
# See docs/integrations/peppol.md.
ADEMICO_USER=
ADEMICO_PASSWORD=
ADEMICO_TOKEN=
# Test: https://test-peppol-api1.ademico-software.com/domibus
# ADEMICO_API_BASE_URL=https://peppol-api1.ademico-software.com/domibus
#
# The password Ademico uses to push deliveries and received EHF to the webhook
# (user "ademico"). Generate with: openssl rand -hex 32. Without it the webhook
# answers 503 and the sweep below is the only channel, so EHF arrives within
# the sweep interval instead of at once. Set it and restart before running
# `uv run python -m myntos.integrations.peppol_sync on`, which tells Ademico
# where to push: from then on a backend without it refuses every push.
ADEMICO_WEBHOOK_SECRET=
# ADEMICO_WEBHOOK_URL=https://api.myntos.no/api/v1/webhooks/ademico
# How often Myntos checks Ademico for anything no push brought. 0 switches the
# sweep off, which leaves a missed push missed: keep it on.
# PEPPOL_SWEEP_INTERVAL_SECONDS=900

# --- Enhetsregisteret (Brønnøysundregistrene) ----------------------------------------
# Open data — no credentials. Company and party names are looked up from the
# organisasjonsnummer here. Leave unset unless you are pointing it at a stub.
# BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# --- Document storage (bilag PDFs) ---------------------------------------------------
# One of: local | r2
#
# "local" writes to LOCAL_STORAGE_PATH and is for development only — a
# Cloudflare Container's disk is ephemeral, so anything stored there is gone
# when the instance sleeps. Production must use r2.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/bilag

# Cloudflare R2 (only used when STORAGE_BACKEND=r2). All four are required;
# a blank value counts as missing and the application refuses to start rather
# than discovering it at the first upload.
#
# Create the bucket with `wrangler r2 bucket create <name> --jurisdiction eu`,
# then an S3 API token under R2 → Manage API tokens. The token needs Object
# Read & Write on this bucket and nothing else — Myntos never lists, deletes or
# administers buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The jurisdiction is part of the endpoint hostname, is fixed when the bucket
# is created, and cannot be changed afterwards. "eu" keeps accounting records
# inside the EEA (see docs/ARCHITECTURE.md on bokføringsforskriften § 7-5);
# pointing at the wrong one does not fail over, it writes somewhere else.
# One of: eu | fedramp | default
R2_JURISDICTION=eu
# Optional: overrides the endpoint entirely, for a self-hosted S3-compatible
# store (MinIO) or a test double. Normally leave empty.
R2_ENDPOINT_URL=

# --- Working copies (uploaded SAF-T files and printouts) ------------------------------
# Kept until the import is posted or thrown away, and never more than 14 days,
# so they cannot live in the bilag bucket, which never deletes. A second bucket,
# same account, same jurisdiction, same token (give it Object Read & Write on
# this bucket too); Myntos lists and deletes in this one, daily.
#
#   wrangler r2 bucket create myntos-working --jurisdiction eu --storage-class Standard
#   wrangler r2 bucket lifecycle add myntos-working slett-etter-15-dager \
#     --expire-days 15 --abort-multipart-days 1 --jurisdiction eu
#
# The lifecycle rule is the backstop for a sweep that never ran; Myntos deletes
# sooner on its own. Aborting a multipart upload after a day frees the parts
# of an upload whose request died halfway (R2's own default is seven days). Standard storage class, never Infrequent Access: that
# bills 30 days for anything deleted sooner and charges for every read.
R2_WORKING_BUCKET=
# Where the same files go with STORAGE_BACKEND=local (development only).
LOCAL_WORKING_PATH=./data/working
