# Normalize to LF in the repo and in working copies (matches .editorconfig)
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary

# Vendored validation artefacts are kept byte-for-byte as published; their
# README lists the upstream checksums, which a line-ending rewrite would break.
backend/tests/fixtures/ehf/** -text
