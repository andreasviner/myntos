# Build context for backend/Dockerfile.
#
# This file is not an optimisation — the Dockerfile does `COPY . .` after
# `uv sync` has already built /app/.venv inside the image. Without the .venv
# rule below, the *Windows* virtualenv from this directory (Lib\, Scripts\,
# ~147 MB) is copied straight over the Linux one, and the runtime stage's
# PATH=/app/.venv/bin then points at a directory that does not exist.
.venv/
venv/

# Tool caches — large, machine-specific, and never needed at runtime.
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Secrets never enter the image; production config arrives as environment
# variables from the Worker (see wrangler.jsonc).
.env
.env.*
!.env.example

# Cloudflare plumbing lives beside the backend but is not part of it.
wrangler.jsonc
worker.js
.wrangler/

# Tests are dev-only; the runtime image installs with --no-dev anyway.
tests/

# NB: README.md is deliberately NOT ignored — pyproject.toml declares
# `readme = "README.md"`, so hatchling fails to build the wheel without it.
