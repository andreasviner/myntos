# Frontend build configuration.
#
# Copy to `frontend/.env` for local development:   cp .env.example .env
#
# Only variables prefixed with PUBLIC_ are exposed to the browser, and they are
# inlined into the built JavaScript. Never put a secret here — the frontend is
# a static site, so anything it knows, every visitor knows.

# Absolute base URL of the backend API. The default when unset is
# http://localhost:8000, which is where `uv run uvicorn myntos.main:app` listens.
#
# In production the API must be on the same registrable domain as the site
# (e.g. api.myntos.no next to myntos.no) so the SameSite=Lax session cookie is
# sent with fetch requests, and the backend needs a matching
# SESSION_COOKIE_DOMAIN plus this origin in CORS_ORIGINS.
PUBLIC_API_BASE_URL=http://localhost:8000
