---
import ProviderButtons from '../components/ProviderButtons.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Logg inn — Myntos" description="Logg inn på Myntos med e-post, Google, Microsoft eller Vipps.">
  <div class="auth-page">
    <h1>Logg inn</h1>
    <p class="lead">Fortsett der du slapp.</p>

    <div class="card">
      <p class="status" id="status" hidden></p>

      <ProviderButtons />

      <form id="login-form" novalidate>
        <label class="field">
          <span>E-postadresse</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label class="field">
          <span>Passord</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button class="btn btn-primary btn-block" type="submit" id="submit">Logg inn</button>
      </form>
    </div>

    <p class="switch">
      Har du ikke konto? <a href="/registrer/">Opprett en gratis</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 26rem;
    margin: 0 auto;
  }
  .switch {
    text-align: center;
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }
</style>

<script>
  import { ApiError, login } from '../lib/api';
  import { el, setStatus } from '../lib/dom';
  // The backend never reflects a provider's own error text — it would be
  // attacker-influenced content rendered in our page — so the callback sends a
  // fixed keyword and CALLBACK_ERRORS owns the wording.
  import { CALLBACK_ERRORS, renderProviderButtons } from '../lib/providers';
  import { rememberAuth } from '../lib/session';

  /** Only site-relative paths, so ?neste= cannot become an open redirect. */
  function safeNext(value: string | null): string {
    if (value === null || !value.startsWith('/') || value.startsWith('//')) return '/';
    return value;
  }

  const params = new URLSearchParams(window.location.search);
  const next = safeNext(params.get('neste'));
  const status = el<HTMLParagraphElement>('#status');
  const form = el<HTMLFormElement>('#login-form');
  const submit = el<HTMLButtonElement>('#submit');

  const callbackError = params.get('error');
  if (callbackError !== null) {
    setStatus(status, CALLBACK_ERRORS[callbackError] ?? 'Innloggingen feilet. Prøv en gang til.');
  }

  void renderProviderButtons(next);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const password = String(data.get('password') ?? '');
    if (email === '' || password === '') {
      setStatus(status, 'Fyll inn både e-postadresse og passord.');
      return;
    }

    submit.disabled = true;
    setStatus(status, '');
    void login(email, password)
      .then(() => {
        rememberAuth('inn');
        window.location.href = next;
      })
      .catch((error: unknown) => {
        const message =
          error instanceof ApiError ? error.message : 'Innloggingen feilet. Prøv en gang til.';
        setStatus(status, message);
        submit.disabled = false;
      });
  });
</script>
