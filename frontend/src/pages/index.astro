<script>
  import {
    ApiError,
    getSummary,
    listCashFlow,
    listSaftImports,
    type CashFlowEntry,
    type Company,
    type Session,
    type Summary,
  } from '../lib/api';
  import { openCompanyMenu } from '../lib/chrome';
  import { currentCompany, loadCompanies } from '../lib/company';
  import { foldCorrections, foldNote } from '../lib/corrections';
  import { el, setStatus, show } from '../lib/dom';
  import { isoDate, kroner, orgnummer } from '../lib/format';
  import { booksBehind, type BooksBehind } from '../lib/regnskap';
  import { currentImport, isWorking } from '../lib/saftimport';
  import { can, canInCompany, loadSession, setActiveCompany } from '../lib/session';

  const RECENT_LIMIT = 6;

  /*
    The placeholder shapes the *markup* ships with are still there, above, and
    they are what the first paint shows. The JavaScript copies of them lived
    here for the one case that had to build them at runtime: switching company
    on this page, which redrew in place and would otherwise have left the
    previous company's totals sitting under the new company's name.

    That switch now happens in the header and reloads the page, so the moment
    it guarded against no longer exists. If in-place switching ever comes back,
    these come back with it — see `skeletonInto` and `skeletonRows`.
  */

  /*
    Oversikten finnes ikke i dokumentet før `mountDashboard` har satt den inn fra
    malen, så elementene hentes der og ikke når modulen lastes. Ingen av
    funksjonene under kalles før det har skjedd.
  */
  let status!: HTMLParagraphElement;
  let loading!: HTMLDivElement;
  let empty!: HTMLDivElement;
  let overview!: HTMLDivElement;
  let controls!: HTMLDivElement;

  /**
   * Sett inn oversikten fra malen, hvis skriptet i siden ikke alt har gjort det,
   * og hent elementene den består av.
   *
   * Hilsenen fylles her også. Toppen fyller den fra /auth/me i `applyChrome`,
   * men det skjer før denne, og en oversikt som ble satt inn etterpå, ville
   * stått med «Hei, der». Selskapets navn trenger ingen slik hjelp:
   * `setActiveCompany` maler det når selskapet er kjent.
   */
  function mountDashboard(session: Session): void {
    const host = el<HTMLElement>('#dashboard');
    if (host.childElementCount === 0) {
      host.append(el<HTMLTemplateElement>('#dashboard-view').content.cloneNode(true));
    }
    // Oversikten er fanen man har åpen hele dagen, og der holder navnet. Satt
    // her og ikke i skriptet i siden, som bare vet hva hintet sa: et hint fra
    // en innlogging som er utløpt, ville ellers gitt forsiden feil tittel.
    document.title = 'Myntos';
    for (const node of host.querySelectorAll<HTMLElement>('[data-session-name]')) {
      node.textContent = session.user.full_name || session.user.email;
    }
    status = el('#dash-status');
    loading = el('#loading');
    empty = el('#no-company');
    overview = el('#overview');
    controls = el('#company-controls');
  }

  /** Every company the caller can reach. */
  let companies: Company[] = [];

  function text(value: string): Text {
    return document.createTextNode(value);
  }

  function cell(value: string, className?: string): HTMLTableCellElement {
    const td = document.createElement('td');
    if (className !== undefined) td.className = className;
    td.append(text(value));
    return td;
  }

  function renderSummary(summary: Summary): void {
    el('#stat-in').textContent = kroner(summary.total_in);
    el('#stat-out').textContent = kroner(summary.total_out);

    const net = el('#stat-net');
    net.textContent = kroner(summary.net);
    net.className = `stat-value ${Number(summary.net) < 0 ? 'amount-out' : 'amount-in'}`;
    el('#stat-count').textContent =
      `${summary.entry_count} ${summary.entry_count === 1 ? 'føring' : 'føringer'} i ${summary.financial_year}`;

    // Det som skyldes nå, ikke årets mva: terminer som ikke er sendt, og sendte
    // som ikke er betalt. Årets sum med de sendte trukket ut viste en gård som
    // hadde levert fire terminer i et annet program som om staten skyldte den
    // penger, mens den siste terminen skulle betales.
    //
    // Men bare så lenge bøkene følger med. Har fristen for terminen de slutter
    // i gått uten at noe er ført siden, mangler betalingen eller utbetalingen
    // som skulle vært der, og saldoen er den dagens, ikke dagens. Da står det
    // ikke noe beløp: en gård som bare hadde hentet 2025 fikk «−303 471,00
    // kr» her i oktober 2026, for en tilbakebetaling som kom i februar. Et
    // beløp med en dato under ble fortsatt lest som det man har til gode.
    const vat = Number(summary.vat_position);
    const behind = booksBehind(summary);
    const vatValue = el('#stat-vat');
    vatValue.dataset.stale = String(behind !== null);
    // Uten fortegn, som tekst: et beløp går aldri gjennom et flyttall for å miste minustegnet.
    const settled = summary.vat_settled.replace(/^-/, '');
    if (behind !== null) {
      vatValue.textContent = '–';
      el('#stat-vat-note').textContent = `ikke kjent: regnskapet slutter ${isoDate(behind.through)}`;
    } else {
      vatValue.textContent = kroner(summary.vat_position);
      el('#stat-vat-note').textContent =
        (vat >= 0 ? 'anslått å betale' : 'anslått til gode') +
        // Levert er ikke betalt: en termin står på 2740 til betalingen er
        // ført, og det er den man glemmer å føre.
        (Number(settled) !== 0 && vat !== 0 ? `, herav ${kroner(settled)} levert og ikke ført betalt` : '');
    }
    renderBooksBehind(summary, behind);

    const body = el<HTMLTableSectionElement>('#by-type');
    body.replaceChildren();
    for (const item of summary.by_type.slice(0, 8)) {
      const row = document.createElement('tr');
      const label = document.createElement('td');
      const badge = document.createElement('span');
      badge.className = 'badge';
      badge.dataset.direction = item.direction;
      badge.append(text(item.direction === 'inn' ? 'Inn' : 'Ut'));
      label.append(badge, text(' '), text(item.type_label ?? item.type_code ?? 'Ukjent'));
      row.append(label, cell(String(item.count), 'num'), cell(kroner(item.total), 'num'));
      body.append(row);
    }
    show(el('#by-type-empty'), summary.by_type.length === 0);
  }

  /**
   * Says where the books stop, once a VAT deadline has passed since they did.
   *
   * Never just because the year turned: on 1 January nothing is posted in the
   * new year yet, and that is not something to point out.
   */
  function renderBooksBehind(summary: Summary, behind: BooksBehind | null): void {
    show(el('#books-stop'), behind !== null);
    if (behind === null) return;
    const year = summary.financial_year;
    const through = isoDate(behind.through);
    el('#books-stop-title').textContent = behind.emptyYear
      ? `Ingenting er ført i ${year} ennå`
      : `Regnskapet er ført til ${through}`;
    el('#books-stop-text').textContent =
      (behind.emptyYear
        ? `Regnskapet i Myntos går til ${through}, så tallene for ${year} står på null. `
        : `Det er ikke ført noe etter ${through}, og fristen for mva-terminen da er passert. `) +
      'Merverdiavgiften kan ikke regnes ut for i dag, fordi det som er levert og betalt siden ' +
      'ikke er ført. Hent resten fra det gamle programmet, eller registrer betalingene og les ' +
      'inn kontoutskriften under Bankavstemming.';
    const company = currentCompany(companies);
    show(el('#books-stop-import'), company !== undefined && canInCompany(company, 'ledger:write'));
  }

  function renderRecent(entries: CashFlowEntry[]): void {
    // Folded the same way as the register on /kontantstrom, and for a stronger
    // reason here: this list is short. Left unfolded, one corrected purchase
    // filled three of the eight rows and showed its reversal as money coming
    // in, so "siste bevegelser" reported an income the company never had.
    //
    // Read-only, so no disclosure triangle: the older vouchers stay out of the
    // way entirely and the line says how many there are. Whoever wants to see
    // them is one link away, on the page that can also do something about them.
    const rows = foldCorrections(entries);
    const body = el<HTMLTableSectionElement>('#recent');
    body.replaceChildren();
    for (const { lead, history } of rows) {
      const row = document.createElement('tr');
      // A reversed entry stays visible: struck through, not hidden. It is
      // still part of the record.
      row.dataset.reversed = String(lead.reversed_by_id !== null);

      const what = cell(lead.description);
      const note = foldNote({ lead, history });
      if (note !== null) {
        const line = document.createElement('span');
        line.className = 'fold-note';
        line.textContent = note;
        what.append(line);
      }

      row.append(
        cell(isoDate(lead.occurred_on)),
        what,
        cell(lead.type_label ?? '-'),
        cell(
          kroner(lead.gross_amount),
          `num ${lead.direction === 'inn' ? 'amount-in' : 'amount-out'}`,
        ),
      );
      body.append(row);
    }
    show(el('#recent-empty'), rows.length === 0);
  }

  async function showCompany(company: Company): Promise<void> {
    // The heading, the header at the top of every page, and the id the two
    // requests below are built from: one call, one record. This is what makes
    // «which company am I looking at» and «which company answered» the same
    // question on this page. See lib/tenant.ts.
    setActiveCompany(company);
    // The orgnr under the name, because two companies in a group share a name
    // more often than they share a number, and because a name alone is not
    // something you can check against a letter from Skatteetaten.
    const orgnr = el('#company-orgnr');
    orgnr.textContent = orgnummer(company.orgnr);
    orgnr.hidden = false;
    // Together, not one after the other. Neither answer depends on the other,
    // and asked in single file the second request could not even leave the
    // browser until the first had crossed the country and come back.
    const [summary, recent] = await Promise.all([
      getSummary(company.id),
      listCashFlow(company.id, RECENT_LIMIT),
    ]);
    renderSummary(summary);
    renderRecent(recent);
    overview.hidden = false;
    settled();
    // Bare når det kan bety noe: et regnskap uten registrerte betalinger, for
    // den som kan føre. Én forespørsel til, og bare da.
    if (recent.length === 0 && canInCompany(company, 'ledger:write')) {
      void listSaftImports(company.id)
        .then((imports) => renderImportInvite(imports))
        .catch(() => {
          // Kortet er en snarvei, ikke en del av oversikten: uten svar står det ikke.
        });
    }
  }

  function renderImportInvite(imports: Awaited<ReturnType<typeof listSaftImports>>): void {
    const job = currentImport(imports);
    const card = el('#start-import');
    const title = el('#start-import-title');
    const text = el('#start-import-text');
    const link = el<HTMLAnchorElement>('#start-import-link');
    if (job === null) {
      show(card, true);
      return;
    }
    if (job.status === 'posted') return;
    if (isWorking(job)) {
      title.textContent = job.status === 'posting' ? 'Myntos fører regnskapet' : 'Myntos leser SAF-T-filene';
      text.textContent = `${job.step ?? 'Arbeidet pågår.'} Det skjer på serveren; du kan gjøre noe annet imens.`;
      link.textContent = 'Se innlesingen';
    } else if (job.status === 'ready') {
      title.textContent = 'SAF-T-filene er lest';
      text.textContent = 'Se over hva som blir ført, og før det når du er klar.';
      link.textContent = 'Se over og før';
    } else {
      title.textContent = 'SAF-T-filene kunne ikke leses';
      text.textContent = job.error ?? 'Last dem opp på nytt.';
      link.textContent = 'Se hva som gikk galt';
    }
    show(card, true);
  }

  /**
   * Stop saying the page is loading.
   *
   * One place, called from both the answer and the failure, because a region
   * left marked aria-busy is a region a screen reader keeps waiting on.
   */
  function settled(): void {
    overview.removeAttribute('aria-busy');
  }

  /**
   * Clear the placeholders when there will be no figures to put in them.
   *
   * Without this a failed request leaves the shapes shimmering under an error
   * message, which reads as "still trying" when nothing is still trying.
   */
  function clearSkeletons(): void {
    settled();
    for (const value of overview.querySelectorAll<HTMLElement>('.stat-value')) {
      if (value.querySelector('.skeleton') !== null) value.textContent = '-';
    }
    for (const note of overview.querySelectorAll<HTMLElement>('.stat-note')) {
      if (note.querySelector('.skeleton') !== null) note.textContent = '';
    }
    for (const row of overview.querySelectorAll('tr[data-skeleton-row]')) row.remove();
  }

  void loadSession().then(async (session) => {
    if (session === null) return;
    mountDashboard(session);
    try {
      companies = await loadCompanies();
      loading.hidden = true;

      // «Bytt selskap» only where there is something to switch to. On an
      // account with one set of books it would be a control that does nothing;
      // on an account with four it is both the way over and a standing reminder
      // that the name above is one of several.
      const switcher = el<HTMLButtonElement>('#company-switch');
      switcher.hidden = companies.length < 2;
      switcher.addEventListener('click', openCompanyMenu);

      const current = currentCompany(companies);
      if (current === undefined) {
        // No books yet, so there is no overview to draw. The way to add a set
        // lives on /organisasjon/, next to the organisation that will own it,
        // and the only thing this page does about it is point there once.
        //
        // Reachable with the overview already laid out, when the hint said this
        // account had books and it no longer does. Putting it away again is the
        // correction, and it is why the hint is only ever allowed to decide
        // layout.
        overview.hidden = true;
        settled();
        controls.hidden = true;
        show(empty, true);
        // Nothing is being looked at, so the heading says what the page is
        // rather than naming a company. This heading only, and never through
        // the shared slot: the header at the top of the page has its own answer
        // for an account with no books (the account's name, from applyChrome),
        // and «Oversikt» in the company slot up there would be a page title
        // pretending to be a company. Nothing is stored either way.
        el('#company-orgnr').hidden = true;
        el('#dash-company').textContent = 'Oversikt';
        const mayAdd = session.memberships.some((m) =>
          can(session, m.organization_id, 'organization:manage'),
        );
        show(el('#no-company-add'), mayAdd);
        show(el('#no-permission'), !mayAdd);
        return;
      }

      controls.hidden = false;
      await showCompany(current);
    } catch (error: unknown) {
      loading.hidden = true;
      clearSkeletons();
      setStatus(
        status,
        error instanceof ApiError ? error.message : 'Vi fikk ikke hentet oversikten.',
      );
    }
  });
</script>
