---
import VerifyEmailNotice from '../components/VerifyEmailNotice.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
  How many placeholder rows the two tables hold while the figures are on their
  way. They are markup rather than something JavaScript builds, so the page
  arrives at its finished height instead of growing into it, and the render that
  replaces them (`replaceChildren`) clears them without knowing they were there.

  Six is what «Siste bevegelser» actually shows (RECENT_LIMIT below), so the
  common case reserves exactly the right space. Four is a guess at «Største
  poster», which has no limit worth calling typical.
*/
const RECENT_SKELETON_ROWS = 6;
const TYPE_SKELETON_ROWS = 4;

/* Widths that read as amounts and dates rather than as identical grey bars. */
const RECENT_WIDTHS = ['6.5rem', '11rem', '7rem', '5.5rem'];
const TYPE_WIDTHS = ['9rem', '3rem', '6rem'];
---

<BaseLayout
  title="Myntos: gratis regnskapsprogram med offentlig kildekode"
  description="Gratis norsk regnskapsprogram med offentlig kildekode: bilag, faktura, merverdiavgift og SAF-T, bygget for innlevering til Skatteetaten."
  width="wide"
>
  {/*
    Both views ship in the same file. The signed-out one is the default, so it
    is what a search engine indexes and what a visitor without JavaScript sees;
    lib/session.ts flips the document's data-auth attribute once it knows.
  */}

  <!-- ------------------------------------------------------------------ -->
  <!-- Signed out: what Myntos is                                          -->
  <!-- ------------------------------------------------------------------ -->
  <section data-auth-only="ut">
    <div class="hero">
      <p class="pill">Beta</p>
      {/*
        The app name leads the h1 deliberately. Google's OAuth brand review
        compares the consent-screen name against the home page's most prominent
        heading, and rejected "Regnskap for norske regler, i åpent lende" as not
        matching "Myntos". The metaphor still carries the footer tagline.
      */}
      <h1>Myntos: norsk regnskapsprogram<br /><span class="grad">med offentlig kildekode</span></h1>
      <p class="lead">
        Myntos fører inn- og utbetalinger med bilag, regner merverdiavgift, og er bygget for å
        levere SAF-T og skattemelding til Skatteetaten. Det koster 0 kr, og hele kildekoden er
        offentlig, så du kan se nøyaktig hva som skjer med tallene dine.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-large" href="/registrer/">Kom i gang gratis</a>
        <a class="btn btn-ghost btn-large" href="/funksjoner/">Se funksjonene</a>
      </div>
      <p class="hero-note">Ingen betalingsopplysninger. Ingen bindingstid.</p>
    </div>

    <div class="grid features">
      <article class="card feature">
        <h3 class="card-title">Bygget på norske krav</h3>
        <p class="card-hint">
          Datamodellen følger SAF-T Financial fra første linje: kontoplan med
          næringsspesifikasjon per regnskapsår, mva-koder med datostyrte satser, og bilag som ikke
          kan endres etter føring. Rettelser skjer med motpostering, slik bokføringsloven krever.
        </p>
      </article>
      <article class="card feature">
        <h3 class="card-title">Dataene blir i EØS</h3>
        <p class="card-hint">
          Database og dokumentlager kjøres i EØS. Bokføringsforskriften § 7-5 tillater det mot
          skriftlig melding til skattekontoret, og Myntos skal hjelpe deg å skrive den, ikke late
          som kravet ikke finnes.
        </p>
      </article>
      <article class="card feature">
        <h3 class="card-title">Ingen innlåsing</h3>
        <p class="card-hint">
          SAF-T-eksport og PDF-arkiv er ikke en ekstrafunksjon, men et lovkrav. Du skal kunne ta
          med deg hele regnskapet ut igjen, også hvis du slutter å bruke oss.
        </p>
      </article>
      <article class="card feature">
        <h3 class="card-title">Én organisasjon, flere hoder</h3>
        <p class="card-hint">
          Kontoen din hører til en organisasjon, og kollegaer inviteres inn med roller.
          Regnskapsførere kan føre flere selskaper under samme organisasjon.
        </p>
      </article>
    </div>

    <h2>Slik kommer du i gang</h2>
    <ol class="steps">
      <li>
        <strong>Opprett konto</strong> med e-post og passord, eller med Google, Microsoft
        eller BankID.
      </li>
      <li>
        <strong>Registrer selskapet</strong> med organisasjonsnummer. Kontoplan, mva-koder og
        regnskapsår settes opp automatisk.
      </li>
      <li>
        <strong>Før inn- og utbetalinger</strong> med type og eventuell PDF. Typen bestemmer konto
        og mva-kode. Det er den som gjør at tallene senere kan bli en skattemelding.
      </li>
    </ol>

    <p class="steps-note">
      Kommer du fra Fiken, Tripletex, PowerOffice Go eller Conta?
      <a href="/kom-i-gang/">Se hvordan du henter regnskapet ut derfra</a>, og hva du bør laste
      ned før du sier opp abonnementet.
    </p>

    <div class="cta card">
      <div>
        <h2 class="cta-title">Klar til å prøve?</h2>
        <p class="card-hint">
          Det tar et minutt å komme i gang, og du kan ta med deg alt ut igjen når som helst.
        </p>
      </div>
      <a class="btn btn-primary btn-large" href="/registrer/">Opprett konto</a>
    </div>
  </section>

  <!-- ------------------------------------------------------------------ -->
  <!-- Signed in: the overview                                             -->
  <!-- ------------------------------------------------------------------ -->
  <section data-auth-only="inn" id="dashboard">
    <header class="page-head">
      <div class="page-head-id">
        {/* Hilsenen er ikke det siden handler om.

            Den sto som overskrift, og da var det ingenting i denne spalten som
            svarte på hvilket regnskap tallene under gjelder. Navnet på den
            innloggede står dessuten i toppen på hver side og endrer seg aldri;
            selskapet endrer seg hver gang noen bytter klient. Så selskapet er
            overskriften, og hilsenen den dempede linjen over den. */}
        <p class="greeting">Hei, <span data-session-name>der</span></p>
        <h1 class="company-title">
          {/* Fylles fra den samme lagrede posten som selskapsnavnet i toppen og
              som hver forespørsel bygges av, så de tre kan ikke komme i utakt.
              Se lib/tenant.ts. «Oversikt» er bare det som står i filen før noen
              vet hvem som spør. */}
          <span id="dash-company" data-session-company>Oversikt</span>
          {/* Samme mangel som prikken i toppen, med plass til ordet ved siden
              av: ingen har bekreftet i Altinn at de kan opptre for selskapet.
              Lenken går dit bekreftelsen gjøres. */}
          <a class="company-unverified" href="/organisasjon/#selskap" data-session-unverified hidden>
            <span class="dot" aria-hidden="true"></span>ubekreftet
          </a>
        </h1>
        {/* Under navnet: organisasjonsnummeret, fordi to selskaper i samme
            konsern deler navn oftere enn de deler nummer. Linjen holder høyden
            sin også før tallene er hentet, så kortene under ikke flytter seg
            når de kommer.

            Ingen kontonavn her. Kontoen er ikke noe siden handler om, og et
            kontonavn ved siden av et selskapsnavn leses som om det hørte til
            selskapet. Se docs/company-isolation.md. */}
        <p class="company-meta">
          <span id="company-orgnr" hidden></span>
          <button type="button" class="company-switch" id="company-switch" hidden>
            Bytt selskap
          </button>
        </p>
      </div>
      {/* Bare handlingen. Hvilket selskap oversikten gjelder, står nå i
          overskriften ved siden av. */}
      <div class="page-head-actions" id="company-controls" hidden>
        {/* Oversikten er ett år, det som pågår. Alle årene, også de som er
            hentet fra et annet program, står på en egen side, og veien dit
            står her fordi det er her man ser at «i år» ikke er hele bildet. */}
        <a class="btn btn-ghost" href="/regnskap/">Regnskapet år for år</a>
        <a class="btn btn-primary" href="/kontantstrom/">Registrer betaling</a>
      </div>
    </header>

    <p class="status" id="dash-status" hidden></p>

    <VerifyEmailNotice />

    <div id="loading" class="empty">Henter oversikten …</div>

    {/* No books yet. Only the way to the form, not the form: setting up a set
        of books happens once, perhaps twice, and it has a page of its own with
        three questions and an Altinn login in it. This card is here because a
        dashboard with nothing on it has to say what to do next. */}
    <div class="card no-company" id="no-company" hidden>
      <h2 class="card-title">Ingen regnskap ennå</h2>
      <p class="card-hint">
        Vi setter opp kontoplan, mva-koder og regnskapsår automatisk. Har du rettigheter for
        selskaper i Altinn, henter vi dem derfra, så du slipper å skrive inn
        organisasjonsnummeret.
      </p>
      <a class="btn btn-primary" id="no-company-add" href="/nytt-selskap/" hidden>
        Legg til selskapet ditt
      </a>
      <p class="card-hint" id="no-permission" hidden>
        Du har ikke tilgang til å opprette selskaper i denne organisasjonen. Be en administrator
        om å gjøre det.
      </p>
    </div>

    {/*
        The overview proper.

        Everything below ships at its finished size with placeholders where the
        figures go, rather than appearing all at once when the last request
        lands. Two reasons, and the second is the one that matters: the numbers
        are the only part that is actually unknown, so they are the only part
        worth showing as unknown; and a page that assembles itself under the
        reader moves the thing they were about to click.

        `aria-busy` is set alongside, and is what a screen reader is told. The
        placeholders themselves say nothing: a dozen unlabelled boxes announced
        one by one is noise, and «laster» once is the fact.
    */}
    <div id="overview" hidden>
      {/* Veien inn for den som kommer fra et annet program, der den trengs:
          på oversikten til et regnskap som ikke har noe i seg ennå, og så
          lenge en innlesing er i gang eller venter på å bli sett over. Den
          sto bare i notatet nederst, og en bonde som hadde lastet opp filene
          fant verken dem eller bilagene igjen. */}
      <div class="card start-import" id="start-import" hidden>
        <div>
          <h2 class="card-title" id="start-import-title">Kommer du fra et annet regnskapsprogram?</h2>
          <p class="card-hint" id="start-import-text">
            Last opp SAF-T-filene fra Tripletex, Fiken, PowerOffice eller et annet program. Myntos
            henter kontoene, kundene og leverandørene, inngående balanse og bilagene, også for
            tidligere år, og gjør jobben på serveren mens du gjør noe annet.
          </p>
        </div>
        <a class="btn btn-primary" id="start-import-link" href="/tidligere-program/">Hent regnskapet</a>
      </div>

      {/* Når bøkene har stått stille forbi en mva-frist. En bonde som hadde
          hentet 2025 fra Tripletex så null for 2026 overalt, og mva-kortet
          viste siste termin i 2025 som til gode i oktober, måneder etter at
          pengene kom: utbetalingen er et 2026-bilag som ikke er i Myntos.
          Fristen og ikke nyttår avgjør, ellers står kortet her fra første
          minutt hvert år. */}
      <div class="card books-stop" id="books-stop" hidden>
        <div>
          <h2 class="card-title" id="books-stop-title"></h2>
          <p class="card-hint" id="books-stop-text"></p>
        </div>
        <div class="books-stop-links">
          <a class="btn btn-primary" href="/regnskap/">Se regnskapet år for år</a>
          <a class="btn btn-ghost" id="books-stop-import" href="/tidligere-program/" hidden
            >Hent fra det gamle programmet</a
          >
        </div>
      </div>

      <div class="grid stats">
        <div class="card stat">
          <p class="stat-label">Inn i år</p>
          <p class="stat-value amount-in" id="stat-in">
            <span class="skeleton" style="--skeleton-width: 8rem"></span>
          </p>
        </div>
        <div class="card stat">
          <p class="stat-label">Ut i år</p>
          <p class="stat-value amount-out" id="stat-out">
            <span class="skeleton" style="--skeleton-width: 8rem"></span>
          </p>
        </div>
        <div class="card stat">
          <p class="stat-label">Netto</p>
          <p class="stat-value" id="stat-net">
            <span class="skeleton" style="--skeleton-width: 8rem"></span>
          </p>
          {/* The notes carry a placeholder too, and not for decoration: an
              empty <p> is zero tall, so the two cards that have one were short
              until the answer arrived and then grew, taking the whole row of
              cards with them. */}
          <p class="stat-note" id="stat-count">
            <span class="skeleton" style="--skeleton-width: 7rem"></span>
          </p>
        </div>
        <div class="card stat">
          <p class="stat-label">Merverdiavgift</p>
          <p class="stat-value" id="stat-vat">
            <span class="skeleton" style="--skeleton-width: 8rem"></span>
          </p>
          <p class="stat-note" id="stat-vat-note">
            <span class="skeleton" style="--skeleton-width: 7rem"></span>
          </p>
          {/* Mva-meldingen nås herfra og ikke fra toppmenyen: man går dit når
              tallet her får en til det, og det skjer annenhver måned, ikke
              flere ganger om dagen. */}
          <p class="stat-note">
            <a href="/mva/">Mva-meldingen →</a>
          </p>
        </div>
      </div>

      <h2>Siste bevegelser</h2>
      <div class="card">
        <div class="table-scroll">
          <table class="data">
            <thead>
              <tr>
                <th>Dato</th>
                <th>Beskrivelse</th>
                <th>Type</th>
                <th class="num">Beløp</th>
              </tr>
            </thead>
            <tbody id="recent">
              {
                Array.from({ length: RECENT_SKELETON_ROWS }, () => (
                  <tr data-skeleton-row>
                    {RECENT_WIDTHS.map((width, column) => (
                      <td class={column === 3 ? 'num' : undefined}>
                        <span class="skeleton" style={`--skeleton-width: ${width}`} />
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="empty" id="recent-empty" hidden>
          Ingen betalinger registrert i Myntos ennå.
          <a href="/kontantstrom/">Registrer den første betalingen</a>, eller se
          <a href="/bilag/">alle bilag</a>, også de som er hentet fra et annet program.
        </p>
        {/* «Siste bevegelser» er betalingene registrert i Myntos. Alt annet som
            er ført (inngående balanse, bilag fra det gamle programmet,
            manuelle bilag) står under Bilag, og den lenken står her fordi det
            er her man leter. */}
        <p class="card-hint see-all">
          <a href="/kontantstrom/">Se hele kontantstrømmen →</a>
          <a href="/bilag/">Se alle bilag →</a>
        </p>
      </div>

      <h2>Største poster i år</h2>
      <div class="card">
        <div class="table-scroll">
          <table class="data">
            <thead>
              <tr>
                <th>Type</th>
                <th class="num">Antall</th>
                <th class="num">Sum</th>
              </tr>
            </thead>
            <tbody id="by-type">
              {
                Array.from({ length: TYPE_SKELETON_ROWS }, () => (
                  <tr data-skeleton-row>
                    {TYPE_WIDTHS.map((width, column) => (
                      <td class={column === 0 ? undefined : 'num'}>
                        <span class="skeleton" style={`--skeleton-width: ${width}`} />
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="empty" id="by-type-empty" hidden>Ingen tall å vise for i år.</p>
      </div>

      <p class="meta-note">
        Tallene er en oppsummering av det du selv har ført, ikke en mva-melding og ikke et
        ferdig regnskap. Mva-meldingen for hver termin ser du under
        <a href="/mva/">Mva-melding</a>.
        {/* SAF-T lenkes herfra og ikke fra menyen: filen lages når Skatteetaten
            ber om den, kanskje aldri, og hører hjemme ved siden av årets tall. */}
        SAF-T-filen Skatteetaten kan be om ved bokettersyn, lager du under
        <a href="/saft/">SAF-T</a>.
        {/* Avstemmingen lenkes herfra av samme grunn: den svarer på om tallene
            over stemmer med banken, og hører hjemme ved siden av dem. */}
        Om det som er ført stemmer med banken, ser du under
        <a href="/bank/">Bankavstemming</a>.
        {/* Resultatet per avdeling er tallene over delt opp, og hører hjemme ved
            dem. De fleste selskaper har ingen avdelinger, så det er ingen menypost. */}
        Resultatet per avdeling, prosjekt eller driftsgren ser du under
        <a href="/avdelinger/">Avdelinger</a>.
        {/* Samme begrunnelse: begge gjøres én gang i året, eller én gang i
            regnskapets liv, og hører hjemme ved årets tall, ikke i menyen. */}
        {/* Regnskapet for alle årene står også i toppen, som en knapp: det er
            den siden folk leter etter når «i år» står på null. */}
        Resultatregnskapet og balansen for hvert år ser du under
        <a href="/regnskap/">Regnskapet år for år</a>.
        Regnskapet fra et annet program, tidligere år og året du står i, henter du under
        <a href="/tidligere-program/">Hent regnskapet fra et annet program</a>, og en balanse
        du skriver inn selv fører du under <a href="/inngaende-balanse/">Inngående balanse</a>.
        Årsoppgjørsføringer og omposteringer fører du som <a href="/manuelt-bilag/">Manuelt bilag</a>,
        driftsmidler og årets avskrivninger under <a href="/anlegg/">Anlegg og avskrivning</a>,
        og et år som er over avslutter du under <a href="/arsavslutning/">Årsavslutning</a>.
      </p>
    </div>
  </section>

  {/*
      Enter the waiting state before the browser paints, not after.

      `data-books` is what the head script read out of the hint: this browser was
      signed in last time and the account had books, so the overview is what is
      coming and it may as well be on screen, at full size, with the figures
      pending. Everything here is a guess about *layout* only — the numbers are
      still whatever the API says, and if the guess is wrong (books removed, a
      different account) the script below hides the overview again, which is the
      same correction the page has always made.

      Inline, and here rather than in the module below, because a module is
      deferred: it would run after the whole document is parsed, by which time
      «Henter oversikten …» has already been painted and the point is lost.

      Without the hint nothing happens and the page waits the way it always has.
      That is the right answer for a first-ever visit: we do not know that there
      are books to lay out, and an empty account would watch a skeleton turn
      into «Ingen regnskap ennå».
  */}
  <script is:inline>
    (function () {
      const root = document.documentElement;
      if (root.dataset.auth !== 'inn') return;
      const hint = window.myntosHint;

      // The greeting and the company name, painted here rather than by the
      // script under the header, because they are on this page and that script
      // ran before this page had been parsed. Same stored values, same rules:
      // they say what was true last time, and the module below corrects them if
      // it was not.
      //
      // The company comes out of `window.myntosCompany` and nowhere else. That
      // record carries the id every request on this page will be built from, so
      // the name in this heading and the figures under it cannot be about two
      // different companies. See lib/tenant.ts.
      if (hint) {
        for (const node of document.querySelectorAll('[data-session-name]')) {
          node.textContent = hint.user;
        }
      }
      const company = window.myntosCompany;
      if (company) {
        for (const node of document.querySelectorAll('[data-session-company]')) {
          node.textContent = company.name;
        }
        for (const node of document.querySelectorAll('[data-session-unverified]')) {
          node.hidden = company.verified === true || company.name === '';
        }
      }

      if (root.dataset.books !== 'ja') return;
      const overview = document.getElementById('overview');
      const loading = document.getElementById('loading');
      const controls = document.getElementById('company-controls');
      if (overview === null || loading === null || controls === null) return;

      loading.hidden = true;
      overview.hidden = false;
      overview.setAttribute('aria-busy', 'true');
      controls.hidden = false;
    })();
  </script>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 2.5rem;
    max-width: 48rem;
  }
  .grad {
    background: linear-gradient(100deg, var(--accent), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .hero-note {
    color: var(--faint);
    font-size: 0.88rem;
    margin-top: 1rem;
  }
  .features {
    margin-top: 1rem;
  }
  .feature {
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }
  .feature:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .steps {
    padding-left: 1.2rem;
    max-width: 42rem;
  }
  .steps li {
    margin-bottom: 0.6rem;
  }
  .steps-note {
    max-width: 42rem;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 3.5rem;
    background: linear-gradient(140deg, var(--accent-soft), var(--surface) 60%);
    border-color: var(--accent-line);
  }
  .cta-title {
    margin: 0 0 0.2rem;
    font-size: 1.3rem;
  }
  .meta-note {
    color: var(--faint);
    font-size: 0.86rem;
    margin-top: 2rem;
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .page-head-id {
    min-width: 0;
  }
  /* Over overskriften og dempet: hyggelig å bli hilst på, ikke noe man leser
     to ganger. */
  .greeting {
    margin: 0 0 0.15rem;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .company-title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  /* Ordet, ikke bare prikken, fordi det er plass til det her: dette er stedet
     man leser for å vite hvilket regnskap man står i, og «ubekreftet» hører
     til svaret. Liten og rolig, for ingenting er i stykker. */
  .company-unverified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .company-unverified:hover {
    color: var(--fg-strong);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .company-unverified .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--danger);
  }
  /* Høyden er reservert, ikke betinget: linjen står tom til
     organisasjonsnummeret er hentet, og uten min-height ville hele raden med
     kort under flyttet seg i det øyeblikket det kom. */
  .company-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.4rem;
    margin: 0.3rem 0 0;
    color: var(--faint);
    font-size: 0.88rem;
  }
  /* Skilletegn mellom det som faktisk står der. `[hidden]` er det linjen
     skjuler ting med, så selektoren regner bare med synlige naboer: uten det
     ville en skjult første del gitt en ledende prikk. */
  .company-meta > *:not([hidden]) ~ *:not([hidden])::before {
    content: '·';
    margin-right: 0.5rem;
  }
  /* Bare synlig når det finnes noe å bytte til. Da er den også en opplysning i
     seg selv: kontoen har flere regnskap, og dette er ett av dem. */
  .company-switch {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .company-switch:hover {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }
  .page-head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .no-company {
    max-width: 38rem;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .stats {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }
  .stat-label {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 700;
  }
  .stat-value {
    margin: 0.35rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .stat-note {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .see-all {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 0.9rem;
  }
  .start-import {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(140deg, var(--accent-soft), var(--surface) 65%);
    border-color: var(--accent-line);
  }
  .start-import > div {
    max-width: 44rem;
  }
  .books-stop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
  }
  .books-stop > div:first-child {
    max-width: 44rem;
  }
  .books-stop-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  /* Et beløp som er slik det sto den dagen bøkene slutter, ikke i dag. */
  .stat-value[data-stale='true'] {
    color: var(--muted);
  }
</style>

<script>
  import {
    ApiError,
    getSummary,
    listCashFlow,
    listSaftImports,
    type CashFlowEntry,
    type Company,
    type Session,
    type Summary,
  } from '../lib/api';
  import { openCompanyMenu } from '../lib/chrome';
  import { currentCompany, loadCompanies } from '../lib/company';
  import { foldCorrections, foldNote } from '../lib/corrections';
  import { el, setStatus, show } from '../lib/dom';
  import { isoDate, kroner, orgnummer } from '../lib/format';
  import { booksBehind, type BooksBehind } from '../lib/regnskap';
  import { currentImport, isWorking } from '../lib/saftimport';
  import { can, canInCompany, loadSession, setActiveCompany } from '../lib/session';

  const RECENT_LIMIT = 6;

  /*
    The placeholder shapes the *markup* ships with are still there, above, and
    they are what the first paint shows. The JavaScript copies of them lived
    here for the one case that had to build them at runtime: switching company
    on this page, which redrew in place and would otherwise have left the
    previous company's totals sitting under the new company's name.

    That switch now happens in the header and reloads the page, so the moment
    it guarded against no longer exists. If in-place switching ever comes back,
    these come back with it — see `skeletonInto` and `skeletonRows`.
  */

  const status = el<HTMLParagraphElement>('#dash-status');
  const loading = el<HTMLDivElement>('#loading');
  const empty = el<HTMLDivElement>('#no-company');
  const overview = el<HTMLDivElement>('#overview');
  const controls = el<HTMLDivElement>('#company-controls');

  /** Every company the caller can reach. */
  let companies: Company[] = [];

  function text(value: string): Text {
    return document.createTextNode(value);
  }

  function cell(value: string, className?: string): HTMLTableCellElement {
    const td = document.createElement('td');
    if (className !== undefined) td.className = className;
    td.append(text(value));
    return td;
  }

  function renderSummary(summary: Summary): void {
    el('#stat-in').textContent = kroner(summary.total_in);
    el('#stat-out').textContent = kroner(summary.total_out);

    const net = el('#stat-net');
    net.textContent = kroner(summary.net);
    net.className = `stat-value ${Number(summary.net) < 0 ? 'amount-out' : 'amount-in'}`;
    el('#stat-count').textContent =
      `${summary.entry_count} ${summary.entry_count === 1 ? 'føring' : 'føringer'} i ${summary.financial_year}`;

    // Det som skyldes nå, ikke årets mva: terminer som ikke er sendt, og sendte
    // som ikke er betalt. Årets sum med de sendte trukket ut viste en gård som
    // hadde levert fire terminer i et annet program som om staten skyldte den
    // penger, mens den siste terminen skulle betales.
    //
    // Men bare så lenge bøkene følger med. Har fristen for terminen de slutter
    // i gått uten at noe er ført siden, mangler betalingen eller utbetalingen
    // som skulle vært der, og saldoen er den dagens, ikke dagens. Da står det
    // ikke noe beløp: en gård som bare hadde hentet 2025 fikk «−303 471,00
    // kr» her i oktober 2026, for en tilbakebetaling som kom i februar. Et
    // beløp med en dato under ble fortsatt lest som det man har til gode.
    const vat = Number(summary.vat_position);
    const behind = booksBehind(summary);
    const vatValue = el('#stat-vat');
    vatValue.dataset.stale = String(behind !== null);
    // Uten fortegn, som tekst: et beløp går aldri gjennom et flyttall for å miste minustegnet.
    const settled = summary.vat_settled.replace(/^-/, '');
    if (behind !== null) {
      vatValue.textContent = '–';
      el('#stat-vat-note').textContent = `ikke kjent: regnskapet slutter ${isoDate(behind.through)}`;
    } else {
      vatValue.textContent = kroner(summary.vat_position);
      el('#stat-vat-note').textContent =
        (vat >= 0 ? 'anslått å betale' : 'anslått til gode') +
        // Levert er ikke betalt: en termin står på 2740 til betalingen er
        // ført, og det er den man glemmer å føre.
        (Number(settled) !== 0 && vat !== 0 ? `, herav ${kroner(settled)} levert og ikke ført betalt` : '');
    }
    renderBooksBehind(summary, behind);

    const body = el<HTMLTableSectionElement>('#by-type');
    body.replaceChildren();
    for (const item of summary.by_type.slice(0, 8)) {
      const row = document.createElement('tr');
      const label = document.createElement('td');
      const badge = document.createElement('span');
      badge.className = 'badge';
      badge.dataset.direction = item.direction;
      badge.append(text(item.direction === 'inn' ? 'Inn' : 'Ut'));
      label.append(badge, text(' '), text(item.type_label ?? item.type_code ?? 'Ukjent'));
      row.append(label, cell(String(item.count), 'num'), cell(kroner(item.total), 'num'));
      body.append(row);
    }
    show(el('#by-type-empty'), summary.by_type.length === 0);
  }

  /**
   * Says where the books stop, once a VAT deadline has passed since they did.
   *
   * Never just because the year turned: on 1 January nothing is posted in the
   * new year yet, and that is not something to point out.
   */
  function renderBooksBehind(summary: Summary, behind: BooksBehind | null): void {
    show(el('#books-stop'), behind !== null);
    if (behind === null) return;
    const year = summary.financial_year;
    const through = isoDate(behind.through);
    el('#books-stop-title').textContent = behind.emptyYear
      ? `Ingenting er ført i ${year} ennå`
      : `Regnskapet er ført til ${through}`;
    el('#books-stop-text').textContent =
      (behind.emptyYear
        ? `Regnskapet i Myntos går til ${through}, så tallene for ${year} står på null. `
        : `Det er ikke ført noe etter ${through}, og fristen for mva-terminen da er passert. `) +
      'Merverdiavgiften kan ikke regnes ut for i dag, fordi det som er levert og betalt siden ' +
      'ikke er ført. Hent resten fra det gamle programmet, eller registrer betalingene og les ' +
      'inn kontoutskriften under Bankavstemming.';
    const company = currentCompany(companies);
    show(el('#books-stop-import'), company !== undefined && canInCompany(company, 'ledger:write'));
  }

  function renderRecent(entries: CashFlowEntry[]): void {
    // Folded the same way as the register on /kontantstrom, and for a stronger
    // reason here: this list is short. Left unfolded, one corrected purchase
    // filled three of the eight rows and showed its reversal as money coming
    // in, so "siste bevegelser" reported an income the company never had.
    //
    // Read-only, so no disclosure triangle: the older vouchers stay out of the
    // way entirely and the line says how many there are. Whoever wants to see
    // them is one link away, on the page that can also do something about them.
    const rows = foldCorrections(entries);
    const body = el<HTMLTableSectionElement>('#recent');
    body.replaceChildren();
    for (const { lead, history } of rows) {
      const row = document.createElement('tr');
      // A reversed entry stays visible: struck through, not hidden. It is
      // still part of the record.
      row.dataset.reversed = String(lead.reversed_by_id !== null);

      const what = cell(lead.description);
      const note = foldNote({ lead, history });
      if (note !== null) {
        const line = document.createElement('span');
        line.className = 'fold-note';
        line.textContent = note;
        what.append(line);
      }

      row.append(
        cell(isoDate(lead.occurred_on)),
        what,
        cell(lead.type_label ?? '-'),
        cell(
          kroner(lead.gross_amount),
          `num ${lead.direction === 'inn' ? 'amount-in' : 'amount-out'}`,
        ),
      );
      body.append(row);
    }
    show(el('#recent-empty'), rows.length === 0);
  }

  async function showCompany(company: Company): Promise<void> {
    // The heading, the header at the top of every page, and the id the two
    // requests below are built from: one call, one record. This is what makes
    // «which company am I looking at» and «which company answered» the same
    // question on this page. See lib/tenant.ts.
    setActiveCompany(company);
    // The orgnr under the name, because two companies in a group share a name
    // more often than they share a number, and because a name alone is not
    // something you can check against a letter from Skatteetaten.
    const orgnr = el('#company-orgnr');
    orgnr.textContent = orgnummer(company.orgnr);
    orgnr.hidden = false;
    // Together, not one after the other. Neither answer depends on the other,
    // and asked in single file the second request could not even leave the
    // browser until the first had crossed the country and come back.
    const [summary, recent] = await Promise.all([
      getSummary(company.id),
      listCashFlow(company.id, RECENT_LIMIT),
    ]);
    renderSummary(summary);
    renderRecent(recent);
    overview.hidden = false;
    settled();
    // Bare når det kan bety noe: et regnskap uten registrerte betalinger, for
    // den som kan føre. Én forespørsel til, og bare da.
    if (recent.length === 0 && canInCompany(company, 'ledger:write')) {
      void listSaftImports(company.id)
        .then((imports) => renderImportInvite(imports))
        .catch(() => {
          // Kortet er en snarvei, ikke en del av oversikten: uten svar står det ikke.
        });
    }
  }

  function renderImportInvite(imports: Awaited<ReturnType<typeof listSaftImports>>): void {
    const job = currentImport(imports);
    const card = el('#start-import');
    const title = el('#start-import-title');
    const text = el('#start-import-text');
    const link = el<HTMLAnchorElement>('#start-import-link');
    if (job === null) {
      show(card, true);
      return;
    }
    if (job.status === 'posted') return;
    if (isWorking(job)) {
      title.textContent = job.status === 'posting' ? 'Myntos fører regnskapet' : 'Myntos leser SAF-T-filene';
      text.textContent = `${job.step ?? 'Arbeidet pågår.'} Det skjer på serveren; du kan gjøre noe annet imens.`;
      link.textContent = 'Se innlesingen';
    } else if (job.status === 'ready') {
      title.textContent = 'SAF-T-filene er lest';
      text.textContent = 'Se over hva som blir ført, og før det når du er klar.';
      link.textContent = 'Se over og før';
    } else {
      title.textContent = 'SAF-T-filene kunne ikke leses';
      text.textContent = job.error ?? 'Last dem opp på nytt.';
      link.textContent = 'Se hva som gikk galt';
    }
    show(card, true);
  }

  /**
   * Stop saying the page is loading.
   *
   * One place, called from both the answer and the failure, because a region
   * left marked aria-busy is a region a screen reader keeps waiting on.
   */
  function settled(): void {
    overview.removeAttribute('aria-busy');
  }

  /**
   * Clear the placeholders when there will be no figures to put in them.
   *
   * Without this a failed request leaves the shapes shimmering under an error
   * message, which reads as "still trying" when nothing is still trying.
   */
  function clearSkeletons(): void {
    settled();
    for (const value of overview.querySelectorAll<HTMLElement>('.stat-value')) {
      if (value.querySelector('.skeleton') !== null) value.textContent = '-';
    }
    for (const note of overview.querySelectorAll<HTMLElement>('.stat-note')) {
      if (note.querySelector('.skeleton') !== null) note.textContent = '';
    }
    for (const row of overview.querySelectorAll('tr[data-skeleton-row]')) row.remove();
  }

  void loadSession().then(async (session) => {
    if (session === null) return;
    try {
      companies = await loadCompanies();
      loading.hidden = true;

      // «Bytt selskap» only where there is something to switch to. On an
      // account with one set of books it would be a control that does nothing;
      // on an account with four it is both the way over and a standing reminder
      // that the name above is one of several.
      const switcher = el<HTMLButtonElement>('#company-switch');
      switcher.hidden = companies.length < 2;
      switcher.addEventListener('click', openCompanyMenu);

      const current = currentCompany(companies);
      if (current === undefined) {
        // No books yet, so there is no overview to draw. The way to add a set
        // lives on /organisasjon/, next to the organisation that will own it,
        // and the only thing this page does about it is point there once.
        //
        // Reachable with the overview already laid out, when the hint said this
        // account had books and it no longer does. Putting it away again is the
        // correction, and it is why the hint is only ever allowed to decide
        // layout.
        overview.hidden = true;
        settled();
        controls.hidden = true;
        show(empty, true);
        // Nothing is being looked at, so the heading says what the page is
        // rather than naming a company. This heading only, and never through
        // the shared slot: the header at the top of the page has its own answer
        // for an account with no books (the account's name, from applyChrome),
        // and «Oversikt» in the company slot up there would be a page title
        // pretending to be a company. Nothing is stored either way.
        el('#company-orgnr').hidden = true;
        el('#dash-company').textContent = 'Oversikt';
        const mayAdd = session.memberships.some((m) =>
          can(session, m.organization_id, 'organization:manage'),
        );
        show(el('#no-company-add'), mayAdd);
        show(el('#no-permission'), !mayAdd);
        return;
      }

      controls.hidden = false;
      await showCompany(current);
    } catch (error: unknown) {
      loading.hidden = true;
      clearSkeletons();
      setStatus(
        status,
        error instanceof ApiError ? error.message : 'Vi fikk ikke hentet oversikten.',
      );
    }
  });
</script>
