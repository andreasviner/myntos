---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Private uttak | Myntos"
  description="Melk, poteter, kjøtt, ved og annet husholdningen har tatt fra gården i året."
  width="wide"
>
  <header class="page-head">
    <div>
      <p class="eyebrow">Private uttak</p>
      {/* Selskapet er overskriften: uttakene gjelder ett regnskap. */}
      <h1 data-session-company></h1>
      <p class="muted orgnr" id="orgnr"></p>
    </div>
    <label class="year-pick" id="year-pick" hidden>
      <span>Regnskapsår</span>
      <select id="year"></select>
    </label>
  </header>

  <p class="lead">
    Det husholdningen tar fra gården, er inntekt for gården og et uttak for eieren. Før opp hva
    som er tatt ut i året, så verdsetter Myntos det etter takseringsreglene, finner mva-en og fører
    det mot privatkontoen.
  </p>

  <p class="status" id="page-status" hidden></p>
  <div class="empty" id="loading">Henter …</div>

  <section class="card" id="not-farm" hidden>
    <h2 class="card-title">Landbruk er ikke slått på</h2>
    <p>
      Private uttak av gårdens produkter hører til landbrukstillegget. Slå det på under
      <a href="/kontoplan/">Kontoplan</a>, i kortet «Landbruk». Andre uttak med mva fører du under
      <a href="/mva-justeringer/">Mva-justeringer</a>.
    </p>
  </section>

  <p class="card-hint" id="rates" hidden></p>

  {/* Listen som står. Retting er reversering pluss ny liste, aldri endring. */}
  <section class="card" id="standing" hidden>
    <h2 class="card-title">Førte uttak <span id="standing-no" class="muted"></span></h2>
    <div class="table-scroll">
      <table class="lines" id="standing-table">
        <thead>
          <tr>
            <th>Produkt</th><th class="num">Mengde</th><th class="num">Per enhet</th><th
              class="num">Verdi</th
            ><th>Mva</th><th class="num">Mva-beløp</th>
          </tr>
        </thead>
        <tbody id="standing-lines"></tbody>
      </table>
    </div>
    <div class="actions" id="standing-actions">
      <button type="button" class="btn btn-ghost" id="correct">Rett uttakene</button>
      <button type="button" class="btn btn-ghost" id="withdraw">Trekk dem tilbake</button>
    </div>
    <p class="card-hint">
      En ført liste endres ikke. Retting reverserer bilaget og fører den nye listen i samme operasjon.
    </p>
  </section>

  <section class="card" id="form-card" hidden>
    <h2 class="card-title" id="form-title">Uttak i året</h2>
    <form id="uttak-form" novalidate>
      <label class="field date-field">
        <span>Dato for bilaget</span>
        <input type="date" id="date" />
        <span class="field-hint">
          Normalt 31. desember. Datoen avgjør hvilken mva-termin uttaket kommer med i.
        </span>
      </label>
      <div class="table-scroll">
        <table class="lines" id="form-table">
          <thead>
            <tr>
              <th>Produkt</th><th class="num">Mengde</th><th class="num">Verdi per enhet</th><th
                >Beskrivelse</th
              ><th><span class="visually-hidden">Fjern</span></th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <p class="card-hint">
        Melk og poteter regnes per husstandsmedlem i året: skriv 0,5 for den som er over 70 år, og
        for poteter også for barn under 10. Ved regnes i løse kubikkmeter. Kjøtt, egg og annet uten
        norm føres med det det ville kostet å kjøpe, i «Verdi per enhet».
      </p>
      <div class="actions">
        <button type="button" class="btn btn-ghost" id="add-row">Legg til linje</button>
        <button type="submit" class="btn btn-primary" id="check">Kontroller</button>
      </div>
      <p class="status" id="form-status" hidden></p>
    </form>
  </section>

  <section class="card" id="review" hidden aria-live="polite">
    <h2 class="card-title">Gjennomgå før føring</h2>
    <p id="review-intro"></p>
    <div class="table-scroll">
      <table class="lines" id="review-table">
        <thead>
          <tr>
            <th>Produkt</th><th class="num">Mengde</th><th class="num">Per enhet</th><th
              class="num">Verdi</th
            ><th>Mva</th><th class="num">Mva-beløp</th>
          </tr>
        </thead>
        <tbody id="review-lines"></tbody>
        <tfoot>
          <tr><th colspan="3">Sum</th><th class="num" id="sum-value"></th><th></th><th class="num" id="sum-vat"></th></tr>
        </tfoot>
      </table>
    </div>
    <ul class="findings" id="errors" hidden></ul>
    <ul class="findings notes" id="notes" hidden></ul>
    <div class="actions">
      <button type="button" class="btn btn-ghost" id="back">Tilbake til skjemaet</button>
      <button type="button" class="btn btn-primary" id="post" disabled>Før uttakene</button>
    </div>
    <p class="status" id="review-status" hidden></p>
  </section>

  <section class="card" id="history-card" hidden>
    <h2 class="card-title">Historikk</h2>
    <ul class="history" id="history"></ul>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .orgnr {
    margin: 0.2rem 0 0;
  }
  .year-pick {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .date-field {
    max-width: 20rem;
    margin-bottom: 1rem;
  }
  .card + .card {
    margin-top: 1rem;
  }
  /* Radene lages av skriptet, så reglene for dem går gjennom :global(). */
  .lines {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .lines :global(th),
  .lines :global(td) {
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--border, #ddd);
  }
  .lines :global(.num) {
    text-align: right;
  }
  .lines :global(input),
  .lines :global(select) {
    width: 100%;
    min-width: 5rem;
  }
  .findings {
    margin: 0.75rem 0;
    padding-left: 1.2rem;
    color: var(--negative);
  }
  .findings.notes {
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .history {
    padding-left: 1.2rem;
  }
</style>

<script>
  import {
    ApiError,
    getLandbruk,
    getUttakState,
    listFinancialYears,
    postUttak,
    reviewUttak,
    withdrawUttak,
    type Company,
    type UttakLine,
    type UttakLineInput,
    type UttakState,
  } from '../lib/api';
  import { normaliseAmount } from '../lib/amount';
  import { currentCompany, loadCompanies } from '../lib/company';
  import { el, setStatus, show } from '../lib/dom';
  import { VAT_REASON_LABELS, decimal, yearToOpen } from '../lib/farm';
  import { isoDate, kroner, orgnummer, todayIso } from '../lib/format';
  import { canInCompany, loadSession, redirectToLogin } from '../lib/session';

  const pageStatus = el<HTMLParagraphElement>('#page-status');
  const formStatus = el<HTMLParagraphElement>('#form-status');
  const reviewStatus = el<HTMLParagraphElement>('#review-status');
  const rows = el<HTMLTableSectionElement>('#rows');
  const postButton = el<HTMLButtonElement>('#post');
  const yearSelect = el<HTMLSelectElement>('#year');
  const dateInput = el<HTMLInputElement>('#date');

  let company: Company;
  let year = 0;
  let state: UttakState;
  let correcting = false;
  // Linjene og datoen slik de ble kontrollert; det er disse som føres.
  let reviewed: UttakLineInput[] = [];
  let reviewedDate: string | null = null;

  function cell(text: string, numeric = false): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    if (numeric) td.className = 'num';
    return td;
  }

  function vatText(line: UttakLine): string {
    const reason = VAT_REASON_LABELS[line.vat_reason] ?? line.vat_reason;
    return line.tax_code === null ? reason : `${reason}, kode ${line.tax_code}`;
  }

  function lineRow(line: UttakLine): HTMLTableRowElement {
    const tr = document.createElement('tr');
    const what = line.description && line.description !== line.label ? `${line.label} (${line.description})` : line.label;
    tr.append(
      cell(what),
      cell(`${decimal(line.quantity)} ${line.unit}`, true),
      cell(kroner(line.unit_value), true),
      cell(kroner(line.value), true),
      cell(vatText(line)),
      cell(kroner(line.vat), true),
    );
    return tr;
  }

  function productSelect(selected: string): HTMLSelectElement {
    const select = document.createElement('select');
    select.className = 'product';
    select.setAttribute('aria-label', 'Produkt');
    for (const product of state.products) {
      const option = document.createElement('option');
      option.value = product.code;
      option.textContent =
        product.value === null ? `${product.label} (per ${product.unit})` : `${product.label} (${kroner(product.value)} per ${product.unit})`;
      option.title = product.note;
      select.append(option);
    }
    select.value = selected;
    return select;
  }

  function input(className: string, value: string, label: string, numeric = false): HTMLInputElement {
    const node = document.createElement('input');
    node.className = className;
    node.value = value;
    node.setAttribute('aria-label', label);
    if (numeric) node.inputMode = 'decimal';
    return node;
  }

  function addRow(line?: Partial<UttakLineInput>): void {
    const tr = document.createElement('tr');
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'btn btn-ghost btn-small';
    remove.textContent = 'Fjern';
    remove.addEventListener('click', () => tr.remove());
    const parts: HTMLElement[] = [
      productSelect(line?.product ?? state.products[0]?.code ?? 'annet'),
      input('quantity', line?.quantity ? decimal(line.quantity) : '', 'Mengde', true),
      input('unit-value', line?.unit_value ? decimal(line.unit_value) : '', 'Verdi per enhet', true),
      input('description', line?.description ?? '', 'Beskrivelse'),
      remove,
    ];
    for (const part of parts) {
      const td = document.createElement('td');
      td.append(part);
      tr.append(td);
    }
    rows.append(tr);
  }

  function fill(lines: UttakLine[]): void {
    rows.replaceChildren();
    for (const line of lines) {
      const product = state.products.find((p) => p.code === line.product);
      addRow({
        product: line.product,
        quantity: line.quantity,
        // En norm sendes ikke tilbake: bare et avvik fra den, eller en omsetningsverdi.
        unit_value:
          product?.value != null && decimal(product.value) === decimal(line.unit_value) ? null : line.unit_value,
        description: line.description === line.label ? '' : line.description,
      });
    }
    if (lines.length === 0) addRow();
  }

  function collect(): UttakLineInput[] | string {
    const lines: UttakLineInput[] = [];
    for (const [index, tr] of [...rows.querySelectorAll('tr')].entries()) {
      const value = (selector: string): string => el<HTMLInputElement>(selector, tr).value.trim();
      const rawQuantity = value('.quantity');
      if (rawQuantity === '') continue;
      const quantity = normaliseAmount(rawQuantity, 3);
      const rawUnit = value('.unit-value');
      const unitValue = rawUnit === '' ? null : normaliseAmount(rawUnit, 4);
      if (quantity === null) return `Mengden på linje ${index + 1} kan ikke leses.`;
      if (rawUnit !== '' && unitValue === null) return `Verdien på linje ${index + 1} kan ikke leses.`;
      lines.push({
        product: el<HTMLSelectElement>('.product', tr).value,
        quantity,
        unit_value: unitValue,
        description: value('.description'),
      });
    }
    return lines;
  }

  function list(target: HTMLElement, messages: string[]): void {
    target.replaceChildren(
      ...messages.map((message) => {
        const item = document.createElement('li');
        item.textContent = message;
        return item;
      }),
    );
    show(target, messages.length > 0);
  }

  function renderState(): void {
    const mayWrite = canInCompany(company, 'ledger:write');
    if (state.refusal !== null) setStatus(pageStatus, state.refusal[0]!.toUpperCase() + state.refusal.slice(1) + '.');
    else setStatus(pageStatus, '');
    const rates = el<HTMLParagraphElement>('#rates');
    rates.textContent = state.rates.published
      ? `Normene er fra ${state.rates.source}.`
      : `Skattedirektoratet har ikke publisert normene for ${year} ennå (de kommer i desember). ` +
        'Produkter uten norm, som kjøtt og egg, kan føres nå.';
    show(rates, true);

    const standing = state.standing;
    show(el('#standing'), standing !== null);
    if (standing !== null) {
      el('#standing-no').textContent = `bilag ${standing.voucher_no ?? ''}, ${isoDate(standing.occurred_on)}`;
      el('#standing-lines').replaceChildren(...standing.lines.map(lineRow));
    }
    show(el('#standing-actions'), standing !== null && state.allowed && mayWrite);
    show(el('#form-card'), state.allowed && mayWrite && (standing === null || correcting));
    el('#form-title').textContent = correcting ? `Rettede uttak ${year}` : `Uttak i ${year}`;

    const history = state.history;
    show(el('#history-card'), history.length > 1);
    el('#history').replaceChildren(
      ...history.map((item) => {
        const li = document.createElement('li');
        const what = item.withdrawn ? 'Trukket tilbake' : item.corrects_id !== null ? 'Rettet liste' : 'Uttak';
        li.textContent = `${isoDate(item.created_at.slice(0, 10))}: ${what}${item.voucher_no ? `, bilag ${item.voucher_no}` : ''}${item.withdrawn ? '' : `, ${kroner(item.total_value)}`}`;
        return li;
      }),
    );
  }

  async function load(): Promise<void> {
    state = await getUttakState(company.id, year);
    renderState();
  }

  function resetForm(): void {
    dateInput.value = state.standing?.occurred_on ?? state.occurred_on ?? '';
    fill([]);
  }

  function showReview(visible: boolean): void {
    show(el('#review'), visible);
    show(el('#form-card'), !visible);
  }

  el<HTMLFormElement>('#uttak-form').addEventListener('submit', (event) => {
    event.preventDefault();
    setStatus(formStatus, '');
    const lines = collect();
    if (typeof lines === 'string') {
      setStatus(formStatus, lines);
      return;
    }
    const date = dateInput.value === '' ? null : dateInput.value;
    const button = el<HTMLButtonElement>('#check');
    button.disabled = true;
    reviewUttak(company.id, year, lines, date)
      .then((review) => {
        reviewed = lines;
        reviewedDate = date;
        const day = review.occurred_on ? isoDate(review.occurred_on) : '';
        el('#review-intro').textContent = correcting
          ? `Dette erstatter de førte uttakene. Bilaget reverseres, og dette føres ${day} mot privatkontoen 2060.`
          : `Dette føres som ett bilag ${day} mot privatkontoen 2060.`;
        el('#review-lines').replaceChildren(...review.lines.map(lineRow));
        el('#sum-value').textContent = kroner(review.total_value);
        el('#sum-vat').textContent = kroner(review.total_vat);
        list(el('#errors'), review.findings.filter((f) => f.severity === 'feil').map((f) => f.message));
        list(el('#notes'), review.findings.filter((f) => f.severity === 'merknad').map((f) => f.message));
        postButton.disabled = !review.postable;
        setStatus(reviewStatus, '');
        showReview(true);
      })
      .catch((error: unknown) => {
        setStatus(formStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke kontrollert uttakene.');
      })
      .finally(() => {
        button.disabled = false;
      });
  });

  el('#back').addEventListener('click', () => showReview(false));

  postButton.addEventListener('click', () => {
    postButton.disabled = true;
    postUttak(company.id, year, reviewed, reviewedDate, correcting)
      .then(async (posted) => {
        correcting = false;
        show(el('#review'), false);
        setStatus(pageStatus, `Uttakene er ført som bilag ${posted.voucher_no ?? ''}.`, 'ok');
        await load().catch(() => undefined);
      })
      .catch((error: unknown) => {
        postButton.disabled = false;
        setStatus(reviewStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke ført uttakene.');
      });
  });

  el('#add-row').addEventListener('click', () => addRow());

  el('#correct').addEventListener('click', () => {
    correcting = true;
    dateInput.value = state.standing?.occurred_on ?? state.occurred_on ?? '';
    fill(state.standing?.lines ?? []);
    renderState();
  });

  el('#withdraw').addEventListener('click', () => {
    // En bekreftelse holder: tilbaketrekkingen er en reversering, og en ny liste kan føres etterpå.
    if (!window.confirm('Trekke tilbake de private uttakene? Bilaget reverseres og blir stående i regnskapet.')) return;
    withdrawUttak(company.id, year)
      .then(async () => {
        correcting = false;
        setStatus(pageStatus, 'Uttakene er trukket tilbake, og bilaget er reversert.', 'ok');
        await load();
        resetForm();
      })
      .catch((error: unknown) => {
        setStatus(pageStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke trukket tilbake uttakene.');
      });
  });

  yearSelect.addEventListener('change', () => {
    year = Number(yearSelect.value);
    correcting = false;
    showReview(false);
    load()
      .then(resetForm)
      .catch((error: unknown) => {
        setStatus(pageStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke hentet året.');
      });
  });

  void loadSession().then(async (session) => {
    if (session === null) {
      redirectToLogin();
      return;
    }
    try {
      const companies = await loadCompanies();
      if (companies.length === 0) {
        window.location.href = '/';
        return;
      }
      const current = currentCompany(companies);
      if (current === undefined) return;
      company = current;
      el('#orgnr').textContent = `Org.nr. ${orgnummer(company.orgnr)}`;
      const [landbruk, years] = await Promise.all([getLandbruk(company.id), listFinancialYears(company.id)]);
      if (!landbruk.enabled) {
        show(el('#not-farm'), true);
        return;
      }
      const opened = yearToOpen(years, todayIso());
      if (opened === null) {
        setStatus(pageStatus, 'Selskapet har ikke noe regnskapsår i Myntos ennå.');
        return;
      }
      year = opened;
      yearSelect.replaceChildren(
        ...years.map((y) => {
          const option = document.createElement('option');
          option.value = String(y.year);
          option.textContent = y.closed ? `${y.year} (avsluttet)` : String(y.year);
          return option;
        }),
      );
      yearSelect.value = String(year);
      show(el('#year-pick'), true);
      await load();
      resetForm();
    } catch (error: unknown) {
      setStatus(pageStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke hentet uttakene.');
    } finally {
      el('#loading').hidden = true;
    }
  });
</script>
