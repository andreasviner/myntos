---
import ClaimedDialog from '../components/ClaimedDialog.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_MODE, MODES, RIGHTS } from '../lib/agentkeys';
import { LEVELS } from '../lib/datasharing';
---

{/* Selskapet: hvem det er, og hvem som har tilgang til regnskapet.

    Siden er bygget som ett kort per spørsmål, og hvert kort viser først svaret
    og deretter — bak «Endre» — skjemaet som retter det. En side som møter deg
    med seks skjemaer ser ut som seks oppgaver du har til gode; de samme seks
    som opplysninger ser ut som det de er, nemlig at alt er på plass.

    Alt som bygges i JavaScript her — Altinn-listen, rollene, medlemsradene —
    får aldri attributtet Astro bruker for å avgrense stiler til én side. Derfor
    er stilarket under `is:global` og alt henger under `.org`. Uten det står
    listene upyntet, som de gjorde før. */}

<BaseLayout
  title="Selskapet | Myntos"
  description="Selskapet, medlemmene som fører regnskapet og invitasjonene til det."
  width="wide"
>
  <div class="org">
    {/* Selskapet, og bare selskapet.

        Her sto kontoen over overskriften, og en velger for å bytte konto ved
        siden av. Begge er borte: kontoen eier selskapene og ingenting annet
        noen ser på, og et kontonavn — som gjerne er navnet på det første
        selskapet noen satte opp — leses som selskapets eget når det står to
        centimeter over et annet selskaps tall. Det ble meldt som en lekkasje,
        og det er nettopp slik det ser ut. Se docs/company-isolation.md. */}
    <header class="org-head">
      <div>
        <p class="eyebrow">Selskap</p>
        <h1 id="sidetittel">…</h1>
      </div>
    </header>

    <p class="status" id="page-status" hidden></p>

    {/* Øverst på siden, fordi det er hit «Ubekreftet» i toppen lenker.

        Gult og ikke rødt: ingenting er galt. Regnskapet føres, fakturaer
        utstedes, og alt virker. Det som mangler er at noen har vist at de kan
        opptre for selskapet, og det er en oppgave som venter — ikke en feil som
        har skjedd. */}
    <div class="varsel" id="ubekreftet-varsel" hidden>
      <div>
        <p class="varsel-tittel">Selskapet ditt er ikke bekreftet hos oss</p>
        <p class="varsel-tekst" id="ubekreftet-tekst">
          Logg inn med ID-porten for å bekrefte rollen din i selskapet. Vi spør Altinn hvilke
          selskaper du kan opptre for, og bekrefter regnskapet mot det. Regnskapet virker som før
          i mellomtiden.
        </p>
        <p class="status" id="ubekreftet-status" hidden></p>
      </div>
      {/* Én knapp, med ett navn, synlig i samme øyeblikk som varselet. Knappen
          heter det den gjør: bekrefte selskapet. At den underveis må innom
          ID-porten er vår sak, ikke en avgjørelse brukeren skal ta i toppen av
          siden. */}
      <div class="varsel-knapper">
        <button type="button" class="btn btn-primary" id="varsel-fiks">Bekreft selskapet</button>
      </div>
    </div>

    <div class="empty" id="loading">Henter …</div>

    <div id="content" hidden>
      {/* --- Selskapet ------------------------------------------------------

          Det siden handler om. Opplysningene står som opplysninger, ikke som
          utfylte felter, og skjemaet kommer fram når noen ber om det.
          Kontonummeret hører hit og ikke på fakturaskjemaet: det er det samme
          på hver faktura, og en utstedt faktura kan bare rettes med kreditnota.
          Derfor nekter /faktura/ å utstede så lenge feltet er tomt. */}
      <section id="selskap" hidden>
        <div class="org-section-head">
          <h2>Selskapet</h2>
          <div class="org-section-tools">
            <span class="org-merke" id="selskap-merke" hidden></span>
          </div>
        </div>

        <div class="card">
          <p class="status" id="selskap-status" hidden></p>

          {/* Opplysninger, ikke et skjema. Den som kommer hit for å se hva som
              står registrert skal se det med én gang; den som kom for å rette
              én ting retter den der den står, og lar resten være. */}
          <dl class="org-felt" id="selskap-felt"></dl>
          {/* Kontoplanen er regnskapets og ikke selskapets opplysninger, men det
              er her man leter etter oppsettet, og mva-registreringen over
              bestemmer hva typene i den foreslår. */}
          <p class="card-hint">
            Kontoene og hvilken post i næringsspesifikasjonen hver av dem havner i, står i
            <a href="/kontoplan/">kontoplanen</a>.
          </p>

          {/* --- Kontonummer ------------------------------------------------

              Egen liste og ikke én linje blant opplysningene over, fordi det
              er flertall: et selskap har så mange kontoer som banken ga det,
              og skattetrekket skal etter skattebetalingsloven § 5-12 stå for
              seg. Den øverste er merket, og det er den fakturaen betales til
              når den ikke sier noe annet.

              Tom liste er ikke ingenting å si: /faktura/ nekter å utstede så
              lenge den er tom, og en utstedt faktura kan bare rettes med
              kreditnota. Derfor står tomheten som en linje med farge, ikke som
              et felt som mangler. */}
          <div class="org-kontoer">
            <div class="org-kort-head">
              <h3>Kontonummer</h3>
              <button type="button" class="btn btn-ghost btn-small" id="konto-ny" hidden>
                Legg til konto
              </button>
            </div>
            <p class="status" id="konto-status" hidden></p>
            <ul class="org-kontoliste" id="konto-liste"></ul>
          </div>

          {/* Eierskapet.

              Å skrive inn ni siffer viser ingenting. Et regnskap er ubekreftet
              til noen har vist gjennom Altinn at de kan opptre for selskapet,
              og det er den samme rettigheten en innsending senere hviler på.

              Regnskapet virker like fullt. Bokføring er ikke sperret bak en
              BankID-innlogging på en søndag kveld; det bekreftelsen avgjør er
              hvem selskapet hører til, ikke om det kan føres. */}
          <div class="org-eierskap" id="eierskap" hidden>
            <p class="org-eierskap-tekst" id="eierskap-tekst"></p>
            <p class="status" id="eierskap-status" hidden></p>
            <div class="org-knapperad">
              <a class="btn btn-ghost btn-small" id="eierskap-login" href="#" hidden>
                Logg inn med ID-porten
              </a>
              <button type="button" class="btn btn-ghost btn-small" id="eierskap-bekreft" hidden>
                Bekreft eierskap i Altinn
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* --- Tilgang til dette regnskapet -------------------------------------

          Medlemmene og invitasjonene hører til selskapet over, ikke til
          kontoen. Det er den endringen som gjør «hjelp meg med denne ene
          klienten» mulig å si: før fikk den man inviterte hvert selskap på
          kontoen på én gang, og skjemaet som ga dem det sto under kontoen, der
          ingenting sa fra om det.

          Rett under Selskapet, foran registeroppslaget: å invitere en kollega
          er en av de to tingene noen faktisk gjør på denne siden, og den lå
          tidligere under en tabell man bare leser. */}
      <section id="tilgang">
        <h2>Tilgang</h2>

        <div class="card">
          <div class="org-kort-head">
            <h3 id="medlemmer-tittel">Medlemmer</h3>
            {/* «Inviter en KI» står ved siden av «Inviter en kollega», fordi en
                nøkkel er tilgang til regnskapet på samme måte som et
                medlemskap, bare for et program i stedet for en person. Den
                åpner et vindu: første gang med det man må vite før nøkler slås
                på, deretter rett på skjemaet. Se docs/agents-and-api.md. */}
            <div class="org-knapperad">
              <button type="button" class="btn btn-ghost btn-small" id="agent-vis" hidden>
                Inviter en KI
              </button>
              <button type="button" class="btn btn-ghost btn-small" id="invite-vis" hidden>
                Inviter en kollega
              </button>
            </div>
          </div>
          <div class="table-scroll">
            <table class="data org-medlemmer">
              <thead>
                <tr>
                  <th>Navn</th>
                  <th>E-post</th>
                  <th>Rolle</th>
                  {/* Hvem som har vist hvem de er. Ikke det samme som å være
                      logget inn: en ID-porten-innlogging varer en time, mens
                      det den viste står. Det er denne koblingen som gjør at
                      styrelisten lenger nede kan si «bekreftet» og ikke bare
                      «trolig». */}
                  <th>ID-porten</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="members"></tbody>
            </table>
          </div>

          <div id="invite" hidden>
            <p class="status" id="invite-status" hidden></p>
            <form id="invite-form" class="org-form">
              {/* Står bare når invitasjonen ble startet fra en rad i styret.
                  Da har man allerede pekt på en person, og skjemaet skal si
                  hvem, og ikke be om det på nytt. */}
              <p class="org-invite-for" id="invite-for" hidden></p>
              <label class="field">
                <span>E-postadresse</span>
                <input type="email" name="email" required autocomplete="off" />
                <span class="field-hint">
                  Vi sender en e-post med lenken hit. Invitasjonen gjelder bare denne adressen, og
                  en videresendt lenke er ikke en billett inn.
                </span>
              </label>
              {/* Navnet spørres det ikke om. Det er en merkelapp og ingen
                  kontroll — invitasjonen gjelder adressen, og det er den man må
                  logge inn med — så et tomt felt over «Send invitasjon» ba om
                  noe man ikke behøver å vite for å invitere en kollega, og
                  gjorde en handling på to sekunder til et skjema.

                  Feltet står likevel, skjult, fordi «Inviter» i styret fra
                  Enhetsregisteret fyller det: da har registeret oppgitt navnet,
                  det står i klartekst i #invite-for over, og det er navnet som
                  lar styrelisten si «Invitert» om nettopp den raden. Se
                  docs/register-access.md. */}
              <input type="hidden" name="full_name" />
              <label class="field">
                <span>Rolle</span>
                <select name="role">
                  <option value="viewer">Leser: ser regnskapet, kan ikke føre</option>
                  <option value="member" selected>Medlem: kan føre bilag</option>
                  <option value="admin">Administrator: kan også styre selskaper og medlemmer</option>
                  <option value="owner">Eier: kan alt, inkludert abonnement</option>
                </select>
              </label>
              <div class="org-knapperad org-form-knapper">
                <button class="btn btn-primary" type="submit" id="invite-submit">
                  Send invitasjon
                </button>
                <button class="btn btn-ghost" type="button" id="invite-avbryt">Avbryt</button>
              </div>
            </form>

            {/* Etter hver invitasjon, også når e-posten gikk. Den var skjult da,
                fordi en sendt e-post så ut til å ligge i innboksen allerede. Det
                gjorde den ikke: Cloudflare svarer «i kø» før søppelpostfilteret
                har lest meldingen, og i oktober 2026 avviste det tre
                invitasjoner som siden hadde meldt «sendt». Lenken vises bare
                denne gangen, så den som skjuler den, tar fra avsenderen den
                eneste veien videre. */}
            <div class="org-lenke" id="invite-link-box" hidden>
              <p class="card-hint" id="invite-link-ikke-sendt" hidden>
                <strong>Vi fikk ikke sendt e-posten.</strong> Kopier lenken og send den selv. Den
                vises bare denne ene gangen, for vi lagrer bare et hash av den.
              </p>
              <p class="card-hint" id="invite-link-sendt" hidden>
                Vi kan ikke se om e-posten kommer fram. Kommer den ikke, kopierer du lenken og
                sender den selv. Den vises bare denne ene gangen, for vi lagrer bare et hash av den.
              </p>
              <div class="org-kopirad">
                <input type="text" id="invite-link" readonly />
                <button class="btn btn-ghost" type="button" id="copy-link">Kopier</button>
              </div>
            </div>
          </div>
        </div>

        <div class="card" id="invitations-card" hidden>
          <h3>Ventende invitasjoner</h3>
          <div class="table-scroll">
            <table class="data org-invitasjoner">
              <thead>
                <tr>
                  <th>Hvem</th>
                  <th>Rolle</th>
                  {/* Den første tingen man lurer på om en invitasjon man ikke
                      kjenner igjen. */}
                  <th>Sendt av</th>
                  <th>Utløper</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="invitations"></tbody>
            </table>
          </div>
        </div>

        {/* --- KI-agenter og API-nøkler ---------------------------------------

            Nøklene står her, under medlemmene, og ikke på KI-siden: KI-siden
            handler om hva Myntos selv sender til Løynd, og dette er det
            motsatte, at selskapets eget verktøy henter regnskapet. Det samme
            for en KI-assistent og for et skript noen har skrevet mot API-et:
            en nøkkel er en nøkkel.

            Kortet står bare når nøkler er slått på. Før det er det ingenting å
            liste, og det man må lese før man slår dem på, står i vinduet
            «Inviter en KI» åpner, ikke på siden hver gang. */}
        <div class="card org-agent" id="agenter" hidden>
          <div class="org-kort-head">
            <h3 id="agent-tittel">KI-agenter og API-nøkler</h3>
          </div>
          <p class="status" id="agent-status" hidden></p>
          {/* Det agentene venter på, med lenke dit det avgjøres. */}
          <p class="org-agent-venter" id="agent-venter" hidden>
            <a href="/godkjenning/" id="agent-venter-lenke"></a>
          </p>
          <p class="card-hint" id="agent-tom" hidden>
            Ingen nøkler ennå. Trykk «Inviter en KI» for å lage en.
          </p>
          <div class="table-scroll" id="agent-tabell" hidden>
            <table class="data org-agenter">
              <thead>
                <tr>
                  <th>Nøkkel</th>
                  <th>Får gjøre</th>
                  <th id="agent-hvem-kol">Laget av</th>
                  <th>Sist brukt</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="agent-nokler"></tbody>
            </table>
          </div>

          {/* Å slå av er trygt, men det stopper hver nøkkel for godt, og
              agentene til alle i selskapet slutter å virke. Derfor et trinn
              som sier det, ikke en knapp som bare gjør det. */}
          <div class="org-agent-av" id="agent-av-trinn" hidden>
            <button class="btn-link" type="button" id="agent-av-vis">
              Slå av nøkler for selskapet
            </button>
            <div id="agent-av-bekreft" hidden>
              <p class="card-hint">
                Alle nøklene stopper med en gang, også kollegenes, og de kan ikke slås på igjen.
                Det de venter på godkjenning for, blir aldri utført. Agentene må få nye nøkler hvis
                dere slår det på senere.
              </p>
              <div class="org-knapperad">
                <button class="btn btn-primary" type="button" id="agent-av">Slå av</button>
                <button class="btn btn-ghost" type="button" id="agent-av-avbryt">Avbryt</button>
              </div>
            </div>
          </div>
        </div>

        {/* --- Vinduet «Inviter en KI» ------------------------------------------

            Et <dialog> med showModal(): fokus holdes inne, Escape lukker, og
            resten av siden er utilgjengelig så lenge det står. Fire tilstander,
            én synlig om gangen:

            - samtykke: nøkler er av, og man kan slå dem på. Det regel 8 krever
              at noen har lest: hva agenten ser, at modellen bak den bestemmer
              hvor dataene havner, og at det er selskapets eget ansvar.
            - av-spor: nøkler er av, og man kan ikke slå dem på.
            - skjema: navn og rettigheter.
            - ny: teksten som limes inn, vist én gang.

            Rettighetene er tegnet her og ikke i skriptet, fra RIGHTS og MODES i
            lib/agentkeys.ts, så ordene på skjermen og ordene som testes er de
            samme. */}
        <dialog class="org-dialog" id="agent-dialog" aria-labelledby="agent-dialog-tittel">
          <div class="org-dialog-head">
            <h3 id="agent-dialog-tittel">Inviter en KI eller et program</h3>
            <button type="button" class="org-dialog-lukk" id="agent-lukk" aria-label="Lukk">
              ×
            </button>
          </div>
          <p class="status" id="agent-dialog-status" hidden></p>

          <div id="agent-samtykke" hidden>
            <p class="card-hint">
              Med en nøkkel kan din egen KI-assistent, for eksempel ChatGPT, Claude eller en modell du
              kjører selv, lese og føre i regnskapet for deg. Den samme nøkkelen lar et program eller
              et skript du eller en utvikler har laget, koble seg til Myntos.
              <span id="agent-av-tekst">Nøkler er slått av for dette selskapet.</span>
            </p>
            <p class="org-agent-ingress">Før du slår det på:</p>
            <ul class="org-agent-punkter">
              <li>
                Agenten kan lese hele regnskapet, også opplysninger om kunder, leverandører og
                ansatte.
              </li>
              <li>
                Modellen bak agenten bestemmer hvor opplysningene havner. En modell du kjører selv,
                holder dem hos deg. ChatGPT og Claude sender dem til OpenAI og Anthropic, gjerne utenfor
                EØS. Myntos sjekker ikke hvilken modell som brukes, så valget og ansvaret er
                selskapets.
              </li>
              <li>
                Du velger for hver nøkkel hva den får gjøre selv, og hva den må spørre deg om først.
                Det den spør om, godkjenner eller avviser du under Godkjenning.
              </li>
              <li>
                Alt en nøkkel vil sende ut av Myntos, som mva-meldingen og skattemeldingen til
                Skatteetaten, venter på at du godkjenner det, hver gang, og går med din egen
                ID-porten-innlogging. Ingen nøkkel kan flytte penger, endre kontonummer eller
                bestemme hvem som har tilgang, uansett hva den får lov til.
              </li>
            </ul>
            <label class="org-agent-check">
              <input type="checkbox" id="agent-forstaar" />
              <span id="agent-forstaar-tekst">Jeg har lest dette og vil slå på nøkler.</span>
            </label>
            <div class="org-knapperad">
              <button type="button" class="btn btn-primary" id="agent-paa" disabled>
                Slå på nøkler
              </button>
              <button type="button" class="btn btn-ghost" data-agent-lukk>Avbryt</button>
            </div>
          </div>

          <div id="agent-av-spor" hidden>
            <p class="card-hint">
              Nøkler for KI-agenter og API er slått av for dette selskapet. Bare en eier eller
              administrator kan slå dem på. Spør en av dem.
            </p>
            <button type="button" class="btn btn-ghost" data-agent-lukk>Lukk</button>
          </div>

          <form id="agent-form" class="org-agent-skjema" novalidate hidden>
            <label class="field">
              <span>Navn på nøkkelen</span>
              <input type="text" name="name" maxlength="64" autocomplete="off" />
              <span class="field-hint">
                Det du vil kjenne den igjen på, for eksempel «Claude på jobb-PC» eller «Fakturaskript».
                Navnet står ved hvert bilag den fører.
              </span>
            </label>

            {/* Bare når det er et valg. En leser kan bare gi en nøkkel som
                leser, og da er det ingenting å spørre om. */}
            <fieldset class="org-agent-rettigheter" id="agent-rettigheter" hidden>
              <legend>Hva skal den få gjøre?</legend>
              <div class="org-agent-rett">
                <div>
                  <strong>Lese</strong>
                  <span class="field-hint">Ser hele regnskapet. Det gjør hver nøkkel.</span>
                </div>
                <span class="org-agent-fast">Alltid</span>
              </div>
              {
                RIGHTS.map((right) => (
                  <div class="org-agent-rett">
                    <div>
                      <strong>{right.label}</strong>
                      <span class="field-hint">{right.hint}</span>
                    </div>
                    <div class="org-agent-valg" role="radiogroup" aria-label={right.label}>
                      {MODES.map((mode) => (
                        <label>
                          <input
                            type="radio"
                            name={right.scope}
                            value={mode.value}
                            checked={mode.value === DEFAULT_MODE}
                          />
                          <span>{mode.label}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))
              }
              <div class="org-agent-rett">
                <div>
                  <strong>Sende til Skatteetaten</strong>
                  <span class="field-hint">
                    Kontrollen og innsendingen av mva-meldingen og skattemeldingen. En nøkkel som får
                    bokføre kan be om det, og det venter alltid på at du godkjenner det med din egen
                    ID-porten-innlogging.
                  </span>
                </div>
                <span class="org-agent-fast">Aldri selv</span>
              </div>
            </fieldset>
            <p class="card-hint" id="agent-bare-lese" hidden>
              Rollen din lar deg bare lese regnskapet, så nøkkelen kan bare lese.
            </p>

            <div class="org-knapperad org-form-knapper">
              <button class="btn btn-primary" type="submit" id="agent-lag">Lag nøkkelen</button>
              <button class="btn btn-ghost" type="button" data-agent-lukk>Avbryt</button>
            </div>
          </form>

          {/* Vises én gang. Bare et hash av nøkkelen lagres, så den kan ikke
              vises igjen, og det skal den heller ikke: den virker bare én gang
              uansett. */}
          <div id="agent-ny" hidden>
            <p class="card-hint">
              <strong>Kopier teksten og lim den inn i samtalen med agenten, eller gi den til
              programmet.</strong> Nøkkelen vises bare nå. Den virker én gang: agenten bytter den
              ut med en gang, og etter det kan ingen bruke kopien. Den må brukes innen et døgn.
            </p>
            <div class="org-kopirad">
              <textarea id="agent-lim" rows="3" readonly></textarea>
              <button class="btn btn-ghost" type="button" id="agent-kopier">Kopier</button>
            </div>
            <button class="btn btn-primary" type="button" data-agent-lukk>Ferdig</button>
          </div>
        </dialog>

        {/* «Selskapet er allerede registrert … Er du sikker?», før et selskap
            noen andre har bekreftet, blir bekreftet her også. */}
        <ClaimedDialog />
      </section>

      {/* --- Fra Enhetsregisteret --------------------------------------------

          Hentet i stedet for skrevet inn. Rollene står øverst, fordi det er dem
          folk kommer hit for å se; resten av registeropplysningene ligger bak
          en utvidelse, siden de sjelden er spørsmålet.

          Står nederst fordi det er oppslag, ikke noe man gjør noe med: det
          man kommer hit for å endre (selskapet, medlemmene) står over.

          Ingenting herfra lagres utover feltene i Selskapet: registeret endrer seg
          uten å si fra, og noe av det er andres personopplysninger som vi ikke
          har noe å gjøre med en gammel kopi av. */}
      <section id="register" hidden>
        <div class="org-section-head">
          <h2>Fra Enhetsregisteret</h2>
          <div class="org-section-tools">
            <span class="org-synk" id="register-synk"></span>
            <button type="button" class="btn btn-ghost btn-small" id="register-hent">
              Hent på nytt
            </button>
          </div>
        </div>

        <div class="card">
          <p class="status" id="register-status" hidden></p>

          <div id="register-roller" hidden>
            <h3>Roller</h3>
            <p class="card-hint">
              Slik de står registrert i dag. Én rad per person: den som både er daglig leder og
              sitter i styret står én gang, med begge rollene. Underenheter har ingen egne roller,
              så da er det hovedenhetens som vises.
            </p>
            {/* Hvorfor merket til høyre er formulert som det er.

                Registeret gir et navn og ingenting mer: ingen fødselsnummer,
                ingen fødselsdato (den kaster vi med vilje). Så koblingen mot
                medlemslisten er en navnesammenligning, og da må merket si hvor
                mye den sammenligningen er verdt. «Bekreftet» er et navn fra
                ID-porten, altså fra Folkeregisteret, som er registerets egen
                kilde. «Trolig» er navnet noen skrev inn selv. Forskjellen er
                hele grunnen til at det er verdt å koble ID-porten. */}
            <p class="card-hint">
              Merknaden sier om personen kan åpne regnskapet. Den gir ingen tilgang og tar ingen
              bort. Den sammenligner navn, og sier hvor sikkert det er.
            </p>
            <div class="table-scroll">
              <table class="data org-roller">
                <thead>
                  <tr>
                    <th>Navn</th>
                    <th>Roller</th>
                    <th>Merknad</th>
                  </tr>
                </thead>
                <tbody id="register-roller-rader"></tbody>
              </table>
            </div>
          </div>

          <p class="empty" id="register-tomt">Ingenting hentet fra registeret ennå.</p>

          <details class="org-mer" id="register-mer" hidden>
            <summary>Alt registeret har om selskapet</summary>
            <dl class="org-felt" id="register-felt"></dl>
          </details>
        </div>
      </section>

      {/* --- Del data med Myntos -------------------------------------------

          Ingenting er standard, for hvert selskap, og det er et valg for dem
          som har ansvaret for regnskapet: eiere og administratorer. Andre ser
          hva selskapet deler, men kan ikke endre det.

          Nesten nederst, rett over «Slett selskapet», og en nedtrekksliste i
          stedet for fire rader: det velges sjelden og skal ikke ta plass fra
          det folk kommer hit for å gjøre. Setningen under listen sier hva det
          valgte nivået deler, så ingen må åpne listen for å se det.

          Nivåene og hva de omfatter kommer fra lib/datasharing.ts, den samme
          listen /datadeling/ forklarer, så valget og forklaringen ikke kan si
          to forskjellige ting. Det øverste nivået er bilagene slik de er, ikke
          anonymisert. Derfor er det rødt, og derfor må man krysse av for at man
          forstår det før «Lagre» virker. Se docs/data-sharing.md. */}
      <section id="datadeling" hidden>
        <div class="org-section-head">
          <h2>Del data for å forbedre Myntos</h2>
          <div class="org-section-tools">
            <a class="btn btn-ghost btn-small" href="/datadeling/">Hva deles på hvert nivå?</a>
          </div>
        </div>

        <div class="card">
          <p class="card-hint" id="datadeling-na"></p>
          {/* «Takk :)» står over listen et øyeblikk når noen velger det røde
              nivået. Det er et takk for tilbudet, ikke en bekreftelse: ingenting
              er lagret før avkrysningen og «Lagre». */}
          <div class="org-datadeling-velg">
            <label class="field org-datadeling">
              <span>Hva selskapet deler</span>
              <select id="datadeling-valg" aria-describedby="datadeling-om">
                {
                  LEVELS.map((level) => (
                    <option value={level.value} data-fare={level.danger ? 'true' : undefined}>
                      {level.label}
                    </option>
                  ))
                }
              </select>
            </label>
            <span class="org-takk" id="datadeling-takk" role="status" hidden>Takk :)</span>
          </div>
          <p class="field-hint org-datadeling-om" id="datadeling-om"></p>

          <div class="org-datadeling-fare" id="datadeling-fare" hidden>
            <p>
              <strong>Bilagene deles slik de er, ikke anonymisert.</strong> De har ofte opplysninger
              om andre enn deg: kunder, leverandører og ansatte. Velg dette bare hvis selskapet kan
              stå inne for å dele dem med oss.
            </p>
            <label class="org-agent-check" id="datadeling-forstaar-rad">
              <input type="checkbox" id="datadeling-forstaar" />
              <span>Jeg forstår at bilagene deles slik de er, og vil dele dem.</span>
            </label>
          </div>

          <p class="card-hint" id="datadeling-les" hidden>
            Bare eiere og administratorer kan endre hva selskapet deler.
          </p>
          <div class="org-knapperad" id="datadeling-knapper" hidden>
            <button type="button" class="btn btn-primary" id="datadeling-lagre" disabled>
              Lagre
            </button>
          </div>
          <p class="status" id="datadeling-status" role="status" hidden></p>
        </div>
      </section>

      {/* --- Slett selskapet ---------------------------------------------

          Nederst på siden og rød, fordi det er det siste noen gjør med et
          regnskap. Knappen sletter ingenting: den fører til /slett-selskap/,
          der SAF-T-filene lastes ned først, det står hva som skjer med
          bilagene, og passordet kreves. Teksten her sier det viktigste før
          noen trykker, så ingen tror at et klikk tar regnskapet med en gang.
          Bare for eiere. */}
      <section id="slett-selskap" hidden>
        <h2>Slett selskapet</h2>
        <div class="card">
          <p>
            Er selskapet avviklet, eller fører dere regnskapet et annet sted nå, kan du slette det
            fra Myntos. Last ned SAF-T-filene først: de er selskapets egen kopi av regnskapet.
          </p>
          <p class="card-hint">
            Er noe ført i regnskapet, låses det i stedet for å slettes med en gang. Bokføringsloven
            krever at det oppbevares i fem år etter regnskapsåret, så ingen kan arbeide i det, men
            du kan åpne det igjen til det slettes for godt. Alle andre mister tilgangen med en gang.
          </p>
          <div class="org-knapperad">
            <a class="btn btn-fare" href="/slett-selskap/">Slett selskapet …</a>
          </div>
        </div>
      </section>

      {/* --- Ingen bøker ennå ---------------------------------------------

          Én lenke, ikke et skjema. Å sette opp et regnskap er en egen oppgave
          med tre spørsmål og en Altinn-innlogging i seg, og den lå her fordi
          det var her den ble født — mellom medlemslisten og de ventende
          invitasjonene, på en side som ellers handler om selskapet du allerede
          har. Nå har den sin egen side, og dette er bare veien dit for den ene
          som trenger den: en konto uten regnskap i det hele tatt. */}
      <section id="ingen-boker" hidden>
        <h2>Ingen regnskap ennå</h2>
        <div class="card">
          <p class="card-hint">
            Du fører ingen regnskap ennå. Å sette opp ett tar et minutt: vi henter selskapet
            fra Altinn eller Enhetsregisteret, så du slipper å skrive inn det som allerede står
            registrert. Hvert regnskap har sitt eget abonnement, så du betaler for det du
            faktisk fører.
          </p>
          <div class="org-knapperad">
            <a class="btn btn-primary" href="/nytt-selskap/">Sett opp regnskapet</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

{/* `is:global`, og alt under `.org`.

    Grunnen står øverst i filen: Astro merker elementene i malen med et
    attributt og avgrenser stilene til det, og et element laget med
    `createElement` får det aldri. Altinn-listen, rollene og medlemsradene
    bygges i JavaScript, så en vanlig `<style>` her ville truffet overskriftene
    og latt listene stå upyntet — som de sto. Prefikset `.org` gjør jobben
    avgrensningen skulle gjort. */}
<style is:global>
  /* --- Toppen ------------------------------------------------------------- */

  .org-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .org-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .org .eyebrow {
    margin-bottom: 0.4rem;
  }

  /* --- Seksjoner ----------------------------------------------------------
     Overskriften og det man kan gjøre med seksjonen står på samme linje, så
     «Endre» hører synlig til det den endrer. */

  .org-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin: 2.6rem 0 0.9rem;
  }
  .org-section-head h2 {
    margin: 0;
  }
  .org-section-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .org-synk {
    color: var(--faint);
    font-size: 0.85rem;
  }
  .org-kort-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.6rem;
  }
  .org-kort-head h3 {
    margin: 0;
  }

  /* --- Selskapet, som opplysning ------------------------------------------ */

  /* Bekreftet eller ikke, sagt med ett ord der navnet står. Gull og ikke rødt:
     ubekreftet er en oppgave som venter, ikke en feil som har skjedd. */
  .org-merke {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .org-merke[data-tone='vent'] {
    border-color: var(--gold);
    background: var(--gold-soft);
    color: var(--gold);
  }

  /* --- Opplysninger med blyant --------------------------------------------
     Siden er en side med fakta. En linje er et faktum og en blyant, og
     blyanten gjør om den ene linjen til et lite skjema — ikke hele kortet til
     et stort. Den som kom for å lese, leser. */

  .org-felt {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 0 1.5rem;
    margin: 1.4rem 0 0;
  }
  .org-felt dt,
  .org-felt dd {
    padding: 0.45rem 0;
    border-top: 1px solid var(--border);
  }
  /* Første linje trenger ingen strek over seg: kortkanten er der allerede. */
  .org-felt dt:first-of-type,
  .org-felt dt:first-of-type + dd {
    border-top: none;
  }
  .org-felt dt {
    color: var(--faint);
    font-size: 0.9rem;
  }
  .org-felt dd {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .org-felt dd > span:first-child {
    min-width: 0;
  }
  .org-felt [data-numerisk='true'] {
    font-family: var(--font-numeric);
  }
  /* Det som mangler og som noe annet står og venter på. */
  .org-felt [data-tone='vent'] {
    color: var(--gold);
  }
  .org-felt [data-tone='av'] {
    color: var(--muted);
  }
  /* Ett ord i stedet for blyanten, der verdien er avgjort. */
  .org-felt-merke {
    color: var(--faint);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Blyanten. Dempet til den trengs: den skal finnes, ikke rope. */
  .org-blyant {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    background: none;
    color: var(--faint);
    cursor: pointer;
    /* Dempet, ikke skjult. En blyant som først kommer fram når musen er over
       linjen, er en blyant man må finne ut at finnes. */
    opacity: 0.5;
    transition:
      opacity 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }
  .org-blyant svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .org-felt dd:hover .org-blyant,
  .org-blyant:hover,
  .org-blyant:focus-visible {
    opacity: 1;
    color: var(--accent);
  }
  .org-blyant:hover {
    border-color: var(--border);
  }

  /* --- Kontonumrene -------------------------------------------------------
     En liste og ikke en tabell: hver rad er ett tall, eventuelt et navn, og to
     ting man kan gjøre med det. Hovedkontoen står øverst og er merket, fordi
     det er den fakturaen betales til når den ikke sier noe annet. */

  .org-kontoer {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .org-kontoliste {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .org-kontoliste li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--border);
  }
  .org-kontoliste li:first-child {
    border-top: none;
  }
  .org-konto-rad {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }
  .org-konto-nummer {
    font-family: var(--font-numeric);
  }
  .org-konto-navn {
    color: var(--muted);
    font-size: 0.9rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Skyver knappene til høyre uten å gi raden en egen kolonne å holde tom. */
  .org-konto-handlinger {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .org-konto-tom {
    margin: 0;
    padding: 0.55rem 0;
    color: var(--gold);
  }

  /* Den ene linjen som står åpen. */
  .org-endre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.15rem 0;
  }
  .org-endre input,
  .org-endre select {
    flex: 1 1 10rem;
    min-width: 0;
    padding: 0.4rem 0.6rem;
    font-size: 0.95rem;
  }
  .org-endre-hjelp {
    flex: 1 0 100%;
    margin: 0.1rem 0 0.3rem;
  }

  @media (max-width: 40rem) {
    .org-felt {
      grid-template-columns: minmax(0, 1fr);
    }
    .org-felt dt {
      padding-bottom: 0;
    }
    .org-felt dt + dd {
      border-top: none;
      padding-top: 0.1rem;
    }
  }

  .org-eierskap {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .org-eierskap-tekst {
    margin: 0;
    max-width: 46rem;
    color: var(--muted);
    font-size: 0.93rem;
  }
  .org-eierskap-tekst[data-tone='ok'] {
    color: var(--faint);
  }
  .org-eierskap .status {
    margin: 0;
  }

  .org-knapperad {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* --- Skjemaene ----------------------------------------------------------
     To kolonner der det er plass, og alt som gjelder hele selskapet — de to
     avkrysningene og knappene — over hele bredden. */

  .org-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0 1.2rem;
    /* A measure, not the card's width. The card is 72rem across on a desktop,
       and a text field that wide is one nobody can see both ends of. */
    max-width: 38rem;
  }
  .org-form > .field {
    min-width: 0;
  }
  .org-form-tittel,
  .org-form .check,
  .org-form .org-par,
  .org-form-knapper {
    grid-column: 1 / -1;
  }
  .org-form-tittel {
    margin: 0 0 0.8rem;
  }
  .org-par {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(8rem, 1fr);
    gap: 0 1.2rem;
  }
  .org-form .check .field-hint {
    display: block;
    margin-top: 0.15rem;
  }
  .org-form-knapper {
    margin-top: 0.8rem;
  }
  @media (max-width: 34rem) {
    .org-par {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- KI-agenter og API-nøkler -------------------------------------------- */

  .org-agent-ingress {
    margin: 1rem 0 0.4rem;
    font-weight: 600;
  }
  .org-agent-punkter {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }
  .org-agent-punkter li + li {
    margin-top: 0.4rem;
  }
  .org-agent-check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 0.9rem;
  }
  .org-agent-check input {
    margin-top: 0.25rem;
    flex: none;
  }
  .org-agent-venter {
    margin: 0 0 0.8rem;
    font-weight: 600;
  }
  .org-agent-av {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  /* Vinduet. Bredt nok til at rettighetene står på én linje hver på en
     vanlig skjerm, og aldri bredere enn skjermen på en telefon. */
  .org-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    overflow-y: auto;
  }
  .org-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .org-dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .org-dialog-head h3 {
    margin: 0;
  }
  .org-dialog-lukk {
    flex: none;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .org-agent-skjema .field {
    display: block;
    margin-bottom: 1rem;
  }
  .org-agent-rettigheter {
    margin: 0 0 0.6rem;
    padding: 0;
    border: 0;
  }
  .org-agent-rettigheter legend {
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .org-agent-rett {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }
  .org-agent-rett > div:first-child {
    flex: 1 1 14rem;
  }
  .org-agent-rett .field-hint {
    display: block;
    margin-top: 0.1rem;
  }
  .org-agent-fast {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 0.1rem;
  }
  .org-agent-valg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .org-agent-valg label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .org-agent-valg label:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .org-agent-valg label:has(input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .org-dialog .org-kopirad {
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .org-dialog .org-kopirad textarea {
    flex: 1;
    min-width: 0;
    font-family: var(--font-numeric);
    font-size: 0.85rem;
    resize: vertical;
  }

  /* --- Registeret ---------------------------------------------------------- */

  .org-roller td {
    vertical-align: top;
  }
  .org-roller-navn {
    font-weight: 600;
  }
  .org-roller-orgnr {
    display: block;
    color: var(--faint);
    font-family: var(--font-numeric);
    font-size: 0.85rem;
  }
  /* Rollene som merkelapper, én per rolle. Én person står på én rad, og
     hvor mange hatter vedkommende har er da noe man ser i stedet for å lete
     etter navnet en gang til lenger ned. */
  .org-rollemerker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .org-rollemerker li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--fg);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  /* --- Merket: kan denne personen åpne regnskapet? --------------------------

     Fire tilstander, og forskjellen mellom dem er hvor sikre vi er, ikke hvor
     alvorlig det er. Derfor er ingen av dem rød: et styremedlem uten tilgang er
     helt normalt, ofte med vilje, og en rød prikk ville lest som en feil noen
     skulle rette.

     «Bekreftet» er fylt, «trolig» er den samme fargen i omriss. At sikkerheten
     leses som fyll og ikke som en annen farge er poenget: de sier det samme,
     med ulik tyngde. Ordene bærer det uansett, for den som ikke ser forskjell
     på to grønnfarger. */
  .org-tilgang {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .org-tilgang-bekreftet {
    background: var(--accent-soft);
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .org-tilgang-trolig {
    background: transparent;
    border-color: var(--accent-line);
    color: var(--muted);
  }
  .org-tilgang-invitert {
    background: var(--gold-soft);
    border-color: var(--gold);
    color: var(--gold);
  }
  .org-tilgang-ingen {
    background: var(--surface-2);
    border-color: var(--border);
    color: var(--faint);
    font-weight: 400;
  }
  /* Rollen står inne i merket, dempet: «Har tilgang Administrator» er ett
     utsagn, ikke to merkelapper som konkurrerer. */
  .org-tilgang-rolle {
    font-weight: 400;
    opacity: 0.8;
  }
  /* Navnet vi koblet mot, adressen invitasjonen gikk til, «Representant for de
     ansatte». Alt sammen under merket, i samme dempede form, fordi det er
     begrunnelse og ikke svar. */
  .org-tilgang-detalj {
    display: block;
    margin-top: 0.2rem;
    color: var(--faint);
    font-size: 0.82rem;
  }
  .org-tilgang-detalj + .btn-link,
  .org-tilgang + .btn-link {
    display: inline-block;
    margin-top: 0.3rem;
  }

  .org-mer {
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .org-mer > summary {
    cursor: pointer;
    color: var(--accent);
    font-size: 0.93rem;
    font-weight: 600;
  }
  .org-mer[open] > summary {
    margin-bottom: 0.4rem;
  }

  /* --- Altinn-listen -------------------------------------------------------
     Selve grunnen til at dette arket er globalt: hver rad her er laget i
     JavaScript. Navnet på én linje, nummeret og enhetstypen under, rollene
     dempet til slutt — i stedet for alt sammen i én midtstilt klump, som er
     det en knapp gjør når ingen har sagt noe annet. */

  .org-altinn {
    margin: 1.2rem 0;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .org-altinn h3 {
    margin: 0 0 0.3rem;
  }
  .org-altinn > .btn {
    margin-top: 0.9rem;
  }
  .org-parter {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    /* Nok til en håndfull uten å rulle, og en rullelist for regnskapsføreren
       med førti klienter i stedet for en side som aldri tar slutt. */
    max-height: 22rem;
    overflow-y: auto;
  }
  .org-part {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: var(--surface);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }
  .org-part:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--surface-2);
  }
  /* Navnet, nummeret og rollene under hverandre, og hver på sin linje: det er
     hele forskjellen fra listen som sto her før, der navnet og de ni sifrene
     var sveiset sammen til ett ord. */
  .org-part-tekst {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 0.1rem;
  }
  .org-part-navn {
    font-weight: 620;
    line-height: 1.3;
  }
  .org-part-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .org-part-orgnr {
    font-family: var(--font-numeric);
  }
  .org-part-roller {
    color: var(--faint);
    font-size: 0.8rem;
  }
  /* Statusen til høyre, der øyet leter etter den, og på egen linje når raden
     blir smal. */
  .org-part-tag {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 650;
    white-space: nowrap;
  }
  /* Allerede satt opp. Blir stående i listen i stedet for å bli filtrert bort:
     å se at en klient er der er svaret på «la jeg inn Bergen avdeling eller
     ikke?», og en liste som stilltiende kortet seg selv ned kunne ikke svart. */
  .org-part:disabled {
    cursor: default;
    background: var(--surface-2);
    color: var(--muted);
  }
  .org-part:disabled .org-part-navn {
    font-weight: 600;
  }
  /* Tatt av noen andre. Ikke deaktivert, slik «allerede satt opp» er: her er
     det noe å gjøre, det er bare ikke det man trodde. */
  .org-part[data-claimed='true'] .org-part-tag {
    border-color: var(--gold);
    background: var(--gold-soft);
    color: var(--gold);
  }
  @media (max-width: 34rem) {
    .org-part {
      flex-wrap: wrap;
      align-items: flex-start;
