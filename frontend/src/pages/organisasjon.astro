  /* --- Medlemmer ----------------------------------------------------------- */

  .org select.role {
    min-width: 10rem;
    padding-block: 0.35rem;
    font-size: 0.88rem;
  }
  .org-deg {
    margin-left: 0.35rem;
    color: var(--faint);
    font-weight: 400;
  }
  /* The action column, and only that one: the roles table's last column is a
     merknad, and pushing prose to the right edge would read as a number. */
  .org-medlemmer td:last-child {
    text-align: right;
  }

  #invite {
    margin-top: 1.4rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--border);
  }
  /* Hvem invitasjonen ble startet for, når den kom fra en rad i styret. Over
     hele skjemaet, fordi den svarer på spørsmålet skjemaet ellers stiller. */
  .org-invite-for {
    grid-column: 1 / -1;
    margin: 0 0 0.2rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-small);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  /* To handlinger i samme celle. De står med luft mellom seg fordi den ene
     sender en ny lenke og den andre gjør invitasjonen ugyldig, og de skal ikke
     kunne treffes i stedet for hverandre. */
  .org-invitasjoner td:last-child {
    text-align: right;
    white-space: nowrap;
  }
  .org-invitasjoner td:last-child .btn-link + .btn-link {
    margin-left: 0.9rem;
  }
  .org-lenke {
    grid-column: 1 / -1;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .org-kopirad {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .org-kopirad input {
    font-family: var(--font-numeric);
    font-size: 0.85rem;
  }

  /* --- Varselet øverst ------------------------------------------------------ */

  .org .varsel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--gold-soft);
    border: 1px solid var(--gold);
    border-left-width: 3px;
    border-radius: var(--radius-small);
  }
  .org .varsel-tittel {
    margin: 0 0 0.3rem;
    font-weight: 650;
    color: var(--fg-strong);
  }
  .org .varsel-tekst {
    margin: 0;
    max-width: 46rem;
    color: var(--fg);
  }
  .org .varsel .status {
    margin: 0.6rem 0 0;
  }
  .org .varsel-knapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .org .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* --- Del data med Myntos ----------------------------------------------------
     En nedtrekksliste, laveste nivå først. Det øverste er rødt i listen der
     nettleseren lar oss farge et valg, og hele feltet blir rødt når det er
     valgt, sammen med setningen under: det er det eneste nivået som ikke er
     anonymisert, og det skal ikke gå an å velge det uten å ha sett det. */
  .org-datadeling-velg {
    position: relative;
    max-width: 24rem;
  }
  .org-datadeling {
    margin-bottom: 0;
  }
  /* Valgene arver ellers feltets farge, så alle ville blitt røde i listen så
     snart det røde er valgt. */
  .org-datadeling option {
    color: var(--fg);
    background: var(--surface);
  }
  .org-datadeling option[data-fare] {
    color: var(--danger);
  }
  .org-datadeling select[data-fare] {
    color: var(--danger);
    border-color: var(--danger-line);
    background: var(--danger-bg);
  }
  .org-datadeling-om {
    margin: 0.4rem 0 0.9rem;
  }
  .org-datadeling-om[data-fare] {
    color: var(--danger);
  }
  /* Et lite takk over høyre ende av listen, et øyeblikk. Skriptet skjuler det
     igjen; animasjonen er bare pynt, så den slås helt av for den som har bedt
     om lite bevegelse, i stedet for å bli et blink av den globale regelen. */
  .org-takk {
    position: absolute;
    top: -0.3rem;
    right: 0;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    pointer-events: none;
  }
  .org-takk.org-takk-vis {
    animation: org-takk 1.4s ease forwards;
  }
  @keyframes org-takk {
    0% {
      opacity: 0;
      transform: translateY(4px) scale(0.9);
    }
    15%,
    75% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .org-takk.org-takk-vis {
      animation: none !important;
    }
  }
  .org-datadeling-fare {
    margin: 0 0 0.9rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--danger-line);
    border-radius: var(--radius-small);
    background: var(--danger-bg);
    color: var(--danger);
  }
  .org-datadeling-fare p {
    margin: 0 0 0.7rem;
  }
  .org-datadeling-fare .org-agent-check {
    margin: 0;
    color: var(--fg);
  }
</style>
<script>
  import { CALLBACK_ERRORS } from '../lib/providers';
  import {
    ApiError,
    ORGNR_LOCKED,
    addBankAccount,
    changeMemberRole,
    deleteBankAccount,
    getGovernmentLoginStatus,
    governmentLoginStartUrl,
    inviteMember,
    listInvitations,
    getCompanyRegister,
    createAgentKey,
    listAgentKeys,
    listApprovals,
    listMembers,
    setAgentAccess,
    setDataSharing,
    stopAgentKey,
    refreshCompany,
    removeMember,
    resendInvitation,
    revokeInvitation,
    updateBankAccount,
    updateCompany,
    type AgentKey,
    type BankAccount,
    type Company,
    type DataSharingLevel,
    type GovernmentLoginStatus,
    type Invitation,
    type Member,
    type Membership,
    type RegisterAccess,
    type RegisterAnswer,
    type RegisteredRoleWithAccess,
  } from '../lib/api';
  import {
    DEFAULT_MODE,
    MODES,
    isLive,
    pasteText,
    rightsLabel,
    scopesFor,
    settleModes,
    stateLabel,
    type Mode,
  } from '../lib/agentkeys';
  import { isWaiting } from '../lib/approvals';
  import { currentText as sharingText, levelOf } from '../lib/datasharing';
  import { currentCompany, loadCompanies, mountChromeCompanyMenu } from '../lib/company';
  import { clearStatus, el, setStatus, show } from '../lib/dom';
  import { isoDate, kontonummer, kroner, orgnummer } from '../lib/format';
  import { confirmOwnership } from '../lib/ownership';
  import { canInCompany, loadSession, redirectToLogin, setActiveCompany } from '../lib/session';

  /**
   * Whether this deployment offers the ID-porten login, and whether the caller
   * has one right now.
   *
   * Fetched once and shared: both the Altinn list and the ownership block under
   * Selskapet branch on the same answer, and asking twice could produce two
   * different ones within a second of each other.
   */
  let governmentStatus: Promise<GovernmentLoginStatus> | null = null;

  function loadGovernmentStatus(force = false): Promise<GovernmentLoginStatus> {
    if (governmentStatus === null || force) governmentStatus = getGovernmentLoginStatus();
    return governmentStatus;
  }

  const ROLES: [string, string][] = [
    ['viewer', 'Leser'],
    ['member', 'Medlem'],
    ['admin', 'Administrator'],
    ['owner', 'Eier'],
  ];

  const pageStatus = el<HTMLParagraphElement>('#page-status');
  const inviteStatus = el<HTMLParagraphElement>('#invite-status');
  // Here was a <select> for switching account. Gone with the account itself:
  // see the note where showOrganization used to be, further down.
  const memberBody = el<HTMLTableSectionElement>('#members');
  const invitationBody = el<HTMLTableSectionElement>('#invitations');

  /**
   * The caller's standing on the *account*, which this page barely needs.
   *
   * One thing only: whether they may set up a company at all, for the empty
   * state below. Everything else on this page is about a set of books, and what
   * a person may do with those comes from the company itself
   * (`canInCompany`), because access is a row per person per company.
   */
  let konto: Membership | undefined;
  /**
   * Every company the caller can reach, across all their organizations. Fetched
   * once: the picker below filters by organization rather than refetching, so
   * switching back and forth costs nothing.
   */
  let companies: Company[] = [];
  /** The company the page is showing, or null when there is none. */
  let selskap: Company | null = null;
  /** The register's answer for that company: stored, or freshly fetched. */
  let register: RegisterAnswer | null = null;

  /**
   * What the caller may do with the books on screen. Asked, never remembered.
   *
   * These were two booleans, assigned once and only after the first draw, which
   * is one step too late. showSelskap() paints the account list, the register
   * button and the pencils on every field, and all of them ask, so an ordinary
   * visit opened on the read-only page: no «Legg til konto» for an owner, and
   * an empty account list telling them they could not add one. It stayed that
   * way until a rename or a register fetch happened to draw the card a second
   * time, which is why it looked like a permissions problem rather than an
   * ordering one.
   *
   * Functions for the same reason `bokene()` is one. `selskap` moves when the
   * company is switched, renamed or confirmed, and a permission copied out
   * before that is a permission for a different set of books.
   */
  const mayManage = (): boolean => canInCompany(selskap, 'member:manage');
  const mayAdmin = (): boolean => canInCompany(selskap, 'organization:manage');

  const digitsOf = (value: string): string => value.replace(/[^0-9]+/g, '');

  /**
   * The confirmation the browser left this page in the middle of.
   *
   * Confirming ownership takes two steps that are separated by leaving the
   * site: log in with ID-porten, then ask Altinn. Nothing carried the second
   * step across the round trip, so pressing «Bekreft selskapet» sent people
   * through BankID and returned them to a page that had quietly forgotten why
   * they went — logged in, still unconfirmed, and still showing the same
   * warning. The banner was not lying; the confirmation had never run.
   *
   * `sessionStorage`, not the URL: it belongs to this tab and this errand, and
   * a marker on the address bar would replay the confirmation on every reload
   * and travel in any link somebody copied.
   */
  const RESUME_KEY = 'myntos.bekreft-selskap';

  function rememberConfirm(companyId: number): void {
    try {
      window.sessionStorage.setItem(RESUME_KEY, String(companyId));
    } catch {
      // Private-mode Safari throws on access. The button still works; it just
      // takes the second press it always took.
    }
  }

  /** Read the pending confirmation and clear it, so it is attempted once. */
  function takeConfirm(): number | null {
    try {
      const raw = window.sessionStorage.getItem(RESUME_KEY);
      window.sessionStorage.removeItem(RESUME_KEY);
      return raw === null ? null : Number(raw);
    } catch {
      return null;
    }
  }

  function cell(value: string): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = value;
    return td;
  }

  function roleLabel(role: string): string {
    return ROLES.find(([value]) => value === role)?.[1] ?? role;
  }

  function report(error: unknown, fallback: string): void {
    setStatus(pageStatus, error instanceof ApiError ? error.message : fallback);
  }

  /** One `<dt>/<dd>` pair, skipped entirely when there is nothing to say. */
  function field(
    list: HTMLElement,
    label: string,
    value: string | null,
    options: { tone?: 'vent' | 'av'; numeric?: boolean } = {},
  ): void {
    if (value === null || value === '') return;
    const term = document.createElement('dt');
    term.textContent = label;
    const detail = document.createElement('dd');
    detail.textContent = value;
    if (options.tone !== undefined) detail.dataset.tone = options.tone;
    if (options.numeric === true) detail.dataset.numerisk = 'true';
    list.append(term, detail);
  }

  /**
   * Say what happened when ID-porten sent the browser back here having failed.
   *
   * The government login leaves the site entirely, so the only thing that
   * survives the round trip is a marker on the query string. Until this
   * existed the backend put that marker on `/skatt/?error=`, a route that does
   * not exist, so every failure ended on a 404 and the person was left with a
   * button that had visibly done nothing.
   *
   * The marker is dropped from the address afterwards: it describes one trip
   * back from BankID, and leaving it in place would replay the message on
   * every reload and on any link somebody copied out of the address bar.
   */
  function reportCallbackError(): void {
    const marker = new URLSearchParams(window.location.search).get('error');
    if (marker === null) return;
    setStatus(pageStatus, CALLBACK_ERRORS[marker] ?? 'Innloggingen feilet. Prøv en gang til.');

    const url = new URL(window.location.href);
    url.searchParams.delete('error');
    window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  }

  // --- Selskapet ---------------------------------------------------------------
  //
  // The company's own details: shown as details, and edited behind a button.
  // Two of them decide what an invoice is allowed to say (see § 5-1-2), and one
  // of them, kontonummeret, decides whether an invoice can be issued at all: a
  // document with nowhere to pay it is refused by the backend, because an
  // issued invoice can only be corrected with a kreditnota.

  const selskapStatus = el<HTMLParagraphElement>('#selskap-status');

  /**
   * The row that is currently open for editing, or null.
   *
   * One at a time, and by key rather than by element: the list is rebuilt from
   * scratch on every draw, so a held element would be an orphan a moment later.
   */
  let redigerer: string | null = null;

  /** A pencil, 14px, in the current text colour. */
  function pencil(): SVGSVGElement {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '1.9');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z');
    svg.append(path);
    return svg;
  }

  /**
   * One line of an information list, and how to change it.
   *
   * The page is a page of facts. A field is a fact plus a pencil, and pressing
   * the pencil turns that one line into a small form — not the whole card into
   * a large one. Somebody who came to read reads; somebody who came to correct
   * the kontonummer corrects the kontonummer.
   *
   * `rediger` absent means the register owns the value and we only show it.
   */
  interface Felt {
    nokkel: string;
    navn: string;
    /** Empty string means the row is left out entirely. */
    vis: string;
    tone?: 'vent' | 'av';
    numerisk?: boolean;
    /** A word in place of the pencil, for a value that is settled. */
    merke?: string;
    /** Builds the inputs, and reads them back into a save. */
    rediger?: {
      felter: (
        | { navn: string; verdi: string; bredde?: string; plassholder?: string }
      )[];
      valg?: { verdi: string; etikett: string }[];
      hjelp?: string;
      lagre: (verdier: string[]) => Promise<void>;
    };
  }

  /** Draw a list of facts into a `<dl>`, with the open row as a form. */
  function tegnFelt(list: HTMLDListElement, felter: Felt[], status: HTMLElement): void {
    list.replaceChildren();
    for (const felt of felter) {
      if (felt.vis === '' && felt.rediger === undefined) continue;
      const term = document.createElement('dt');
      term.textContent = felt.navn;
      const detail = document.createElement('dd');

      if (redigerer === felt.nokkel && felt.rediger !== undefined) {
        detail.append(redigeringsform(felt.rediger, list, felter, status));
      } else {
        const value = document.createElement('span');
        if (felt.tone !== undefined) value.dataset.tone = felt.tone;
        if (felt.numerisk === true) value.dataset.numerisk = 'true';
        value.textContent = felt.vis;
        detail.append(value);
        if (felt.merke !== undefined) {
          const merke = document.createElement('span');
          merke.className = 'org-felt-merke';
          merke.textContent = felt.merke;
          detail.append(merke);
        } else if (felt.rediger !== undefined) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'org-blyant';
          button.title = `Endre ${felt.navn.toLowerCase()}`;
          button.setAttribute('aria-label', button.title);
          button.append(pencil());
          button.addEventListener('click', () => {
            redigerer = felt.nokkel;
            setStatus(status, '');
            tegnFelt(list, felter, status);
            list.querySelector<HTMLElement>('.org-endre input, .org-endre select')?.focus();
          });
          detail.append(button);
        }
      }
      list.append(term, detail);
    }
  }

  /** The one row that is open: inputs, Lagre, Avbryt. */
  function redigeringsform(
    rediger: NonNullable<Felt['rediger']>,
    list: HTMLDListElement,
    felter: Felt[],
    status: HTMLElement,
  ): HTMLFormElement {
    const form = document.createElement('form');
    form.className = 'org-endre';

    const controls: (HTMLInputElement | HTMLSelectElement)[] = [];
    if (rediger.valg !== undefined) {
      const select = document.createElement('select');
      for (const option of rediger.valg) {
        const node = document.createElement('option');
        node.value = option.verdi;
        node.textContent = option.etikett;
        node.selected = option.verdi === rediger.felter[0]?.verdi;
        select.append(node);
      }
      controls.push(select);
      form.append(select);
    } else {
      for (const spec of rediger.felter) {
        const input = document.createElement('input');
        input.type = 'text';
        input.value = spec.verdi;
        input.autocomplete = 'off';
        input.setAttribute('aria-label', spec.navn);
        if (spec.plassholder !== undefined) input.placeholder = spec.plassholder;
        if (spec.bredde !== undefined) input.style.flex = spec.bredde;
        controls.push(input);
        form.append(input);
      }
    }

    const save = document.createElement('button');
    save.type = 'submit';
    save.className = 'btn btn-primary btn-small';
    save.textContent = 'Lagre';
    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'btn btn-ghost btn-small';
    cancel.textContent = 'Avbryt';
    cancel.addEventListener('click', () => {
      redigerer = null;
      setStatus(status, '');
      tegnFelt(list, felter, status);
    });
    form.append(save, cancel);

    if (rediger.hjelp !== undefined) {
      const help = document.createElement('p');
      help.className = 'field-hint org-endre-hjelp';
      help.textContent = rediger.hjelp;
      form.append(help);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      save.disabled = true;
      setStatus(status, '');
      void rediger
        .lagre(controls.map((control) => control.value.trim()))
        .then(() => {
          redigerer = null;
        })
        .catch((error: unknown) => {
          setStatus(status, error instanceof ApiError ? error.message : 'Ble ikke lagret.');
        })
        .finally(() => {
          save.disabled = false;
        });
    });
    return form;
  }

  /** Save a change to the company, and redraw everything that shows it. */
  async function lagreSelskap(
    company: Company,
    payload: Parameters<typeof updateCompany>[1],
  ): Promise<void> {
    const saved = await updateCompany(company.id, payload);
    const moved = saved.orgnr !== company.orgnr;
    companies = companies.map((item) => (item.id === saved.id ? saved : item));
    selskap = saved;
    redigerer = null;
    showSelskap();
    setStatus(selskapStatus, 'Lagret.', 'ok');
    if (moved) {
      // A different orgnr is a different company as far as the register is
      // concerned, and what is on screen belongs to the old one.
      register = null;
      showRegister();
      await loadStoredRegister(saved);
    }
  }

  /** What the Selskapet card says, line by line. */
  function selskapFelter(company: Company): Felt[] {
    const may = mayAdmin();
    const felter: Felt[] = [
      {
        nokkel: 'name',
        navn: 'Navn',
        vis: company.name,
        rediger: may
          ? {
              felter: [{ navn: 'Navn', verdi: company.name }],
              hjelp: 'Slik navnet står i Enhetsregisteret.',
              lagre: ([name]) => lagreSelskap(company, { name: name ?? '' }),
            }
          : undefined,
      },
      {
        nokkel: 'orgnr',
        navn: 'Organisasjonsnummer',
        vis: orgnummer(company.orgnr),
        numerisk: true,
        // Settled once somebody has confirmed it in Altinn: the confirmation is
        // about that number, and a different number is a different company.
        merke: company.verified ? 'Bekreftet' : undefined,
        rediger:
          may && !company.verified
            ? {
                felter: [{ navn: 'Organisasjonsnummer', verdi: orgnummer(company.orgnr) }],
                lagre: async ([orgnr]) => {
                  const digits = digitsOf(orgnr ?? '');
                  if (digits.length !== 9) {
                    throw new Error('Organisasjonsnummeret må være ni siffer.');
                  }
                  try {
                    await lagreSelskap(company, { orgnr: digits });
                  } catch (error: unknown) {
                    // Somebody confirmed the company in another tab while this
                    // row stood open. Redrawing takes the pencil away, so the
                    // next attempt is not the same refusal again.
                    if (error instanceof ApiError && error.code === ORGNR_LOCKED) {
                      companies = await loadCompanies(true);
                      redigerer = null;
                      showSelskap();
                    }
                    throw error;
                  }
                },
              }
            : undefined,
      },
      {
        nokkel: 'adresse',
        navn: 'Adresse',
        vis:
          [company.address_line, [company.postal_code, company.city].filter(Boolean).join(' ')]
            .filter((part) => part !== null && part !== '')
            .join(', ') || 'Ikke oppgitt',
        tone: company.address_line === null ? 'av' : undefined,
        rediger: may
          ? {
              felter: [
                { navn: 'Adresse', verdi: company.address_line ?? '', bredde: '3 1 9rem' },
                { navn: 'Postnummer', verdi: company.postal_code ?? '', bredde: '0 0 5rem' },
                { navn: 'Sted', verdi: company.city ?? '', bredde: '2 1 6rem' },
              ],
              hjelp:
                'Hentes fra Enhetsregisteret. Står på fakturaen fordi bokføringsforskriften ' +
                '§ 5-1-2 krever hovedkontorets adresse fra selskaper i Foretaksregisteret.',
              lagre: ([line, postal, city]) =>
                lagreSelskap(company, {
                  address_line: line ?? '',
                  postal_code: postal ?? '',
                  city: city ?? '',
                }),
            }
          : undefined,
      },
      {
        nokkel: 'vat_registered',
        navn: 'Merverdiavgift',
        vis: company.vat_registered ? 'Registrert' : 'Ikke registrert',
        tone: company.vat_registered ? undefined : 'av',
        rediger: may
          ? {
              felter: [{ navn: 'Merverdiavgift', verdi: String(company.vat_registered) }],
              valg: [
                { verdi: 'true', etikett: 'Registrert i Merverdiavgiftsregisteret' },
                { verdi: 'false', etikett: 'Ikke registrert' },
              ],
              hjelp:
                'Uten dette kan fakturaene ikke vise merverdiavgift. Å kreve inn mva uten å ' +
                'være registrert er å kreve inn en avgift på statens vegne uten å ha rett til ' +
                'det, og pengene skyldes likevel.',
              lagre: ([value]) => lagreSelskap(company, { vat_registered: value === 'true' }),
            }
          : undefined,
      },
      // Registreringen gjelder fra en dato. Et kjøp før den datoen gir ikke
      // fradrag, uansett når det føres inn, og føringene får mva-kode 0 til da.
      // Tomt betyr «for så langt tilbake regnskapet går». Endrer bare nye
      // føringer: det som er bokført, står som det ble bokført.
      {
        nokkel: 'vat_registered_from',
        navn: 'Registrert fra',
        vis: !company.vat_registered
          ? ''
          : company.vat_registered_from !== null
            ? isoDate(company.vat_registered_from)
            : 'Fra regnskapets start',
        rediger:
          may && company.vat_registered
            ? {
                felter: [
                  {
                    navn: 'Registrert fra',
                    verdi: company.vat_registered_from ?? '',
                    plassholder: 'ÅÅÅÅ-MM-DD',
                  },
                ],
                hjelp:
                  'Datoen registreringen i Merverdiavgiftsregisteret gjelder fra. Kjøp før den gir ' +
                  'ikke fradrag. La feltet stå tomt hvis selskapet var registrert da regnskapet startet.',
                lagre: ([value]) =>
                  lagreSelskap(company, {
                    vat_registered_from: (value ?? '') === '' ? null : (value ?? null),
                  }),
              }
            : undefined,
      },
      {
        nokkel: 'in_foretaksregisteret',
        navn: 'Foretaksregisteret',
        vis: company.in_foretaksregisteret ? 'Registrert' : 'Ikke registrert',
        tone: company.in_foretaksregisteret ? undefined : 'av',
        rediger: may
          ? {
              felter: [
                { navn: 'Foretaksregisteret', verdi: String(company.in_foretaksregisteret) },
              ],
              valg: [
                { verdi: 'true', etikett: 'Registrert i Foretaksregisteret' },
                { verdi: 'false', etikett: 'Ikke registrert' },
              ],
              hjelp:
                'Da skal ordet «Foretaksregisteret» og hovedkontorets adresse stå på hvert ' +
                'salgsdokument. Alle AS, ASA og NUF er registrert der.',
              lagre: ([value]) =>
                lagreSelskap(company, { in_foretaksregisteret: value === 'true' }),
            }
          : undefined,
      },
      // Abonnementet og rollen sto tidligere på et kort for kontoen, sammen
      // med et kontonavn som så ut som et selskapsnavn. Begge hører hjemme
      // her: et regnskap er det som har en størrelse og en pris, og rollen din
      // er noe du har over disse bøkene og ikke over kontoen. Ingen blyant på
      // noen av dem — det finnes ingenting å selge ennå, og rollen din er det
      // ikke du som setter.
      { nokkel: 'plan', navn: 'Abonnement', vis: company.plan },
      { nokkel: 'rolle', navn: 'Din rolle', vis: roleLabel(company.role) },
    ];

    // What the register owns. Shown, never edited here: a refresh would
    // overwrite anything typed, so a pencil would be a promise we do not keep.
    const fraRegisteret: [string, string | null][] = [
      ['Organisasjonsform', company.organisation_form],
      [
        'Næring',
        company.industry_code === null
          ? null
          : `${company.industry_code} ${company.industry_description ?? ''}`.trim(),
      ],
      ['Nettsted', company.website],
      ['Telefon', company.phone],
      ['E-post', company.email],
      ['Underenhet av', company.parent_orgnr === null ? null : orgnummer(company.parent_orgnr)],
    ];
    for (const [navn, verdi] of fraRegisteret) {
      if (verdi === null || verdi === '') continue;
      felter.push({ nokkel: navn, navn, vis: verdi });
    }
    return felter;
  }

  // --- Kontonumrene ------------------------------------------------------------
  //
  // The one collection on a page of facts, and it is a collection because a
  // company is paid into as many accounts as its bank gave it: a driftskonto to
  // invoice against, a skattetrekkskonto that skattebetalingsloven § 5-12
  // requires be kept apart. The marked one is where an invoice goes when it
  // says nothing else, and /faktura/ is where it says something else.

  const kontoStatus = el<HTMLParagraphElement>('#konto-status');

  /**
   * The account row open for editing, `'ny'` for the add form, or null.
   *
   * By id rather than by element, for the same reason `redigerer` is by key:
   * the list is rebuilt from scratch on every draw, so a held element would be
   * an orphan a moment later.
   */
  let redigererKonto: number | 'ny' | null = null;

  /** Adopt a company the account endpoints answered with, and redraw. */
  function kontoLagret(saved: Company, melding: string): void {
    companies = companies.map((item) => (item.id === saved.id ? saved : item));
    selskap = saved;
    redigererKonto = null;
    showSelskap();
    setStatus(kontoStatus, melding, 'ok');
  }

  /** A small button in an account row. */
  function kontoKnapp(tekst: string, handling: () => Promise<void>): HTMLButtonElement {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn btn-ghost btn-small';
    button.textContent = tekst;
    button.addEventListener('click', () => {
      button.disabled = true;
      setStatus(kontoStatus, '');
      void handling()
        .catch((error: unknown) => {
          setStatus(kontoStatus, error instanceof ApiError ? error.message : 'Ble ikke lagret.');
        })
        .finally(() => {
          button.disabled = false;
        });
    });
    return button;
  }

  /**
   * The number and the name, as a form. `konto` null means a new account.
   *
   * The account number is asked for grouped the way people read it; the backend
   * strips the separators and checks the mod-11 digit, which is the check that
   * matters — a transposed pair is discovered by a customer whose payment
   * bounced, weeks later, and an issued invoice cannot be corrected.
   */
  function kontoSkjema(company: Company, konto: BankAccount | null): HTMLFormElement {
    const form = document.createElement('form');
    form.className = 'org-endre';

    const nummer = document.createElement('input');
    nummer.type = 'text';
    nummer.autocomplete = 'off';
    nummer.placeholder = '1506.20.33158';
    nummer.setAttribute('aria-label', 'Kontonummer');
    nummer.value = konto === null ? '' : kontonummer(konto.account);
    nummer.style.flex = '2 1 9rem';

    const navn = document.createElement('input');
    navn.type = 'text';
    navn.autocomplete = 'off';
    navn.placeholder = 'Navn, for eksempel Drift';
    navn.setAttribute('aria-label', 'Navn på kontoen');
    navn.value = konto?.label ?? '';
    navn.style.flex = '1 1 7rem';

    const lagre = document.createElement('button');
    lagre.type = 'submit';
    lagre.className = 'btn btn-primary btn-small';
    lagre.textContent = konto === null ? 'Legg til' : 'Lagre';

    const avbryt = document.createElement('button');
    avbryt.type = 'button';
    avbryt.className = 'btn btn-ghost btn-small';
    avbryt.textContent = 'Avbryt';
    avbryt.addEventListener('click', () => {
      redigererKonto = null;
      setStatus(kontoStatus, '');
      showKontoer(company);
    });

    const hjelp = document.createElement('p');
    hjelp.className = 'field-hint org-endre-hjelp';
    hjelp.textContent =
      'Elleve siffer. Kontrollsifferet kontrolleres når du lagrer. Navnet er valgfritt og ' +
      'står ikke på fakturaen. Det er der for å skille kontoene fra hverandre.';

    form.append(nummer, navn, lagre, avbryt, hjelp);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      lagre.disabled = true;
      setStatus(kontoStatus, '');
      const payload = { account: nummer.value.trim(), label: navn.value.trim() };
      const request =
        konto === null
          ? addBankAccount(company.id, payload)
          : updateBankAccount(company.id, konto.id, payload);
      void request
        .then((saved) => {
          kontoLagret(saved, konto === null ? 'Kontoen er lagt til.' : 'Lagret.');
        })
        .catch((error: unknown) => {
          setStatus(kontoStatus, error instanceof ApiError ? error.message : 'Ble ikke lagret.');
        })
        .finally(() => {
          lagre.disabled = false;
        });
    });
    return form;
  }

  /** One account as a line: the number, what it is called, and what it is for. */
  function kontoRad(company: Company, konto: BankAccount): HTMLDivElement {
    const rad = document.createElement('div');
    rad.className = 'org-konto-rad';

    const nummer = document.createElement('span');
    nummer.className = 'org-konto-nummer';
    nummer.textContent = kontonummer(konto.account);
    rad.append(nummer);

    if (konto.label !== null) {
      const navn = document.createElement('span');
      navn.className = 'org-konto-navn';
      navn.textContent = konto.label;
      rad.append(navn);
    }
    if (konto.is_primary) {
      // Merket og ikke bare øverst. Rekkefølgen er et hint; ordet er svaret på
      // hvor fakturaen betales når den ikke sier noe annet.
      const merke = document.createElement('span');
      merke.className = 'org-felt-merke';
      merke.textContent = 'Hovedkonto';
      rad.append(merke);
    }
    if (!mayAdmin()) return rad;

    const handlinger = document.createElement('div');
    handlinger.className = 'org-konto-handlinger';
    if (!konto.is_primary) {
      handlinger.append(
        kontoKnapp('Gjør til hovedkonto', async () => {
          kontoLagret(
            await updateBankAccount(company.id, konto.id, { is_primary: true }),
            `${kontonummer(konto.account)} er nå hovedkonto.`,
          );
        }),
      );
    }
    handlinger.append(
      kontoKnapp('Fjern', async () => {
        // Confirm og ikke et eget steg: en fjernet konto kan legges inn igjen,
        // og utstedte fakturaer beholder nummeret de ble utstedt med — det
        // står på dokumentet, ikke i denne listen.
        const svar = window.confirm(
          `Fjerne ${kontonummer(konto.account)}? Fakturaer som alt er utstedt beholder ` +
            'nummeret sitt.',
        );
        if (!svar) return;
        kontoLagret(await deleteBankAccount(company.id, konto.id), 'Kontoen er fjernet.');
      }),
    );

    const blyant = document.createElement('button');
    blyant.type = 'button';
    blyant.className = 'org-blyant';
    blyant.title = 'Endre kontonummeret';
    blyant.setAttribute('aria-label', blyant.title);
    blyant.append(pencil());
    blyant.addEventListener('click', () => {
      redigererKonto = konto.id;
      setStatus(kontoStatus, '');
      showKontoer(company);
      el<HTMLInputElement>('.org-endre input', el('#konto-liste')).focus();
    });
    handlinger.append(blyant);

    rad.append(handlinger);
    return rad;
  }

  /** The whole list, with at most one row open. */
  function showKontoer(company: Company): void {
    show(el('#konto-ny'), mayAdmin() && redigererKonto !== 'ny');
    const liste = el<HTMLUListElement>('#konto-liste');
    liste.replaceChildren();

    for (const konto of company.bank_accounts) {
      const rad = document.createElement('li');
      rad.append(
        redigererKonto === konto.id ? kontoSkjema(company, konto) : kontoRad(company, konto),
      );
      liste.append(rad);
    }
    if (redigererKonto === 'ny') {
      const ny = document.createElement('li');
      ny.append(kontoSkjema(company, null));
      liste.append(ny);
    } else if (company.bank_accounts.length === 0) {
      // Tomheten er en opplysning og ikke et manglende felt: uten en konto kan
      // ingen faktura utstedes i det hele tatt, og /faktura/ lenker hit for
      // nettopp dette.
      //
      // Og den bærer veien videre selv. «Legg til konto» står oppe ved
      // overskriften, og det er en annen linje enn den man leser: den som kom
      // hit fra /faktura/ fikk vite at ingen faktura kan utstedes, uten noe å
      // trykke på i samme blikk, og lette etter knappen et helt kort unna.
      // Setningen om at det ikke går er ikke et svar på hvor det gjøres.
      //
      // Den som ikke får legge inn noe får vite hvem som får. Å bare si «du kan
      // ikke» er å låse døra uten å si hvem som har nøkkelen, og det er samme
      // svar som eierskapsavsnittet gir lenger nede.
      const tom = document.createElement('li');
      tom.className = 'org-konto-tom';
      tom.textContent = 'Ingen konto lagt inn. Ingen faktura kan utstedes uten. ';
      if (mayAdmin()) {
        const legg = document.createElement('button');
        legg.type = 'button';
        legg.className = 'btn-link';
        legg.textContent = 'Legg inn kontonummer';
        legg.addEventListener('click', nyKonto);
        tom.append(legg);
      } else {
        tom.append('Be en administrator for dette regnskapet om å legge inn en.');
      }
      liste.append(tom);
    }
  }

  /** Open the add form, and put the cursor in it. */
  function nyKonto(): void {
    redigererKonto = 'ny';
    setStatus(kontoStatus, '');
    if (selskap !== null) showKontoer(selskap);
    el<HTMLInputElement>('.org-endre input', el('#konto-liste')).focus();
  }

  el('#konto-ny').addEventListener('click', nyKonto);

  /** Every fact about the company, and whether anyone has confirmed it. */
  function showSelskapDetaljer(company: Company): void {
    const merke = el<HTMLSpanElement>('#selskap-merke');
    show(merke, true);
    merke.dataset.tone = company.verified ? 'ok' : 'vent';
    merke.textContent = company.verified ? 'Bekreftet' : 'Ubekreftet';

    tegnFelt(el<HTMLDListElement>('#selskap-felt'), selskapFelter(company), selskapStatus);
    showKontoer(company);
    show(el('#slett-selskap'), canInCompany(company, 'organization:delete'));
  }

  /**
   * What the page is called: the company, and a label above it.
   *
   * The label is a *word*, never the organisation's name, and that is the whole
   * point. An organisation adopts the name of the first company set up under it
   * (`adopt_name_if_placeholder`), so an account is routinely called after one
   * of its companies. Printed above a different company it read as that
   * company's name having crossed over — the one thing this page must never
   * look like, whether or not any data actually moved.
   *
   * Which organisation you are in is answered by the picker in this header when
   * The company, and nothing above it: there is no account on this page.
   */
  /**
   * The books every member and invitation call on this page is about.
   *
   * A function rather than a captured value, and it throws rather than
   * returning null: every one of those calls is behind a control that is hidden
   * when there is no company, so reaching one without books is a bug, and a
   * request built from a guess would be the worst kind. `selskap` moves when
   * the company is renamed or confirmed, so reading it late is also what keeps
   * these calls pointed at the right company.
   */
  function bokene(): Company {
    if (selskap === null) throw new Error('ingen bøker valgt');
    return selskap;
  }

  function showTittel(): void {
    // Never an account name, however provisional this page's own state is: see
    // the note where showOrganization used to be.
    el('#sidetittel').textContent = selskap === null ? 'Ingen regnskap ennå' : selskap.name;
    const medlemmer = el('#medlemmer-tittel');
    medlemmer.textContent =
      selskap === null ? 'Medlemmer' : `Medlemmer i ${selskap.name}`;
  }

  /** Draw the whole Selskapet section from `companies` and `selskap`. */
  function showSelskap(): void {
    // Whatever is already on screen, else whatever the rest of the site is
    // showing. Going through `currentCompany` rather than reading the stored id
    // directly is what keeps /organisasjon/ describing the same set of books
    // that /faktura/ would invoice from: it does not merely read the choice, it
    // *writes* it, along with the header and the record the next page load
    // paints from (lib/tenant.ts).
    //
    // Every company the caller can reach, with no filtering by account: access
    // is per company now, so `companies` is already exactly the list of books
    // this person may open, whoever set them up.
    const kept = companies.find((company) => company.id === selskap?.id);
    selskap = kept ?? currentCompany(companies) ?? null;

    show(el('#selskap'), selskap !== null);
    showTittel();
    // Everyone who can open the books may read what the register said: it is a
    // stored answer and a plain lookup. Asking Brønnøysund for a *new* one can
    // move the VAT flag, which is a change to every future invoice, so that
    // button needs the permission editing needs.
    show(el('#register'), selskap !== null);
    show(el('#register-hent'), mayAdmin());
    show(el('#datadeling'), selskap !== null);
    // No books at all is the one case this page cannot answer, so it points at
    // the page that can. Only for someone whose *account* could set one up: an
    // invitation to a refusal is worse than silence, and somebody invited to a
    // company has no account to add one to.
    show(el('#ingen-boker'), companies.length === 0 && konto !== undefined);
    if (selskap === null) {
      showEierskap();
      return;
    }
    // The header is company-first, and this page is where a company is renamed,
    // switched and confirmed. Every one of those has to reach the top of the
    // page, or the header would keep asserting what the card no longer says.
    setActiveCompany(selskap);
    // And the same for the switcher behind the name: a company set up or
    // renamed here is one the menu on every other page has to know about.
    mountChromeCompanyMenu(companies, selskap);

    showSelskapDetaljer(selskap);
    showDatadeling(selskap);
    showEierskap();
    showRegisterAge();
  }

  {/* Her var det en selskapsvelger i overskriften på Selskapet-kortet. Den er
      borte av samme grunn som de fire andre på nettstedet: spørsmålet «hvilket
      selskap» besvares i toppen, på hver side, ett sted. Byttet der laster
      siden på nytt, så dette kortet tegnes for det selskapet man kom til. */}

  // --- Eierskapet --------------------------------------------------------------
  //
  // Creating a set of books proves nothing: anyone can type nine digits. The
  // confirmation below is what turns it into a claim, and the evidence is
  // Altinn's own list of parties the person may act for — the same rights an
  // innsending will later rest on.
  //
  // When another account has confirmed the orgnr already, confirmOwnership
  // asks «Er du sikker på at du vil fortsette?» in ClaimedDialog, and «Ja»
  // confirms these books too. «Avbryt» leaves them unconfirmed, which is not a
  // consolation prize: a regnskapsfører engaged for a client whose own
  // confirmation sits elsewhere is exactly that case.

  const eierskapStatus = (): HTMLParagraphElement => el<HTMLParagraphElement>('#eierskap-status');

  /** Say what the refusal was, and show the button that answers it. */
  function reportEierskap(error: unknown): void {
    const status = eierskapStatus();
    if (error instanceof ApiError && error.status === 409) {
      // The login lapsed between drawing the button and pressing it. The way
      // out is the login, not a sentence about it.
      setStatus(status, error.message);
      show(el('#eierskap-bekreft'), false);
      void loadGovernmentStatus(true).then(() => showEierskap());
      return;
    }
    setStatus(
      status,
      error instanceof ApiError ? error.message : 'Vi fikk ikke bekreftet eierskapet.',
    );
  }

  /**
   * Confirm through Altinn that the current books are the caller's.
   *
   * Folds the answer back into `companies` rather than refetching: the list is
   * loaded once per page, and a stale `verified` here would outlive the
   * confirmation that just succeeded. Null when the person was asked whether
   * to confirm books somebody else has confirmed, and said no.
   */
  async function confirmEierskap(company: Company): Promise<Company | null> {
    const saved = await confirmOwnership(company);
    if (saved === null) return null;
    companies = companies.map((item) => (item.id === saved.id ? saved : item));
    if (selskap?.id === saved.id) selskap = saved;
    showSelskap();
    return saved;
  }

  /**
   * Ask Altinn, and say what came back.
   *
   * Shared by the banner's button and by the resume after ID-porten, so the two
   * paths cannot drift into saying different things about the same answer. On
   * success the banner is gone — `showSelskap` has already removed it — so the
   * confirmation is reported in the card that is still on screen.
   */
  async function attemptConfirm(company: Company, status: HTMLElement): Promise<void> {
    setStatus(status, 'Spør Altinn om rollen din …', 'ok');
    try {
      const saved = await confirmEierskap(company);
      // «Avbryt»: the person chose, and the banner still says what is missing.
      if (saved === null) {
        setStatus(status, '');
        return;
      }
      setStatus(status, '');
      setStatus(selskapStatus, `Eierskapet for ${saved.name} er bekreftet i Altinn.`, 'ok');
      // Confirming re-reads the register on the server, so what is stored is
      // now newer than what the page is showing. Read back rather than fetched
      // again: Brønnøysund was asked a moment ago, on our behalf.
      await loadStoredRegister(saved);
    } catch (error: unknown) {
      setStatus(
        status,
        error instanceof ApiError ? error.message : 'Vi fikk ikke bekreftet rollen din.',
      );
    }
  }

  /** Whether these books are confirmed, and what the caller can do about it. */
  function showEierskap(): void {
    const block = el<HTMLDivElement>('#eierskap');
    const company = selskap;
    if (company === null) {
      show(block, false);
      showVarsel(null);
      return;
    }
    const text = el<HTMLParagraphElement>('#eierskap-tekst');
    const login = el<HTMLAnchorElement>('#eierskap-login');
    const confirm = el<HTMLButtonElement>('#eierskap-bekreft');
    show(block, true);
    setStatus(eierskapStatus(), '');
    show(login, false);
    show(confirm, false);

    if (company.verified) {
      text.dataset.tone = 'ok';
      text.textContent =
        company.verified_at === null
          ? 'Eierskapet er bekreftet i Altinn.'
          : `Eierskapet er bekreftet i Altinn ${isoDate(company.verified_at.slice(0, 10))}.`;
      showVarsel(null);
      return;
    }
    // Drawn before the login state is known, so the banner is up from the first
    // paint rather than a beat later; the call below fills in its button.
    showVarsel(null);

    text.dataset.tone = 'plain';
    text.textContent =
      'Ingen har vist gjennom Altinn at de kan opptre for dette selskapet ennå. Regnskapet ' +
      'virker som før. Bekreftelsen avgjør hvem selskapet hører til, ikke om det kan føres, ' +
      'men den bør på plass før første innsending.';

    // The fact is true for everyone in the organization; the remedy is not.
    // Somebody who may not manage it gets the sentence without a button that
    // would answer 403, and is told who can.
    if (!mayAdmin()) {
      text.textContent += ' Be en administrator for dette regnskapet om å gjøre det.';
      return;
    }

    // The state below is the deployment's and Altinn's answer, so it arrives a
    // moment later. The company is captured because the picker may have moved
    // on by then, and a button drawn for the previous company would confirm the
    // wrong one.
    void loadGovernmentStatus()
      .then((state) => {
        if (selskap?.id !== company.id || company.verified) return;
        showVarsel(state);
        if (!state.available) {
          text.textContent +=
            ' Denne installasjonen har ikke satt opp innlogging med ID-porten, så bekreftelse ' +
            'er ikke mulig her.';
          return;
        }
        if (state.logged_in) {
          show(confirm, true);
          return;
        }
        login.href = governmentLoginStartUrl('/organisasjon/#selskap');
        // Same errand as the banner's button, so the same note is left behind:
        // whichever of the two took you to BankID, coming back finishes the job.
        login.onclick = (): void => rememberConfirm(company.id);
        show(login, true);
      })
      // Silent, like the Altinn block below: this is an offer, and the books
      // work without it.
      .catch(() => undefined);
  }

  /**
   * The banner at the top of the page.
   *
   * The same three states as the block under Selskapet — confirmed, needs a
   * login, ready to confirm — but said once, loudly, at the top, because that
   * is where «Ubekreftet» in the header sends people and a warning they have to
   * scroll to find is not a warning.
   *
   * Yellow rather than red on purpose. Nothing is broken: the books work, the
   * invoices go out. What is missing is evidence of who the company belongs to,
   * and that is a task waiting rather than a fault that happened.
   */
  function showVarsel(state: GovernmentLoginStatus | null): void {
    const banner = el<HTMLDivElement>('#ubekreftet-varsel');
    const company = selskap;
    // Nothing to warn about: no books yet, or books somebody has confirmed.
    if (company === null || company.verified) {
      show(banner, false);
      return;
    }
    const fix = el<HTMLButtonElement>('#varsel-fiks');
    show(banner, true);
    show(fix, true);
    fix.disabled = false;
    fix.removeAttribute('title');
    fix.textContent = 'Bekreft selskapet';
    // Rewritten from scratch every time rather than edited in place: the two
    // branches below replace it, and switching organization must not leave the
    // previous one's sentence standing under the new one's company.
    el('#ubekreftet-tekst').textContent =
      'Logg inn med ID-porten for å bekrefte rollen din i selskapet. Vi spør Altinn hvilke ' +
      'selskaper du kan opptre for, og bekrefter regnskapet mot det. Regnskapet virker som ' +
      'før i mellomtiden.';

    if (!mayAdmin()) {
      el('#ubekreftet-tekst').textContent =
        'Ingen har bekreftet i Altinn at de kan opptre for dette selskapet. Be en administrator ' +
        'for dette regnskapet om å gjøre det. Regnskapet virker som før i mellomtiden.';
      show(fix, false);
      return;
    }

    if (state === null) return;
    if (!state.available) {
      // Ingen ID-porten-klient i denne installasjonen. Knappen blir stående og
      // grå i stedet for å forsvinne: et varsel som ber deg gjøre noe, uten noe
      // å gjøre det med, får deg til å lete etter knappen du ikke finner. Grå
      // med en begrunnelse svarer på spørsmålet med én gang.
      el('#ubekreftet-tekst').textContent =
        'Denne installasjonen har ikke satt opp innlogging med ID-porten, så eierskapet kan ' +
        'ikke bekreftes herfra ennå. Regnskapet virker som før.';
      fix.disabled = true;
      fix.title = 'Innlogging med ID-porten er ikke satt opp i denne installasjonen.';
      return;
    }
    // Med ID-porten på plass er det ingenting mer å si om knappen: den heter
    // det samme uansett om innloggingen mangler eller ikke, og klikket ordner
    // stegene i riktig rekkefølge.
  }

  function wireVarsel(): void {
    const fix = el<HTMLButtonElement>('#varsel-fiks');
    const status = el<HTMLParagraphElement>('#ubekreftet-status');
    fix.addEventListener('click', () => {
      const company = selskap;
      if (company === null) return;
      fix.disabled = true;
      setStatus(status, 'Et øyeblikk …', 'ok');
      // Asked again on the click rather than trusted from the render: a session
      // that expired, or an ID-porten login finished in another tab, both make
      // the state we drew the button from wrong by the time it is pressed.
      void loadGovernmentStatus(true)
        .then((state) => {
          if (!state.available) {
            setStatus(status, 'Innlogging med ID-porten er ikke satt opp her.');
            return undefined;
          }
          if (!state.logged_in) {
            // Written down before leaving, because the trip through BankID ends
            // on a fresh page load that would otherwise have no idea an errand
            // was in progress. Leaves the page, so the disabled button and the
            // status line stay as they are until the browser navigates.
            rememberConfirm(company.id);
            window.location.href = governmentLoginStartUrl('/organisasjon/#selskap');
            return undefined;
          }
          return attemptConfirm(company, status);
        })
        .catch((error: unknown) => {
          setStatus(
            status,
            error instanceof ApiError ? error.message : 'Vi fikk ikke bekreftet rollen din.',
          );
        })
        .finally(() => {
          fix.disabled = false;
        });
    });
  }

  function wireEierskap(): void {
    const confirm = el<HTMLButtonElement>('#eierskap-bekreft');
    confirm.addEventListener('click', () => {
      const company = selskap;
      if (company === null) return;
      confirm.disabled = true;
      setStatus(eierskapStatus(), 'Spør Altinn om rettighetene dine …', 'ok');
      void confirmEierskap(company)
        .then(async (saved) => {
          if (saved === null) {
            setStatus(eierskapStatus(), '');
            return;
          }
          setStatus(eierskapStatus(), `Eierskapet for ${saved.name} er bekreftet.`, 'ok');
          setStatus(selskapStatus, `Eierskapet for ${saved.name} er bekreftet i Altinn.`, 'ok');
          await loadStoredRegister(saved);
        })
        .catch(reportEierskap)
        .finally(() => {
          confirm.disabled = false;
        });
    });
  }

  /**
   * Finish a confirmation that went through ID-porten and came back.
   *
   * The callback returns the browser to this page with nothing on the URL to
   * say it succeeded, which is right — a marker there would replay on reload.
   * The note left in `sessionStorage` before leaving is what carries the
   * errand, and this is where it is spent: once, for the company it names, and
   * only while that company is still unconfirmed.
   */
  function resumeConfirm(): void {
    const pending = takeConfirm();
    if (pending === null || !mayAdmin()) return;
    const company = companies.find((item) => item.id === pending);
    if (company === undefined || company.verified) return;
    // The picker may have settled on a different company than the one the
    // errand was for. Confirming is about a named company, so it moves.
    if (selskap?.id !== company.id) {
      selskap = company;
      setActiveCompany(company);
      showSelskap();
    }
    void attemptConfirm(company, el('#ubekreftet-status'));
  }

  // --- Fra Enhetsregisteret ------------------------------------------------------
  //
  // Everything the register holds about the company, fetched rather than typed.
  // Only a handful of it is stored — the fields an invoice or a filing repeats;
  // the rest is shown and thrown away, because it changes without telling us
  // and some of it is other people's personal data.

  const yesNo = (value: boolean): string => (value ? 'Ja' : 'Nei');

  /** One person, and every role the register has them in. */
  interface Rolleinnehaver {
    name: string;
    orgnr: string | null;
    roles: string[];
    notes: string[];
    /** Whether they can open the books, and how sure we are. */
    access: RegisterAccess;
    /** The organization role they hold, or would hold on accepting. */
    accessRole: string | null;
    /** The Myntos-side name, when it is spelled differently from the register's. */
    accessName: string | null;
    /** Where a pending invitation went. */
    accessEmail: string | null;
  }

  /**
   * The register's roles, one row per person rather than one per role.
   *
   * The register answers per role, so a daglig leder who also chairs the board
   * arrives twice and used to be listed twice — the same name on two rows, which
   * reads as two people until you look twice. Grouping is the whole difference:
   * the question the table answers is who is behind this company, and the answer
   * is a list of people who each hold something.
   *
   * Keyed on the name together with the orgnr, because a revisor and a
   * regnskapsfører are companies and it is the number that tells two of them
   * apart. First appearance decides the order, which is the register's own.
   */
  function byPerson(roles: RegisteredRoleWithAccess[]): Rolleinnehaver[] {
    const holders = new Map<string, Rolleinnehaver>();
    for (const role of roles) {
      const key = `${role.name}|${role.orgnr ?? ''}`;
      let holder = holders.get(key);
      if (holder === undefined) {
        // The access mark is resolved per person, so every row for one holder
        // carries the same one and the first is as good as the last.
        holder = {
          name: role.name,
          orgnr: role.orgnr,
          roles: [],
          notes: [],
          access: role.access,
          accessRole: role.access_role,
          accessName: role.access_name,
          accessEmail: role.access_email,
        };
        holders.set(key, holder);
      }
      // The rollegruppe in parentheses only where it says something the role
      // does not: «Styremedlem (Styre)» earns it, «Daglig leder» does not.
      const label =
        role.group === role.code
          ? role.description
          : `${role.description} (${role.group_description})`;
      if (!holder.roles.includes(label)) holder.roles.push(label);
      if (role.elected_by !== null && !holder.notes.includes(role.elected_by)) {
        holder.notes.push(role.elected_by);
      }
    }
    return [...holders.values()];
  }

  function showRegister(): void {
    const list = el<HTMLDListElement>('#register-felt');
    const rows = el<HTMLTableSectionElement>('#register-roller-rader');
    list.replaceChildren();
    rows.replaceChildren();
    show(el('#register-roller'), false);
    show(el('#register-mer'), register !== null);
    show(el('#register-tomt'), register === null);
    if (register === null) return;

    const unit = register.unit;
    field(list, 'Navn i registeret', unit.name);
    field(list, 'Organisasjonsform', unit.organisation_form_description);
    field(
      list,
      'Forretningsadresse',
      [unit.address_line, [unit.postal_code, unit.city].filter(Boolean).join(' ')]
        .filter((part) => part !== null && part !== '')
        .join(', ') || null,
    );
    field(list, 'Kommune', unit.municipality);
    field(
      list,
      'Postadresse',
      unit.postal_address_line === null
        ? null
        : [
            unit.postal_address_line,
            [unit.postal_address_postal_code, unit.postal_address_city].filter(Boolean).join(' '),
          ]
            .filter((part) => part !== '')
            .join(', '),
    );
    field(
      list,
      'Næringskode',
      unit.industry_code === null
        ? null
        : `${unit.industry_code} ${unit.industry_description ?? ''}`.trim(),
    );
    for (const [code, description] of unit.secondary_industries) {
      field(list, 'Binæring', `${code} ${description}`);
    }
    field(list, 'Sektor', unit.sector_description);
    field(list, 'Nettsted', unit.website);
    field(list, 'Telefon', unit.phone);
    field(list, 'Mobil', unit.mobile);
    field(list, 'E-post', unit.email);
    field(list, 'Stiftet', unit.established_on === null ? null : isoDate(unit.established_on));
    field(
      list,
      'Registrert i Enhetsregisteret',
      unit.registered_on === null ? null : isoDate(unit.registered_on),
    );
    field(list, 'Registrert i Merverdiavgiftsregisteret', yesNo(unit.registered_in_vat_register));
    field(list, 'Registrert i Foretaksregisteret', yesNo(unit.registered_in_foretaksregisteret));
    field(list, 'Siste innsendte årsregnskap', unit.last_submitted_annual_accounts);
    field(
      list,
      'Ansatte',
      // Null is "ingen har meldt inn et tall", which is a different thing from
      // none, and saying 0 would be an opplysning registeret aldri ga.
      unit.employees === null ? 'Ikke oppgitt' : String(unit.employees),
    );
    field(
      list,
      'Aksjekapital',
      // kroner() already writes the currency, so only a capital registered in
      // something other than NOK needs the code spelled out.
      unit.capital === null
        ? null
        : (unit.capital.currency === 'NOK'
            ? kroner(unit.capital.amount)
            : `${unit.capital.amount} ${unit.capital.currency}`) +
          (unit.capital.shares === null ? '' : ` · ${unit.capital.shares} aksjer`),
    );
    field(list, 'Underenhet av', unit.parent_orgnr === null ? null : orgnummer(unit.parent_orgnr));
    field(list, 'Målform', unit.language);
    field(list, 'Tidligere navn', unit.former_names.join(', ') || null);
    field(list, 'Vedtektsfestet formål', unit.purpose.join(' ') || null);
    field(list, 'Aktivitet', unit.activity.join(' ') || null);
    // Only when true. "Konkurs: Nei" on every company is noise; "Konkurs: Ja"
    // is the one line somebody needs to see.
    if (unit.deleted_on) field(list, 'Slettet fra Enhetsregisteret', isoDate(unit.deleted_on));
    if (unit.bankrupt) field(list, 'Konkurs', 'Ja');
    if (unit.under_liquidation) field(list, 'Under avvikling', 'Ja');
    if (unit.under_forced_liquidation) field(list, 'Under tvangsavvikling', 'Ja');

    for (const holder of byPerson(register.roles)) {
      const row = document.createElement('tr');

      const who = document.createElement('td');
      const name = document.createElement('span');
      name.className = 'org-roller-navn';
      name.textContent = holder.name;
      who.append(name);
      // Only a revisor or a regnskapsfører has one, and then it is what tells
      // two firms with near-identical names apart.
      if (holder.orgnr !== null) {
        const number = document.createElement('span');
        number.className = 'org-roller-orgnr';
        number.textContent = orgnummer(holder.orgnr);
        who.append(number);
      }

      const what = document.createElement('td');
      const badges = document.createElement('ul');
      badges.className = 'org-rollemerker';
      for (const role of holder.roles) {
        const item = document.createElement('li');
        item.textContent = role;
        badges.append(item);
      }
      what.append(badges);

      row.append(who, what, accessCell(holder));
      rows.append(row);
    }
    show(el('#register-roller'), register.roles.length > 0);
  }

  /**
   * How each access mark reads, and what the reader should take from it.
   *
   * Four states for a person and one for a firm. The wording carries the
   * certainty rather than the colour doing it alone: «har tilgang» and «har
   * trolig tilgang» are different claims, and somebody scanning the column
   * should not have to know the palette to tell them apart.
   */
  const ACCESS_WORDS: Record<RegisterAccess, string | null> = {
    bekreftet: 'Har tilgang',
    trolig: 'Har trolig tilgang',
    invitert: 'Invitert',
    ingen: 'Ingen tilgang',
    // A revisor or regnskapsfører firm. «Ingen tilgang» on one answers a
    // question nobody asked, so the cell stays empty.
    selskap: null,
  };

  /** Why the mark says what it says, in one line, on hover and for a reader. */
  const ACCESS_WHY: Record<RegisterAccess, string> = {
    bekreftet:
      'Navnet stemmer med en ID-porten-innlogging, altså med Folkeregisteret, samme kilde som registeret selv bruker.',
    trolig:
      'Navnet stemmer med navnet på en Myntos-konto, men ingen har vist gjennom ID-porten at det er samme person.',
    invitert: 'Invitasjonen er sendt, men ikke tatt imot ennå.',
    ingen: 'Ingen med tilgang til regnskapet går under dette navnet.',
    selskap: 'Et selskap, ikke en person med innlogging her.',
  };

  const roleWord = (role: string | null): string | null =>
    role === null ? null : (ROLES.find(([value]) => value === role)?.[1] ?? role);

  /**
   * The Merknad cell: what the register says about this person, and whether
   * they can open the books.
   *
   * The «Inviter» button is the point of putting the mark here at all. Seeing
   * that a board member has no access is only useful next to the one thing to
   * do about it, and the alternative was to read the name, scroll up, and
   * retype it into a form.
   */
  function accessCell(holder: Rolleinnehaver): HTMLTableCellElement {
    const td = document.createElement('td');
    const word = ACCESS_WORDS[holder.access];
    if (word !== null) {
      const mark = document.createElement('span');
      mark.className = `org-tilgang org-tilgang-${holder.access}`;
      mark.title = ACCESS_WHY[holder.access];
      mark.textContent = word;
      const role = roleWord(holder.accessRole);
      if (role !== null) {
        const suffix = document.createElement('span');
        suffix.className = 'org-tilgang-rolle';
        suffix.textContent = role;
        mark.append(' ', suffix);
      }
      td.append(mark);
    }

    // Which name was matched, when it is not the one on this row. An
    // administrator who knows their colleagues should be able to see the join
    // and disagree with it.
    const detail =
      holder.access === 'invitert'
        ? holder.accessEmail
        : holder.accessName !== null
          ? `som ${holder.accessName}`
          : null;
    if (detail !== null) {
      const note = document.createElement('span');
      note.className = 'org-tilgang-detalj';
      note.textContent = detail;
      td.append(note);
    }

    for (const elected of holder.notes) {
      const note = document.createElement('span');
      note.className = 'org-tilgang-detalj';
      note.textContent = elected;
      td.append(note);
    }

    if (mayManage() && holder.access === 'ingen') {
      const invite = document.createElement('button');
      invite.type = 'button';
      invite.className = 'btn-link';
      invite.textContent = 'Inviter';
      invite.addEventListener('click', () => openInvite(holder.name));
      td.append(invite);
    }
    return td;
  }

  /** Say how old the answer on screen is, and where it came from. */
  function showRegisterAge(): void {
    el('#register-synk').textContent =
      register === null ? '' : `Hentet ${isoDate(register.fetched_at.slice(0, 10))}`;
  }

  /**
   * Show what the register last said, without asking it again.
   *
   * This is the page-load path. The old one asked Brønnøysund on every single
   * visit, which spent a round trip on an answer that changes a few times a
   * year and made the panel go blank whenever somebody else's service was slow.
   * Now the answer is stored when it is fetched, and a visit reads it back.
   *
   * A company with nothing stored — set up while the register was down — gets
   * one quiet fetch, which then stores it for every visit after this one.
   */
  async function loadStoredRegister(company: Company): Promise<void> {
    try {
      const stored = await getCompanyRegister(company.id);
      if (selskap?.id !== company.id) return;
      register = stored;
      showRegister();
      showRegisterAge();
      if (stored === null && mayAdmin()) await loadRegister(company, true);
    } catch {
      // Silent: the books do not depend on it, and the panel says plainly that
      // nothing has been fetched.
    }
  }

  /** Ask the register for a fresh answer, and say what it moved. */
  async function loadRegister(company: Company, quiet = false): Promise<void> {
    const status = el<HTMLParagraphElement>('#register-status');
    if (!quiet) setStatus(status, 'Henter fra Enhetsregisteret …', 'ok');
    await refreshCompany(company.id)
      .then((answer) => {
        register = answer;
        companies = companies.map((item) => (item.id === answer.company.id ? answer.company : item));
        if (selskap?.id === answer.company.id) {
          selskap = answer.company;
          showSelskap();
        }
        showRegister();
        showRegisterAge();
        setStatus(
          status,
          answer.changed.length === 0
            ? 'Alt stemmer med registeret.'
            : `Oppdatert fra registeret: ${answer.changed.map(feltnavn).join(', ')}.`,
          'ok',
        );
      })
      .catch((error: unknown) => {
        // What is on screen stays on screen. It came from the register too,
        // just earlier, and «Hentet 12. mars» beside it says as much — which is
        // a better answer than blanking the panel because Brønnøysund is busy.
        // Quiet on the automatic pass: the register is a convenience, and a
        // banner about it on page load would sit on top of a page that works.
        if (quiet) return;
        setStatus(
          status,
          error instanceof ApiError ? error.message : 'Vi fikk ikke kontakt med Enhetsregisteret.',
        );
      });
  }

  /** The stored fields, in the words the card above uses for them. */
  function feltnavn(name: string): string {
    const names: Record<string, string> = {
      address_line: 'adresse',
      postal_code: 'postnummer',
      city: 'sted',
      organisation_form: 'organisasjonsform',
      vat_registered: 'mva-registrering',
      in_foretaksregisteret: 'Foretaksregisteret',
      industry_code: 'næringskode',
      industry_description: 'næring',
      website: 'nettsted',
      phone: 'telefon',
      email: 'e-post',
      parent_orgnr: 'hovedenhet',
    };
    return names[name] ?? name;
  }

  function wireRegister(): void {
    const button = el<HTMLButtonElement>('#register-hent');
    button.addEventListener('click', () => {
      const company = selskap;
      if (company === null) return;
      button.disabled = true;
      void loadRegister(company).finally(() => {
        button.disabled = false;
      });
    });
  }

  // --- Tilgang til regnskapet ----------------------------------------------------

  // Here lived showOrganization, deltNavn and navnHjelp: the Organisasjonen
  // card, its name with a pencil, and the warning for a name the account shared
  // with one of its own companies.
  //
  // All three are gone with the card. The account is not something a person
  // looks at any more: its members, its invitations and its subscription are
  // the company's (`selskapFelter` above, and the Tilgang section below), and
  // its *name* was the thing that made this page read like a leak. An account
  // is routinely called after the first company set up under it, so with two
  // companies on one account the card said one company's name while the header
  // said the other's, and there was nothing on screen to tell the two kinds of
  // name apart. Warning about the collision was a plaster; not showing an
  // account at all is the fix. See docs/company-isolation.md.

  function renderMembers(members: Member[]): void {
    memberBody.replaceChildren();
    for (const member of members) {
      const row = document.createElement('tr');

      const who = document.createElement('td');
      who.textContent = member.full_name;
      if (member.is_self) {
        const you = document.createElement('span');
        you.className = 'org-deg';
        you.textContent = '(deg)';
        who.append(' ', you);
      }

      const role = document.createElement('td');
      if (mayManage()) {
        const select = document.createElement('select');
        select.className = 'role';
        for (const [value, label] of ROLES) {
          const node = document.createElement('option');
          node.value = value;
          node.textContent = label;
          node.selected = value === member.role;
          select.append(node);
        }
        select.addEventListener('change', () => {
          void changeMemberRole(bokene().id, member.user_id, select.value)
            .then(() => refresh())
            .catch((error: unknown) => {
              // The server refused: the last owner, or granting owner as an
              // admin. Put the select back so it never shows a role that is
              // not the one in force.
              select.value = member.role;
              report(error, 'Rollen kunne ikke endres.');
            });
        });
        role.append(select);
      } else {
        role.textContent = roleLabel(member.role);
      }

      const actions = document.createElement('td');
      if (mayManage() || member.is_self) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn-link';
        button.textContent = member.is_self ? 'Gi fra deg tilgangen' : 'Fjern';
        button.addEventListener('click', () => {
          void leave(member);
        });
        actions.append(button);
      }

      row.append(who, cell(member.email), role, governmentCell(member), actions);
      memberBody.append(row);
    }
  }

  /**
   * Whether this colleague has shown who they are, and the way to do it.
   *
   * Only for yourself is there a button: linking is a personal ID-porten login
   * and nobody can do it on somebody else's behalf. For everybody else the
   * cell is a statement, and the honest one for an unlinked colleague is that
   * they have not, rather than a prompt to nag them from here.
   *
   * The name is shown when ID-porten gave one and it differs from the account's
   * own, because that difference is exactly what makes the register's board
   * list resolvable.
   */
  function governmentCell(member: Member): HTMLTableCellElement {
    const td = document.createElement('td');
    if (member.government_linked) {
      const mark = document.createElement('span');
      mark.className = 'org-tilgang org-tilgang-bekreftet';
      mark.textContent = 'Bekreftet';
      mark.title =
        member.government_verified_at === null
          ? 'Har logget inn med ID-porten.'
          : `Sist bekreftet ${isoDate(member.government_verified_at.slice(0, 10))}.`;
      td.append(mark);
      if (member.government_name !== null && member.government_name !== member.full_name) {
        const name = document.createElement('span');
        name.className = 'org-tilgang-detalj';
        name.textContent = member.government_name;
        td.append(name);
      }
      return td;
    }

    if (!member.is_self) {
      const nothing = document.createElement('span');
      nothing.className = 'org-tilgang org-tilgang-ingen';
      nothing.textContent = 'Ikke koblet';
      td.append(nothing);
      return td;
    }

    const link = document.createElement('a');
    link.className = 'btn-link';
    link.textContent = 'Koble til ID-porten';
    link.href = governmentLoginStartUrl('/organisasjon/');
    td.append(link);
    const why = document.createElement('span');
    why.className = 'org-tilgang-detalj';
    why.textContent = 'Da vet vi hvem du er i styret.';
    td.append(why);
    return td;
  }

  async function leave(member: Member): Promise<void> {
    const question = member.is_self
      ? 'Gi fra deg tilgangen til dette regnskapet? Du kommer ikke inn i det igjen uten en ny invitasjon.'
      : `Fjerne ${member.full_name} sin tilgang til dette regnskapet?`;
    if (!window.confirm(question)) return;
    try {
      await removeMember(bokene().id, member.user_id);
      if (member.is_self) {
        window.location.href = '/';
        return;
      }
      await refresh();
    } catch (error: unknown) {
      report(error, 'Medlemmet kunne ikke fjernes.');
    }
  }

  function renderInvitations(invitations: Invitation[]): void {
    invitationBody.replaceChildren();
    for (const invitation of invitations) {
      const row = document.createElement('tr');

      // Name over address when there is one: an invitation sent from the board
      // list is about a person, and «Andreas Edvardsen Lindeman» is what an
      // administrator recognises. The address stays, because it is what the
      // invitation actually grants against.
      const who = document.createElement('td');
      if (invitation.full_name !== null) {
        const name = document.createElement('span');
        name.className = 'org-roller-navn';
        name.textContent = invitation.full_name;
        who.append(name);
      }
      const address = document.createElement('span');
      address.className = invitation.full_name === null ? '' : 'org-roller-orgnr';
      address.textContent = invitation.email;
      who.append(address);

      const actions = document.createElement('td');
      // Sending again is the ordinary repair for a message that never arrived,
      // and it was not possible before: only the token's hash is stored, so the
      // link could not be looked up and the whole invitation had to be redone.
      const again = document.createElement('button');
      again.type = 'button';
      again.className = 'btn-link';
      again.textContent = 'Send på nytt';
      again.addEventListener('click', () => {
        again.disabled = true;
        void resendInvitation(bokene().id, invitation.id)
          .then(async (sent) => {
            reportInvitationSend(sent, {
              ok: `Invitasjonen er sendt på nytt til ${sent.email}.`,
              failed: `Vi fikk ikke sendt e-posten til ${sent.email} på nytt.`,
            });
            await refresh();
          })
          .catch((error: unknown) => report(error, 'Invitasjonen kunne ikke sendes på nytt.'))
          .finally(() => {
            again.disabled = false;
          });
      });
      const withdraw = document.createElement('button');
      withdraw.type = 'button';
      withdraw.className = 'btn-link';
      withdraw.textContent = 'Trekk tilbake';
      withdraw.addEventListener('click', () => {
        void revokeInvitation(bokene().id, invitation.id)
          .then(() => refresh())
          .catch((error: unknown) => report(error, 'Invitasjonen kunne ikke trekkes tilbake.'));
      });
      actions.append(again, withdraw);

      row.append(
        who,
        cell(roleLabel(invitation.role)),
        cell(invitation.invited_by ?? 'Ukjent'),
        cell(isoDate(invitation.expires_at.slice(0, 10))),
        actions,
      );
      invitationBody.append(row);
    }
    // A heading with nothing under it is a question about something that is not
    // happening. The card appears when there is an invitation to show.
    show(el('#invitations-card'), invitations.length > 0);
  }

  async function refresh(): Promise<void> {
    renderMembers(await listMembers(bokene().id));
    if (mayManage()) renderInvitations(await listInvitations(bokene().id));
    else show(el('#invitations-card'), false);
    // The board list downstairs answers a question about the member list, so it
    // goes stale for the same reasons. Inviting somebody, changing a role or
    // removing a colleague all move a mark down there, and the register has
    // said nothing new, which is exactly why the marks are resolved on read
    // rather than stored. Re-read, quietly: this is a stored answer, not a
    // round trip to Brønnøysund.
    if (selskap !== null) await loadStoredRegister(selskap);
  }

  /**
   * Open the invite panel, for a person the register named or for nobody yet.
   *
   * The form asks for an address and a role, and never for a name: the name is
   * a label on the invitation, and asking for one turned "give my colleague
   * access" into a form with something to fill in first.
   *
   * The board list is the one place a name exists before the invitation does,
   * so it is the one place that carries one. It goes into the hidden field and
   * onto the screen as `#invite-for`, and the cursor goes to the address,
   * because that is the one thing the register cannot tell us. Opened from
   * anywhere else the field is cleared, so a name from an abandoned invitation
   * cannot ride along on the next one.
   */
  function openInvite(fullName?: string): void {
    const form = el<HTMLFormElement>('#invite-form');
    const nameField = form.querySelector<HTMLInputElement>('[name="full_name"]');
    const emailField = form.querySelector<HTMLInputElement>('[name="email"]');
    const forWhom = el<HTMLParagraphElement>('#invite-for');

    setStatus(inviteStatus, '');
    show(el('#invite-link-box'), false);
    if (nameField !== null) nameField.value = fullName ?? '';
    if (fullName !== undefined) {
      forWhom.textContent = `Invitasjon til ${fullName}, fra styret i Enhetsregisteret.`;
    }
    show(forWhom, fullName !== undefined);
    show(el('#invite'), true);
    show(el('#invite-vis'), false);
    emailField?.focus();
    // The panel sits under the member table and the register list is further
    // down the page, so an invitation started from a board row would otherwise
    // open somewhere the reader is not looking.
    el('#invite').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  /**
   * Say whether the message went out, and offer the link only when it did not.
   *
   * Shared by the first send and by "send again", so the two cannot drift into
   * saying different things about the same outcome. The link is a fallback, not
   * the result: when the email arrived, showing it invites somebody to send a
   * second copy of a message already sitting in an inbox.
   */
  function reportInvitationSend(
    invitation: Invitation,
    words: { ok: string; failed: string },
  ): void {
    const linkBox = el<HTMLDivElement>('#invite-link-box');
    const link = el<HTMLInputElement>('#invite-link');
    const sent = invitation.email_sent === true;
    // Lenken uansett, se merknaden over #invite-link-box: «sendt» betyr levert
    // til Cloudflare, ikke at den kom fram.
    if (invitation.invite_url !== null) {
      link.value = invitation.invite_url;
      show(el('#invite-link-ikke-sendt'), !sent);
      show(el('#invite-link-sendt'), sent);
      show(el('#invite'), true);
      show(linkBox, true);
    } else {
      show(linkBox, false);
    }
    setStatus(inviteStatus, sent ? words.ok : words.failed, sent ? 'ok' : 'error');
  }

  function wireInviteForm(): void {
    const form = el<HTMLFormElement>('#invite-form');
    const submit = el<HTMLButtonElement>('#invite-submit');
    const panel = el<HTMLDivElement>('#invite');
    const open = el<HTMLButtonElement>('#invite-vis');
    const linkBox = el<HTMLDivElement>('#invite-link-box');
    const link = el<HTMLInputElement>('#invite-link');

    open.addEventListener('click', () => openInvite());
    el<HTMLButtonElement>('#invite-avbryt').addEventListener('click', () => {
      form.reset();
      show(linkBox, false);
      show(el('#invite-for'), false);
      setStatus(inviteStatus, '');
      show(panel, false);
      show(open, mayManage());
    });

    el<HTMLButtonElement>('#copy-link').addEventListener('click', () => {
      void navigator.clipboard.writeText(link.value).then(
        () => setStatus(inviteStatus, 'Lenken er kopiert.', 'ok'),
        // Clipboard access can be refused; selecting the text still works.
        () => link.select(),
      );
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const fullName = String(data.get('full_name') ?? '').trim();
      submit.disabled = true;
      setStatus(inviteStatus, '');
      void inviteMember(
        bokene().id,
        email,
        String(data.get('role') ?? 'member'),
        fullName === '' ? null : fullName,
      )
        .then(async (invitation) => {
          reportInvitationSend(invitation, {
            ok: `Invitasjonen er sendt til ${invitation.email}.`,
            failed: `Invitasjonen for ${invitation.email} er opprettet, men e-posten gikk ikke ut.`,
          });
          form.reset();
          show(el('#invite-for'), false);
          await refresh();
        })
        .catch((error: unknown) => {
          setStatus(
            inviteStatus,
            error instanceof ApiError ? error.message : 'Invitasjonen ble ikke opprettet.',
          );
        })
        .finally(() => {
          submit.disabled = false;
        });
    });
  }

  // --- KI-agenter og API-nøkler ------------------------------------------------------
  //
  // Personens ende av docs/agents-and-api.md: slå på, lag en nøkkel, gi den til
  // agenten eller programmet, se hva som ble av den. Selve byttet av nøkkelen
  // gjør agenten mot API-et; siden her ser aldri noe annet enn
  // tilkoblingsnøkkelen, og bare én gang.

  const agentStatus = el<HTMLParagraphElement>('#agent-status');
  const agentBody = el<HTMLTableSectionElement>('#agent-nokler');
  const agentDialog = el<HTMLDialogElement>('#agent-dialog');
  const dialogStatus = el<HTMLParagraphElement>('#agent-dialog-status');
  const agentForm = el<HTMLFormElement>('#agent-form');
  const paste = el<HTMLTextAreaElement>('#agent-lim');

  // Spurt hver gang, aldri husket, av samme grunn som mayManage(): selskapet
  // kan ha blitt byttet ut med et nyere svar siden sist.
  const agentsOn = (): boolean => selskap?.agent_access_enabled === true;
  const mayWriteWithKey = (): boolean => canInCompany(selskap, 'ledger:write');

  /** Legg et nytt svar om selskapet inn der resten av siden leser det. */
  function nyttSelskap(saved: Company): void {
    companies = companies.map((item) => (item.id === saved.id ? saved : item));
    if (selskap?.id === saved.id) selskap = saved;
  }

  function sistBrukt(key: AgentKey): string {
    if (key.last_used_at === null) return 'Aldri';
    const dag = isoDate(key.last_used_at.slice(0, 10));
    return key.last_used_client === null ? dag : `${dag}, ${key.last_used_client}`;
  }

  function renderAgentKeys(keys: AgentKey[]): void {
    agentBody.replaceChildren();
    // Hvem som laget nøkkelen står bare når listen har andres nøkler i seg,
    // og det har den bare for den som styrer tilgangen. «Deg» på hver rad i
    // ens egen liste svarer ikke på noe.
    const andres = keys.some((key) => !key.is_own);
    show(el('#agent-hvem-kol'), andres);
    for (const key of keys) {
      const row = document.createElement('tr');
      const hvem = cell(key.is_own ? 'Deg' : key.person_name);
      hvem.hidden = !andres;

      const handling = document.createElement('td');
      if (isLive(key)) {
        const stopp = document.createElement('button');
        stopp.type = 'button';
        stopp.className = 'btn-link';
        stopp.textContent = 'Stopp';
        stopp.addEventListener('click', () => {
          stopp.disabled = true;
          void stopAgentKey(bokene().id, key.id)
            .then(async () => {
              setStatus(agentStatus, `Nøkkelen «${key.name}» er stoppet.`, 'ok');
              await refreshAgents();
            })
            .catch((error: unknown) => {
              stopp.disabled = false;
              setStatus(
                agentStatus,
                error instanceof ApiError ? error.message : 'Nøkkelen ble ikke stoppet.',
              );
            });
        });
        handling.append(stopp);
      }

      row.append(
        cell(key.name),
        cell(rightsLabel(key)),
        hvem,
        cell(sistBrukt(key)),
        cell(stateLabel(key)),
        handling,
      );
      agentBody.append(row);
    }
    show(el('#agent-tabell'), keys.length > 0);
    show(el('#agent-tom'), keys.length === 0);
  }

  /** «2 forespørsler venter på godkjenning», med lenke dit, når noe venter. */
  async function showWaiting(company: Company): Promise<void> {
    const waiting = (await listApprovals(company.id, 'pending')).filter(isWaiting);
    const line = el('#agent-venter');
    show(line, waiting.length > 0);
    el('#agent-venter-lenke').textContent =
      waiting.length === 1
        ? '1 forespørsel venter på godkjenning'
        : `${waiting.length} forespørsler venter på godkjenning`;
  }

  /** Kortet med nøklene står bare når nøkler er slått på. */
  function showAgents(): void {
    const on = agentsOn();
    show(el('#agenter'), on);
    show(el('#agent-vis'), selskap !== null && canInCompany(selskap, 'ledger:read'));
    show(el('#agent-av-trinn'), on && mayManage());
  }

  async function refreshAgents(): Promise<void> {
    showAgents();
    if (!agentsOn() || selskap === null) return;
    const company = selskap;
    renderAgentKeys(await listAgentKeys(company.id));
    // For seg selv: en liste over ventende forespørsler som ikke kom, skal
    // ikke ta nøklene med seg.
    void showWaiting(company).catch(() => show(el('#agent-venter'), false));
  }

  function reportAgents(error: unknown, fallback: string): void {
    setStatus(agentStatus, error instanceof ApiError ? error.message : fallback);
  }

  function reportInDialog(error: unknown, fallback: string): void {
    setStatus(dialogStatus, error instanceof ApiError ? error.message : fallback);
  }

  /** Hvilken av de fire tilstandene vinduet står i. */
  function showPane(pane: 'samtykke' | 'av-spor' | 'skjema' | 'ny'): void {
    show(el('#agent-samtykke'), pane === 'samtykke');
    show(el('#agent-av-spor'), pane === 'av-spor');
    show(agentForm, pane === 'skjema');
    show(el('#agent-ny'), pane === 'ny');
  }

  function checkedMode(name: 'write' | 'post'): Mode {
    const picked = agentForm.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return (picked?.value as Mode | undefined) ?? DEFAULT_MODE;
  }

  /**
   * Hold «Bokføre» innenfor «Forberede», slik backend krever.
   *
   * Valgene for «Bokføre» som rekker lenger enn «Forberede» er ikke bare
   * flyttet bort fra, men slått av, så skjemaet viser hva som går an i stedet
   * for å rette på det etterpå.
   */
  function syncModes(): void {
    const write = checkedMode('write');
    const settled = settleModes(write, checkedMode('post'));
    const order = MODES.map((mode) => mode.value);
    for (const input of agentForm.querySelectorAll<HTMLInputElement>('input[name="post"]')) {
      input.disabled = order.indexOf(input.value as Mode) < order.indexOf(write);
      input.checked = input.value === settled.post;
    }
  }

  function prepareForm(): void {
    agentForm.reset();
    const offered = mayWriteWithKey();
    show(el('#agent-rettigheter'), offered);
    show(el('#agent-bare-lese'), !offered);
    syncModes();
    showPane('skjema');
  }

  /**
   * Åpne vinduet i den tilstanden selskapet står i.
   *
   * Første gang, mens nøkler er av, er det samtykket: det man må vite før de
   * slås på. Står de på, går det rett på skjemaet.
   */
  function openAgentDialog(): void {
    clearStatus(dialogStatus);
    const company = bokene();
    el('#agent-forstaar-tekst').textContent =
      `Jeg har lest dette og vil slå på nøkler for ${company.name}.`;
    el('#agent-av-tekst').textContent = `Nøkler er slått av for ${company.name}.`;
    if (agentsOn()) prepareForm();
    else showPane(mayManage() ? 'samtykke' : 'av-spor');
    agentDialog.showModal();
  }

  function wireAgents(): void {
    el<HTMLButtonElement>('#agent-vis').addEventListener('click', openAgentDialog);
    el<HTMLButtonElement>('#agent-lukk').addEventListener('click', () => agentDialog.close());
    for (const button of agentDialog.querySelectorAll<HTMLButtonElement>('[data-agent-lukk]')) {
      button.addEventListener('click', () => agentDialog.close());
    }
    // Nøkkelen skal ikke bli liggende på siden etter at den er levert: tømt,
    // ikke bare skjult, så den ikke står i en fane noen glemmer å lukke. Også
    // når vinduet lukkes med Escape.
    agentDialog.addEventListener('close', () => {
      paste.value = '';
      agentForm.reset();
      clearStatus(dialogStatus);
    });

    const understood = el<HTMLInputElement>('#agent-forstaar');
    const switchOn = el<HTMLButtonElement>('#agent-paa');
    understood.addEventListener('change', () => {
      switchOn.disabled = !understood.checked;
    });
    switchOn.addEventListener('click', () => {
      switchOn.disabled = true;
      clearStatus(dialogStatus);
      void setAgentAccess(bokene().id, true)
        .then(async (saved) => {
          nyttSelskap(saved);
          understood.checked = false;
          // Rett videre til skjemaet: det var en nøkkel personen ville lage.
          prepareForm();
          setStatus(dialogStatus, 'Nøkler er slått på. Nå kan du lage en.', 'ok');
          await refreshAgents();
        })
        .catch((error: unknown) => {
          switchOn.disabled = !understood.checked;
          reportInDialog(error, 'Nøkler ble ikke slått på.');
        });
    });

    for (const input of agentForm.querySelectorAll<HTMLInputElement>('input[type="radio"]')) {
      input.addEventListener('change', syncModes);
    }

    const submit = el<HTMLButtonElement>('#agent-lag');
    agentForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = String(new FormData(agentForm).get('name') ?? '').trim();
      if (name === '') {
        setStatus(dialogStatus, 'Gi nøkkelen et navn, så du kjenner den igjen i listen.');
        return;
      }
      const chosen = mayWriteWithKey()
        ? scopesFor(checkedMode('write'), checkedMode('post'))
        : scopesFor('no', 'no');
      submit.disabled = true;
      clearStatus(dialogStatus);
      void createAgentKey(bokene().id, name, chosen.scopes, chosen.approvalScopes)
        .then(async (issued) => {
          paste.value = pasteText(bokene().name, issued.connection_key, import.meta.env.SITE);
          showPane('ny');
          await refreshAgents();
        })
        .catch((error: unknown) => reportInDialog(error, 'Nøkkelen ble ikke laget.'))
        .finally(() => {
          submit.disabled = false;
        });
    });

    el<HTMLButtonElement>('#agent-kopier').addEventListener('click', () => {
      void navigator.clipboard.writeText(paste.value).then(
        () => setStatus(dialogStatus, 'Kopiert. Lim det inn i samtalen med agenten.', 'ok'),
        // Utklippstavlen kan være sperret; å markere teksten virker likevel.
        () => paste.select(),
      );
    });

    const offStep = el('#agent-av-bekreft');
    el<HTMLButtonElement>('#agent-av-vis').addEventListener('click', () => show(offStep, true));
    el<HTMLButtonElement>('#agent-av-avbryt').addEventListener('click', () => show(offStep, false));
    const switchOff = el<HTMLButtonElement>('#agent-av');
    switchOff.addEventListener('click', () => {
      switchOff.disabled = true;
      void setAgentAccess(bokene().id, false)
        .then(async (saved) => {
          nyttSelskap(saved);
          show(offStep, false);
          setStatus(agentStatus, 'Nøkler er slått av, og alle nøklene er stoppet.', 'ok');
          await refreshAgents();
        })
        .catch((error: unknown) => reportAgents(error, 'Nøkler ble ikke slått av.'))
        .finally(() => {
          switchOff.disabled = false;
        });
    });
  }

  // --- Del data med Myntos ----------------------------------------------------------
  //
  // Valgene lages fra lib/datasharing.ts når siden bygges; her tegnes det
  // selskapet har valgt, og et nytt valg lagres. Ingenting lagres på et valg i
  // listen alene: «Lagre» er beslutningen, og for nivået som deler bilagene
  // slik de er, også avkrysningen over den.

  const delingStatus = el<HTMLParagraphElement>('#datadeling-status');
  const delingValg = el<HTMLSelectElement>('#datadeling-valg');
  const delingForstaar = el<HTMLInputElement>('#datadeling-forstaar');
  const delingLagre = el<HTMLButtonElement>('#datadeling-lagre');
  const delingTakk = el<HTMLSpanElement>('#datadeling-takk');
  let takkTimer: number | undefined;

  function valgtDeling(): DataSharingLevel {
    return levelOf(delingValg.value).value;
  }

  /** Tegn valget fra selskapets eget svar, slik det står nå. */
  function showDatadeling(company: Company): void {
    const current = levelOf(company.data_sharing);
    // Selskapet med navn, hentet fra selskapet lagringen går til, som på /ki/:
    // et valg om hva som forlater regnskapet skal ikke la noen lure på hvilket.
    el('#datadeling-na').textContent = sharingText(company.name, company.data_sharing);
    const may = mayAdmin();
    delingValg.value = current.value;
    delingValg.disabled = !may;
    delingForstaar.checked = false;
    show(el('#datadeling-les'), !may);
    show(el('#datadeling-knapper'), may);
    syncDatadeling();
  }

  /**
   * Advarselen, avkrysningen og knappen, ut fra hva som er valgt og hva som er lagret.
   *
   * Advarselen står når det øverste nivået er merket, lagret eller ikke, fordi
   * den sier hva som deles. Avkrysningen kreves bare på vei opp dit: den som
   * allerede har valgt det, skal ikke måtte si ja igjen for å la det stå.
   */
  function syncDatadeling(): void {
    const chosen = levelOf(valgtDeling());
    const saved = levelOf(selskap?.data_sharing);
    const opp = chosen.danger && !saved.danger;
    const om = el('#datadeling-om');
    om.textContent = chosen.summary;
    om.toggleAttribute('data-fare', chosen.danger);
    delingValg.toggleAttribute('data-fare', chosen.danger);
    show(el('#datadeling-fare'), chosen.danger);
    show(el('#datadeling-forstaar-rad'), opp);
    delingLagre.disabled =
      !mayAdmin() || chosen.value === saved.value || (opp && !delingForstaar.checked);
  }

  /**
   * «Takk :)» et øyeblikk, når noen velger å dele bilagene. Bare når en person
   * velger det i listen, aldri når siden tegner et valg som alt er lagret.
   * Velges det igjen før det har forsvunnet, starter det på nytt.
   */
  function takk(): void {
    window.clearTimeout(takkTimer);
    delingTakk.classList.remove('org-takk-vis');
    // Tving en ny layout, ellers starter ikke animasjonen på nytt.
    void delingTakk.offsetWidth;
    delingTakk.hidden = false;
    delingTakk.classList.add('org-takk-vis');
    takkTimer = window.setTimeout(() => {
      delingTakk.hidden = true;
      delingTakk.classList.remove('org-takk-vis');
    }, 1500);
  }

  function wireDatadeling(): void {
    delingValg.addEventListener('change', () => {
      clearStatus(delingStatus);
      syncDatadeling();
      if (levelOf(delingValg.value).danger) takk();
    });
    delingForstaar.addEventListener('change', syncDatadeling);
    delingLagre.addEventListener('click', () => {
      const chosen = valgtDeling();
      delingLagre.disabled = true;
      clearStatus(delingStatus);
      void setDataSharing(bokene().id, chosen)
        .then((saved) => {
          nyttSelskap(saved);
          showDatadeling(saved);
          setStatus(delingStatus, `Lagret. ${sharingText(saved.name, saved.data_sharing)}`, 'ok');
        })
        .catch((error: unknown) => {
          // Tilbake til det som er lagret. Et valg som blir stående på et nivå
          // serveren avviste, ville si at selskapet deler noe det ikke gjør.
          showDatadeling(bokene());
          setStatus(
            delingStatus,
            error instanceof ApiError && error.status === 403
              ? 'Bare eiere og administratorer kan endre hva selskapet deler.'
              : 'Fikk ikke lagret. Prøv igjen.',
          );
        });
    });
  }

  // --- Oppstart -------------------------------------------------------------------

  void loadSession().then(async (session) => {
    if (session === null) {
      redirectToLogin();
      return;
    }
    if (session.memberships[0] === undefined) return;

    // The companies come first, because which organisation this page is about
    // is decided by which company the rest of the site is showing.
    //
    // It used to open on `memberships[0]`, whichever membership happened to be
    // oldest, and then filter the companies down to that one organisation. For
    // an account with a single organisation the two answers are the same, which
    // is why it stood. For an account with two, arriving here from a company in
    // the second one silently swapped the page over to the first: another
    // organisation's Selskapet card, another organisation's member list, and
    // (through `setActiveCompany` in `showSelskap`) another company's name
    // written into the header of the page you were reading. The rest of the
    // site kept working in the company you had actually chosen, so the header
    // and every other page disagreed until the next reload.
    //
    // Nothing crossed a tenant boundary: every organisation here is one the
    // caller belongs to, and the API had already scoped each answer to it. But
    // one company's name appearing on another company's page is precisely what
    // a leak would look like from the outside, and there is no way to tell the
    // two apart by looking. So the page follows the company, the way
    // /index.astro does with its eyebrow.
    //
    // A failure is reported and stepped over: the members list is the rest of
    // the page and does not depend on it. Landing on `memberships[0]` after one
    // is the honest fallback, because with no company list there is nothing
    // better to go on.
    try {
      companies = await loadCompanies();
    } catch (error: unknown) {
      report(error, 'Vi fikk ikke hentet selskapene.');
    }

    // The account, for one question only: may this person set up a company at
    // all? Somebody invited to a company has no account membership, so this is
    // undefined for them, and the empty state says so instead of offering a
    // form that ends in a 404.
    konto = session.memberships.find((item) =>
      item.permissions.includes('organization:manage'),
    );

    // What this caller may do with *these* books, from the company itself: the
    // role travels with the company, so the same person can own their own books
    // and merely read a client's. Each section is shown on its own permission
    // rather than on a role, so what a role carries stays defined in one place:
    // the backend.
    const applyPermissions = (): void => {
      // showSelskap settles which company the page is about, and it draws every
      // section that asks what may be done with it, so it has to run first. It
      // asks `mayAdmin()` while it draws rather than reading a value set here:
      // see the note on those two, and the visit that opened read-only because
      // this order was the other way round.
      showSelskap();
      show(el('#invite-vis'), mayManage());
      show(el('#invite'), false);
      show(el('#invite-for'), false);
    };

    // Wired once, before any permission check: every handler reads the current
    // company, and their sections are hidden rather than removed, so a company
    // the caller *does* manage needs no rewiring, and one they do not still
    // cannot reach the form.
    wireInviteForm();
    wireEierskap();
    wireVarsel();
    wireRegister();
    wireAgents();
    wireDatadeling();

    applyPermissions();
    showRegister();
    reportCallbackError();
    // The register panel fills itself in without anybody asking, from what was
    // stored the last time it was fetched. No round trip to Brønnøysund on an
    // ordinary visit, and nothing to go blank when Brønnøysund is slow.
    if (selskap !== null) void loadStoredRegister(selskap);
    // And if the browser is here because it just came back from BankID, finish
    // what it left. Without this the round trip ends on a page that is logged
    // in, still unconfirmed, and still showing the warning that sent them.
    resumeConfirm();

    // For seg selv, så en nøkkelliste som ikke kom ikke tar medlemmene med seg.
    void refreshAgents().catch((error: unknown) =>
      reportAgents(error, 'Vi fikk ikke hentet nøklene.'),
    );

    try {
      await refresh();
      el('#loading').hidden = true;
      el('#content').hidden = false;
      // /faktura/ links here as #selskap when an invoice cannot be issued for
      // want of a kontonummer, and ID-porten comes back to it. The browser
      // resolved the fragment before any of this ran, against an element that
      // was still hidden, so it never scrolled. Doing it here is the first
      // moment the section exists on screen. Only for the anchors we send
      // people to: honouring an arbitrary hash would be a scroll nobody asked
      // for.
      // Nøklene har sin egen adresse: e-postene om en nøkkel, KI-siden og
      // teksten agenten får sender folk hit for å se nøklene, ikke selskapet.
      if (window.location.hash === '#tilgang') {
        el('#tilgang').scrollIntoView({ block: 'start' });
      }
      // /datadeling/ og hjelpeartikkelen sender folk hit for å velge.
      if (window.location.hash === '#datadeling' && !el('#datadeling').hidden) {
        el('#datadeling').scrollIntoView({ block: 'start' });
      }
      if (window.location.hash === '#selskap' && !el('#selskap').hidden) {
        el('#selskap').scrollIntoView({ block: 'start' });
        // The anchor is used for two different errands. The header's company
        // name and its «Ubekreftet» pill both send people here to *look*, and
        // /faktura/ sends them to add the kontonummer it could not issue
        // without. Only the second wants a form open, and a company with no
        // account at all is exactly what tells them apart — so it opens the
        // add form rather than the whole card.
        if (mayAdmin() && selskap !== null && selskap.bank_accounts.length === 0) {
          nyKonto();
        }
      }
    } catch (error: unknown) {
      el('#loading').hidden = true;
      report(error, 'Vi fikk ikke hentet medlemmene.');
    }
  });
</script>
