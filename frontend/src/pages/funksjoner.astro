---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The anchors here are linked directly from the Funksjoner menu in
 * BaseLayout. Keep the ids in sync with that list.
 *
 * `status` is deliberately part of the content rather than a footnote: half of
 * this is built and half is not, and a features page that hides which is which
 * is the kind of thing that makes people distrust the half that works.
 */
const sections = [
  {
    id: 'kontantstrom',
    kicker: 'Føring',
    title: 'Kontantstrøm og bilag',
    status: 'virker' as const,
    body: 'Registrer inn- og utbetalinger fra bruttobeløpet. Myntos splitter i netto og merverdiavgift, fører det som en balansert postering med dobbel bokføring, og legger PDF-en ved som bilag. Arkivet er append-only, og det finnes ingen slettevei, fordi oppbevaringsplikten ikke har noen.',
    points: [
      'Typen bestemmer konto og mva-kode, med antakelsen skrevet ut',
      'Rettelser skjer med motpostering, aldri ved å endre historikk',
      'PDF lagres med SHA-256 og generert lagringsnøkkel',
    ],
  },
  {
    id: 'faktura',
    kicker: 'Salg',
    title: 'Faktura og e-faktura',
    status: 'virker' as const,
    body: 'Fakturaen kontrolleres mot bokføringsforskriften § 5-1 før den utstedes, og får først da et nummer. Et utkast som slettes etterlater ingen luke i serien. Utstedelsen bokfører fordringen og utgående mva, fryser EHF-filen og legger en lesbar PDF i bilagsarkivet. En utstedt faktura kan bare rettes med kreditnota, slik § 5-2-7 krever.',
    points: [
      'Kontrollen sier hvilken paragraf som mangler noe, ikke bare at noe mangler',
      'EHF/Peppol BIS Billing 3.0, formatet kravet fra 1. januar 2027 gjelder',
      'Avgiftspliktig, avgiftsfritt og unntatt salg summeres hver for seg (§ 5-1-5)',
    ],
  },
  {
    id: 'mva',
    kicker: 'Avgift',
    title: 'Merverdiavgift',
    status: 'virker' as const,
    body: 'Mva-kodene er knyttet til standard SAF-T-koder og har datostyrte satser, ikke én sats per kode. Det høres pedantisk ut helt til en sats endres midt i året, slik vann og avløp gikk fra 25 til 15 prosent 1. juli 2025 på samme kode som mat.',
    points: [
      'Satsen kopieres ned på den førte linjen, så historikk ikke kan skrives om',
      'Beløp regnes i eksakte desimaler; flyttall kommer aldri nær et kronebeløp',
      'Koder som aldri skal rapporteres er merket i kodeverket',
    ],
  },
  {
    id: 'saft',
    kicker: 'Lovkrav',
    title: 'SAF-T-eksport',
    status: 'underveis' as const,
    body: 'SAF-T Financial er ikke en periodisk innlevering, men filen Skatteetaten ber om ved bokettersyn. Datamodellen i Myntos er formet etter den fra første linje, slik at eksporten blir en projeksjon av regnskapet framfor en oversettelse i etterkant.',
    points: [
      'Kontoplan med næringsspesifikasjon per regnskapsår, med historikk',
      'Versjonsstyrt eksport: v1.30 og v1.40, valgt på regnskapsår',
      'Egen kryssreferansesjekk i tillegg til XSD-validering',
    ],
  },
  {
    id: 'skattemelding',
    kicker: 'Innlevering',
    title: 'Skattemelding og næringsspesifikasjon',
    status: 'underveis' as const,
    body: 'Næringsspesifikasjonen bygges fra hovedboken og leveres gjennom Altinn. Selve innsendingen krever at et menneske logger inn med ID-porten og godkjenner. Det er Skatteetatens krav, og et vi ikke prøver å gå rundt.',
    points: [
      'Henting, validering og opplasting kan skje maskinelt',
      'Siste steg er alltid en gjennomgang du selv bekrefter',
      'Kvittering og valideringsresultat lagres med periodens bilag',
    ],
  },
  {
    id: 'samarbeid',
    kicker: 'Tilgang',
    title: 'Flere brukere og roller',
    status: 'virker' as const,
    body: 'Kontoen din hører til en organisasjon, ikke omvendt. Kollegaer inviteres inn i den samme organisasjonen med en rolle, og en regnskapsfører kan føre flere selskaper under ett tak.',
    points: [
      'Roller: eier, administrator, medlem og leser',
      'Invitasjoner er engangslenker, lagret hashet',
      'Et selskap i en annen organisasjon finnes ikke for deg',
    ],
  },
  {
    id: 'apen-kildekode',
    kicker: 'Innsyn',
    title: 'Offentlig kildekode',
    status: 'virker' as const,
    body: 'Reglene er offentlige: bokføringsloven sier hva som må lagres, Skatteetaten publiserer formatene, og MVA-meldingen er en åpen spesifikasjon. Da bør programmet som oversetter mellom deg og staten også være til å ettergå. Begrunnelsen for hvert valg ligger i koden, ved siden av koden.',
    points: [
      'Hele programmet er offentlig tilgjengelig',
      'Du kan kjøre det selv om du heller vil det',
      'Ingenting skjer med tallene dine som ikke kan leses',
    ],
  },
];

const label = { virker: 'Virker i dag', underveis: 'Under arbeid' };
---

<BaseLayout
  title="Funksjoner | Myntos"
  description="Hva Myntos gjør: kontantstrøm og bilag, merverdiavgift, SAF-T-eksport, skattemelding, roller og offentlig kildekode."
  width="wide"
>
  <div class="head">
    <p class="pill">Funksjoner</p>
    <h1>Alt bygget rundt norske krav</h1>
    <p class="lead">
      Myntos er tidlig, og siden nedenfor sier hva som virker i dag og hva som er under arbeid.
      Det er lettere å stole på den halvparten som er ferdig når den andre halvparten ikke later
      som noe annet.
    </p>
  </div>

  <div class="sections">
    {
      sections.map((section) => (
        <section class="feature-block" id={section.id}>
          <div class="feature-meta">
            <p class="kicker">{section.kicker}</p>
            <span class="state" data-state={section.status}>
              {label[section.status]}
            </span>
          </div>
          <div class="feature-body">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            <ul class="ticks">
              {section.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <div class="cta card">
    <div>
      <h2 class="cta-title">Prøv det som finnes</h2>
      <p class="card-hint">Gratis, uten betalingsopplysninger, og du kan ta dataene ut igjen.</p>
    </div>
    <a class="btn btn-primary btn-large" href="/registrer/">Opprett konto</a>
  </div>
</BaseLayout>

<style>
  .head {
    max-width: 44rem;
    padding: 2rem 0 1rem;
  }
  .sections {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .feature-block {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
    scroll-margin-top: 6rem;
  }
  .feature-meta {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--faint);
  }
  .state {
    font-size: 0.76rem;
    font-weight: 650;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }
  .state[data-state='virker'] {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .feature-body h2 {
    margin-top: 0;
  }
  .feature-body > p {
    color: var(--muted);
    max-width: 44rem;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  .ticks li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.94rem;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.7rem;
    height: 0.38rem;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 3rem;
    background: linear-gradient(140deg, var(--accent-soft), var(--surface) 60%);
    border-color: var(--accent-line);
  }
  .cta-title {
    margin: 0 0 0.2rem;
    font-size: 1.3rem;
  }

  @media (width < 46rem) {
    .feature-block {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .feature-meta {
      flex-direction: row;
      align-items: center;
      gap: 0.8rem;
    }
  }
</style>
