  const askSource = el<HTMLSpanElement>('#ask-source');
  const askText = el<HTMLParagraphElement>('#ask-text');
  const askOptions = el<HTMLDivElement>('#ask-options');
  const askReply = el<HTMLDivElement>('#ask-reply');
  const askInput = el<HTMLInputElement>('#ask-input');
  const askOther = el<HTMLButtonElement>('#ask-other');
  const askSend = el<HTMLButtonElement>('#ask-send');
  const askStatus = el<HTMLParagraphElement>('#ask-status');
  const reading = el<HTMLParagraphElement>('#doc-reading');
  const readingText = reading;
  const warningList = el<HTMLUListElement>('#doc-warnings');
