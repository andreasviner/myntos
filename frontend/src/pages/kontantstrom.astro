---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontantstrøm | Myntos"
  description="Last opp fakturaen, så fyller skjemaet seg ut. Registrer inn- og utbetalinger med type og bilag."
  width="wide"
>
  <header class="page-head">
    <div>
      <p class="eyebrow" id="company-name">Kontantstrøm</p>
      <h1>Inn og ut</h1>
    </div>
    {/* Registeret er ett selskaps. Hvilket, svarer selskapsvelgeren i toppen
        på — ett sted, ikke ett per side. */}
  </header>

  <p class="status" id="page-status" hidden></p>
  <div class="empty" id="loading">Henter registeret …</div>

  <div class="split" id="content" hidden>
    <!-- ---------------------------------------------------------------- -->
    <!-- Entry form                                                        -->
    <!-- ---------------------------------------------------------------- -->
    <div class="card form-card" id="form-card">
      <h2 class="card-title" id="form-title">Registrer en betaling</h2>

      {/* Shown only while an entry is open for editing. It says what saving
          will do before it does it, because "Lagre endringer" on a bilag that
          is about to become three bilag should not be a surprise. */}
      <p class="editing-note" id="editing-note" role="status" hidden></p>

      <p class="status" id="form-status" hidden></p>

      <form id="entry-form">
        {/*
          Siden begynner med én ting å gjøre.

          Skjemaet under var alltid der først, tolv felter langt, med
          opplastingen på toppen som et tilbud. Men alle tolv står allerede på
          bilaget, så for nesten alle er det riktige svaret «last opp PDF-en og
          se over». Å vise de tolv feltene før noen har lastet opp noe, er å be
          brukeren om å gjøre arbeidet vi nettopp har lovet å gjøre for dem.

          Så feltene er skjult til det finnes noe å fylle dem med. To ting
          åpner dem: en PDF som er lest, eller knappen for å fylle inn selv.
          Den andre veien er ikke en nødløsning — en kontantutgift uten
          kvittering skal føres uten omveier — men den er den mindre vanlige,
          og står deretter.
        */}
        {/*
          Spørsmålene står rett over beskrivelsen, ikke under, fordi de er
          grunnen til å skrive i den. Et felt med en overskrift blir stående som
          det er; et felt med et spørsmål rett over seg blir besvart.
        */}
        <ul class="asks" id="doc-questions" hidden></ul>

        {/*
          Ett beskrivelsesfelt, ikke to. Det var to: ett for det brukeren kunne
          fortelle modellen, og ett nede i skjemaet for teksten som havner i
          hovedboken. Men det er samme setning. «Kjøpt strømforsyning, la ut
          3000 privat» er både det modellen mangler for å forstå bilaget og en
          helt riktig bilagstekst, og to felter for samme sak er to steder å
          skrive den. Ett av dem blir stående tomt.

          Så dette feltet er begge: modellen skriver i det, brukeren retter det,
          og retter brukeren det, leses bilaget om igjen med setningen som
          kontekst. Det er derfor det ikke lenger finnes en «les på nytt»-knapp.

          Det står over opplastingen, ikke under, fordi rekkefølgen er et
          spørsmål: «hva gjaldt det?» er det brukeren vet uten å slå opp, og
          skriver de det først, er det den setningen modellen leser bilaget med.
          Skriver de ingenting, fyller modellen det ut selv. Begge veier
          fungerer, og feltet sier hvilken det er på vei ned.
        */}
        <label class="field explain" data-field="description" for="description-input">
          <span class="explain-label">
            Beskrivelse <span class="muted">(valgfritt)</span>
            <span class="tag" data-tag hidden></span>
          </span>
          {/*
            Feltet er låst mens modellen er på vei til å skrive i det, og bare
            da. Å taste i en boks som er i ferd med å bli overskrevet er å miste
            det man skrev, og en boks som ser tom og redigerbar ut mens den
            venter, ser ut som en boks som ikke kommer til å bli fylt ut.
            Skrev brukeren noe selv, står feltet åpent: da er det ingen som skal
            overskrive det.
          */}
          <span class="description-wrap">
            <textarea
              id="description-input"
              name="description"
              rows="2"
              maxlength="255"
              placeholder="Hva gjaldt betalingen?"
            ></textarea>
            <span class="description-busy" id="description-busy" hidden aria-hidden="true">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            </span>
          </span>
        </label>

        {/*
          Flere filer, fordi et bilag ofte ikke er én fil. Et kjøp fra en privat
          selger på FINN er annonsen, meldingene der prisen ble avtalt,
          kvitteringen og linja på kontoutskriften — ingen av de fire er bilaget
          alene. Bilder er med for samme grunn: de fleste kvitteringer i et lite
          selskap finnes bare som et skjermbilde eller et kamerabilde.
        */}
        <div class="dropzone" id="dropzone">
          <input
            class="visually-hidden"
            type="file"
            name="document"
            id="file-input"
            multiple
            accept="application/pdf,.pdf,image/png,image/jpeg,image/webp,image/gif,image/heic,image/heif,.png,.jpg,.jpeg,.webp,.gif,.heic,.heif"
          />
          <label class="dropzone-cta" for="file-input">
            <svg class="dropzone-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <strong>Last opp faktura, kvittering eller skjermbilder</strong>
            <span class="dropzone-hint" id="file-hint">
              Dra filene hit, eller velg dem. PDF og bilder, så mange som bilaget trenger.
            </span>
          </label>

          {/*
            Kamera for den som står med kvitteringen i hånda. Et eget felt,
            fordi `capture` på hovedfeltet ville åpnet kameraet direkte og
            stengt veien til PDF-er og bilder som allerede ligger på telefonen.
            Vises bare på berøringsskjerm: på en PC åpner `capture` en vanlig
            filvelger, og da er knappen bare en dårligere kopi av den over.
          */}
          <input
            class="visually-hidden"
            type="file"
            id="camera-input"
            accept="image/jpeg,image/heic,image/heif,image/png,image/webp"
            capture="environment"
          />
          <p class="dropzone-camera">
            <label class="btn-link" for="camera-input">Ta bilde av kvitteringen</label>
          </p>

          <ul class="dropzone-files" id="drop-files" hidden></ul>
          <p class="dropzone-more" id="drop-more" hidden>
            <label class="btn-link" for="file-input">Legg til flere filer</label>
            <button type="button" class="btn-link" id="file-clear">Fjern alle</button>
          </p>
        </div>


        <p class="reading" id="doc-reading" hidden>Leser bilaget …</p>
        <ul class="doc-warnings" id="doc-warnings" hidden></ul>

        <p class="manual" id="manual-row">
          <button type="button" class="btn-link" id="manual-entry">
            Ingen bilag? Fyll inn manuelt
          </button>
        </p>

        <div class="fields" id="form-fields" hidden>
          {/* Ingen retning er valgt på forhånd. «Penger inn» sto avkrysset mens
              bilaget ble lest, med «Salg» og 25 % utgående mva under, og for en
              faktura fra MA-3D så det ut som svaret i fire sekunder. Retningen
              kommer fra bilaget eller fra brukeren, aldri fra en standard. */}
          <div class="direction" role="group" aria-label="Retning">
            <label>
              {/* Påkrevd, så nettleseren peker på retningen før den peker på en
                  kategoriliste som er tom fordi retningen mangler. */}
              <input type="radio" name="direction" value="inn" required />
              <span>Penger inn</span>
            </label>
            <label>
              <input type="radio" name="direction" value="ut" />
              <span>Penger ut</span>
            </label>
          </div>

          <label class="field" data-field="type_code">
            <span>Hva gjaldt det? <span class="tag" data-tag hidden></span></span>
            <select name="type_code" id="type-select" required></select>
            <span class="field-hint" id="type-note"></span>
          </label>

          <div class="field-row">
            <label class="field" data-field="occurred_on">
              <span>Dato <span class="tag" data-tag hidden></span></span>
              <input type="date" name="occurred_on" id="date-input" required />
            </label>
            <label class="field" data-field="gross_amount">
              <span>Beløp inkl. mva <span class="tag" data-tag hidden></span></span>
              <input
                type="number"
                name="gross_amount"
                step="0.01"
                min="0.01"
                inputmode="decimal"
                placeholder="1250.00"
                required
              />
            </label>
          </div>

          {/* En div og ikke en label: lista under boksen er ikke lov inne i
              en label, og boksen får navnet sitt fra overskriften i stedet. */}
          <div class="field" data-field="party_id">
            <span id="party-label">
              Motpart <span class="muted">(valgfritt)</span>
              <span class="tag" data-tag hidden></span>
            </span>
            {/* Én boks: skriv et navn, eller velg fra lista. Det var en liste
                med en egen tekstboks under for nye navn, som viste samme navn
                to ganger. Da bilaget fra MA-3D foreslo kjøperen, var det
                boksen under lista som måtte rettes, og den så ut som en kopi. */}
            <div class="combo">
              <input
                type="text"
                id="party-input"
                name="party_name"
                role="combobox"
                aria-labelledby="party-label"
                aria-autocomplete="list"
                aria-controls="party-list"
                aria-expanded="false"
                autocomplete="off"
                maxlength="255"
                placeholder="Skriv et navn, eller velg fra lista"
              />
              <button
                type="button"
                class="combo-toggle"
                id="party-toggle"
                aria-label="Vis motpartene dine"
                aria-controls="party-list"
                aria-expanded="false"
                tabindex="-1"
              >
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"></path>
                </svg>
              </button>
              <ul
                class="combo-list"
                id="party-list"
                role="listbox"
                aria-labelledby="party-label"
                hidden
              >
              </ul>
            </div>
            {/* Egen linje for hva som skjer med et nytt navn, slik at den faste
                hjelpeteksten med lenken til /parter blir stående. */}
            <span class="field-hint" id="party-note" hidden></span>
            <span class="field-hint">
              Føringen går fint uten. <a href="/parter/">Se motpartene dine</a>.
            </span>
          </div>

          <div class="field-row">
            <label class="field" data-field="tax_code">
              <span>Mva-kode <span class="tag" data-tag hidden></span></span>
              <select name="tax_code" id="tax-select"></select>
              <span class="field-hint">Foreslått ut fra typen. Endre hvis fakturaen sier noe annet.</span>
            </label>
            {/* Bare når kontoplanen har en annen konto av samme slag som typens
                egen: et valg med ett alternativ er ikke et spørsmål. */}
            <label class="field" data-field="account_number" id="account-field" hidden>
              <span>Konto</span>
              <select name="account_number" id="account-select"></select>
              <span class="field-hint">
                Typen fører hit. Kontoene du har lagt til i <a href="/kontoplan/">kontoplanen</a>
                kan velges i stedet.
              </span>
            </label>
            <label class="field">
              <span>Betalt via</span>
              <select name="payment_method">
                <option value="bank">Bankkonto</option>
                <option value="kontant">Kontant</option>
              </select>
            </label>
          </div>

          <button class="btn btn-primary btn-block" type="submit" id="entry-submit">
            Registrer betaling
          </button>
          <p class="cancel-edit" id="cancel-edit" hidden>
            <button type="button" class="btn-link" id="cancel-edit-button">
              Avbryt redigering
            </button>
          </p>
        </div>
      </form>
    </div>

    <div class="card readonly-note" id="readonly" hidden>
      <h2 class="card-title">Du har lesetilgang</h2>
      <p class="card-hint">
        Rollen din i denne organisasjonen lar deg se registeret, men ikke føre i det.
      </p>
    </div>

    <!-- ---------------------------------------------------------------- -->
    <!-- Oversikt                                                          -->
    <!-- ---------------------------------------------------------------- -->
    {/*
      Hva som hører hjemme ved siden av skjemaet.

      Ikke en gjentakelse av forsiden. Det som er verdt å vite mens du fører,
      er ikke det samme som det som er verdt å vite når du logger inn: her er
      det saldoen føringen din er i ferd med å endre, avgiften som bygger seg
      opp, og — den eneste som ber om noe — føringene som mangler bilag.
      Dokumentasjonskravet i bokføringsloven § 10 er det letteste å bryte ved
      et uhell, fordi ingenting går galt før noen spør.
    */}
    <aside class="side">
      <div class="card">
        <h2 class="card-title">Oversikt</h2>
        <p class="card-hint" id="side-year">Henter tall …</p>

        <dl class="figures">
          <div class="figure figure-lead">
            <dt>Kasse og bank</dt>
            <dd id="fig-cash">-</dd>
          </div>
          <div class="figure">
            <dt>Inn</dt>
            <dd class="amount-in" id="fig-in">-</dd>
          </div>
          <div class="figure">
            <dt>Ut</dt>
            <dd class="amount-out" id="fig-out">-</dd>
          </div>
          <div class="figure">
            <dt>Netto</dt>
            <dd id="fig-net">-</dd>
          </div>
          <div class="figure">
            <dt>Mva <span class="muted" id="fig-vat-note"></span></dt>
            <dd id="fig-vat">-</dd>
          </div>
        </dl>

        <p class="side-flag" id="missing-docs" hidden></p>

        {/* Not a disclaimer. It explains why there is no delete button, and
            which of the two buttons that leaves does what. Folded away because
            it answers a question you only ask once. */}
        <details class="side-info">
          <summary>Hvorfor kan ingenting slettes?</summary>
          <p>
            En betaling bokføres med en gang og kan ikke endres eller slettes, slik
            bokføringsloven krever.
          </p>
          <p>
            <strong>Rediger</strong> gjør derfor to ting når du lagrer: motposterer den
            opprinnelige føringen og legger inn den rettede. Alle tre bilagene blir stående i
            regnskapet, men registeret viser dem som én linje: den som gjelder nå. Trekanten
            foran datoen henter fram de to eldre.
          </p>
          <p>
            <strong>Reverser</strong> er for betalinger som ikke skulle vært ført i det hele
            tatt.
          </p>
        </details>
      </div>
    </aside>

    <!-- ---------------------------------------------------------------- -->
    <!-- Register                                                          -->
    <!-- ---------------------------------------------------------------- -->
    {/*
      Fem kolonner, ikke ni.

      Motpart, type, konto, netto, mva og mva-kode sto alle i tabellen før, og
      de gjorde hver linje til noe man måtte lese framfor å skumme. De står
      fortsatt der, men bak «Vis info» på den linjen de gjelder: det er
      opplysninger du slår opp om én føring, ikke noe du sammenligner nedover.
    */}
    <section class="register">
      <div class="card">
        <div class="table-scroll">
          <table class="data register-table">
            <thead>
              <tr>
                <th>Dato</th>
                <th>Bilag</th>
                <th>Beskrivelse</th>
                <th class="num">Beløp</th>
                <th>Bilagsfil</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="entries"></tbody>
          </table>
        </div>
        <p class="empty" id="entries-empty" hidden>
          Ingen føringer ennå. Registrer den første betalingen i skjemaet.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* Skjemaet til venstre, oversikten til høyre, registeret i full bredde under
     begge. Registeret er det bredeste på siden og det eneste som vokser, så
     det er det som skal ha hele bredden; skjemaet trengte den aldri, og fikk
     tolv felter presset ned i tjuefire rem så lenge de sto side om side. */
  .split {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem);
  }
  .register {
    grid-column: 1 / -1;
  }
  @media (max-width: 62rem) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .register {
      grid-column: auto;
    }
  }

  /* --- Oversikten ---------------------------------------------------------- */

  .figures {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.55rem;
  }
  .figure {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .figure dt {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .figure dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  /* Saldoen er den ene av tallene du faktisk kjenner igjen utenfra, så den
     står øverst og i en annen størrelse enn resten. */
  .figure-lead {
    display: block;
    padding-bottom: 0.6rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
  }
  .figure-lead dt {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .figure-lead dd {
    margin-top: 0.2rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .side-flag {
    margin: 1rem 0 0;
    padding: 0.6rem 0.75rem;
    background: var(--gold-soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-small);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .side-info {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .side-info summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--muted);
  }
  .side-info summary:hover {
    color: var(--fg);
  }
  .side-info p {
    margin: 0.7rem 0 0;
    color: var(--muted);
  }

  /* --- Opplasting ---------------------------------------------------------- */

  .dropzone {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-small);
    background: var(--surface-2);
    padding: 0.35rem;
    margin-bottom: 1rem;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }
  .dropzone[data-drag='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .dropzone-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.15rem;
    padding: 1.1rem 0.9rem;
    border-radius: var(--radius-small);
    cursor: pointer;
  }
  .dropzone-cta:hover {
    background: var(--surface-3);
  }
  /* The input is visually hidden, so its focus ring has to be borrowed. */
  .dropzone:focus-within .dropzone-cta {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .dropzone-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
  }
  .dropzone-cta strong {
    font-size: 0.95rem;
  }
  .dropzone-hint {
    font-size: 0.84rem;
    color: var(--muted);
  }
  .dropzone-camera {
    margin: 0;
    padding: 0 0.8rem 0.6rem;
    text-align: center;
    font-size: 0.9rem;
  }
  /* Kameraknappen gir bare mening der det finnes et kamera å peke med. */
  @media (pointer: fine) {
    .dropzone-camera {
      display: none;
    }
  }
  .dropzone-files {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0.8rem 0;
    text-align: left;
  }
  /* Radene i fillisten bygges av skriptet, og Astro avgrenser stiler ved å
     stemple `data-astro-cid-*` på elementene i malen, som en node fra
     createElement aldri får. `.dropzone-files li` kompilerte derfor til en
     regel ingen rad traff, og lista sto som «(184 kB)Fjernikke lest» uten et
     mellomrom. Forankret i lista, som står i malen, og nådd med `:global()`:
     samme mønster som /faktura/. */
  .dropzone-files :global(li) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    font-size: 0.9rem;
  }
  .dropzone-more {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.3rem 0.8rem 0.7rem;
    font-size: 0.9rem;
  }
  .dropzone-files :global(.file-name) {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Filer som ikke ga tekst. Ikke en feil — bilaget er lastet opp og lagres —
     men brukeren må se hvilken av seks som ikke ble lest, ikke bare at én ikke
     ble det. */
  .dropzone-files :global(li[data-unread] .file-name) {
    color: var(--muted);
  }
  .dropzone-files :global(.file-note) {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .explain {
    display: block;
    margin: 0 0 1rem;
  }
  .explain-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .explain textarea {
    width: 100%;
    resize: vertical;
    font: inherit;
  }
  /* Prikkene ligger oppå feltet i stedet for under, slik at høyden ikke hopper
     idet den første bokstaven kommer. */
  .description-wrap {
    display: block;
    position: relative;
  }
  .description-busy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.32rem;
    padding-left: 0.7rem;
    border-radius: inherit;
    pointer-events: none;
  }
  .description-busy .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--muted);
    opacity: 0.45;
    animation: description-blink 1.1s ease-in-out infinite;
  }
  .description-busy .dot:nth-child(2) {
    animation-delay: 0.18s;
  }
  .description-busy .dot:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes description-blink {
    0%,
    70%,
    100% {
      opacity: 0.25;
    }
    35% {
      opacity: 0.9;
    }
  }
  /* Respekterer at noen har slått av bevegelse. Prikkene er fortsatt der og
     sier fortsatt det samme; de står bare stille. */
  @media (prefers-reduced-motion: reduce) {
    .description-busy .dot {
      animation: none;
      opacity: 0.5;
    }
  }
  .explain textarea:disabled {
    /* Låst, ikke avslått. Standardstilen for disabled gjør feltet grått og
       dødt, og dette feltet er verken. */
    background: var(--surface, #fff);
    opacity: 1;
    cursor: progress;
  }
  /* Spørsmål, ikke advarsler. De står i normal tekstfarge og med et
     spørsmålstegn-merke, så de leses som noe å svare på og ikke som noe som
     har gått galt. */
  .asks {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .asks li {
    position: relative;
    padding: 0.6rem 0.8rem 0.6rem 2.2rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font-size: 0.92rem;
  }
  .asks li::before {
    content: '?';
    position: absolute;
    left: 0.85rem;
    font-weight: 700;
    color: var(--accent, currentColor);
  }
  /* Gjetning, ikke avlesning: et spørsmål modellen fant på skal ikke se like
     sikkert ut som et registeret utledet av sin egen lesning. */
  .asks li[data-ki] {
    border-style: dashed;
  }
  .ask-source {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .reading {
    margin: -0.4rem 0 1rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .doc-warnings {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0.7rem 0.85rem;
    display: grid;
    gap: 0.5rem;
    background: var(--gold-soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-small);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  /* Samme form som varslene fra bilaget: en ramme rundt noe du bør lese før du
     trykker, ikke en feilmelding. */
  .editing-note {
    margin: 0 0 1rem;
    padding: 0.7rem 0.85rem;
    background: var(--gold-soft);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-small);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .cancel-edit {
    margin: 0.75rem 0 0;
    text-align: center;
    font-size: 0.88rem;
  }

  /* Den andre veien ut av startskjermen. Sentrert og dempet, fordi den er den
     mindre vanlige av de to og ikke skal konkurrere med opplastingen. */
  .manual {
    margin: 0;
    text-align: center;
    font-size: 0.88rem;
  }

  .fields {
    margin-top: 1.25rem;
  }

  /* Knappen sier hva som skjer mens den er opptatt, så teksten må kunne
     leses: halvgjennomsiktig og «ikke tillatt» er for en knapp som venter på
     brukeren, ikke for en som brukeren venter på. */
  #entry-submit[aria-busy='true'] {
    opacity: 0.85;
    cursor: progress;
  }

  /* --- Felt som er fylt ut for deg ------------------------------------------- */

  .tag {
    display: none;
    vertical-align: middle;
    margin-left: 0.35rem;
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .tag:not([hidden]) {
    display: inline-block;
  }
  /* Gjetning, ikke avlesning: KI-forslaget skal ikke se like sikkert ut. */
  .tag[data-source='ki'] {
    background: var(--gold-soft);
    border-color: var(--gold);
    color: var(--gold);
  }
  .combo {
    position: relative;
  }
  .combo input {
    padding-right: 2.5rem;
  }
  .combo-toggle {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 2.5rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .combo-list {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.25rem);
    left: 0;
    right: 0;
    max-height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    box-shadow: var(--shadow-lifted);
  }
  .combo-list [role='option'] {
    padding: 0.45rem 0.75rem;
    cursor: pointer;
  }
  .combo-list [role='option']:hover,
  .combo-list [role='option'][aria-selected='true'] {
    background: var(--accent-soft);
  }
  .combo-list .combo-number {
    color: var(--muted);
    font-family: var(--font-numeric);
    font-size: 0.85em;
    margin-right: 0.5rem;
  }
  .combo-list .combo-group,
  .combo-list .combo-empty {
    padding: 0.45rem 0.75rem 0.2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .combo-list .combo-group {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .field[data-suggested='true'] input,
  .field[data-suggested='true'] select {
    border-color: var(--accent-line);
    background: color-mix(in srgb, var(--accent-soft) 45%, var(--surface-2));
  }

  .direction {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .direction label {
    display: block;
  }
  .direction input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .direction span {
    display: block;
    text-align: center;
    padding: 0.55rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .direction input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .direction input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Radene i registeret bygges i JavaScript, og et element laget med
     createElement får aldri attributtet Astro avgrenser stiler med. Alt som
     gjelder en rad står derfor i BaseLayout, sammen med resten av
     `table.data`. */
</style>

<script>
  import {
    ApiError,
    documentUrl,
    fetchThumbnail,
    getCompanyCatalogue,
    getSummary,
    interpretDocumentStreaming,
    listCashFlow,
    listParties,
    createParty,
    editCashFlow,
    recordCashFlow,
    reverseCashFlow,
    uploadDocument,
    type CashFlowEntry,
    type CashFlowType,
    type CompanyCatalogue,
    type Company,
    type Direction,
    type FieldSource,
    type AttachmentInfo,
    type DocumentRead,
    type InvoiceSuggestion,
    type Party,
    type Summary,
  } from '../lib/api';
  import { authorOf, namesAuthors } from '../lib/authors';
  import { currentCompany, loadCompanies } from '../lib/company';
  import { partiesMatching, resolveParty } from '../lib/counterparty';
  import {
    foldCorrections,
    foldNote,
    hasDocument,
    vouchersIn,
    type RegisterRow,
  } from '../lib/corrections';
  import { el, setStatus, show } from '../lib/dom';
  import { fileSize, isoDate, kroner, todayIso } from '../lib/format';
  import { settleLimited } from '../lib/parallel';
  import { can, loadSession, redirectToLogin } from '../lib/session';

  /**
   * What the file dialogs offer. One string, because the entry form and the
   * per-row control accept the same things and a pair that drifts apart is a
   * dialog that refuses a file the backend would have taken.
   */
  const ATTACHMENT_ACCEPT =
    'application/pdf,.pdf,image/png,image/jpeg,image/webp,image/gif,image/heic,image/heif,.png,.jpg,.jpeg,.webp,.gif,.heic,.heif';

  const pageStatus = el<HTMLParagraphElement>('#page-status');
  const formStatus = el<HTMLParagraphElement>('#form-status');
  const loading = el<HTMLDivElement>('#loading');
  const content = el<HTMLDivElement>('#content');
  const typeSelect = el<HTMLSelectElement>('#type-select');
  const taxSelect = el<HTMLSelectElement>('#tax-select');
  const accountSelect = el<HTMLSelectElement>('#account-select');
  const partyInput = el<HTMLInputElement>('#party-input');
  const partyToggle = el<HTMLButtonElement>('#party-toggle');
  const partyList = el<HTMLUListElement>('#party-list');
  const typeNote = el<HTMLSpanElement>('#type-note');
  const form = el<HTMLFormElement>('#entry-form');
  const formCard = el<HTMLDivElement>('#form-card');
  const formTitle = el<HTMLHeadingElement>('#form-title');
  const editingNote = el<HTMLParagraphElement>('#editing-note');
  const cancelEdit = el<HTMLParagraphElement>('#cancel-edit');
  const submit = el<HTMLButtonElement>('#entry-submit');
  const fileInput = el<HTMLInputElement>('#file-input');
  const cameraInput = el<HTMLInputElement>('#camera-input');
  const dropzone = el<HTMLDivElement>('#dropzone');
  const dropFiles = el<HTMLUListElement>('#drop-files');
  const dropMore = el<HTMLParagraphElement>('#drop-more');
  const descriptionBox = el<HTMLTextAreaElement>('#description-input');
  const descriptionBusy = el<HTMLSpanElement>('#description-busy');
  const askList = el<HTMLUListElement>('#doc-questions');
  const reading = el<HTMLParagraphElement>('#doc-reading');
  const readingText = reading;
  const warningList = el<HTMLUListElement>('#doc-warnings');
  const formFields = el<HTMLDivElement>('#form-fields');
  const manualRow = el<HTMLParagraphElement>('#manual-row');
  const body = el<HTMLTableSectionElement>('#entries');

  let catalogue: CompanyCatalogue;
  let company: Company;
  let parties: Party[] = [];
  // Feltene brukeren har endret selv siden bilaget ble valgt. En ny lesing
  // fyller ikke disse: å svare på spørsmålet i beskrivelsen leser bilaget på
  // nytt, og da skrev svaret motparten brukeren nettopp hadde rettet tilbake
  // til den gale. Tømmes når bilaget tømmes.
  const touched = new Set<string>();
  let mayWrite = false;
  // Om registeret skal si hvem som førte hva. Avgjort én gang per lasting, over
  // hele listen og ikke per rad: merket betyr «det er flere hender i denne
  // boken», og det er en egenskap ved registeret. Regelen står i lib/authors.ts.
  let marksAuthor = false;

  // Motparten som ble valgt fra lista, eller som bilaget traff i registeret.
  // Teksten i boksen er ellers det som teller, men to motparter kan hete det
  // samme, og da er det valget og ikke navnet som sier hvilken.
  let pickedParty: Party | null = null;
  // Det lista viser akkurat nå, og hvilken rad piltastene står på.
  let listed: Party[] = [];
  let active = -1;

  function option(value: string, label: string): HTMLOptionElement {
    const node = document.createElement('option');
    node.value = value;
    node.textContent = label;
    return node;
  }

  /**
   * What to call one attached file, in the two words the badge has room for.
   *
   * The same two the file list above the form uses, so a document is called the
   * same thing before it is filed and after.
   */
  function kindOf(contentType: string): string {
    return contentType.startsWith('image/') ? 'BILDE' : 'PDF';
  }

  function cell(value: string, className?: string): HTMLTableCellElement {
    const td = document.createElement('td');
    if (className !== undefined) td.className = className;
    td.textContent = value;
    return td;
  }

  /** The direction showing, or `null` before the bilag or the user has said. */
  function currentDirection(): Direction | null {
    const checked = form.querySelector<HTMLInputElement>('input[name="direction"]:checked');
    if (checked?.value === 'ut') return 'ut';
    if (checked?.value === 'inn') return 'inn';
    return null;
  }

  function selectedType(): CashFlowType | undefined {
    return catalogue.types.find((entry) => entry.code === typeSelect.value);
  }

  /** What to call an entry whose description was left empty. */
  function describedByType(): string {
    return selectedType()?.label ?? 'Betaling';
  }

  /** Hva gruppen med reverseringer heter, i hver sin retning. */
  const REVERSAL_GROUP: Record<Direction, string> = {
    inn: 'Penger tilbake på et kjøp',
    ut: 'Kreditnota til en kunde',
  };

  /** Prefikset gruppen selv sier, og som derfor ikke skal stå på hver linje. */
  const REVERSAL_PREFIX = /^(?:Refusjon|Kreditnota): /;

  /**
   * Fill the category list for the direction, reversals in a group of their own.
   *
   * Sixteen refunds against twelve ways of earning money would otherwise bury
   * the ordinary case: someone registering a sale would scroll past "Refusjon:
   * leie av lokaler" to reach it. Only grouped, never hidden, since a refund is
   * exactly as valid a thing for money to be, and the same holds the other way
   * round for the six kreditnotaer on the money-out list.
   *
   * Which family lands here is read off `reverses` rather than off the code,
   * so a reversal added to the catalogue appears in its group without this
   * page being told about it.
   */
  function fillTypes(): void {
    const direction = currentDirection();
    if (direction === null) {
      // Ingen kategori og ingen mva-kode før retningen er kjent. Lista for
      // «inn» er salg, og den første med sin 25 % var det som sto her før.
      const waiting = option('', 'Velg penger inn eller ut først');
      waiting.disabled = true;
      typeSelect.replaceChildren(waiting);
      typeSelect.value = '';
      taxSelect.value = '';
      typeNote.textContent = '';
      return;
    }
    const entries = catalogue.types.filter((t) => t.direction === direction);
    typeSelect.replaceChildren();

    const reversals = entries.filter((entry) => entry.reverses !== null);
    for (const entry of entries) {
      if (entry.reverses === null) typeSelect.append(option(entry.code, entry.label));
    }
    if (reversals.length > 0) {
      const group = document.createElement('optgroup');
      group.label = REVERSAL_GROUP[direction];
      for (const entry of reversals) {
        // The prefix is the group's job now, so the label reads as the thing
        // being reversed rather than repeating "Refusjon:" sixteen times.
        group.append(option(entry.code, capitalised(entry.label.replace(REVERSAL_PREFIX, ''))));
      }
      typeSelect.append(group);
    }
    // Nothing chosen until something chooses: the bilag, or the user. The first
    // entry used to be selected by default, so the form showed «Varekjøp» and
    // 25 % for the seconds a read took, which looked like the answer.
    const waiting = option('', 'Velg type');
    waiting.disabled = true;
    typeSelect.prepend(waiting);
    typeSelect.value = '';
    taxSelect.value = '';
    typeNote.textContent = '';
  }

  /** A label that has lost its prefix, given its capital letter back. */
  function capitalised(label: string): string {
    return label.charAt(0).toUpperCase() + label.slice(1);
  }

  /** Which kind of party the money's direction implies: we pay suppliers. */
  function preferredPartyType(): Party['party_type'] {
    // Before a direction is known, a supplier: most bilag are purchases.
    return currentDirection() === 'inn' ? 'kunde' : 'leverandor';
  }

  /**
   * The registered party the box stands for, or `null` for a new name.
   *
   * What was picked counts only while the box still says its name; typing
   * over it is choosing again. Otherwise the text decides, by the rule in
   * lib/counterparty.ts.
   */
  function partyChoice(): Party | null {
    if (pickedParty !== null && partyInput.value.trim() === pickedParty.name) return pickedParty;
    return resolveParty(partyInput.value, parties, preferredPartyType());
  }

  /** Put a name in the box, and say which registered party it is, if one. */
  function setPartyText(text: string, party: Party | null): void {
    partyInput.value = text;
    pickedParty = party;
    closePartyList();
    showPartyNote();
  }

  /**
   * Refresh what depends on the register and the direction.
   *
   * Called wherever the list used to be rebuilt: the parties arrived, the
   * direction flipped, the form was reset. The list itself is drawn when it
   * opens, so only an open one needs drawing again.
   */
  function fillParties(): void {
    if (!partyList.hidden) openPartyList(partyInput.value);
    showPartyNote();
  }

  /**
   * Show the registered parties matching `query`, the group the direction
   * implies on top.
   *
   * Both groups stay available: a refund from a supplier is money in, and a
   * credit note to a customer is money out, so filtering one away would make
   * ordinary corrections impossible to record properly.
   */
  function openPartyList(query: string): void {
    const matching = partiesMatching(query, parties);
    const groups: [string, Party[]][] = [
      ['Kunder', matching.filter((party) => party.party_type === 'kunde')],
      ['Leverandører', matching.filter((party) => party.party_type === 'leverandor')],
    ];
    if (currentDirection() !== 'inn') groups.reverse();

    partyList.replaceChildren();
    listed = [];
    active = -1;
    for (const [label, members] of groups) {
      if (members.length === 0) continue;
      const heading = document.createElement('li');
      heading.className = 'combo-group';
      heading.setAttribute('role', 'presentation');
      heading.textContent = label;
      partyList.append(heading);
      for (const party of members) {
        const row = document.createElement('li');
        row.id = `party-option-${party.id}`;
        row.setAttribute('role', 'option');
        row.setAttribute('aria-selected', 'false');
        row.dataset.index = String(listed.length);
        const number = document.createElement('span');
        number.className = 'combo-number';
        number.textContent = party.party_id;
        row.append(number, party.name);
        partyList.append(row);
        listed.push(party);
      }
    }
    if (listed.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'combo-empty';
      empty.setAttribute('role', 'presentation');
      // Ikke en feil: et navn ingen er registrert under, blir en ny motpart.
      empty.textContent =
        query.trim() === ''
          ? 'Ingen registrerte motparter ennå. Skriv navnet, så lagres det når du fører.'
          : 'Ingen registrerte motparter passer. Navnet lagres som ny motpart når du fører.';
      partyList.append(empty);
    }
    partyList.hidden = false;
    partyInput.setAttribute('aria-expanded', 'true');
    partyToggle.setAttribute('aria-expanded', 'true');
  }

  function closePartyList(): void {
    partyList.hidden = true;
    active = -1;
    partyInput.removeAttribute('aria-activedescendant');
    partyInput.setAttribute('aria-expanded', 'false');
    partyToggle.setAttribute('aria-expanded', 'false');
  }

  /** Move the keyboard's place in the open list, and keep it in view. */
  function moveActive(step: number): void {
    if (listed.length === 0) return;
    active = (active + step + listed.length) % listed.length;
    for (const row of partyList.querySelectorAll<HTMLElement>('[role="option"]')) {
      const isActive = row.dataset.index === String(active);
      row.setAttribute('aria-selected', String(isActive));
      if (isActive) {
        partyInput.setAttribute('aria-activedescendant', row.id);
        row.scrollIntoView({ block: 'nearest' });
      }
    }
  }

  /** The user chose a registered party: theirs now, not the bilag's. */
  function pickParty(party: Party): void {
    touched.add('party_id');
    markField('party_id', null);
    setPartyText(party.name, party);
  }

  /** Show the type's note and preselect the VAT code it assumes. */
  function applyType(): void {
    const entry = selectedType();
    typeNote.textContent = entry?.note ?? '';
    if (entry !== undefined) taxSelect.value = entry.default_tax_code;
    fillAccounts(entry);
  }

  /**
   * Typens egen konto først, så alle andre aktive kontoer av samme slag i
   * selskapets kontoplan. Bare samme slag: en kostnad flyttet over i balansen er
   * nettopp feilen en type finnes for å hindre, og backend nekter den også.
   */
  function fillAccounts(entry: CashFlowType | undefined): void {
    accountSelect.replaceChildren();
    if (entry === undefined || entry.account_type == null) {
      show(el('#account-field'), false);
      return;
    }
    const own = catalogue.accounts.find((account) => account.number === entry.account_number);
    accountSelect.append(
      option(entry.account_number, `${entry.account_number}${own ? ` ${own.description}` : ''}`),
    );
    const others = catalogue.accounts.filter(
      (account) => account.account_type === entry.account_type && account.number !== entry.account_number,
    );
    for (const account of others) {
      accountSelect.append(option(account.number, `${account.number} ${account.description}`));
    }
    accountSelect.value = entry.account_number;
    show(el('#account-field'), others.length > 0);
  }

  // --- Bilaget som fyller ut skjemaet ----------------------------------------

  /**
   * Mark a field as filled in from the document rather than typed.
   *
   * The label matters: a date lifted out of the text and a category a model
   * chose are not the same kind of claim, and the person about to post the
   * entry is the one who should decide how much to trust each of them.
   */
  function markField(name: string, label: string | null, source?: string): void {
    const field = form.querySelector<HTMLElement>(`.field[data-field="${name}"]`);
    if (field === null) return;
    const tag = field.querySelector<HTMLElement>('[data-tag]');
    if (label === null) {
      delete field.dataset.suggested;
      if (tag !== null) tag.hidden = true;
      return;
    }
    field.dataset.suggested = 'true';
    if (tag === null) return;
    tag.textContent = label;
    tag.hidden = false;
    if (source === undefined) delete tag.dataset.source;
    else tag.dataset.source = source;
  }

  /**
   * Say what happens to a name the register does not have yet.
   *
   * One line, and only while that choice is the one showing. Most bilag are
   * from someone the company meets once, so the ordinary case is a name in the
   * field and nothing to read about it.
   */
  function showPartyNote(): void {
    const note = el<HTMLSpanElement>('#party-note');
    const isNew = partyInput.value.trim() !== '' && partyChoice() === null;
    note.textContent = isNew ? 'Ny motpart. Navnet lagres når du fører.' : '';
    note.hidden = !isNew;
  }

  function clearMarks(): void {
    for (const field of form.querySelectorAll<HTMLElement>('.field[data-field]')) {
      markField(field.dataset.field ?? '', null);
    }
    const partyNote = el<HTMLSpanElement>('#party-note');
    partyNote.textContent = '';
    partyNote.hidden = true;
    warningList.replaceChildren();
    warningList.hidden = true;
  }

  /**
   * What each kind of proposal is called next to the field it filled.
   *
   * Three different degrees of confidence, and the user is owed the
   * difference. "Fra bilaget" means the words are printed on the page and we
   * read them. "Foreslått av KI" means Løynd answered and the user decides
   * whether it answered well. "Regnet om" means neither: the document gave a
   * total in another currency and we multiplied it by a published Norges Bank
   * rate, which is the one proposal here that can be checked against a table.
   */
  const SOURCE_LABEL: Record<FieldSource, string> = {
    dokument: 'Fra bilaget',
    ki: 'Foreslått av KI',
    beregnet: 'Regnet om',
  };

  /** Put a proposal into the form, and say which parts of it came from where. */
  function applySuggestion(suggestion: InvoiceSuggestion, { keepDescription = false } = {}): void {
    clearMarks();

    /**
     * Mark one field with where its value came from.
     *
     * "Fra bilaget" means the words are printed on the page and we read them.
     * "Foreslått av KI" means Løynd answered, and the user is the one who
     * decides whether it answered well. Nothing is marked when nothing was
     * proposed, so a field the user must fill in looks like an empty field.
     */
    const mark = (name: string): void => {
      const source = suggestion.sources[name];
      if (source === undefined) return;
      markField(name, SOURCE_LABEL[source], source);
    };

    // A field the user has changed is theirs. The read still fills every other
    // field, but on a touched one it is a proposal that arrived too late, not
    // an answer that overrules them.
    const proposes = (name: string): boolean => !touched.has(name);

    if (proposes('direction')) {
      const direction = form.querySelector<HTMLInputElement>(
        `input[name="direction"][value="${suggestion.direction}"]`,
      );
      if (direction !== null) direction.checked = true;
    }
    // The lists depend on the direction, so they are rebuilt before anything is
    // selected in them. Rebuilding the type list forgets its selection, so a
    // category the user picked is put back rather than lost to the rebuild.
    const keptType = typeSelect.value;
    const keptTax = taxSelect.value;
    fillTypes();
    fillParties();
    if (!proposes('type_code')) {
      typeSelect.value = keptType;
      applyType();
    }
    if (!proposes('tax_code')) taxSelect.value = keptTax;

    if (proposes('type_code') && suggestion.type_code !== null) {
      typeSelect.value = suggestion.type_code;
      applyType();
      mark('type_code');
    }
    // After applyType, which sets the type's own default. And not under a
    // category the user chose: the proposed code belongs to the proposed
    // category, and the user's choice already set its own default.
    if (proposes('type_code') && proposes('tax_code') && suggestion.tax_code !== null) {
      taxSelect.value = suggestion.tax_code;
      mark('tax_code');
    }
    if (proposes('occurred_on') && suggestion.occurred_on !== null) {
      el<HTMLInputElement>('#date-input').value = suggestion.occurred_on;
      mark('occurred_on');
    }
    // Null when the bilag is in a foreign currency: the ledger is in kroner, and
    // the total on the document is not that number. It is in the warnings below
    // instead, where it belongs — next to the sentence saying why the field is
    // the one thing the user has to look up.
    if (proposes('gross_amount') && suggestion.gross_amount !== null) {
      const amount = form.querySelector<HTMLInputElement>('input[name="gross_amount"]');
      if (amount !== null) amount.value = suggestion.gross_amount;
      mark('gross_amount');
    }
    // The finished value replaces whatever was streamed, because it is the
    // authoritative one: the reference goes in front of the sentence, and a
    // printed item line beats a composed one. Usually that means a prefix
    // appearing. Skipped entirely when the read was caused by the user editing
    // this field — then their sentence is the input, not the output.
    if (!keepDescription && suggestion.description !== null) {
      descriptionBox.value = suggestion.description;
      written = suggestion.description;
      readWith = suggestion.description;
      mark('description');
    } else if (keepDescription) {
      markField('description', 'Din tekst');
    }
    if (!proposes('party_id')) {
      // Left as the user set it. This is the case that used to be stuck: the
      // bilag named the buyer, the user picked something else, answered the
      // model's question in the description box, and the re-read that answer
      // triggered put the buyer back.
    } else if (suggestion.party_id !== null) {
      const party = parties.find((candidate) => candidate.id === suggestion.party_id) ?? null;
      setPartyText(party?.name ?? suggestion.counterparty_name ?? '', party);
      mark('party_id');
    } else if (suggestion.counterparty_name !== null && suggestion.sources.party_id !== undefined) {
      // Named on the bilag, not in the register, and that is a perfectly
      // ordinary thing for a bilag to be. It used to leave the field reading
      // "ingen valgt" under a sentence explaining that the sender was not a
      // registered party, which is a wordy way of showing the one thing the
      // field is for and then not showing it.
      //
      // Now the name is in the box, which the user can write over: the
      // proposal can be the wrong party, and the right one is usually printed
      // a few lines further down the same page.
      //
      // Only when the proposal is marked, which is the backend saying the name
      // is one it would stand behind as a party. A name it read but will not
      // vouch for is still in `counterparty_name`, and stays out of a list
      // whose entries turn into rows in the register.
      setPartyText(suggestion.counterparty_name, null);
      mark('party_id');
    } else {
      // What the previous read named is not evidence about this one.
      setPartyText('', null);
    }

    // Said out loud, because the alternative is a form that came back half
    // empty and no way to tell whether that was the model's considered opinion
    // or the model never having been asked. Only mentioned where it could have
    // made a difference: a document the parser read in full needs no excuse.
    const notes = [...suggestion.warnings];
    if (!suggestion.ki_used && suggestion.type_code === null) {
      notes.push(
        'KI er ikke brukt på dette bilaget, så feltene er fylt ut av vår egen lesing av ' +
          'PDF-en. Er KI slått av for selskapet, kan du slå det på igjen under KI.',
      );
    }
    for (const warning of notes) {
      const item = document.createElement('li');
      item.textContent = warning;
      warningList.append(item);
    }
    warningList.hidden = notes.length === 0;
  }

  /**
   * Show the entry fields, once and for good.
   *
   * One-way on purpose. Removing an uploaded file after the form has been
   * filled in should not sweep away what the user has since typed into it, and
   * a card that folds itself back up while someone is working in it is worse
   * than one field too many.
   */
  function revealFields(): void {
    formFields.hidden = false;
    manualRow.hidden = true;
  }

  /**
   * The files this bilag is made of, in the order they were added.
   *
   * Held here rather than read off the input, because the input cannot
   * accumulate: picking two more files replaces the two already chosen, and a
   * user assembling a FINN purchase out of four screenshots would lose the
   * first two every time they went back for more. This array is the truth, and
   * it is what gets both read and attached.
   */
  let chosen: File[] = [];

  /**
   * Which read is current, and what the model has written into the description.
   *
   * `reads` counts them so a late answer from an abandoned read can be
   * recognised and dropped. Two are genuinely in flight whenever somebody adds
   * a file while the previous read is still going, or edits the description
   * twice — and a stale answer painting the form is worse than no answer,
   * because it looks like a correct one.
   *
   * `written` is what has arrived so far in the current read, kept separately
   * from the field's value so that appending a piece cannot pick up whatever
   * the user has meanwhile typed.
   */
  let reads = 0;
  let written = '';
  /**
   * What the description held when the last read finished.
   *
   * Compared against on the way out of the field, so that tabbing through the
   * box, or clicking into it and out again, is not mistaken for an edit — the
   * model's own sentence would otherwise read as something the user had typed
   * and trigger a read of the bilag with it.
   */
  let readWith = '';

  function showFiles(): void {
    el<HTMLLabelElement>('.dropzone-cta').hidden = chosen.length > 0;
    dropFiles.hidden = chosen.length === 0;
    dropMore.hidden = chosen.length === 0;
    dropFiles.replaceChildren(
      ...chosen.map((file) => {
        const row = document.createElement('li');
        const badge = document.createElement('span');
        badge.className = 'badge';
        badge.textContent = kindOf(file.type);
        const name = document.createElement('span');
        name.className = 'file-name';
        name.textContent = `${file.name} (${fileSize(file.size)})`;
        const drop = document.createElement('button');
        drop.type = 'button';
        drop.className = 'btn-link';
        drop.textContent = 'Fjern';
        drop.addEventListener('click', () => {
          chosen = chosen.filter((candidate) => candidate !== file);
          showFiles();
          // Ikke lest på nytt automatisk. Å fjerne én av seks filer skal ikke
          // koste et halvt minutts venting og skrive over det brukeren har
          // rettet i skjemaet i mellomtiden.
        });
        row.append(badge, name, drop);
        return row;
      }),
    );
  }

  /**
   * Show what the register still needs to know.
   *
   * The answer goes in the box below and the bilag is read again, so these are
   * not decoration: they are the prompt that turns an optional free-text field
   * into a question with an answer. Cleared on every read, because a question
   * that has been answered must not still be on screen.
   */
  function showQuestions(suggestion: InvoiceSuggestion): void {
    const asks = suggestion.questions;
    askList.hidden = asks.length === 0;
    askList.replaceChildren(
      ...asks.map((ask) => {
        const row = document.createElement('li');
        if (ask.asked_by_model) row.dataset.ki = 'true';
        row.append(ask.text);
        if (ask.asked_by_model) {
          const source = document.createElement('span');
          source.className = 'ask-source';
          source.textContent = 'Spurt av KI';
          row.append(source);
        }
        return row;
      }),
    );
    // Sende folk til boksen de skal svare i, uten å stjele fokus fra det de
    // holder på med: bare når det faktisk er noe å svare på.
    if (asks.length > 0) descriptionBox.setAttribute('aria-describedby', 'doc-questions');
  }

  /** Mark the files that produced no text, so the user can see which. */
  /**
   * Lock the description while the model is on its way to writing in it.
   *
   * Only while it is *about* to be written: a field the user filled in
   * themselves is never locked, because nothing is going to overwrite it and
   * taking it away mid-sentence would be the rudest possible moment.
   */
  function describing(busy: boolean): void {
    descriptionBusy.hidden = !busy;
    descriptionBox.disabled = busy;
    // The placeholder would otherwise show through under the dots and read as
    // a question nobody is being asked yet.
    descriptionBox.placeholder = busy ? '' : DESCRIPTION_PLACEHOLDER;
  }

  const DESCRIPTION_PLACEHOLDER = descriptionBox.placeholder;

  function markUnread(suggestion: InvoiceSuggestion): void {
    markRead(suggestion.documents_read);
  }

  /** Mark the files that produced no text, so the user can see which. */
  function markRead(documents: DocumentRead[]): void {
    const rows = [...dropFiles.children];
    for (const [index, read] of documents.entries()) {
      const row = rows[index];
      if (row === undefined) continue;
      if (read.chars > 0) {
        delete (row as HTMLElement).dataset.unread;
        continue;
      }
      // Kalt to ganger per lesing, når filene er lest og når forslaget er
      // ferdig, og det sto «ikke lest» to ganger etter hver fil.
      if ((row as HTMLElement).dataset.unread === 'true') continue;
      (row as HTMLElement).dataset.unread = 'true';
      const note = document.createElement('span');
      note.className = 'file-note';
      note.textContent = 'ikke lest';
      row.append(note);
    }
  }

  /**
   * Hand the whole bilag to the backend and let it fill the form in.
   *
   * `keepDescription` says the sentence in the box is an input rather than an
   * output: it is sent to the model as context and left alone afterwards. That
   * is obviously right when the read was caused by the user editing it, and it
   * defaults to the same thing whenever the box holds anything the model did
   * not write itself — text typed before a file was even chosen, or an answer
   * to a question, both of which would otherwise be overwritten by the reply
   * they were meant to inform. `readWith` is what the model last put there, so
   * "the model's own sentence" is a comparison and not a guess.
   */
  async function readDocuments({
    keepDescription = descriptionBox.value.trim() !== '' &&
      descriptionBox.value !== readWith,
  } = {}): Promise<void> {
    if (chosen.length === 0) return;
    reads += 1;
    const read = reads;
    if (!keepDescription) {
      written = '';
      describing(true);
    }
    showFiles();
    // Reading images is inference and not parsing, so a bilag of six
    // screenshots is a genuine wait rather than a flicker. Say how many, so the
    // spinner is a progress report instead of a mystery.
    readingText.textContent =
      chosen.length === 1
        ? 'Leser bilaget …'
        : `Leser ${chosen.length} dokumenter … bilder tar litt tid.`;
    reading.hidden = false;
    submit.disabled = true;
    setStatus(formStatus, '');
    // The fields open before the answer arrives, because the description is
    // written into one of them while we wait. A form that appeared only at the
    // end would leave the typing happening somewhere the user cannot see.
    revealFields();
    // Only a direction the user clicked. One a previous read proposed is the
    // backend's own reading, and sending it back would present it as theirs.
    const retning = touched.has('direction') ? (currentDirection() ?? undefined) : undefined;
    try {
      const suggestion = await interpretDocumentStreaming(
        company.id,
        chosen,
        keepDescription ? descriptionBox.value : undefined,
        {
          retning,
          onDocuments: (documents) => {
            if (read !== reads) return;
            markRead(documents);
          },
          onNotice: (message) => {
            // Et langt bilag sies fra om mens man venter, i samme linje som
            // spinneren, fordi «dette tar litt tid» ikke er verdt noe når
            // ventetiden er over.
            if (read !== reads) return;
            readingText.textContent = message;
          },
          onDescription: (piece) => {
            // A stale read must not type into the box. Two reads can overlap —
            // the user adds a file while the previous read is still going — and
            // the older one's sentence arriving into the newer one's field
            // would interleave two descriptions character by character.
            if (read !== reads || keepDescription) return;
            // The first piece is what the dots were waiting for.
            describing(false);
            written += piece;
            descriptionBox.value = written;
            markField('description', 'Skriver …', 'ki');
          },
        },
      );
      if (read !== reads) return;
      applySuggestion(suggestion, { keepDescription });
      markUnread(suggestion);
      showQuestions(suggestion);
      revealFields();
    } catch (error: unknown) {
      if (read !== reads) return;
      // The fields open even so. A reading that failed is precisely the case
      // where the user has to fill them in, and leaving them shut would answer
      // "we could not read it" with nowhere to go.
      revealFields();
      // The upload itself is still fine, and only the reading failed, and the form
      // is filled in by hand exactly as it was before this feature existed.
      setStatus(
        formStatus,
        error instanceof ApiError
          ? `Vi fikk ikke lest bilaget: ${error.message} Fyll ut skjemaet selv.`
          : 'Vi fikk ikke lest bilaget. Fyll ut skjemaet selv.',
      );
      if (error instanceof ApiError && (error.status === 415 || error.status === 413)) {
        clearFile();
      }
    } finally {
      // Only the current read owns the spinner and the submit button. An
      // abandoned one clearing them would say "finished" while the real read is
      // still going.
      if (read === reads) {
        reading.hidden = true;
        submit.disabled = false;
        // Whatever happened, the field goes back to the user. A read that
        // failed leaves them with an empty box to fill in, and a box they
        // cannot type in is the one thing that would make that worse.
        describing(false);
      }
    }
  }

  function clearFile(): void {
    fileInput.value = '';
    chosen = [];
    showFiles();
    clearMarks();
    // No bilag, no name off one, so nothing lingers as something the form would
    // go and register. And nothing the user changed is theirs any more: the
    // next bilag starts from what it says.
    touched.clear();
    setPartyText('', null);
    askList.hidden = true;
    askList.replaceChildren();
    written = '';
    readWith = '';
  }

  /** Add files to the bilag, skipping any already on it. */
  function addFiles(files: FileList | null | undefined): void {
    if (!files || files.length === 0) return;
    for (const file of files) {
      // Same name and same size is the same file picked twice, which is what
      // happens when somebody re-opens the dialog rather than adding to it.
      const already = chosen.some(
        (candidate) => candidate.name === file.name && candidate.size === file.size,
      );
      if (!already) chosen.push(file);
    }
    // Emptied so that picking the same file again after removing it still fires
    // a change event; the array above is what we actually keep.
    fileInput.value = '';
    void readDocuments();
  }

  fileInput.addEventListener('change', () => {
    addFiles(fileInput.files);
  });
  cameraInput.addEventListener('change', () => {
    addFiles(cameraInput.files);
    // Tømt av samme grunn som filfeltet: neste bilde skal også gi en hendelse.
    cameraInput.value = '';
  });

  el<HTMLButtonElement>('#file-clear').addEventListener('click', clearFile);

  /*
    Editing the description reads the bilag again. There used to be a button
    for this, and a button is a worse design for the same thing: it asks the
    user to know that answering the question was only half of it, and the half
    that fills the form in is the one behind a control they have to notice.

    Two things keep it from being expensive. The wait is debounced past the end
    of a sentence rather than fired per keystroke, and the server remembers what
    each file said — so the second read costs a prompt and not another ninety
    seconds of transcribing screenshots.
  */
  const REREAD_AFTER_MS = 1200;
  let rereadTimer: number | undefined;

  function scheduleReread(): void {
    window.clearTimeout(rereadTimer);
    const typed = descriptionBox.value.trim();
    // Nothing to read with, nothing to read, or nothing changed since last time.
    if (chosen.length === 0 || typed === '' || typed === readWith.trim()) return;
    rereadTimer = window.setTimeout(() => {
      readWith = descriptionBox.value;
      void readDocuments({ keepDescription: true });
    }, REREAD_AFTER_MS);
  }

  descriptionBox.addEventListener('input', scheduleReread);
  // And immediately on the way out of the field, because somebody who has
  // finished typing and clicked elsewhere has finished; waiting out the timer
  // then is a pause with nothing happening in it.
  descriptionBox.addEventListener('blur', () => {
    window.clearTimeout(rereadTimer);
    const typed = descriptionBox.value.trim();
    if (chosen.length === 0 || typed === '' || typed === readWith.trim()) return;
    readWith = descriptionBox.value;
    void readDocuments({ keepDescription: true });
  });

  el<HTMLButtonElement>('#cancel-edit-button').addEventListener('click', () => {
    endEdit();
    form.reset();
    clearFile();
    clearMarks();
    el<HTMLInputElement>('#date-input').value = todayIso();
    fillTypes();
    fillParties();
    setStatus(formStatus, '');
  });

  el<HTMLButtonElement>('#manual-entry').addEventListener('click', () => {
    revealFields();
    // Straight to the first thing there is to decide. Without this the fields
    // appear below the fold on a laptop and the button looks like it did
    // nothing at all.
    typeSelect.focus();
  });

  for (const event of ['dragenter', 'dragover'] as const) {
    dropzone.addEventListener(event, (dragEvent) => {
      dragEvent.preventDefault();
      dropzone.dataset.drag = 'true';
    });
  }
  for (const event of ['dragleave', 'drop'] as const) {
    dropzone.addEventListener(event, () => {
      delete dropzone.dataset.drag;
    });
  }
  dropzone.addEventListener('drop', (dropEvent) => {
    dropEvent.preventDefault();
    // Every dropped file, not just the first. Dragging a folder of screenshots
    // onto the zone is the natural way to assemble a multi-document bilag.
    addFiles(dropEvent.dataTransfer?.files);
  });

  // --- Registeret -------------------------------------------------------------

  /** Kolonner i tabellen, som en detaljlinje må spenne over. */
  const COLUMNS = 6;

  /** En etikett og en verdi i detaljlinjen. */
  function pair(term: string, value: string): HTMLDivElement {
    const wrap = document.createElement('div');
    const dt = document.createElement('dt');
    dt.textContent = term;
    const dd = document.createElement('dd');
    dd.textContent = value;
    wrap.append(dt, dd);
    return wrap;
  }

  /**
   * Feltene som mistet kolonnen sin, som en linje under føringen de gjelder.
   *
   * Motpart, type, konto, netto, mva og mva-kode er ting man slår opp om én
   * føring. De var aldri noe man sammenlignet nedover en kolonne, og ni
   * kolonner gjorde registeret uleselig for det ene tilfellet der noen lurte
   * på hvilken mva-kode som ble brukt.
   */
  function detailRow(entry: CashFlowEntry, bilag: AttachmentInfo[]): HTMLTableRowElement {
    const row = document.createElement('tr');
    row.className = 'detail-row';
    row.hidden = true;

    const holder = document.createElement('td');
    holder.colSpan = COLUMNS;

    const list = document.createElement('dl');
    list.className = 'detail';
    list.append(
      pair('Motpart', entry.party_name ?? 'ingen'),
      pair('Type', entry.type_label ?? '-'),
      pair('Konto', `${entry.account_number} ${entry.account_description}`),
      pair('Netto', kroner(entry.net_amount)),
      pair('Mva', entry.vat_amount === '0.00' ? 'ingen' : kroner(entry.vat_amount)),
      pair('Mva-kode', entry.tax_code ?? '-'),
      // 1900 er kontantkassen og 1920 bankkontoen.
      pair('Betalt via', entry.payment_account === '1900' ? 'Kontant' : 'Bankkonto'),
      // Alltid her, også når bare én person fører: den som åpner detaljene har
      // spurt om denne føringen, og da er «hvem førte den» et av svarene.
      // Merket oppe på raden er det som kommer og går.
      pair('Ført av', authorOf(entry)),
    );
    if (bilag.length > 0) list.append(fileList(bilag));

    holder.append(list);
    row.append(holder);
    return row;
  }

  /**
   * Filene bilaget består av, én lenke per fil, med miniatyr der det finnes en.
   *
   * Her og ikke på raden. Ti skjermbilder av en AliExpress-ordre sto som ti
   * miniatyrer i registeret, og den ene føringen ble høyere enn skjermen: en
   * fil er noe man slår opp om én føring, akkurat som mva-koden, ikke noe man
   * skummer nedover. Miniatyrene hentes først når detaljlinjen åpnes.
   */
  function fileList(bilag: AttachmentInfo[]): HTMLDivElement {
    const wrap = document.createElement('div');
    wrap.className = 'detail-files';
    const dt = document.createElement('dt');
    dt.textContent = bilag.length === 1 ? 'Bilagsfil' : `Bilagsfiler (${bilag.length})`;
    const dd = document.createElement('dd');
    const files = document.createElement('ul');
    files.className = 'bilag-files';
    for (const attachment of bilag) {
      const link = document.createElement('a');
      link.className = 'bilag-file';
      link.href = documentUrl(company.id, attachment.id);
      link.title = attachment.filename;
      // Plassen står der også for en PDF, som ikke får miniatyr, så merkene
      // står under hverandre og ikke hopper etter hvilken fil som er et bilde.
      const thumb = document.createElement('span');
      thumb.className = 'bilag-thumb';
      const badge = document.createElement('span');
      badge.className = 'badge';
      badge.textContent = `${kindOf(attachment.content_type)} ${fileSize(attachment.byte_size)}`;
      const name = document.createElement('span');
      name.className = 'bilag-name';
      name.textContent = attachment.filename;
      link.append(thumb, badge, name);
      if (attachment.content_type.startsWith('image/')) watchForThumbnail(thumb, attachment.id);
      const item = document.createElement('li');
      item.append(link);
      files.append(item);
    }
    dd.append(files);
    wrap.append(dt, dd);
    return wrap;
  }

  /** Én føring: selve linjen, detaljlinjen under, og en måte å lukke begge på. */
  interface RenderedEntry {
    /** Linjen og detaljlinjen, i den rekkefølgen de skal settes inn. */
    rows: HTMLTableRowElement[];
    /** Datocellen, som en rettet føring bytter ut med en knapp. */
    when: HTMLTableCellElement;
    /** Beskrivelsescellen, som en rettet føring henger en merknad på. */
    what: HTMLTableCellElement;
    /** Vis eller skjul linjen som medlem av en sammenslått retting. */
    setVisible(visible: boolean): void;
  }

  /**
   * @param inGroup  Skjult under en sammenslått rad framfor å stå for seg selv.
   * @param bilag    Bilagene raden skal vise. For en sammenslått rad er det
   *                 gruppens, ikke bare den synlige føringens: arkivet er
   *                 append-only, så en retting kan ikke flytte PDF-en over på
   *                 den nye føringen, og den dokumenterer kjøpet uansett.
   */
  function renderEntry(
    entry: CashFlowEntry,
    inGroup: boolean,
    bilag: AttachmentInfo[] = entry.attachments,
  ): RenderedEntry {
    const row = document.createElement('tr');
    const isReversed = entry.reversed_by_id !== null;
    row.dataset.reversed = String(isReversed);
    if (inGroup) {
      row.dataset.member = 'true';
      row.hidden = true;
    }

    const detail = detailRow(entry, bilag);

    const actions = document.createElement('td');
    actions.className = 'row-actions';

    const info = document.createElement('button');
    info.type = 'button';
    info.className = 'btn-link';
    info.textContent = 'Vis info';
    info.setAttribute('aria-expanded', 'false');
    // Knappene som åpner detaljlinjen: «Vis info», og merket for flere filer.
    const openers: HTMLButtonElement[] = [info];
    const setDetail = (open: boolean): void => {
      detail.hidden = !open;
      info.textContent = open ? 'Skjul info' : 'Vis info';
      for (const opener of openers) opener.setAttribute('aria-expanded', String(open));
    };
    info.addEventListener('click', () => {
      setDetail(detail.hidden);
    });
    actions.append(info);

    // Ett merke per føring, aldri ett per fil: hvor mange filer bilaget har,
    // sier ingenting om hvor viktig føringen er, og skal ikke bestemme hvor
    // mye plass den tar. Selve filene står i detaljlinjen.
    const documents = document.createElement('td');
    const [only] = bilag;
    if (bilag.length === 1 && only !== undefined) {
      // Én fil er filen: merket lenker rett til den, som før.
      const link = document.createElement('a');
      link.href = documentUrl(company.id, only.id);
      link.className = 'badge';
      // What the file is, not what most files are. Nine screenshots of an
      // AliExpress order were all labelled "PDF", which is the register
      // describing the bilag wrongly in the one column that describes it.
      link.textContent = `${kindOf(only.content_type)} ${fileSize(only.byte_size)}`;
      link.title = only.filename;
      documents.append(link);
    } else if (bilag.length > 1) {
      const files = document.createElement('button');
      files.type = 'button';
      files.className = 'badge';
      files.textContent = `${bilag.length} FILER`;
      files.title = `Vis de ${bilag.length} filene`;
      files.setAttribute('aria-expanded', 'false');
      files.addEventListener('click', () => {
        setDetail(detail.hidden);
      });
      openers.push(files);
      documents.append(files);
    } else if (mayWrite && !isReversed) {
      documents.append(uploadControl(entry));
    }

    if (mayWrite && !isReversed && !entry.is_reversal) {
      // "Rediger" first, because it is what someone who spotted a mistake is
      // looking for. "Reverser" alone answered a question nobody asks: a
      // wrong mva-kode is not a payment that should be undone, it is a
      // payment that should be recorded correctly.
      const fix = document.createElement('button');
      fix.type = 'button';
      fix.className = 'btn-link';
      fix.textContent = 'Rediger';
      fix.addEventListener('click', () => {
        beginEdit(entry);
      });

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'btn-link';
      button.textContent = 'Reverser';
      button.addEventListener('click', () => {
        void undo(entry);
      });
      actions.append(fix, button);
    }

    const when = cell(isoDate(entry.occurred_on));
    const what = cell(entry.description);
    if (marksAuthor) {
      // Under beskrivelsen, ikke i en egen kolonne: kolonnen ville stått tom på
      // en bok med én fører, og registeret har alt seks kolonner på en telefon.
      // Samme plass som merknaden om en retting, av samme grunn.
      const who = document.createElement('span');
      who.className = 'entry-author';
      who.textContent = `Ført av ${authorOf(entry)}`;
      what.append(who);
    }
    // Datoen og bilagsnummeret brytes ikke. «2026-» over «0004» er et
    // bilagsnummer som ikke kan leses i ett blikk, og det er beskrivelsen, ikke
    // datoen, som skal gi plass når raden blir trang.
    when.classList.add('nowrap');
    row.append(
      when,
      cell(entry.voucher_no, 'nowrap'),
      what,
      cell(
        kroner(entry.gross_amount),
        `num ${entry.direction === 'inn' ? 'amount-in' : 'amount-out'}`,
      ),
      documents,
      actions,
    );

    return {
      rows: [row, detail],
      when,
      what,
      setVisible: (visible: boolean): void => {
        row.hidden = !visible;
        // En detaljlinje som ble stående åpen da gruppen ble lukket, ville
        // dukke opp igjen alene neste gang gruppen åpnes.
        if (!visible) setDetail(false);
      },
    };
  }

  /**
   * En sammenslått rad: hendelsen som står, med bilagene den brukte opp under.
   *
   * Den synlige linjen er en ekte føring og ikke et sammendrag — den rettede
   * ved en retting, den motposterte ved en ren reversering. Historikken er ett
   * klikk unna og forsvinner ikke fra regnskapet; den slutter bare å ta plass i
   * registeret på linje med betalinger som faktisk står ved lag.
   */
  function renderFolded(row: RegisterRow): HTMLTableRowElement[] {
    const live = renderEntry(row.lead, false, vouchersIn(row).flatMap((e) => e.attachments));
    const members = row.history.map((older) => renderEntry(older, true));

    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'row-toggle';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.textContent = isoDate(row.lead.occurred_on);
    live.when.replaceChildren(toggle);

    const note = foldNote(row);
    if (note !== null) {
      const line = document.createElement('span');
      line.className = 'fold-note';
      line.textContent = note;
      live.what.append(line);
    }

    let open = false;
    toggle.addEventListener('click', () => {
      open = !open;
      toggle.setAttribute('aria-expanded', String(open));
      for (const member of members) member.setVisible(open);
    });

    return [...live.rows, ...members.flatMap((member) => member.rows)];
  }

  function renderEntries(rows: RegisterRow[]): void {
    // Over alle bilagene, også de som ligger sammenslått under en retting: en
    // føring en kollega rettet er nettopp et register med to hender i.
    marksAuthor = namesAuthors(rows.flatMap(vouchersIn));
    body.replaceChildren();
    for (const row of rows) {
      body.append(
        ...(row.history.length === 0 ? renderEntry(row.lead, false).rows : renderFolded(row)),
      );
    }
    show(el('#entries-empty'), rows.length === 0);
  }

  // --- Oversikten -------------------------------------------------------------

  /** Tallene ved siden av skjemaet, og det ene av dem som ber om noe. */
  function renderSummary(summary: Summary, rows: RegisterRow[]): void {
    const count = summary.entry_count;
    el('#side-year').textContent =
      `${count} ${count === 1 ? 'føring' : 'føringer'} i ${summary.financial_year}`;

    el('#fig-cash').textContent = kroner(summary.cash_position);
    el('#fig-in').textContent = kroner(summary.total_in);
    el('#fig-out').textContent = kroner(summary.total_out);

    const net = el('#fig-net');
    net.textContent = kroner(summary.net);
    net.className = Number(summary.net) < 0 ? 'amount-out' : 'amount-in';

    // Positivt betyr å betale. Et anslag fra registeret, ikke en mva-melding,
    // og oversikten sier ikke noe annet enn det.
    el('#fig-vat').textContent = kroner(summary.vat_position);
    el('#fig-vat-note').textContent =
      Number(summary.vat_position) >= 0 ? '(anslått å betale)' : '(anslått til gode)';

    // Bokføringsloven § 10 krever at en føring er dokumentert. Ingenting går
    // galt før noen spør, og derfor er dette det ene tallet her som er verdt å
    // telle høyt.
    //
    // Telt over hendelser og ikke over bilag. En retting lager to nye bilag
    // uten PDF på seg, og arkivet er append-only, så kvitteringen blir liggende
    // på den føringen som ble motpostert. Telt per bilag ville hver retting
    // meldt om manglende dokumentasjon for et kjøp som er dokumentert, og det
    // ene tallet som skal bety noe ville blitt støy.
    const missing = rows.filter(
      (row) =>
        !hasDocument(row) && !row.lead.is_reversal && row.lead.reversed_by_id === null,
    ).length;
    const flag = el('#missing-docs');
    const what = missing === 1 ? 'Én føring mangler' : `${missing} føringer mangler`;
    flag.textContent = mayWrite
      ? `${what} bilag. Legg ved PDF-en i registeret under.`
      : `${what} bilag.`;
    flag.hidden = missing === 0;
  }

  /** A per-row "add the bilag" control, for one that arrives after the entry. */
  /**
   * Henter miniatyren når plassen til den faktisk kommer på skjermen.
   *
   * Ikke ved tegning: registeret lister hundre føringer, og en miniatyr som
   * ikke er laget ennå koster serveren et bilde å dekode. Miniatyrene står i
   * detaljlinjene, som er skjult til noen åpner dem, og ber derfor ikke om
   * noe før det.
   */
  const thumbnailWatcher =
    'IntersectionObserver' in window
      ? new IntersectionObserver((seen) => {
          for (const item of seen) {
            if (!item.isIntersecting) continue;
            thumbnailWatcher?.unobserve(item.target);
            const target = item.target as HTMLElement;
            void showThumbnail(target, Number(target.dataset.attachment));
          }
        })
      : null;

  function watchForThumbnail(slot: HTMLElement, attachmentId: number): void {
    slot.dataset.attachment = String(attachmentId);
    if (thumbnailWatcher === null) {
      void showThumbnail(slot, attachmentId);
      return;
    }
    thumbnailWatcher.observe(slot);
  }

  async function showThumbnail(slot: HTMLElement, attachmentId: number): Promise<void> {
    const picture = await fetchThumbnail(company.id, attachmentId).catch(() => null);
    if (picture === null) return;
    const image = document.createElement('img');
    // Tom alt-tekst: lenken har allerede filnavnet som tittel og merket som
    // tekst, og en skjermleser trenger ikke høre det to ganger.
    image.alt = '';
    image.decoding = 'async';
    const url = URL.createObjectURL(picture);
    image.addEventListener('load', () => URL.revokeObjectURL(url), { once: true });
    image.addEventListener('error', () => URL.revokeObjectURL(url), { once: true });
    image.src = url;
    slot.append(image);
  }

  function uploadControl(entry: CashFlowEntry): HTMLLabelElement {
    const label = document.createElement('label');
    label.className = 'btn-link';
    label.textContent = 'Legg ved bilag';
    const input = document.createElement('input');
    input.type = 'file';
    input.multiple = true;
    input.accept = ATTACHMENT_ACCEPT;
    input.hidden = true;
    input.addEventListener('change', () => {
      const files = [...(input.files ?? [])];
      if (files.length === 0) return;
      // Sequentially, so a rejected file is reported by name rather than as one
      // of several simultaneous failures.
      void files
        .reduce(
          (chain, file) => chain.then(() => uploadDocument(company.id, entry.id, file)),
          Promise.resolve() as Promise<unknown>,
        )
        .then(() => refresh())
        .catch((error: unknown) => {
          setStatus(
            pageStatus,
            error instanceof ApiError ? error.message : 'Vi fikk ikke lagret dokumentet.',
          );
        });
    });
    label.append(input);
    return label;
  }

  async function undo(entry: CashFlowEntry): Promise<void> {
    const confirmed = window.confirm(
      `Betalingen på bilag ${entry.voucher_no} skjedde ikke, og skal ut av regnskapet?\n\n` +
        'Den opprinnelige føringen blir stående og en motsatt føring legges ved siden av, ' +
        'slik bokføringsloven krever. Skal betalingen bli stående, men med andre opplysninger, ' +
        'bruk «Rediger» i stedet.',
    );
    if (!confirmed) return;
    try {
      await reverseCashFlow(company.id, entry.id);
      setStatus(pageStatus, `Bilag ${entry.voucher_no} er motpostert.`, 'ok');
      await refresh();
    } catch (error: unknown) {
      setStatus(
        pageStatus,
        error instanceof ApiError ? error.message : 'Motposteringen feilet.',
      );
    }
  }

  /**
   * The entry being edited, or null when the form is registering a new one.
   *
   * The form is one form in two modes rather than two forms. Every field, every
   * proposal and every validation rule is identical between "register this
   * payment" and "register this payment correctly this time"; only the button
   * at the bottom and where it sends differ.
   */
  let editing: CashFlowEntry | null = null;

  /**
   * Open a posted entry for editing.
   *
   * Nothing happens to the books here. The old flow reversed on click, which
   * meant opening the editor and changing your mind left a reversed entry
   * behind — a destructive read. Now the reversal and the corrected posting
   * happen together, on save, in one request (`editCashFlow`), so backing out
   * costs nothing and a dropped connection cannot leave a reversal with no
   * replacement.
   */
  function beginEdit(entry: CashFlowEntry): void {
    editing = entry;
    fillFromEntry(entry);
    editingNote.textContent =
      `Du redigerer bilag ${entry.voucher_no}. Når du lagrer, blir den opprinnelige ` +
      'føringen motpostert og den rettede lagt inn, slik bokføringsloven krever. ' +
      'Regnskapet viser da alle tre.';
    editingNote.hidden = false;
    submit.textContent = idleLabel();
    cancelEdit.hidden = false;
    formTitle.textContent = `Rediger bilag ${entry.voucher_no}`;
    setStatus(formStatus, '');
    formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /** Back to registering a new payment, leaving the edited entry as it was. */
  function endEdit(): void {
    editing = null;
    editingNote.hidden = true;
    submit.textContent = idleLabel();
    cancelEdit.hidden = true;
    formTitle.textContent = 'Registrer en betaling';
  }

  /** Hva knappen heter når ingenting er underveis, i den modusen skjemaet er i. */
  function idleLabel(): string {
    return editing === null ? 'Registrer betaling' : 'Lagre endringer';
  }

  /** Put a posted entry back into the form, ready to be corrected and re-posted. */
  function fillFromEntry(entry: CashFlowEntry): void {
    clearMarks();
    revealFields();
    warningList.replaceChildren();
    warningList.hidden = true;
    // A new posting needs its own bilag. The old one keeps the PDF it had, and
    // the archive has no delete path, so re-attaching is the user's choice
    // rather than something done silently on their behalf.
    clearFile();

    const direction = form.querySelector<HTMLInputElement>(
      `input[name="direction"][value="${entry.direction}"]`,
    );
    if (direction !== null) direction.checked = true;
    // Both lists depend on the direction, so they are rebuilt before anything
    // is selected in them.
    fillTypes();
    fillParties();

    if (entry.type_code !== null) {
      typeSelect.value = entry.type_code;
      // Sets the type's own default mva-kode, which the line below overrides
      // with what was actually posted.
      applyType();
    }
    if (entry.tax_code !== null) taxSelect.value = entry.tax_code;
    // Ført på en konto personen valgte, ikke typens egen.
    if ([...accountSelect.options].some((item) => item.value === entry.account_number)) {
      accountSelect.value = entry.account_number;
    }
    el<HTMLInputElement>('#date-input').value = entry.occurred_on;

    const amount = form.querySelector<HTMLInputElement>('input[name="gross_amount"]');
    if (amount !== null) amount.value = entry.gross_amount;
    // The description is the textarea at the top of the form now, not an input
    // further down. Editing an entry has to fill in the one that exists.
    descriptionBox.value = entry.description;
    readWith = entry.description;
    const party = parties.find((candidate) => candidate.id === entry.party_id) ?? null;
    setPartyText(party?.name ?? '', party);

    const method = form.querySelector<HTMLSelectElement>('select[name="payment_method"]');
    // 1900 is the cash account and 1920 the bank one; anything else is a
    // company with a kontoplan of its own, and bank is the safer assumption.
    if (method !== null) method.value = entry.payment_account === '1900' ? 'kontant' : 'bank';
  }

  async function refresh(): Promise<void> {
    const [entries, summary] = await Promise.all([
      listCashFlow(company.id, 200),
      getSummary(company.id),
    ]);
    const rows = foldCorrections(entries);
    renderEntries(rows);
    renderSummary(summary, rows);
  }

  form.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.name === 'direction') {
      touched.add('direction');
      fillTypes();
      fillParties();
      // Both lists just changed under the proposal, so neither may keep
      // claiming to hold what the document said.
      markField('type_code', null);
      markField('tax_code', null);
      // And the bilag is read again with the user's answer, so the category,
      // the VAT code and the description come from the right side of the
      // ledger instead of being left for them to redo. A read already under
      // way is abandoned: `reads` drops its answer when it arrives. The
      // category list was just rebuilt for the new direction, so the category
      // is the read's to fill again rather than the user's.
      touched.delete('type_code');
      touched.delete('tax_code');
      if (chosen.length > 0) {
        const typed = descriptionBox.value.trim();
        // The user's own sentence is context; one the model is writing or
        // wrote is output, and is written again.
        const theirs =
          typed !== '' && descriptionBox.value !== readWith && descriptionBox.value !== written;
        void readDocuments({ keepDescription: theirs });
      }
    }
    if (target === typeSelect) {
      // applyType resets the VAT code to the new type's default.
      applyType();
      markField('tax_code', null);
    }
    // A field the user has touched is no longer a proposal, and must stop
    // claiming to be one.
    if (target instanceof HTMLElement) {
      const field = target.closest<HTMLElement>('.field[data-field]');
      if (field !== null) {
        markField(field.dataset.field ?? '', null);
        // And a later read of the same bilag leaves it alone. See `touched`.
        touched.add(field.dataset.field ?? '');
      }
    }
  });

  // Per keystroke rather than on change: the list narrows while the name is
  // being written, and a re-read that lands mid-word must already know the
  // field is the user's.
  partyInput.addEventListener('input', () => {
    touched.add('party_id');
    markField('party_id', null);
    pickedParty = null;
    openPartyList(partyInput.value);
    showPartyNote();
  });

  partyInput.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (partyList.hidden) openPartyList('');
      moveActive(event.key === 'ArrowDown' ? 1 : -1);
    } else if (event.key === 'Enter' && !partyList.hidden && active >= 0) {
      // Picks the row, and does not submit the form.
      event.preventDefault();
      const party = listed[active];
      if (party !== undefined) pickParty(party);
    } else if (event.key === 'Escape' && !partyList.hidden) {
      event.preventDefault();
      closePartyList();
    }
  });

  partyInput.addEventListener('blur', closePartyList);

  // The arrow lists everyone, not just what matches the box: with a name
  // already in it, a filtered list would show that name and nothing to pick
  // instead, which is the one time the list is wanted.
  partyToggle.addEventListener('click', () => {
    if (partyList.hidden) {
      partyInput.focus();
      openPartyList('');
    } else {
      closePartyList();
    }
  });

  // Mousedown, not click, keeps the focus in the box, so its blur does not
  // close the list before the click lands.
  partyList.addEventListener('mousedown', (event) => event.preventDefault());
  partyToggle.addEventListener('mousedown', (event) => event.preventDefault());
  partyList.addEventListener('click', (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
    const party = row === null ? undefined : listed[Number(row.dataset.index)];
    if (party !== undefined) pickParty(party);
  });

  /**
   * The party the voucher points at, registering the name in the box first
   * when no registered party has it.
   *
   * Only the name goes in. The number is generated and the organisasjonsnummer
   * stays empty, because a name is what the bilag actually said, and a party
   * with nothing but a name is still a party the next bilag can be matched
   * against.
   */
  async function chosenParty(): Promise<number | null> {
    const registered = partyChoice();
    if (registered !== null) return registered.id;
    // The box, not the proposal: it is the one the user can correct.
    const name = partyInput.value.trim();
    if (name === '') return null;
    try {
      const party = await createParty(company.id, {
        // Money out means we are the customer, so the other side is a supplier.
        party_type: currentDirection() === 'ut' ? 'leverandor' : 'kunde',
        name,
      });
      parties = [...parties, party];
      return party.id;
    } catch (error: unknown) {
      // Said in terms of the form the user is looking at. The register's own
      // wording is about numbers and duplicates, which reads like a mystery
      // next to a payment that has nothing wrong with it.
      throw new ApiError(
        error instanceof ApiError ? error.status : 0,
        `Vi fikk ikke lagt ${name} inn som motpart, så betalingen er ikke ført. ` +
          'Velg «ingen valgt» og før den, eller prøv igjen.',
        null,
      );
    }
  }

  /**
   * Hvor mange av bilagets filer som lastes opp samtidig.
   *
   * De gikk én og én, og ti filer tok åtte sekunder bak en knapp som ikke sa
   * noe. Ventetiden var ikke båndbredde, men rundturer: hver opplasting slår
   * opp økten, medlemskapet og bilaget, skriver til R2 og lagrer raden, og ti
   * slike i kø er ti ganger den samme ventingen. Fire, ikke ti, fordi
   * databasen har fem faste tilkoblinger, og registeret som hentes etterpå og
   * kollegers forespørsler skal ikke stå i kø bak én persons skjermbilder.
   *
   * Prisen er rekkefølgen: filene kan havne i arkivet i en annen rekkefølge
   * enn de ble valgt i. Den sier ingenting om bilaget, og registeret viser et
   * antall, ikke en rekke.
   */
  const UPLOADS_AT_ONCE = 4;

  /** Knappen sier hva den venter på, så et trykk aldri ser ut som et heng. */
  function busy(text: string): void {
    submit.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    submit.textContent = text;
  }

  function idle(): void {
    submit.disabled = false;
    submit.removeAttribute('aria-busy');
    submit.textContent = idleLabel();
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    // Captured before the form is reset, and every one of them: the bilag is
    // all of the documents, and archiving only the first would leave four of
    // five screenshots of a FINN purchase nowhere at all.
    const attaching = [...chosen];

    busy(editing === null ? 'Fører betalingen …' : 'Lagrer endringene …');
    setStatus(formStatus, '');
    // Captured before the request, because the handler below ends edit mode.
    const edited = editing;
    const values = {
      type_code: String(data.get('type_code') ?? ''),
      occurred_on: String(data.get('occurred_on') ?? ''),
      gross_amount: String(data.get('gross_amount') ?? ''),
      // Optional to the user, not to the ledger. A voucher has to say what it
      // concerns, so an empty box falls back to the category the user did
      // choose: "Varekjøp" beside a date and an amount is a real bilagstekst,
      // and it is what the register would have shown anyway. Refusing to post
      // instead would make "(valgfritt)" a label over a field that blocks you.
      description: String(data.get('description') ?? '').trim() || describedByType(),
      tax_code: String(data.get('tax_code') ?? ''),
      payment_method: (data.get('payment_method') === 'kontant' ? 'kontant' : 'bank') as
        | 'bank'
        | 'kontant',
      // Filled in below: the one choice that is not a row in the register has
      // to become one before the voucher can point at it.
      party_id: null as number | null,
      // Tom når typen ikke har noe alternativ: da fører backend til typens konto.
      account_number: String(data.get('account_number') ?? '') || null,
    };
    const saving = chosenParty().then((partyPk) => {
      values.party_id = partyPk;
      return edited === null
        ? recordCashFlow(company.id, values)
        : editCashFlow(company.id, edited.id, values);
    });
    void saving
      .then(async (entry) => {
        // The entry is posted whether or not the documents stick; a failed
        // upload must therefore not read as a failed registration. Each is
        // attached on its own and a failure names the file, because "the
        // document was rejected" about six of them says nothing actionable.
        const count = attaching.length;
        const progress = (done: number): void => {
          busy(
            count === 1
              ? 'Laster opp dokumentet …'
              : `Laster opp dokumentene … ${done} av ${count}`,
          );
        };
        if (count > 0) progress(0);
        const results = await settleLimited(
          attaching,
          UPLOADS_AT_ONCE,
          (file) => uploadDocument(company.id, entry.id, file),
          progress,
        );
        const rejected = attaching
          .filter((_, index) => results[index]?.status === 'rejected')
          .map((file) => file.name);
        if (rejected.length > 0) {
          setStatus(
            pageStatus,
            `Betalingen er ført, men disse ble ikke lagret: ${rejected.join(', ')}. ` +
              'Legg dem ved på nytt fra registeret under.',
          );
        }
        setStatus(
          formStatus,
          edited === null
            ? `Bilag ${entry.voucher_no} er ført.`
            : `Bilag ${edited.voucher_no} er rettet. Motposteringen og den rettede føringen ` +
              `(${entry.voucher_no}) står i registeret.`,
          'ok',
        );
        endEdit();
        form.reset();
        clearFile();
        descriptionBox.value = '';
        el<HTMLInputElement>('#date-input').value = todayIso();
        fillTypes();
        fillParties();
        // Ledig før registeret er hentet: betalingen er ført, og neste bilag
        // skal ikke vente på at listen tegnes. Ikke i en `finally` heller, som
        // ville sluppet knappen løs midt i lesingen av et bilag som ble lagt
        // til i mellomtiden.
        idle();
        // Egen feilmelding, fordi feilen under gjelder føringen. Et register
        // som ikke ble hentet, sa «Vi fikk ikke ført betalingen» om en betaling
        // som var ført, og det neste brukeren gjør da, er å føre den på nytt.
        await refresh().catch(() => {
          setStatus(
            pageStatus,
            'Betalingen er ført, men registeret under ble ikke oppdatert. Last siden på nytt.',
          );
        });
      })
      .catch((error: unknown) => {
        setStatus(
          formStatus,
          error instanceof ApiError
            ? error.message
            : edited === null
              ? 'Vi fikk ikke ført betalingen.'
              : 'Vi fikk ikke lagret endringen. Den opprinnelige føringen står som før.',
        );
        idle();
      });
  });

  void loadSession().then(async (session) => {
    if (session === null) {
      redirectToLogin();
      return;
    }
    try {
      const companies = await loadCompanies();

      if (companies.length === 0) {
        // Nothing to book into yet; the overview is where a company is created.
        window.location.href = '/';
        return;
      }

      const current = currentCompany(companies);
      if (current === undefined) return;
      company = current;
      // Selskapets egen katalog, ikke den felles: standardkoden følger
      // mva-registreringen, og en type med deaktivert konto tilbys ikke.
      catalogue = await getCompanyCatalogue(company.id);

      el('#company-name').textContent = company.name;
      mayWrite = can(session, company.organization_id, 'ledger:write');
      show(el('#form-card'), mayWrite);
      show(el('#readonly'), !mayWrite);

      for (const code of catalogue.tax_codes) {
        taxSelect.append(option(code.code, `${code.code}: ${code.description}`));
      }

      el<HTMLInputElement>('#date-input').value = todayIso();
      el('#file-hint').textContent =
        `Dra PDF-en hit, eller velg fil. Maks ${fileSize(catalogue.max_attachment_bytes)}.`;
      fillTypes();

      // Asked together, not one after the other. The counterparty list and the
      // register are two independent questions about the same company, and in
      // single file the second could not leave the browser until the first had
      // crossed the country and come back. Nothing between them reads
      // `parties`, so there was nothing ordering them but the way it was
      // written.
      const [loadedParties] = await Promise.all([listParties(company.id), refresh()]);
      parties = loadedParties;
      fillParties();

      loading.hidden = true;
      content.hidden = false;
    } catch (error: unknown) {
      loading.hidden = true;
      setStatus(
        pageStatus,
        error instanceof ApiError ? error.message : 'Vi fikk ikke hentet registeret.',
      );
    }
  });
</script>
