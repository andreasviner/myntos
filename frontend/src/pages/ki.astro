---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * Hvem som kjører KI-en i Myntos, og bryteren som slår den av.
 *
 * Siden var lang. Den forklarte hvert felt, siterte hver ledetekst og hadde en
 * tabell over hva som kom fra parseren og hva som kom fra modellen. Alt sammen
 * var sant, og nesten ingen leste det, fordi det ikke er tre spørsmål en bruker
 * stiller om KI. Det er ett: hvor blir bilaget mitt av?
 *
 * Så siden svarer på det, én gang, og gir to knapper: les mer hos Løynd, eller
 * slå det av. Detaljene ligger fortsatt i personvernerklæringen, som er stedet
 * de hører hjemme fordi det er den som er bindende.
 *
 * Bryteren er ekte. `ki_enabled` står på selskapet, ikke på brukeren, og av
 * betyr at ingen dokumenter lastes opp til Løynd i det hele tatt — verken til
 * modellen eller til tekstuthentingen. Se
 * backend/src/myntos/domain/ledger/models.py.
 */
---

<BaseLayout
  title="KI i Myntos: kjørt av Løynd, i Norge"
  description="All kunstig intelligens i Myntos kjøres av Løynd på norske servere. Ingenting lagres, ingenting trener en modell, og du kan slå det helt av."
>
  <p class="pill">Kunstig intelligens</p>

  <section class="card headline">
    <span class="loynd-mark" role="img" aria-label="Løynd"></span>
    <h1>All KI i Myntos kjøres av Løynd</h1>
    <p class="lead">
      Løynd er en norsk KI-tjeneste fra samme selskap som lager Myntos. Serverne står i Norge,
      bilagene dine blir ikke lagret, og de trener ingen modell. Det er hele grunnen til at et
      bilag i det hele tatt får forlate programmet.
    </p>
    <ul class="ticks">
      <li>Beløp leser vi alltid selv, rett fra teksten. Modellen skriver aldri et tall i regnskapet.</li>
      <li>Ingenting bokføres automatisk. Du ser og bekrefter hvert forslag.</li>
      <li>KI brukes bare når du selv laster opp et bilag eller ber om et fakturaforslag.</li>
    </ul>
    <p class="actions">
      <a class="btn btn-primary" href="https://loynd.no" rel="noopener">Mer om Løynd</a>
      <a class="btn btn-ghost" href="/personvern/">Personvern</a>
    </p>
  </section>

  <section class="card switch" data-auth-only="inn">
    <h2>Slå av KI</h2>
    <p>
      KI er på. Slår du det av, gjelder det hele programmet for dette selskapet: ingen dokumenter
      sendes til Løynd, og skjemaene fylles ut av programmets egen lesing av PDF-en.
    </p>
    <label class="picker" hidden>
      <span>Selskap</span>
      <select id="company-picker"></select>
    </label>
    {/*
      Avkrysset betyr av, ikke på.

      Boksen het «Bruk KI for dette selskapet», og da er den normale
      tilstanden en avkrysset boks. En avkrysset boks leses som noe du har
      slått på, og de fleste har ikke slått på noe: KI er på fordi det er
      standarden. Verre er det at feilretningen blir farlig. Kommer feltet
      tomt tilbake, blir en «bruk»-boks stående umerket, og siden påstår at
      KI er av mens den er på.

      Snudd er begge deler riktige. Umerket er standardtilstanden, og det er
      det den umerkede boksen viser. Handlingen har navnet sitt: du krysser av
      for å slå noe av.
    */}
    <label class="check">
      <input type="checkbox" id="ki-toggle" />
      <span>Slå av KI-funksjoner for dette selskapet</span>
    </label>
    <p class="status" id="ki-status" role="status" hidden></p>
  </section>

  <section class="card signed-out" data-auth-only="ut">
    <p>
      <a href="/logg-inn/">Logg inn</a> for å slå KI av eller på for et selskap.
    </p>
  </section>
</BaseLayout>

<style>
  .headline {
    text-align: center;
  }

  /* Løynd ships one mark per background: dark ink for a light page, a pale
     one for a dark page. Our theme is an attribute the visitor sets, not the
     OS setting, so the swap is a CSS rule here rather than a media query
     inside the file. A background image is what lets CSS pick; the element
     carries the name for a screen reader instead of an alt text. */
  .loynd-mark {
    width: 96px;
    height: 96px;
    margin: 0 auto 1rem;
    display: block;
    background: url('/loynd-logo-on-light.svg') center / contain no-repeat;
  }

  :global(:root[data-theme='dark']) .loynd-mark {
    background-image: url('/loynd-logo-on-dark.svg');
  }

  .headline h1 {
    margin-top: 0;
  }

  .headline .lead {
    max-width: 46ch;
    margin-inline: auto;
  }

  /* Left-aligned inside a centred card: a list of statements is read line by
     line, and centring the lines takes the ragged edge the eye returns to. */
  .ticks {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto;
    max-width: 52ch;
    text-align: left;
    display: grid;
    gap: 0.6rem;
  }

  .ticks li {
    padding-left: 1.6rem;
    position: relative;
  }

  .ticks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 0;
  }

  /* Same shape as the tick rows on /faktura and /organisasjon. Astro scopes
     styles per page, so the rule is repeated rather than shared. */
  .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
  }

  .switch .picker {
    display: block;
    margin-bottom: 1rem;
  }

  .switch .picker span {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .signed-out {
    text-align: center;
  }
</style>

<script>
  import { ApiError, updateCompany, type Company } from '../lib/api';
  import { currentCompany, loadCompanies, mountCompanyPicker } from '../lib/company';
  import { el, setStatus } from '../lib/dom';
  import { loadSession } from '../lib/session';

  async function mount(): Promise<void> {
    const session = await loadSession();
    if (session === null) return;

    const companies = await loadCompanies();
    let company = currentCompany(companies);
    if (company === undefined) return;

    const toggle = el<HTMLInputElement>('#ki-toggle');
    const status = el<HTMLParagraphElement>('#ki-status');
    const picker = el<HTMLSelectElement>('#company-picker');

    /**
     * Whether KI is on for a company.
     *
     * `!== false` rather than a plain read: an older backend, or one mid-way
     * through a rollout, answers without the field at all, and `undefined`
     * would then read as off. On is the default and the truthful answer while
     * the field is unknown, so it is the one an absent value falls back to.
     */
    const isOn = (shown: Company): boolean => shown.ki_enabled !== false;

    function render(shown: Company): void {
      // Checked means off. See the note on the checkbox.
      toggle.checked = !isOn(shown);
      setStatus(
        status,
        isOn(shown)
          ? ''
          : 'KI er av. Bilag sendes ikke til Løynd, og skjemaene fylles ut av vår egen lesing.',
        'ok',
      );
    }

    mountCompanyPicker(picker, companies, company, (chosen) => {
      company = chosen;
      render(chosen);
    });
    // The picker hides itself when there is only one company; the label around
    // it has to go with it, or the page shows the word "Selskap" over nothing.
    el<HTMLLabelElement>('.switch .picker').hidden = picker.hidden;
    render(company);

    toggle.addEventListener('change', async () => {
      if (company === undefined) return;
      // The box says "slå av", so a tick is a request to disable.
      const wanted = !toggle.checked;
      toggle.disabled = true;
      try {
        const saved = await updateCompany(company.id, { ki_enabled: wanted });
        company = saved;
        // Replace it in the list too, so switching away and back does not show
        // the value this page just changed.
        const index = companies.findIndex((entry) => entry.id === saved.id);
        if (index !== -1) companies[index] = saved;
        render(saved);
      } catch (error) {
        // Put the switch back where it was. A control that keeps a position the
        // server rejected is a control that lies about the state of the books.
        toggle.checked = wanted;
        setStatus(
          status,
          error instanceof ApiError && error.status === 403
            ? 'Du må være administrator i organisasjonen for å endre dette.'
            : 'Fikk ikke lagret. Prøv igjen.',
        );
      } finally {
        toggle.disabled = false;
      }
    });
  }

  void mount();
</script>
