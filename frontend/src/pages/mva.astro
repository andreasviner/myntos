---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mva-melding | Myntos"
  description="Se mva-meldingen for hver termin, kontroller den hos Skatteetaten og send den inn."
  width="wide"
>
  <header class="page-head">
    <div>
      <p class="eyebrow">Mva-melding</p>
      {/* Selskapet er overskriften, slik som på oversikten: en mva-melding
          sendes for ett bestemt organisasjonsnummer, og det skal stå der man
          ser det før man trykker på noe. */}
      <h1 data-session-company></h1>
      <p class="muted orgnr" id="orgnr"></p>
    </div>
    <div class="head-actions year-nav" role="group" aria-label="År">
      <button type="button" class="btn btn-ghost btn-small" id="year-prev" aria-label="Året før"
        >‹</button
      >
      <span class="year" id="year"></span>
      <button type="button" class="btn btn-ghost btn-small" id="year-next" aria-label="Året etter"
        >›</button
      >
    </div>
  </header>

  <p class="lead">
    Meldingen bygges av det du har ført, kode for kode, og du ser hver linje før noe sendes.
    Skatteetaten kontrollerer den først. Den sendes bare når du bekrefter beløpet du så.
    Uttak, tap på krav og justeringer føres <a href="/mva-justeringer/">på en egen side</a> og kommer
    med på egne linjer.
  </p>

  <p class="status" id="page-status" hidden></p>

  {/* Egen markering og ikke en statuslinje, fordi den må lenke til stedet det
      rettes. Står ikke registreringen riktig, er alt under feil, ikke bare
      knappen. */}
  <p class="status" id="not-registered" data-tone="error" hidden>
    Selskapet er ikke merket som registrert i Merverdiavgiftsregisteret, og da sendes det ingen
    mva-melding. Er det feil, rett det under <a href="/organisasjon/#selskap">Selskapet</a>.
  </p>

  <div class="empty" id="loading">Henter …</div>

  <div id="content" hidden>
    <div class="card settings">
      <div class="setting">
        <span class="setting-label">Terminlengde</span>
        <select id="period-type" hidden></select>
        <span id="period-type-text"></span>
      </div>
      <div class="setting">
        <span class="setting-label">Meldingstype</span>
        <select id="category" hidden></select>
        <span id="category-text"></span>
      </div>
      <p class="card-hint setting-hint">
        Annenhver måned er det vanlige. Månedlig og årlig termin får man etter søknad hos
        Skatteetaten, så velg det bare når de har sagt ja.
      </p>
      <p class="status" id="settings-status" hidden></p>
    </div>

    {/* Den andre meldingen: et gårdsbruk med annen næring over 30 000 kroner
        leverer både primærnæringsmeldingen og en alminnelig melding. Hvilken
        melding en linje går i, avgjøres av kontoen. Hvordan inngående mva på
        kostnader begge næringene bruker skal deles, er ikke avklart, så
        Myntos deler ingenting selv; det står her, der kontoene velges. */}
    <section class="card second" id="second" hidden>
      <h2 class="card-title">Den andre meldingen</h2>
      <div id="second-current" hidden>
        <p id="second-summary"></p>
        <p class="muted" id="second-accounts"></p>
      </div>
      <p class="card-hint" id="second-intro">
        Et gårdsbruk, skogbruk eller fiske med annen næring ved siden av (brøyting, gårdsbutikk,
        maskinutleie) leverer to mva-meldinger når salget i den andre næringen er over 30 000
        kroner i året: primærnæringsmeldingen og en alminnelig melding, hver med sine terminer.
        Sett det bare opp når Skatteetaten har registrert begge.
      </p>
      <p class="card-hint shared-costs">
        Kontoene avgjør hvilken melding mvaen går i. En kostnad begge næringene bruker, deles ikke
        av Myntos: hele linjen går i meldingen kontoen hører til, og en konto som ikke står i listen,
        går i hovedmeldingen. Avgjør selv (gjerne med regnskapsføreren) hvilken melding kostnaden
        hører til, og før den på den kontoen, eller del den på to linjer på to kontoer.
      </p>
      <form id="second-form" novalidate hidden>
        <label class="field">
          <span>Terminlengde</span>
          <select name="period_type" id="second-period-type"></select>
        </label>
        <label class="field">
          <span>Fra og med</span>
          <input type="date" name="valid_from" id="second-valid-from" required />
        </label>
        <label class="field">
          <span>Kontoer</span>
          <input type="text" name="accounts" id="second-accounts-input" inputmode="numeric" />
          <span class="field-hint">
            Kontonumrene salget og kostnadene i den andre næringen føres på, skilt med komma. Legg
            dem til under <a href="/kontoplan/">Kontoplan</a> først.
          </span>
        </label>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit" id="second-save">Lagre den andre meldingen</button>
          <button class="btn btn-ghost" type="button" id="second-remove" hidden
            >Fjern den andre meldingen</button
          >
        </div>
      </form>
      <p class="status" id="second-status" hidden></p>
    </section>

    {/* Faner bare når det finnes to meldinger: ett valg er ikke et spørsmål. */}
    <div class="naeringer" id="naeringer" role="group" aria-label="Melding" hidden></div>

    <div class="card">
      <div class="table-scroll">
        <table class="data">
          <thead>
            <tr>
              <th>Termin</th>
              <th>Frist</th>
              <th class="num">Beløp</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="periods"></tbody>
        </table>
      </div>
    </div>

    <section class="card period" id="period" hidden aria-live="polite">
      <div class="period-head">
        <div>
          <h2 class="card-title" id="period-title"></h2>
          <p class="card-hint" id="period-dates"></p>
        </div>
        <a class="btn btn-ghost btn-small" id="period-xml" href="#">Last ned XML</a>
      </div>

      <ul class="blockers" id="blockers" hidden></ul>
      <p class="status" id="overdue" data-tone="error" hidden>
        Fristen er passert, og ingenting er sendt for terminen.
      </p>
      <p class="card-hint" id="period-shared-costs" hidden>
        Selskapet leverer to mva-meldinger. En kostnad går i sin helhet i meldingen kontoen hører
        til; Myntos deler ikke kostnader begge næringene bruker.
      </p>

      {/* Sendt fra et annet program: en opplysning fra personen, ikke en
          innsending. En ny melding for terminen ville erstattet den andre hos
          Skatteetaten, så terminen sperres for kontroll og innsending her til
          merkingen angres. */}
      <div class="elsewhere" id="elsewhere" hidden>
        <p id="elsewhere-text"></p>
        <p id="elsewhere-compare"></p>
        <button class="btn btn-ghost btn-small" type="button" id="elsewhere-undo" hidden>Angre</button>
      </div>
      <div class="elsewhere" id="elsewhere-mark" hidden>
        <p id="elsewhere-proposal" hidden></p>
        <details id="elsewhere-details">
          <summary>Sendt fra et annet program?</summary>
          <p class="card-hint">
            Ble terminen sendt fra programmet du brukte før, merk den her. Da regnes den ikke som
            forsinket, og Myntos sender ikke en ny melding som ville erstattet den.
          </p>
          <form id="elsewhere-form" novalidate>
            <label class="field">
              <span>Sendt dato</span>
              <input type="date" name="filed_on" required />
            </label>
            <label class="field">
              <span>Beløp <span class="muted">(valgfritt)</span></span>
              <input type="text" name="amount" inputmode="decimal" />
              <span class="field-hint">
                Det det andre programmet sendte: positivt å betale, negativt til gode.
              </span>
            </label>
            <input type="hidden" name="voucher_id" />
            <button class="btn btn-primary" type="submit" id="elsewhere-submit"
              >Merk som sendt fra et annet program</button
            >
          </form>
        </details>
      </div>
      <p class="status" id="elsewhere-status" hidden></p>
      <p class="status" id="changed" data-tone="error" hidden>
        Regnskapet for terminen er endret etter at meldingen ble sendt. Tallene under er slik de er
        nå. Send en ny melding for terminen, så erstatter den den forrige.
      </p>
      <p class="status" id="unreconciled" data-tone="error" hidden></p>

      <div class="table-scroll">
        <table class="data lines">
          <thead>
            <tr>
              <th>Kode</th>
              <th>Hva</th>
              <th class="num">Grunnlag</th>
              <th class="num">Sats</th>
              <th class="num">Mva</th>
            </tr>
          </thead>
          <tbody id="lines"></tbody>
        </table>
      </div>
      <p class="empty" id="lines-empty" hidden>
        Ingenting å rapportere i terminen. Meldingen skal likevel sendes, med null.
      </p>

      <dl class="totals">
        <dt>Utgående mva</dt>
        <dd id="total-out"></dd>
        <dt>Inngående mva</dt>
        <dd id="total-in"></dd>
        <dt id="total-label"></dt>
        <dd class="grand" id="total"></dd>
      </dl>

      <div class="actions" id="actions">
        <p class="card-hint" id="not-configured" hidden>
          Innsending fra Myntos er ikke satt opp her. Last ned meldingen som XML og last den opp i
          Skatteetatens portal for mva-meldingen.
        </p>
        <a class="btn btn-primary" id="login" href="#" hidden>Logg inn med ID-porten</a>
        <form id="check-form" novalidate hidden>
          <label class="field">
            <span>Merknad til Skatteetaten <span class="muted">(valgfritt)</span></span>
            <textarea name="merknad" rows="2" maxlength="4000"></textarea>
            <span class="field-hint">
              Bare hvis et tall trenger en forklaring. Kontrollen sier fra når den vil ha en.
            </span>
          </label>
          <button class="btn btn-primary" type="submit" id="check">Kontroller hos Skatteetaten</button>
          <p class="card-hint">Kontrollen sender ingenting inn. Du ser svaret før du bestemmer deg.</p>
        </form>
        <p class="status" id="action-status" hidden></p>
      </div>

      {/* Innsendingen er et steg og ikke en dialog: den kan ikke trekkes
          tilbake, bare erstattes av en ny melding. Kortet viser meldingen slik
          den ble kontrollert, Skatteetatens svar, og hvem den sendes for. */}
      <div class="review" id="review" hidden>
        <h3>Send inn</h3>
        <p id="review-verdict"></p>
        <ul class="findings" id="review-findings" hidden></ul>
        <label class="check">
          <input type="checkbox" id="confirm" />
          <span id="confirm-text"></span>
        </label>
        <button class="btn btn-primary" type="button" id="submit" disabled></button>
        <p class="status" id="submit-status" hidden></p>
      </div>

      <div id="history" hidden>
        <h3>Meldinger for terminen</h3>
        <ol class="filings" id="filings"></ol>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .orgnr {
    margin: 0.2rem 0 0;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    margin: 0 0 0.4rem;
  }
  .year-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .year {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 3.5rem;
    text-align: center;
  }
  .settings {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .setting {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .setting-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .setting-hint {
    flex-basis: 100%;
    margin: 0;
  }
  .second {
    margin-bottom: 1.5rem;
  }
  .second form {
    display: grid;
    gap: 0.75rem;
    max-width: 30rem;
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .naeringer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .naeringer :global(button[aria-pressed='true']) {
    border-color: var(--accent);
    font-weight: 700;
  }
  .elsewhere {
    margin: 0.5rem 0 1rem;
    max-width: 40rem;
  }
  .elsewhere form {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .period {
    margin-top: 1.5rem;
  }
  .period-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .blockers {
    margin: 0.5rem 0 1rem;
    padding-left: 1.2rem;
    color: var(--negative);
  }
  .totals {
    display: grid;
    grid-template-columns: max-content max-content;
    justify-content: end;
    gap: 0.3rem 1.5rem;
    margin: 1rem 0 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .totals dt {
    color: var(--muted);
  }
  .totals dd {
    margin: 0;
    text-align: right;
  }
  .totals .grand {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 36rem;
  }
  .actions form {
    width: 100%;
  }
  .actions textarea {
    width: 100%;
  }
  .review {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius-small);
    max-width: 40rem;
  }
  .review h3,
  #history h3 {
    margin-top: 0;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.8rem 0;
  }
  .check input {
    margin-top: 0.25rem;
  }
  .findings {
    padding-left: 1.2rem;
    margin: 0.5rem 0;
  }
  /* Funnene, terminene og innsendingene lages av skriptet, så reglene for
     dem henges på listene og tabellen i malen og når radene med :global(). */
  .findings :global(li) {
    margin-bottom: 0.35rem;
  }
  #history {
    margin-top: 2rem;
  }
  .filings {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .filings > :global(li) {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    padding: 0.75rem 1rem;
  }
  .filings :global(.filing-head) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }
  .filings :global(.filing-meta) {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
  }
  .filings :global(.filing-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.5rem;
  }
  #periods :global(.badge[data-tone='ok']),
  .filings :global(.badge[data-tone='ok']) {
    background: var(--accent-soft);
    color: var(--positive);
  }
  #periods :global(.badge[data-tone='error']),
  .filings :global(.badge[data-tone='error']) {
    background: var(--danger-bg);
    color: var(--negative);
  }
  #periods :global(tr[data-open='true'] td) {
    background: var(--surface-2);
  }
</style>

<script>
  import {
    ApiError,
    checkMvaPeriod,
    fetchMvaFeedback,
    getGovernmentLoginStatus,
    getMvaOverview,
    getMvaPeriod,
    governmentLoginStartUrl,
    markMvaFiledElsewhere,
    mvaDocumentUrl,
    mvaFiledXmlUrl,
    mvaPeriodXmlUrl,
    removeSecondMvaMelding,
    setSecondMvaMelding,
    submitMvaFiling,
    updateMvaSettings,
    withdrawMvaFiledElsewhere,
    type Company,
    type GovernmentLoginStatus,
    type MvaFiling,
    type MvaFilingStatus,
    type MvaNaering,
    type MvaOverview,
    type MvaPeriod,
    type MvaPeriodRow,
    type MvaSettings,
  } from '../lib/api';
  import { currentCompany, loadCompanies } from '../lib/company';
  import { el, setStatus, show } from '../lib/dom';
  import { isoDate, kroner, orgnummer, todayIso } from '../lib/format';
  import { canInCompany, loadSession, redirectToLogin } from '../lib/session';

  const pageStatus = el<HTMLParagraphElement>('#page-status');
  const settingsStatus = el<HTMLParagraphElement>('#settings-status');
  const actionStatus = el<HTMLParagraphElement>('#action-status');
  const submitStatus = el<HTMLParagraphElement>('#submit-status');
  const periodTypeSelect = el<HTMLSelectElement>('#period-type');
  const categorySelect = el<HTMLSelectElement>('#category');
  const checkForm = el<HTMLFormElement>('#check-form');
  const checkButton = el<HTMLButtonElement>('#check');
  const confirmBox = el<HTMLInputElement>('#confirm');
  const submitButton = el<HTMLButtonElement>('#submit');
  const secondForm = el<HTMLFormElement>('#second-form');
  const secondStatus = el<HTMLParagraphElement>('#second-status');
  const elsewhereForm = el<HTMLFormElement>('#elsewhere-form');
  const elsewhereStatus = el<HTMLParagraphElement>('#elsewhere-status');

  let company: Company;
  let year = new Date().getFullYear();
  let open: { year: number; termin: number } | null = null;
  let period: MvaPeriod | null = null;
  // Hvilken melding som vises: null er hovedmeldingen, som er den eneste
  // nesten alle selskaper har. Ellers kategorien til den andre.
  let naering: string | null = null;
  let naeringer: MvaNaering[] = [];
  let government: GovernmentLoginStatus = {
    available: false,
    logged_in: false,
    pid: null,
    acr: null,
    expires_at: null,
    linked: false,
    linked_name: null,
    linked_at: null,
  };

  // Tillatelsene spørres der de brukes, aldri tatt vare på: selskapet på
  // skjermen kan endre seg, og da gjelder svaret for det forrige.
  const mayWrite = (): boolean => canInCompany(company, 'ledger:write');
  const mayManage = (): boolean => canInCompany(company, 'organization:manage');

  const STATUS_TEXT: Record<MvaFilingStatus, string> = {
    validert: 'Kontrollert, ikke sendt',
    avvist: 'Avvist i kontrollen',
    sendt: 'Sendt, venter på kvittering',
    mottatt: 'Sendt og mottatt',
    feilet: 'Stoppet underveis',
    annet_program: 'Sendt fra et annet program',
    opphevet: 'Merking angret',
  };
  const STATUS_TONE: Partial<Record<MvaFilingStatus, string>> = {
    mottatt: 'ok',
    sendt: 'ok',
    annet_program: 'ok',
    avvist: 'error',
    feilet: 'error',
  };

  const DOCUMENT_TEXT: Record<string, string> = {
    kvittering: 'Kvittering (PDF)',
    betalingsinformasjon: 'Betalingsinformasjon',
    valideringsresultat: 'Kontrollresultat',
  };

  /** Beløpet uten fortegn. Fortegnet sier om det er å betale eller til gode, og det står i ordet. */
  function unsigned(amount: string): string {
    return kroner(amount.replace(/^-/, ''));
  }

  function owes(amount: string): boolean {
    return !amount.startsWith('-');
  }

  function cell(text: string, className?: string): HTMLTableCellElement {
    const td = document.createElement('td');
    if (className !== undefined) td.className = className;
    td.textContent = text;
    return td;
  }

  function badge(text: string, tone?: string): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = 'badge';
    span.textContent = text;
    if (tone !== undefined) span.dataset.tone = tone;
    return span;
  }

  /** `#2026-3` for hovedmeldingen, `#alminnelig-2026-3` for den andre. */
  function hashFor(termin: number, chosenYear: number = year): string {
    return `#${naering === null ? '' : `${naering}-`}${chosenYear}-${termin}`;
  }

  function dateTime(value: string): string {
    return new Date(value).toLocaleString('nb-NO', { dateStyle: 'medium', timeStyle: 'short' });
  }

  // --- Innstillinger ---------------------------------------------------------

  function fillSelect(select: HTMLSelectElement, choices: { value: string; label: string }[], value: string): void {
    select.replaceChildren(
      ...choices.map((choice) => {
        const option = document.createElement('option');
        option.value = choice.value;
        option.textContent = choice.label;
        return option;
      }),
    );
    select.value = value;
  }

  function renderSettings(settings: MvaSettings): void {
    const label = (choices: { value: string; label: string }[], value: string): string =>
      choices.find((choice) => choice.value === value)?.label ?? value;
    fillSelect(periodTypeSelect, settings.period_types, settings.period_type);
    fillSelect(categorySelect, settings.categories, settings.category);
    el('#period-type-text').textContent = label(settings.period_types, settings.period_type);
    el('#category-text').textContent = label(settings.categories, settings.category);
    // Et valg bare når det finnes et: én kategori å velge mellom er ikke et spørsmål.
    const manage = mayManage();
    show(periodTypeSelect, manage);
    show(el('#period-type-text'), !manage);
    show(categorySelect, manage && settings.categories.length > 1);
    show(el('#category-text'), !(manage && settings.categories.length > 1));
  }

  function saveSettings(payload: { period_type?: string; category?: string }): void {
    periodTypeSelect.disabled = true;
    categorySelect.disabled = true;
    void updateMvaSettings(company.id, payload)
      .then(async () => {
        setStatus(settingsStatus, 'Lagret.', 'ok');
        open = null;
        history.replaceState(null, '', '/mva/');
        await refresh();
      })
      .catch((error: unknown) => {
        setStatus(settingsStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke lagret.');
      })
      .finally(() => {
        periodTypeSelect.disabled = false;
        categorySelect.disabled = false;
      });
  }

  function renderSecond(settings: MvaSettings): void {
    const second = settings.second;
    const manage = mayManage();
    // Oppsettet tilbys der det hører hjemme: et selskap som leverer
    // primærnæringsmeldingen, eller et som allerede har to.
    show(el('#second'), second !== null || (manage && settings.category === 'primaernaering'));
    show(el('#second-current'), second !== null);
    show(el('#second-intro'), second === null);
    show(secondForm, manage);
    show(el('#second-remove'), manage && second !== null);
    const periodLabel = (value: string): string =>
      settings.period_types.find((choice) => choice.value === value)?.label ?? value;
    fillSelect(
      el<HTMLSelectElement>('#second-period-type'),
      settings.period_types,
      second?.period_type ?? 'toMaaneder',
    );
    if (second !== null) {
      el('#second-summary').textContent =
        `${second.label}, ${periodLabel(second.period_type).toLowerCase()}, fra og med ${isoDate(second.valid_from)}.`;
      el('#second-accounts').textContent =
        second.accounts.length === 0
          ? 'Ingen kontoer ennå: alt går i hovedmeldingen til kontoene er valgt.'
          : `Kontoer: ${second.accounts.map((account) => `${account.account_number} ${account.name}`).join(', ')}.`;
      el<HTMLInputElement>('#second-valid-from').value = second.valid_from;
      el<HTMLInputElement>('#second-accounts-input').value = second.accounts
        .map((account) => account.account_number)
        .join(', ');
    } else {
      el<HTMLInputElement>('#second-valid-from').value = `${year}-01-01`;
    }
  }

  secondForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(secondForm);
    const accounts = String(data.get('accounts') ?? '')
      .split(/[\s,;]+/)
      .filter((value) => value !== '');
    const save = el<HTMLButtonElement>('#second-save');
    save.disabled = true;
    setStatus(secondStatus, 'Lagrer …', 'ok');
    void setSecondMvaMelding(company.id, {
      period_type: String(data.get('period_type') ?? ''),
      valid_from: String(data.get('valid_from') ?? ''),
      accounts,
    })
      .then(async () => {
        setStatus(secondStatus, 'Lagret.', 'ok');
        await refresh();
      })
      .catch((error: unknown) => {
        setStatus(secondStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke lagret.');
      })
      .finally(() => {
        save.disabled = false;
      });
  });

  el('#second-remove').addEventListener('click', () => {
    const remove = el<HTMLButtonElement>('#second-remove');
    remove.disabled = true;
    void removeSecondMvaMelding(company.id)
      .then(async () => {
        setStatus(secondStatus, 'Fjernet. Alt går i hovedmeldingen igjen.', 'ok');
        naering = null;
        open = null;
        history.replaceState(null, '', '/mva/');
        await refresh();
      })
      .catch((error: unknown) => {
        setStatus(secondStatus, error instanceof ApiError ? error.message : 'Vi fikk ikke fjernet den.');
      })
      .finally(() => {
        remove.disabled = false;
      });
