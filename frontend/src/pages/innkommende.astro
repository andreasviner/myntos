---
import KiLevelPicker from '../components/KiLevelPicker.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/*
  Mottatt — samlet innboks for e-faktura (EHF over Peppol) og bilag mottatt
  på selskapets egen @myntos.no-adresse.

  Viser alltid kilden (EHF eller E-post) med tydelig bryter for å filtrere på
  bare e-faktura eller bare e-postfaktura, og gir full synlighet på hvem som
  sendte hver e-postfaktura (From, teknisk avsender, Reply-To, SPF/DKIM/DMARC
  og godkjente avsendere).
*/}
<BaseLayout
  title="Mottatt | Myntos"
  description="Se, kontroller avsender og bokfør leverandørfakturaer mottatt som EHF over Peppol eller på selskapets @myntos.no-adresse."
  width="wide"
>
  <header class="page-head">
    <div>
      <p class="eyebrow">Mottatt</p>
      <h1 data-session-company></h1>
      <p class="muted orgnr" id="orgnr"></p>
    </div>
    <div class="head-actions">
      <a class="btn btn-ghost" href="/organisasjon/#efaktura">E-fakturainnstillinger</a>
    </div>
  </header>

  <p class="status" id="page-status" role="status" hidden></p>
  <div class="empty" id="loading">Henter mottatte fakturaer og bilag …</div>

  <section id="inbox-body" hidden>
    <div class="channel-grid">
      <article class="card channel-card">
        <div class="channel-head">
          <div>
            <p class="eyebrow">E-faktura (EHF over Peppol)</p>
            <h2 class="channel-title" id="ehf-channel-title">Sjekker status …</h2>
          </div>
          <span class="badge" id="ehf-channel-badge"></span>
        </div>
        <p class="card-hint" id="ehf-channel-hint"></p>
        <p class="channel-link" id="ehf-channel-action" hidden>
          <a href="/organisasjon/#efaktura">Slå på mottak av e-faktura under Innstillinger →</a>
        </p>
      </article>

      <article class="card channel-card">
        <div class="channel-head">
          <div>
            <p class="eyebrow">E-postfaktura</p>
            <div class="address-row">
              <code class="inbox-address" id="mail-address">—</code>
              <button type="button" class="btn btn-ghost btn-small" id="copy-address-btn">
                Kopier
              </button>
            </div>
          </div>
          <span class="badge" id="mail-channel-badge"></span>
        </div>
        <p class="card-hint" id="mail-channel-hint"></p>
        <p class="notice notice-compact" id="mail-not-configured" hidden>
          E-postmottak er ikke aktivert i denne installasjonen ennå, men adressen er reservert for
          selskapet ditt.
        </p>
        <div class="channel-actions" id="mail-settings-toggle-wrap" hidden>
          <button
            type="button"
            class="btn btn-ghost btn-small"
            id="mail-settings-toggle"
            aria-expanded="false"
            aria-controls="mail-settings-panel"
          >
            Sikkerhet og godkjente avsendere
          </button>
        </div>

        <form id="mail-settings-panel" class="mail-settings" hidden novalidate>
          <label class="checkbox-row" for="mail-enabled">
            <input type="checkbox" id="mail-enabled" />
            <span>Ta imot fakturaer og kvitteringer på denne e-postadressen</span>
          </label>

          <fieldset class="policy-group">
            <legend>Hvem får sende til innboksen?</legend>
            <label class="radio-row">
              <input type="radio" name="sender-policy" value="alle_med_varsel" />
              <span>
                <strong>Alle, med avsendervarsel</strong> — alle kan sende, men ukjente eller
                mistenkelige avsendere merkes tydelig før bokføring.
              </span>
            </label>
            <label class="radio-row">
              <input type="radio" name="sender-policy" value="kun_godkjente" />
              <span>
                <strong>Kun godkjente avsendere</strong> — avviser automatisk e-post fra alle andre
                enn selskapets egne brukere og listen under.
              </span>
            </label>
          </fieldset>

          <div class="trusted-block" id="member-emails-block" hidden>
            <p class="field-label">Egne brukere (alltid godkjent)</p>
            <ul class="chip-list" id="member-emails-list"></ul>
          </div>

          <div class="trusted-block">
            <p class="field-label">Godkjente eksterne avsendere og domener</p>
            <p class="field-hint">
              Skriv inn en full e-postadresse (<code>faktura@leverandor.no</code>) eller et domene
              (<code>@leverandor.no</code>).
            </p>
            <div class="allowlist-add">
              <input
                type="text"
                id="allowlist-input"
                placeholder="faktura@leverandor.no eller @leverandor.no"
                autocomplete="off"
              />
              <button type="button" class="btn btn-ghost btn-small" id="allowlist-add-btn">
                Legg til
              </button>
            </div>
            <ul class="chip-list" id="allowlist-chips"></ul>
            <p class="muted small-note" id="allowlist-empty">Ingen eksterne avsendere lagt til ennå.</p>
          </div>

          <p class="status" id="mail-settings-status" role="status" hidden></p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-small" id="mail-settings-save">
              Lagre innstillinger
            </button>
          </div>
        </form>
      </article>
    </div>

    <div class="toolbar">
      <div class="source-switch" role="radiogroup" aria-label="Velg kilde for mottatte fakturaer">
        <button
          type="button"
          class="switch-option"
          role="radio"
          aria-checked="true"
          data-source="alle"
        >
          Alle <span class="switch-count" id="count-alle">0</span>
        </button>
        <button
          type="button"
          class="switch-option"
          role="radio"
          aria-checked="false"
          data-source="ehf"
        >
          Kun e-faktura (EHF) <span class="switch-count" id="count-ehf">0</span>
        </button>
        <button
          type="button"
          class="switch-option"
          role="radio"
          aria-checked="false"
          data-source="epost"
        >
          Kun e-postfaktura <span class="switch-count" id="count-epost">0</span>
        </button>
      </div>

      <div class="filter-bar" role="tablist" aria-label="Statusfilter for mottatte dokumenter">
        <button type="button" class="btn btn-small btn-primary" data-filter="ny">Nye</button>
        <button type="button" class="btn btn-small btn-ghost" data-filter="bokfort">Bokført</button>
        <button type="button" class="btn btn-small btn-ghost" data-filter="avvist">Avvist</button>
        <button type="button" class="btn btn-small btn-ghost" data-filter="alle">Alle</button>
      </div>
    </div>

    <div class="inbox-grid">
      <div class="card">
        <div class="table-scroll">
          <table class="data">
            <thead>
              <tr>
                <th>Kilde</th>
                <th>Dato</th>
                <th>Leverandør / Emne</th>
                <th>Avsender</th>
                <th class="num">Beløp / Fil</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="incoming-rows"></tbody>
          </table>
        </div>
        <p class="empty" id="incoming-empty" hidden>Ingen mottatte dokumenter i denne visningen.</p>
      </div>

      {/* --- Detaljkort for EHF --- */}
      <div class="card detail-card" id="ehf-detail-card" hidden>
        <div class="detail-head">
          <div>
            <p class="eyebrow" id="detail-kind"></p>
            <h2 id="detail-title"></h2>
            <p class="muted" id="detail-seller-meta"></p>
          </div>
          <div class="detail-downloads">
            <a class="btn btn-ghost btn-small" id="detail-pdf" href="#" target="_blank" rel="noopener">
              Last ned PDF
            </a>
            <a class="btn btn-ghost btn-small" id="detail-xml" href="#" target="_blank" rel="noopener">
              Last ned EHF (XML)
            </a>
          </div>
        </div>

        <dl class="meta-grid" id="detail-meta"></dl>

        <div id="detail-lines-wrap" hidden>
          <h3>Linjer</h3>
          <div class="table-scroll">
            <table class="data">
              <thead>
                <tr>
                  <th>Beskrivelse</th>
                  <th class="num">Antall</th>
                  <th class="num">Mva</th>
                  <th class="num">Beløp</th>
                </tr>
              </thead>
              <tbody id="detail-lines"></tbody>
            </table>
          </div>
        </div>

        <p class="meta-note" id="detail-note" hidden></p>

        <div id="detail-booked-box" class="booked-box" hidden>
          <p id="detail-booked-text"></p>
          <a class="btn btn-ghost btn-small" href="/bilag/">Se i bilagsoversikten</a>
        </div>

        <div id="detail-reopen-box" hidden>
          <p class="card-hint">
            Denne e-fakturaen er avvist og ligger ikke lenger under Nye. Den opprinnelige EHF-filen
            bevares likevel i regnskapet.
          </p>
          <button type="button" class="btn btn-ghost" id="reopen-btn">Åpne på nytt</button>
        </div>

        <form id="book-form" novalidate hidden>
          <h3>Bokfør som bilag</h3>
          <p class="card-hint" id="book-currency-hint" hidden></p>

          <label class="field" for="book-type">
            <span>Hva gjaldt fakturaen?</span>
            <select id="book-type" required></select>
          </label>

          <div class="form-row">
            <label class="field" for="book-date">
              <span>Dato</span>
              <input type="date" id="book-date" required />
            </label>
            <label class="field" for="book-amount">
              <span>Beløp i NOK (inkl. mva)</span>
              <input type="text" id="book-amount" inputmode="decimal" required />
            </label>
          </div>

          <div class="form-row">
            <label class="field" for="book-tax">
              <span>Mva-kode</span>
              <select id="book-tax"></select>
            </label>
            <label class="field" for="book-method">
              <span>Betalt via</span>
              <select id="book-method">
                <option value="bank">Bank (1920)</option>
                <option value="kontant">Kontant (1900)</option>
              </select>
            </label>
          </div>

          <label class="field" for="book-desc">
            <span>Beskrivelse</span>
            <input type="text" id="book-desc" maxlength="255" required />
          </label>

          <label class="checkbox-row" for="book-supplier">
            <input type="checkbox" id="book-supplier" checked />
            <span>Knytt til leverandør automatisk (opprett hvis den ikke finnes)</span>
          </label>

          <p class="status" id="detail-status" role="status" hidden></p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="book-submit">Bokfør bilag</button>
            <button type="button" class="btn btn-ghost" id="dismiss-btn">Avvis</button>
          </div>
        </form>
      </div>

      {/* --- Detaljkort for E-postfaktura --- */}
      <div class="card detail-card" id="mail-detail-card" hidden>
        <div class="detail-head">
          <div>
            <p class="eyebrow">E-postfaktura</p>
            <h2 id="mail-detail-title"></h2>
            <p class="muted" id="mail-detail-file-meta"></p>
          </div>
          <div class="detail-downloads">
            <button type="button" class="btn btn-ghost btn-small" id="mail-open-file-btn">
              Åpne vedlegg
            </button>
            <a class="btn btn-ghost btn-small" id="mail-download-link" href="#" download>
              Last ned
            </a>
          </div>
        </div>

        <section class="security-box" id="mail-security-box" data-tone="muted">
          <div class="security-head">
            <h3>Avsender og sikkerhet</h3>
            <span class="badge trust-badge" id="mail-trust-badge"></span>
          </div>
          <dl class="security-meta" id="mail-security-meta"></dl>
          <div class="auth-row" id="mail-auth-row"></div>
          <ul class="warning-list" id="mail-warnings" hidden></ul>
          <div class="approve-sender-row" id="mail-approve-row" hidden>
            <button type="button" class="btn btn-ghost btn-small" id="approve-sender-btn">
              Godkjenn avsender
            </button>
            <button type="button" class="btn btn-ghost btn-small" id="approve-domain-btn">
              Godkjenn hele domenet
            </button>
          </div>
        </section>

        <div class="mail-excerpt" id="mail-excerpt-wrap" hidden>
          <p class="field-label">Tekst i e-posten (kun ren tekst)</p>
          <pre id="mail-excerpt"></pre>
        </div>

        <div class="mail-preview" id="mail-preview-wrap" hidden>
          <img id="mail-preview-img" alt="Forhåndsvisning av mottatt vedlegg" hidden />
          <object id="mail-preview-pdf" type="application/pdf" hidden>
            <p class="card-hint">
              Nettleseren kunne ikke vise PDF-en direkte. Bruk «Åpne vedlegg» eller «Last ned» over.
            </p>
          </object>
        </div>

        <div id="mail-booked-box" class="booked-box" hidden>
          <p id="mail-booked-text"></p>
          <a class="btn btn-ghost btn-small" href="/bilag/">Se i bilagsoversikten</a>
        </div>

        <div id="mail-reopen-box" hidden>
          <p class="card-hint">
            Denne e-postfakturaen er avvist og ligger ikke lenger under Nye. Vedlegget bevares i
            regnskapet og kan åpnes på nytt ved behov.
          </p>
          <button type="button" class="btn btn-ghost" id="mail-reopen-btn">Åpne på nytt</button>
        </div>

        <form id="mail-book-form" novalidate hidden>
          <div class="book-form-head">
            <h3>Bokfør som bilag</h3>
            <button type="button" class="btn btn-ghost btn-small" id="mail-ki-btn" hidden>
              Les vedlegg med KI
            </button>
          </div>
          <div class="mail-ki-picker">
            <KiLevelPicker id="innkommende-vedlegg" />
          </div>
          <p class="card-hint" id="mail-ki-hint" hidden></p>

          <label class="field" for="mail-book-type">
            <span>Hva gjaldt fakturaen?</span>
            <select id="mail-book-type" required></select>
          </label>

          <div class="form-row">
            <label class="field" for="mail-book-date">
              <span>Dato</span>
              <input type="date" id="mail-book-date" required />
            </label>
            <label class="field" for="mail-book-amount">
              <span>Beløp i NOK (inkl. mva)</span>
              <input type="text" id="mail-book-amount" inputmode="decimal" required />
            </label>
          </div>

          <div class="form-row">
            <label class="field" for="mail-book-tax">
              <span>Mva-kode</span>
              <select id="mail-book-tax"></select>
            </label>
            <label class="field" for="mail-book-method">
              <span>Betalt via</span>
              <select id="mail-book-method">
                <option value="bank">Bank (1920)</option>
                <option value="kontant">Kontant (1900)</option>
              </select>
            </label>
          </div>

          <label class="field" for="mail-book-party">
            <span>Leverandør (valgfritt)</span>
            <select id="mail-book-party"></select>
          </label>

          <label class="field" for="mail-book-desc">
            <span>Beskrivelse</span>
            <input type="text" id="mail-book-desc" maxlength="255" required />
          </label>

          <p class="status" id="mail-detail-status" role="status" hidden></p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="mail-book-submit">Bokfør bilag</button>
            <button type="button" class="btn btn-ghost" id="mail-dismiss-btn">Avvis</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .page-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .orgnr {
    margin: 0.2rem 0 0;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    margin: 0 0 0.35rem;
  }
  .channel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 820px) {
    .channel-grid {
      grid-template-columns: 1fr;
    }
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .channel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .channel-title {
    margin: 0;
    font-size: 1.05rem;
  }
  .address-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .inbox-address {
    font-size: 1rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-small);
    background: var(--surface-alt, var(--accent-soft));
    word-break: break-all;
  }
  .channel-link {
    margin: 0.2rem 0 0;
  }
  .channel-actions {
    margin-top: 0.25rem;
  }
  .notice {
    margin: 0 0 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-small);
    background: var(--gold-soft);
    color: var(--fg);
  }
  .notice-compact {
    margin: 0.25rem 0;
    padding: 0.55rem 0.75rem;
    font-size: 0.9rem;
  }
  .mail-settings {
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .policy-group {
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    padding: 0.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .policy-group legend {
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0 0.35rem;
  }
  .radio-row {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .radio-row input {
    margin-top: 0.25rem;
  }
  .trusted-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field-label {
    font-weight: 600;
    font-size: 0.88rem;
    margin: 0;
  }
  .field-hint {
    font-size: 0.84rem;
    color: var(--muted);
    margin: 0;
  }
  .small-note {
    font-size: 0.85rem;
    margin: 0;
  }
  .allowlist-add {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .allowlist-add input {
    flex: 1 1 13rem;
  }
  .chip-list {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip-list :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.84rem;
    background: var(--bg);
  }
  .chip-list :global(.chip-remove) {
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0 0.1rem;
  }
  .chip-list :global(.chip-remove:hover) {
    color: var(--fg);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .source-switch {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 0.25rem;
    border-radius: var(--radius-small);
    border: 1px solid var(--border);
    background: var(--surface, var(--bg));
    gap: 0.25rem;
  }
  .switch-option {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: calc(var(--radius-small) - 2px);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: background-color 120ms ease, color 120ms ease;
  }
  .switch-option:hover {
    background: var(--accent-soft);
  }
  .switch-option[aria-checked='true'] {
    background: var(--accent);
    color: var(--accent-fg, #fff);
  }
  .switch-count {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: rgba(127, 127, 127, 0.18);
  }
  .switch-option[aria-checked='true'] .switch-count {
    background: rgba(255, 255, 255, 0.22);
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .inbox-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 1020px) {
    .inbox-grid {
      grid-template-columns: 1fr;
    }
  }
  .num {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  #incoming-rows :global(tr) {
    cursor: pointer;
  }
  #incoming-rows :global(tr[data-selected='true']) {
    background: var(--accent-soft);
  }
  #incoming-rows :global(.num) {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  #incoming-rows :global(.sender-cell) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }
  #incoming-rows :global(.sender-line) {
    font-size: 0.88rem;
    word-break: break-word;
  }
  #incoming-rows :global(.source-badge[data-source='ehf']) {
    background: var(--accent-soft);
    color: var(--accent);
  }
  #incoming-rows :global(.source-badge[data-source='epost']) {
    background: var(--gold-soft);
    color: var(--fg);
  }
  #incoming-rows :global(.badge[data-status='bokfort']) {
    background: var(--accent-soft);
    color: var(--positive);
  }
