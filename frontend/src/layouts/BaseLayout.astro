    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- Dropdown -------------------------------------------------------------- */

  .nav-dropdown {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    font: inherit;
    font-weight: 550;
