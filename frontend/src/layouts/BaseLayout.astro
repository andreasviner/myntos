  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem 1.4rem;
    font-size: 0.94rem;
    flex: 1;
    justify-content: space-between;
  }

  .nav-group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem 1.1rem;
  }

  .nav-primary {
    margin-inline-start: 1.5rem;
  }

  .nav-actions {
    margin-inline-start: auto;
    gap: 0.5rem;
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-weight: 550;
    padding: 0.35rem 0;
    transition: color 120ms ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--fg-strong);
  }

  /* Selskapet over, personen under: to linjer i én kolonne, slik at høyden
     holder seg innenfor headeren og navnet ikke dytter knappene. Chevronen
     står ved siden av begge linjene, ikke under den ene, så knappen leses som
     én ting man kan åpne. */
  .nav-identity {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.15rem 0;
    min-width: 0;
    text-decoration: none;
  }

  .nav-identity-tekst {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
