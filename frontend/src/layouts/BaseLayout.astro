     innholdet den sier noe om. */
  .selskap-byttet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 72rem;
    margin: 1rem auto 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--gold);
    border-radius: var(--radius-small);
    background: var(--gold-soft);
    font-size: 0.92rem;
  }

  .selskap-byttet p {
    margin: 0;
  }

  /* --- Page and footer --------------------------------------------------------- */

  main.page {
    flex: 1;
    padding-block: 3rem 5rem;
  }

  main.page-bleed {
    max-width: none;
    padding-inline: 0;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-tint);
    font-size: 0.9rem;
