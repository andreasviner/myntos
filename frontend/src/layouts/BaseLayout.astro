    letter-spacing: -0.025em;
    color: var(--fg-strong);
    margin: 0 0 0.6rem;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.1rem, 1.4rem + 2.8vw, 3.4rem);
    font-weight: 800;
  }

