  }

  .site-header-inner,
  .site-footer-inner,
  .page {
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding-inline: 1.25rem;
  }

  .page-wide,
  body:has(.page-wide) .site-header-inner,
  body:has(.page-wide) .site-footer-inner,
  .site-footer-inner {
    max-width: 72rem;
  }

  .site-header-inner {
    max-width: 72rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }

  .brand {
    display: inline-flex;
