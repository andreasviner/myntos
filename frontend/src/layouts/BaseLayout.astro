---
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Myntos — regnskap for Norge med offentlig kildekode og direkte innlevering til Skatteetaten.',
} = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">
        <Logo class="brand-logo" />
        <span class="brand-name">Myntos</span>
      </a>
    </header>
    <slot />
    {/* Legal disclaimer — must stay visible on every page. See /ansvar and DISCLAIMER.md. */}
    <footer class="site-footer">
      <p>
        <strong>All bruk skjer på eget ansvar.</strong> Myntos leveres uten garanti og uten
        ansvar for feil, tap eller sanksjoner. Programmet gir ikke regnskaps-, skatte- eller
        juridisk rådgivning — du er selv ansvarlig for alt du bokfører og sender inn.
        <a href="/ansvar/">Les hele ansvarsfraskrivelsen</a>.
      </p>
      {/* TODO: link the real repository URL once published */}
      <p class="meta">
        Kildekoden er offentlig tilgjengelig. © 2026 Andreas Lindeman. Med enerett.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #1a1f1d;
    --muted: #5b6662;
    --accent: #0b3d2e;
    --warn-bg: #fff7e6;
    --warn-border: #e6a700;
    --border: #e3e7e5;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121614;
      --fg: #e8ecea;
      --muted: #9aa5a0;
      --accent: #7fc8ab;
      --warn-bg: #2a2410;
      --warn-border: #b38600;
      --border: #2a312e;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
    background: var(--bg);
    color: var(--fg);
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }
  a {
    color: var(--accent);
  }
  .site-header {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
    width: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    text-decoration: none;
  }
  .brand-logo {
    height: 1.9rem;
    width: auto;
    display: block;
  }
  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .site-footer .meta {
    margin-top: 0.75rem;
  }
</style>
