    .nav-selskap {
      order: -1;
      flex: 1 0 100%;
    }

    .nav-identity,
    .nav-identity-tekst {
      align-items: flex-start;
    }

    .nav-identity {
      justify-content: space-between;
      width: 100%;
    }

    .nav-menu-selskap {
      max-height: none;
    }
  }

  /* Gult og ikke rødt, som varselet på /organisasjon/: ingenting er galt, to
