    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-identity:hover .nav-company-name,
  .nav-identity[aria-expanded='true'] .nav-company-name {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  /* En prikk holder fordi den bare betyr «se her». Rød fordi den skal fanges
     opp i et sideblikk, liten fordi ingenting er i stykker: regnskapet føres
     som før, og det som mangler er et bevis ingen har lagt fram ennå. */
  .nav-dot {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--danger);
  }

  .nav-user {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    max-width: 13rem;
