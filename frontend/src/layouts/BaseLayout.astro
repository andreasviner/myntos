    font-weight: 700;
  }

  .nav-selskap-liste {
    display: grid;
    gap: 0.1rem;
  }

  /* Hele raden er knappen, og den fyller menyens bredde: et treffområde man
     ikke kan bomme på med tommelen. */
  .nav-selskap-rad {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.5rem 0.7rem;
    border: none;
    border-radius: var(--radius-small);
    background: none;
    font: inherit;
    text-align: start;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .nav-selskap-rad:hover {
    background: var(--surface-2);
  }

  /* Det selskapet man allerede står i er ikke et valg, men det skal stå i
     listen: uten det måtte man lete etter det som ikke er der for å vite hvor
     man er. Haken sier hvor man er, og markøren sier at raden ikke fører noe
     nytt sted. */
  .nav-selskap-rad[aria-current='true'] {
    background: var(--surface-2);
    cursor: default;
  }

  .nav-selskap-tekst {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
    flex: 1;
  }

  .nav-selskap-navn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    /* Uten denne kan ikke navnet krympe, og et langt firmanavn dytter prikken
       ut av menyen i stedet for å bli forkortet. */
    min-width: 0;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--fg-strong);
    line-height: 1.3;
  }

  .nav-selskap-navn span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Organisasjonsnummeret alltid, fordi to selskaper i samme konsern deler
     navn oftere enn ikke. */
  .nav-selskap-orgnr {
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .nav-selskap-hake {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    color: var(--accent);
  }

  .nav-menu-tom {
    margin: 0;
    padding: 0.5rem 0.7rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  /* En strek mellom det som bytter selskap og det som gjør noe annet. Uten
     den ville «Legg til selskap» sett ut som enda et selskap i listen. */
  .nav-menu-bunn {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  .nav-menu-handling {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-small);
