---
import Logo from '../components/Logo.astro';
import { guider } from '../data/flytting';

interface Props {
  title: string;
  description?: string;
  /** `wide` gives the application pages room for tables and forms. */
  width?: 'narrow' | 'wide';
  /** `full` removes the page gutter so a marketing page can run edge to edge. */
  bleed?: boolean;
}

const {
  title,
  description = 'Myntos: regnskap for Norge med offentlig kildekode og direkte innlevering til Skatteetaten.',
  width = 'narrow',
  bleed = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/*
  Machine-readable identity.

  Google's OAuth brand review kept reporting that the consent-screen app name
  "Myntos" did not match the home page, and that the home page did not explain
  the app's purpose, while the rendered page said both. The site was shipping
  no Open Graph tags and no structured data at all, so an automated check had
  only prose to infer a name from. This states the name and purpose outright.

  APP_NAME is the single place the name is asserted to machines; it must stay
  byte-identical to the OAuth consent screen's "App name".
*/
const APP_NAME = 'Myntos';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://myntos.no/#organization',
      // Every `name` on the page must read "Myntos", because Google's brand review
      // compares the consent-screen app name against whatever name it finds
      // here, and an operator name in this field reads as a mismatch. The legal
      // entity is still stated, just not as the thing the product is called.
      name: APP_NAME,
      legalName: 'Lindeman Technologies',
      url: 'https://myntos.no/',
      logo: 'https://myntos.no/favicon-192.png',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://myntos.no/#website',
      name: APP_NAME,
      url: 'https://myntos.no/',
      inLanguage: 'nb-NO',
      publisher: { '@id': 'https://myntos.no/#organization' },
    },
    {
      '@type': 'SoftwareApplication',
      name: APP_NAME,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      url: 'https://myntos.no/',
      // English deliberately: this description exists for reviewers and
      // aggregators, not for the Norwegian customers the page itself serves.
      description:
        'Myntos is bookkeeping software for Norwegian companies. It records incoming and outgoing payments with their receipts, calculates value-added tax, and produces SAF-T exports and filings for the Norwegian Tax Administration.',
      publisher: { '@id': 'https://myntos.no/#organization' },
    },
  ],
};

/** The Funksjoner menu. One place to edit, used by both the desktop and mobile menu. */
const features = [
  {
    href: '/funksjoner/#kontantstrom',
    title: 'Kontantstrøm og bilag',
    blurb: 'Inn- og utbetalinger med PDF, ført med dobbel bokføring.',
  },
  {
    href: '/funksjoner/#faktura',
    title: 'Faktura og e-faktura',
    blurb: 'Salgsdokument etter § 5-1, med EHF klar til kravet i 2027.',
  },
  {
    href: '/funksjoner/#mva',
    title: 'Merverdiavgift',
    blurb: 'Mva-koder med datostyrte satser, regnet ut per føring.',
  },
  {
    href: '/funksjoner/#saft',
    title: 'SAF-T-eksport',
    blurb: 'Lovpålagt eksportformat, innebygd fra første linje.',
  },
  {
    href: '/funksjoner/#skattemelding',
    title: 'Skattemelding',
    blurb: 'Næringsspesifikasjon og innlevering via Altinn.',
  },
  {
    href: '/funksjoner/#samarbeid',
    title: 'Flere brukere',
    blurb: 'Organisasjon, roller og invitasjoner.',
  },
  {
    href: '/funksjoner/#apen-kildekode',
    title: 'Offentlig kildekode',
    blurb: 'Hele programmet er til å ettergå.',
  },
];

/**
 * Kom i gang-menyen. Oversikten først, deretter én oppføring per flytteguide.
 * De kommer fra data/flytting.ts, som også bygger sidene, slik at menyen
 * ikke kan peke på en guide som ikke finnes.
 */
const gettingStarted = [
  {
    href: '/kom-i-gang/',
    title: 'Flytt regnskapet hit',
    blurb: 'Hva du henter ut av det gamle programmet, i hvilken rekkefølge.',
  },
  ...guider.map((guide) => ({
    href: `/kom-i-gang/${guide.slug}/`,
    title: guide.menyTittel,
    blurb: guide.menyTekst,
  })),
];
---

{/*
  data-auth starts at "ut". The page that ships is the signed-out one, which is
  what a search engine and a browser without JavaScript should see; the inline
  script below upgrades it before first paint for a returning visitor, and
  lib/session.ts confirms or corrects it against the API a moment later.
*/}
<!doctype html>
<html lang="nb" data-auth="ut">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />

    {/* See APP_NAME above for why these exist. */}
    <link rel="canonical" href={canonical} />
    <meta name="application-name" content={APP_NAME} />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content="https://myntos.no/favicon-192.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {/*
      The SVG is what modern browsers use, and it carries its own
      prefers-color-scheme query, so the mark inverts with the browser chrome
      the way it inverts on the page. The PNGs exist because Google Search wants
      a square favicon whose side is a multiple of 48px and will not read the
      SVG; a PNG cannot invert, so it carries an opaque white tile instead. The
      tile is the point: left transparent, the consumer pads the space around
      the ink itself and the mark reads small. Regenerate with `pnpm favicons`.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint: the auth hint, the theme, and what the header
      // said last time, so a returning visitor never sees the wrong shell, a
      // flash of the wrong palette, or somebody else's company. Light is the
      // default, so only an explicit "dark" is applied.
      //
      // None of this is trusted for anything. Every one of these values is a
      // copy of something that was already on this screen, kept so it can be on
      // screen again a third of a second sooner; lib/session.ts replaces all of
      // it the moment the API answers, and disagrees with it freely.
      try {
        const store = window.localStorage;
        if (store.getItem('myntos.signed-in') === '1') {
          document.documentElement.dataset.auth = 'inn';
        }
        if (store.getItem('myntos.theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
        const raw = store.getItem('myntos.chrome');
        const hint = raw === null ? null : JSON.parse(raw);
        if (hint !== null && typeof hint === 'object' && typeof hint.user === 'string') {
          window.myntosHint = hint;
          // Read by the pages, not by the header: it is what lets the overview
          // lay itself out at its finished size straight away rather than grow
          // into it. "nei" is a real answer, meaning an account with no books
          // yet, and the absence of the attribute means we do not know.
          document.documentElement.dataset.books = hint.companies > 0 ? 'ja' : 'nei';
        }
        // The company being worked on, read from its own record and kept apart
        // from the account hint above on purpose. Name, confirmation mark and
        // id are one value here, so the name painted below and the id every
        // request is built from cannot be about two different companies. A
        // record from before that rule is a bare id and paints no name at all,
        // which is the right way to be out of date. See lib/tenant.ts.
        const stored = store.getItem('myntos.company');
        const company = stored === null ? null : JSON.parse(stored);
        if (company !== null && typeof company === 'object' && typeof company.name === 'string') {
          window.myntosCompany = company;
          document.documentElement.dataset.company = String(company.id);
        }
      } catch (error) {
        // No storage, or nonsense in it. The signed-out light view with an
        // empty header is the safe default, and it is one request away from
        // being filled in properly anyway.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#innhold">Hopp til innhold</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand">
          <Logo class="brand-logo" />
          <span class="brand-name">Myntos</span>
        </a>

        <button
          type="button"
          class="nav-toggle"
          data-menu-trigger
          aria-controls="hovedmeny"
          aria-expanded="false"
          aria-label="Åpne menyen"
        >
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="hovedmeny" data-menu data-collapse aria-label="Hovedmeny">
          {/* Signed out: what the product is. */}
          <div class="nav-group nav-primary" data-auth-only="ut">
            <div class="nav-dropdown" data-menu>
              <button
                type="button"
                class="nav-link nav-trigger"
                data-menu-trigger
                aria-controls="meny-funksjoner"
                aria-expanded="false"
              >
                Funksjoner
                <svg class="chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                  <path
                    d="M1 1.5 6 6.5l5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </button>
              <div class="nav-menu" id="meny-funksjoner" hidden>
                {
                  features.map((feature) => (
                    <a class="nav-menu-item" href={feature.href}>
                      <span class="nav-menu-title">{feature.title}</span>
                      <span class="nav-menu-blurb">{feature.blurb}</span>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="nav-dropdown" data-menu>
              <button
                type="button"
                class="nav-link nav-trigger"
                data-menu-trigger
                aria-controls="meny-kom-i-gang"
                aria-expanded="false"
              >
                Kom i gang
                <svg class="chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                  <path
                    d="M1 1.5 6 6.5l5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </button>
              <div class="nav-menu" id="meny-kom-i-gang" hidden>
                {
                  gettingStarted.map((item) => (
                    <a class="nav-menu-item" href={item.href}>
                      <span class="nav-menu-title">{item.title}</span>
                      <span class="nav-menu-blurb">{item.blurb}</span>
                    </a>
                  ))
                }
              </div>
            </div>

            <a class="nav-link" href="/priser/">Priser</a>
            <a class="nav-link" href="/bankpriser/">Bankpriser</a>
            {/* Egen fane, ikke et avsnitt i personvernerklæringen: et
                regnskapsprogram som sender bilag til en modell bør si det der
                folk ser etter det, ikke der de leter. */}
            <a class="nav-link" href="/ki/">KI</a>
          </div>

          {/* Signed in: the application.

              Kort med vilje. Toppen er ikke et innholdsfortegnelse over alle
              sidene, den er de få stedene man går rett til flere ganger om
              dagen. Kontantstrømmen nås fra oversikten, der tallene som får
              deg til å gå dit står; kunder og leverandører nås fra fakturaen
              og fra kontantstrømmen, der man faktisk trenger dem. En lenke
              som står overalt er ikke lettere å finne enn én som står der
              man er. */}
          {/* Rekkefølgen er arbeidsdagen: oversikten først, så det man gjør
              oftest. En betaling føres når den skjer, en faktura skrives når
              det passer, og KI er hjelpen man ber om underveis.

              «Betaling» og ikke «Kontantstrøm»: det er ordet på knappen folk
              allerede trykker på fra forsiden, og det navner det man skal
              gjøre framfor rapporten det ender i. */}
          <div class="nav-group nav-primary" data-auth-only="inn">
            <a class="nav-link" href="/">Oversikt</a>
            <a class="nav-link" href="/kontantstrom/">Betaling</a>
            <a class="nav-link" href="/faktura/">Faktura</a>
            <a class="nav-link" href="/ki/">KI</a>
          </div>

          <div class="nav-group nav-actions">
            <button type="button" class="icon-btn" data-theme-toggle aria-label="Bytt tema">
              <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
                <path
                  d="M12 2.5v2.2M12 19.3v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.7 4.7M19.3 19.3l-1.6-1.6M17.7 6.3l1.6-1.6M4.7 19.3l1.6-1.6"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"></path>
              </svg>
              <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
                  fill="currentColor"></path>
              </svg>
            </button>

            <span class="nav-group" data-auth-only="ut">
              <a class="btn btn-ghost btn-small" href="/logg-inn/">Logg inn</a>
              {/* «Opprett konto», ikke «Kom i gang»: den etiketten er nå en
                  meny med flytteguider, og to naboer med samme navn og ulikt
                  mål er en felle. */}
              <a class="btn btn-primary btn-small" href="/registrer/">Opprett konto</a>
            </span>

            {/* Selskapet først, personen under.

                Hver side i programmet handler om et regnskap, ikke om en konto:
                en regnskapsfører som bytter klient må se hvilken klient med ett
                blikk, mens ens eget navn aldri endrer seg. Derfor er navnet på
                selskapet det store og innloggingen det lille.

                Navnet er samtidig velgeren. Det man peker på når man tenker
                «dette selskapet» er det man klikker på for å bytte det, og en
                regnskapsfører med tolv klienter skal ikke innom en
                innstillingsside for å komme til den trettende. Innstillingene
                og «Legg til selskap» ligger nederst i den samme menyen, der de
                er ett klikk unna uten å ta plassen fra byttet. */}
            <span class="nav-group" data-auth-only="inn">
              <a
                class="icon-btn"
                href="/organisasjon/"
                aria-label="Innstillinger"
                title="Innstillinger"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"></path>
                  <path
                    d="M19.4 13.5a7.7 7.7 0 0 0 0-3l1.7-1.3-1.9-3.3-2 .8a7.7 7.7 0 0 0-2.6-1.5L14.3 3h-3.8l-.3 2.2a7.7 7.7 0 0 0-2.6 1.5l-2-.8L3.7 9.2l1.7 1.3a7.7 7.7 0 0 0 0 3l-1.7 1.3 1.9 3.3 2-.8a7.7 7.7 0 0 0 2.6 1.5l.3 2.2h3.8l.3-2.2a7.7 7.7 0 0 0 2.6-1.5l2 .8 1.9-3.3-1.7-1.3Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linejoin="round"></path>
                </svg>
              </a>

              <div class="nav-dropdown nav-selskap" data-menu>
                <button
                  type="button"
                  class="nav-identity nav-trigger"
                  data-menu-trigger
                  data-company-trigger
                  aria-controls="meny-selskap"
                  aria-expanded="false"
                >
                  <span class="visually-hidden">Bytt selskap</span>
                  <span class="nav-identity-tekst">
                    <span class="nav-company">
                      <span class="nav-company-name" data-session-company></span>
                      {/* En prikk, ikke et ord. At eierskapet ikke er bekreftet
                          er verdt å vite og ikke verdt å lese hver gang: den
                          fulle setningen står i det gule varselet på siden
                          prikken lenker til. */}
                      <span
                        class="nav-dot"
                        data-session-unverified
                        hidden
                        role="img"
                        aria-label="Ikke bekreftet"
                        title="Ingen har bekreftet i Altinn at de kan opptre for dette selskapet ennå."
                      ></span>
                    </span>
                    <span class="nav-user" data-session-name></span>
                  </span>
                  <svg class="chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                    <path
                      d="M1 1.5 6 6.5l5-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </button>

                {/* Selskapene fylles inn av company.ts når kontoen er kjent.
                    Listen står tom i filen som sendes ut, fordi siden er
                    forhåndsbygget og ikke vet hvem som spør. «Henter …» er det
                    sanne svaret i mellomtiden. */}
                <div class="nav-menu nav-menu-selskap" id="meny-selskap" hidden>
                  <p class="nav-menu-etikett">Selskaper</p>
                  <div class="nav-selskap-liste" data-company-list>
                    <p class="nav-menu-tom">Henter …</p>
                  </div>
                  <div class="nav-menu-bunn">
                    {/* «Legg til selskap» og ikke «opprett»: selskapet finnes
                        allerede i Enhetsregisteret, det er regnskapet som
                        settes opp. Skjult for den som ikke kan gjøre det:
                        organization:manage er det samme kravet siden selv
                        stiller. */}
                    <a
                      class="nav-menu-handling"
                      href="/nytt-selskap/"
                      data-company-add
                      hidden
                    >
                      <span class="nav-menu-pluss" aria-hidden="true">+</span>
                      Legg til selskap
                    </a>
                    <a class="nav-menu-handling" href="/organisasjon/#selskap">
                      Innstillinger for selskapet
                    </a>
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn-ghost btn-small" data-sign-out>Logg ut</button>
            </span>
          </div>
        </nav>
      </div>
    </header>

    {/*
      The header, painted from the hint the head script read.

      Inline and here rather than in the module script at the end of the body,
      because a module is deferred: it runs after the document is parsed, which
      is after the header has been on screen blank for a beat. This runs while
      the parser is still on this line, so the name is in place for the first
      paint. Its whole job is to say the same thing the page said last time; the
      API is what settles it.

      It reaches the header and nothing below it, for the same reason: the page
      has not been parsed yet. A page that carries its own data-session-* slots
      paints them from `window.myntosHint` and `window.myntosCompany` itself,
      right after its own markup. /index.astro is the one that does.
    */}
    <script is:inline>
      (function () {
        if (document.documentElement.dataset.auth !== 'inn') return;
        const hint = window.myntosHint;
        if (hint) {
          for (const node of document.querySelectorAll('[data-session-name]')) {
            node.textContent = hint.user;
          }
        }
        // The company and the mark that goes with it come from the company
        // record and never from the account hint, so a name here always belongs
        // to the id the page's requests will carry.
        const company = window.myntosCompany;
        if (company) {
          for (const node of document.querySelectorAll('[data-session-company]')) {
            node.textContent = company.name;
          }
          for (const node of document.querySelectorAll('[data-session-unverified]')) {
            node.hidden = company.name === '' || company.verified === true;
          }
        }
      })();
    </script>

    {/*
      Den ene tingen to faner kan komme i utakt om.

      Bytter man selskap i én fane, flytter valget seg for hele nettleseren.
      Denne fanen følger *ikke* etter: alt som står på skjermen ble hentet for
      selskapet den åpnet, og halve siden av ett selskaps tall under et annet
      selskaps navn er nettopp det som ikke får skje (lib/tenant.ts fryser
      valget per sidevisning). Men «selskapet du ser på» er ikke lenger «det
      nettstedet står på», og det er verdt å si i stedet for å skjule.

      Skjult til `storage`-hendelsen sier noe annet, og den kommer bare i de
      *andre* fanene, som er akkurat de som trenger beskjeden.
    */}
    <div class="selskap-byttet" data-company-switched hidden role="status">
      <p>
        Du byttet selskap i en annen fane. Denne siden viser fortsatt
        <strong data-session-company></strong>.
      </p>
      <button type="button" class="btn btn-ghost btn-small" data-company-reload>
        Last siden på nytt
      </button>
    </div>

    <main
      id="innhold"
      class:list={['page', width === 'wide' && 'page-wide', bleed && 'page-bleed']}
    >
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <Logo class="footer-logo" />
            <p class="footer-tagline">
              Regnskap for norske regler, med kildekoden i åpent lende.
            </p>
          </div>
          <nav class="footer-col" aria-label="Produkt">
            <h2>Produkt</h2>
            <a href="/funksjoner/">Funksjoner</a>
            <a href="/priser/">Priser</a>
            <a href="/registrer/">Opprett konto</a>
          </nav>
          <nav class="footer-col" aria-label="Ressurser">
            <h2>Ressurser</h2>
            <a href="/kom-i-gang/">Flytt regnskapet hit</a>
            <a href="/kom-i-gang/fiken/">Flytte fra Fiken</a>
            <a href="/kom-i-gang/tripletex/">Flytte fra Tripletex</a>
            <a href="/bankpriser/">Bankpriser for bedrift</a>
            <a href="/funksjoner/#apen-kildekode">Offentlig kildekode</a>
          </nav>
          <nav class="footer-col" aria-label="Juridisk">
            <h2>Juridisk</h2>
            <a href="/vilkar/">Bruksvilkår</a>
            <a href="/personvern/">Personvern</a>
            <a href="/ki/">Bruk av KI</a>
            <a href="/ansvar/">Ansvarsfraskrivelse</a>
          </nav>
        </div>
        <div class="footer-base">
          {/*
            Names the product and the company in one sentence, and says how they
            relate. Google's brand review reads a bare "© Lindeman Technologies"
            as the site's name, which is not what the service is called.
          */}
          <p class="meta">
            Myntos er en tjeneste fra Lindeman Technologies. © 2026. Kildekoden er offentlig
            tilgjengelig.
          </p>
          {/* The full disclaimer lives on /ansvar; one line is enough here. */}
          <p class="meta">
            Myntos er i tidlig utvikling og leveres uten garanti.
            <a href="/ansvar/">Ansvar og vilkår</a>.
          </p>
          {/*
            The site is Norwegian; this is the one English page, for readers who
            need to assess what the application does without reading Norwegian.
            Linked from every page because that is where a reviewer looks.
          */}
          <p class="meta"><a href="/about/" lang="en">About Myntos (in English)</a></p>
        </div>
      </div>
    </footer>

    <script>
      import { initNav, initThemeToggle } from '../lib/chrome';
      import { bootstrapHeaderCompany, prefetchCompanies } from '../lib/company';
      import { bootstrapChrome } from '../lib/session';

      // First, and before anything is awaited: /companies needs the session
      // cookie, which the browser attaches by itself, so there is nothing to
      // wait for. Asking after /auth/me answered put two full round trips in
      // single file at the top of every signed-in page, and the page under the
      // header could not ask for a figure until both were done. The promise is
      // shared, so the header and the page still make one request between them.
      prefetchCompanies();
      bootstrapChrome();
      // Fills the header with the company once the books are known, replacing
      // whatever the hint or the organization name was standing in with.
      bootstrapHeaderCompany();
      initThemeToggle();
      initNav();
    </script>
  </body>
</html>

<style is:global>
  /* --------------------------------------------------------------------------
     Palette.

     Light is the default and therefore lives in :root; dark is the single
     override, applied by a data attribute the visitor opts into. Every colour
     is a token, because nothing in a component should ever name a hex value, so a
     future rebrand is one block of edits.
     ----------------------------------------------------------------------- */

  :root {
    color-scheme: light;

    --bg: #ffffff;
    --bg-tint: #f5f8f7;
    --surface: #ffffff;
    --surface-2: #f2f6f5;
    --surface-3: #e8efec;
    --fg: #0e1a17;
    --fg-strong: #04100d;
    --muted: #55665f;
    --faint: #74857e;

    /* Deep green reads as "ledger" without the traffic-light green of a
       spreadsheet; it is the same hue the dark theme brightens into mint. */
    --accent: #0b7a61;
    --accent-hover: #096450;
    --accent-fg: #ffffff;
    --accent-soft: #e4f3ee;
    --accent-line: #bfded4;

    /* Warm counterweight, used for cautionary surfaces. */
    --gold: #9a6c06;
    --gold-soft: #fbf1d9;

    /* The logo mark has its own two tokens rather than borrowing --accent.
       The ring sits at almost the text colour and only the coin carries
       colour, which keeps the accent reserved for things that are actually
       clickable, since a mark painted in the button colour competes with every
       button on the page. */
    --logo-ring: #1c1f1e;
    --logo-coin: #0f8a68;

    --border: #dfe7e4;
    --border-strong: #c2cfcb;
    --danger: #a4201f;
    --danger-bg: #fdeceb;
    --danger-line: #f0c4c2;
    --positive: #0b7a61;
    --negative: #a4201f;

    --shadow: 0 1px 2px rgb(16 32 28 / 6%), 0 10px 28px -14px rgb(16 32 28 / 20%);
    --shadow-lifted: 0 2px 6px rgb(16 32 28 / 8%), 0 24px 48px -22px rgb(16 32 28 / 28%);
    --glow: radial-gradient(60rem 30rem at 50% -12rem, rgb(11 122 97 / 8%), transparent 70%);

    --radius: 14px;
    --radius-small: 9px;
    --radius-pill: 999px;

    --font: 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    --font-numeric: ui-monospace, 'SF Mono', 'Cascadia Mono', 'Segoe UI Mono', monospace;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;

    --bg: #0a0f0e;
    --bg-tint: #0d1413;
    --surface: #121b19;
    --surface-2: #182320;
    --surface-3: #1f2c28;
    --fg: #e8efec;
    --fg-strong: #ffffff;
    --muted: #91a29c;
    --faint: #6b7c77;

    --accent: #2ed3a5;
    --accent-hover: #58e0ba;
    --accent-fg: #04211a;
    --accent-soft: #10302a;
    --accent-line: #1d4f43;

    --gold: #f0b429;
    --gold-soft: #2c2310;

    --logo-ring: #eceeed;
    --logo-coin: #5ee0b4;

    --border: #23302c;
    --border-strong: #33443f;
    --danger: #ff8f8a;
    --danger-bg: #2c1615;
    --danger-line: #55231f;
    --positive: #2ed3a5;
    --negative: #ff8f8a;

    --shadow: 0 1px 2px rgb(0 0 0 / 40%), 0 12px 32px -16px rgb(0 0 0 / 70%);
    --shadow-lifted: 0 2px 4px rgb(0 0 0 / 40%), 0 24px 48px -20px rgb(0 0 0 / 80%);
    --glow: radial-gradient(60rem 30rem at 50% -12rem, rgb(46 211 165 / 12%), transparent 70%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Anchors from the Funksjoner menu must clear the sticky header. */
    scroll-padding-top: 5.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  body {
    margin: 0;
    font-family: var(--font);
    line-height: 1.65;
    background: var(--bg);
    background-image: var(--glow);
    background-repeat: no-repeat;
    color: var(--fg);
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
