  }

  .nav-menu-handling:hover {
    background: var(--surface-2);
    color: var(--fg-strong);
  }

  .nav-menu-pluss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-small);
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1;
  }

  .nav-menu-handling:hover .nav-menu-pluss {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* --- Icon button and theme toggle ------------------------------------------ */

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    text-decoration: none;
    transition:
      color 120ms ease,
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .icon-btn:hover {
    color: var(--fg-strong);
    border-color: var(--border-strong);
    background: var(--surface-2);
  }

  .icon-btn svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* Show the icon for the theme you would switch *to*. */
  .icon-sun {
    display: none;
  }

  .icon-moon {
    display: block;
  }

  :root[data-theme='dark'] .icon-sun {
    display: block;
  }

  :root[data-theme='dark'] .icon-moon {
    display: none;
  }

  /* --- Mobile menu ------------------------------------------------------------ */

  .nav-toggle {
    display: none;
    width: 2.4rem;
    height: 2.4rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: transparent;
    cursor: pointer;
    color: var(--fg);
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 1.05rem;
    height: 1.5px;
    background: currentcolor;
    border-radius: 2px;
    transition: transform 160ms ease;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: relative;
  }

  .nav-toggle-bars::before {
    top: -5px;
  }

  .nav-toggle-bars::after {
    top: 3.5px;
  }

  @media (width < 62rem) {
    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 1rem 1.25rem 1.4rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lifted);
    }

    .site-nav[data-open='true'] {
      display: flex;
    }

    .site-header-inner {
      position: relative;
      flex-wrap: wrap;
    }

    .nav-group {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .nav-primary,
    .nav-actions {
      margin-inline-start: 0;
    }

    .nav-actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.9rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--border);
    }

    .nav-actions .nav-group {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .nav-link,
    .nav-trigger {
      padding: 0.55rem 0;
      font-size: 1rem;
    }

    .nav-dropdown {
      position: static;
    }

    .nav-menu {
      position: static;
      width: auto;
      grid-template-columns: 1fr;
      box-shadow: none;
      background: var(--surface-2);
      margin-bottom: 0.4rem;
    }

    /* I mobilpanelet står selskapet på en linje for seg øverst, med
       tannhjulet og «Logg ut» under: selskapsnavn er det lengste i menyen, og
       klemt inntil to knapper ville det blitt kuttet til ordet «Nordmann».
       `order` og ikke ny rekkefølge i malen, fordi det bare er her det
