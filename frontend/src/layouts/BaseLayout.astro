       turn this sweep into a strobe rather than stop it. A flat tint says the
       same thing without moving at all. */
    .skeleton {
      animation: none !important;
      background: var(--surface-3);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
