    transition: transform 160ms ease;
  }

  .nav-trigger[aria-expanded='true'] {
    color: var(--fg-strong);
  }

  .nav-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .nav-menu {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: -0.75rem;
    width: min(30rem, calc(100vw - 2.5rem));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lifted);
  }

  .nav-menu-item {
    display: block;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-small);
    text-decoration: none;
    color: var(--fg);
    transition: background-color 120ms ease;
  }

  .nav-menu-item:hover {
    background: var(--surface-2);
  }

  .nav-menu-title {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--fg-strong);
  }

  .nav-menu-blurb {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.45;
    margin-top: 0.1rem;
  }

  /* --- Selskapsmenyen ---------------------------------------------------------

     Den generelle .nav-menu er to spalter og henger fra venstre kant, fordi
     Funksjoner har korte oppføringer med undertekst. Selskapslisten er én
     smal spalte i høyre ytterkant: navnene er lange, de leses nedover, og en
     meny som hang fra venstre her ville stukket ut av vinduet. */

  .nav-menu-selskap {
    left: auto;
    right: -0.5rem;
    width: min(20rem, calc(100vw - 2.5rem));
    grid-template-columns: 1fr;
    max-height: min(28rem, calc(100vh - 6rem));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav-menu-etikett {
    margin: 0.15rem 0.7rem 0.35rem;
