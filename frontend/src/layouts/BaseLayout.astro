  /* --- Waiting for figures --------------------------------------------------
     A page that is loading should be the page, at its finished size, with the
     numbers not filled in yet — not a smaller page that grows into the real one
     when the answer lands. Everything below is about holding the layout still.

     .skeleton is a shape standing where a value will be. It takes the width of
     the value it replaces so the column does not jump, and it is inert to a
     screen reader: the region it lives in carries aria-busy, which is the
     honest announcement, and a dozen unlabelled boxes are not.
  --------------------------------------------------------------------------- */

  .skeleton {
    display: inline-block;
    vertical-align: middle;
    width: var(--skeleton-width, 100%);
    height: 1em;
    border-radius: calc(var(--radius) / 2);
    background: linear-gradient(
      90deg,
      var(--surface-2) 0%,
      var(--surface-3) 40%,
      var(--surface-2) 80%
    );
    background-size: 300% 100%;
    animation: skeleton-sweep 1.4s ease-in-out infinite;
  }

  @keyframes skeleton-sweep {
