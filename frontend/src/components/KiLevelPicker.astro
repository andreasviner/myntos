---
/**
 * Valg av KI-nivå («Gratis», «Medium», «Smart») med veiledningslinje.
 *
 * Eneste sted på nettstedet som tegner radiogruppen for KI-nivå, så hver
 * KI-boks (`KiInput.astro`, med `inline`) og hver flate uten tekstboks
 * (`/analyse/`, `/innkommende/`) alltid viser de samme tre nivåene, med
 * «Medium» og «Smart» deaktivert når selskapet mangler aktiv KI-plan eller
 * har brukt opp ukekvoten. Drives av `mountKiInputs()` i `lib/kiinput.ts`.
 */
import { KI_LEVEL_CHOICES } from '../lib/kiinput';

interface Props {
  /** Unik på siden. Nivåvalget får navn og id-er av den. */
  id: string;
  /**
   * Når komponenten står inne i `KiInput.astro`, eier boksen selv
   * `[data-ki-input]` og veiledningslinjen under rammen, så her tegnes bare
   * selve radiogruppen.
   */
  inline?: boolean;
}

const { id, inline = false } = Astro.props;
const titleId = `${id}-niva-tittel`;
---

{
  inline ? (
    <div
      class="ki-level ki-level--inline"
      role="radiogroup"
      aria-labelledby={titleId}
      data-ki-levels
      hidden
    >
      <span class="ki-level-title" id={titleId}>KI-nivå</span>
      <span class="ki-level-options">
        {
          KI_LEVEL_CHOICES.map((level) => (
            <label class="ki-level-option" title={level.hint}>
              <input
                type="radio"
                name={`${id}-niva`}
                value={level.value}
                checked={level.value === 'free'}
              />
              <span>{level.name}</span>
            </label>
          ))
        }
      </span>
    </div>
  ) : (
    <div class="ki-picker" data-ki-input={id}>
      <div
        class="ki-level"
        role="radiogroup"
        aria-labelledby={titleId}
        data-ki-levels
        hidden
      >
        <span class="ki-level-title" id={titleId}>KI-nivå</span>
        <span class="ki-level-options">
          {
            KI_LEVEL_CHOICES.map((level) => (
              <label class="ki-level-option" title={level.hint}>
                <input
                  type="radio"
                  name={`${id}-niva`}
                  value={level.value}
                  checked={level.value === 'free'}
                />
                <span>{level.name}</span>
              </label>
            ))
          }
        </span>
      </div>
      <p class="ki-input-hint" data-ki-hint hidden></p>
    </div>
  )
}

<style>
  .ki-picker {
    margin: 0;
  }

  /* Margin på selve radiogruppen og veiledningen, ikke på .ki-picker, så
     komponenten tar null plass når KI er av og begge barn er skjult. */
  .ki-picker > .ki-level {
    margin-top: 0.75rem;
  }

  .ki-level {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .ki-level-title {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .ki-level--inline .ki-level-title {
    font-size: 0.8rem;
  }

  .ki-level-options {
    display: inline-flex;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--surface);
  }

  .ki-level-option {
    position: relative;
    display: inline-flex;
  }

  .ki-level-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .ki-level-option span {
    padding: 0.28rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .ki-level--inline .ki-level-option span {
    padding: 0.22rem 0.65rem;
    font-size: 0.82rem;
  }

  .ki-level-option + .ki-level-option span {
    border-left: 1px solid var(--border);
  }

  .ki-level-option input:checked + span {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .ki-level-option input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* Et nivå selskapet ikke har nå, står der fortsatt, så man ser at det
     finnes, men kan ikke velges. Linjen under sier hva som skal til. */
  .ki-level-option input:disabled,
  .ki-level-option input:disabled + span {
    cursor: not-allowed;
  }

  .ki-level-option input:disabled + span {
    opacity: 0.45;
  }

  .ki-input-hint {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
    color: var(--muted);
  }
</style>
