# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
secrets/
*.pem
*.p12
*.pfx
*.key
*.jwk
*.jwk.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/

# --- Node / Astro ---
node_modules/
dist/
.astro/
.wrangler/
*.tsbuildinfo

# --- Local data (bilag uploads, dev databases) ---
# Root-anchored: LOCAL_STORAGE_PATH is <repo>/data/bilag. An unanchored `data/`
# would also swallow source directories such as frontend/src/data/.
/data/
*.sqlite3

# --- Local deploy helpers (personal shortcuts, not project infra) ---
/upload.bat
# update.sh embeds this machine's sudo password so a restart does not stop to
# ask for it, so it must never be committed.
/update.sh

# --- OS / editors ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Local machine notes for Claude (not project infra) ---
/CLAUDE.local.md

# --- Real bilag used as extraction fixtures (never commit) ---
# regnaskaps_tests/ holds actual invoices, receipts and Finn/eBay/AliExpress
# screenshots with real names, addresses, order numbers and card digits on them,
# and the farm pilot's SAF-T files and Tripletex postings: a sole trader's whole
# books, which are personal data. They are the reference set the extraction
# pipeline and the SAF-T import are measured against: useful locally, never in
# the history.
/regnaskaps_tests/

# Claude Code's agent worktrees: full checkouts of this repository, which
# `git add -A` would otherwise record as embedded repositories.
/.claude/worktrees/
